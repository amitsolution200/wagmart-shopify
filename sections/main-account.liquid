{% comment %}
  Wagmart Classic Customer Account Dashboard Section
  Matches Wagmart design tokens: #7A46E5 primary, #F5F2EF cream, Lucide icons
{% endcomment %}

<style>
  .wm-account-page {
    background-color: #FBF9F7;
    min-height: calc(100vh - 200px);
    padding: 48px 20px 80px;
    font-family: inherit;
  }

  .wm-account-container {
    max-width: 1140px;
    margin: 0 auto;
  }

  .wm-account-hero {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 32px 36px;
    margin-bottom: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  @media (max-width: 768px) {
    .wm-account-hero {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
  }

  .wm-account-greeting {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .wm-account-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #F5F2EF;
    color: #7A46E5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
    flex-shrink: 0;
    border: 2px solid rgba(122, 70, 229, 0.15);
  }

  .wm-account-hero-title {
    font-size: 24px;
    font-weight: 800;
    color: #18181B;
    margin: 0 0 4px;
    letter-spacing: -0.01em;
  }

  .wm-account-hero-email {
    font-size: 14px;
    color: #71717A;
    margin: 0;
  }

  .wm-account-hero-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .wm-account-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 12px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    font-family: inherit;
  }

  .wm-account-btn--secondary {
    background: #F4F4F5;
    color: #27272A;
    border: 1px solid #E4E4E7;
  }

  .wm-account-btn--secondary:hover {
    background: #E4E4E7;
    color: #09090B;
  }

  .wm-account-btn--danger {
    background: #FFF1F2;
    color: #E11D48;
    border: 1px solid #FFE4E6;
  }

  .wm-account-btn--danger:hover {
    background: #FFE4E6;
    color: #BE123C;
  }

  .wm-account-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 32px;
  }

  @media (max-width: 900px) {
    .wm-account-grid {
      grid-template-columns: 1fr;
    }
  }

  .wm-account-card {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .wm-account-card-title {
    font-size: 18px;
    font-weight: 800;
    color: #18181B;
    margin: 0 0 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: -0.01em;
  }

  .wm-account-card-title svg {
    color: #7A46E5;
  }

  /* Orders Table */
  .wm-orders-table-wrap {
    overflow-x: auto;
  }

  .wm-orders-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    text-align: left;
  }

  .wm-orders-table th {
    padding: 12px 14px;
    font-weight: 700;
    color: #71717A;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1.5px solid #F4F4F5;
  }

  .wm-orders-table td {
    padding: 16px 14px;
    border-bottom: 1px solid #F4F4F5;
    color: #27272A;
    vertical-align: middle;
  }

  .wm-order-link {
    color: #7A46E5;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .wm-order-link:hover {
    color: #5B21B6;
    text-decoration: underline;
  }

  .wm-status-pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 700;
  }

  .wm-status-pill--paid,
  .wm-status-pill--fulfilled {
    background-color: #ECFDF5;
    color: #065F46;
  }

  .wm-status-pill--pending,
  .wm-status-pill--unfulfilled {
    background-color: #FFFBEB;
    color: #92400E;
  }

  .wm-empty-orders {
    text-align: center;
    padding: 48px 20px;
  }

  .wm-empty-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: #F5F2EF;
    color: #7A46E5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .wm-empty-title {
    font-size: 18px;
    font-weight: 800;
    color: #18181B;
    margin: 0 0 6px;
  }

  .wm-empty-desc {
    font-size: 14px;
    color: #71717A;
    margin: 0 0 20px;
  }

  .wm-empty-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: #7A46E5;
    color: #FFFFFF;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .wm-empty-btn:hover {
    background-color: #6938CE;
    transform: translateY(-1px);
  }

  /* Address Card */
  .wm-address-box {
    background: #FAFAFA;
    border-radius: 14px;
    border: 1px solid #F4F4F5;
    padding: 20px;
    font-size: 14px;
    color: #3F3F46;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .wm-address-box p {
    margin: 0 0 4px;
  }

  .wm-address-manage-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #7A46E5;
    font-weight: 700;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.15s ease;
  }

  .wm-address-manage-link:hover {
    color: #5B21B6;
    text-decoration: underline;
  }
</style>

<div class="wm-account-page">
  <div class="wm-account-container">

    {% comment %} Header Card {% endcomment %}
    <div class="wm-account-hero">
      <div class="wm-account-greeting">
        <div class="wm-account-avatar" aria-hidden="true">
          {{ customer.first_name | slice: 0, 1 | default: 'U' | upcase }}
        </div>
        <div>
          <h1 class="wm-account-hero-title">Welcome back, {{ customer.first_name | default: 'Pet Parent' }}!</h1>
          <p class="wm-account-hero-email">{{ customer.email }}</p>
        </div>
      </div>

      <div class="wm-account-hero-actions">
        <a href="{{ routes.account_addresses_url }}" class="wm-account-btn wm-account-btn--secondary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          <span>Addresses ({{ customer.addresses_count }})</span>
        </a>

        <a href="{{ routes.account_logout_url }}" class="wm-account-btn wm-account-btn--danger">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          <span>Sign Out</span>
        </a>
      </div>
    </div>

    {% comment %} 2-Column Split: Orders & Profile {% endcomment %}
    <div class="wm-account-grid">

      {% comment %} Left: Orders History {% endcomment %}
      <div class="wm-account-card">
        <h2 class="wm-account-card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
          </svg>
          <span>Your Orders</span>
        </h2>

        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <div class="wm-orders-table-wrap">
              <table class="wm-orders-table">
                <thead>
                  <tr>
                    <th>Order</th>
                    <th>Date</th>
                    <th>Payment</th>
                    <th>Fulfillment</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {%- for order in customer.orders -%}
                    <tr>
                      <td>
                        <a href="{{ order.customer_url }}" class="wm-order-link">{{ order.name }}</a>
                      </td>
                      <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                      <td>
                        <span class="wm-status-pill wm-status-pill--{{ order.financial_status }}">
                          {{ order.financial_status_label }}
                        </span>
                      </td>
                      <td>
                        <span class="wm-status-pill wm-status-pill--{{ order.fulfillment_status }}">
                          {{ order.fulfillment_status_label }}
                        </span>
                      </td>
                      <td style="font-weight: 700;">{{ order.total_price | money }}</td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
            </div>

            {%- if paginate.pages > 1 -%}
              <div style="margin-top: 24px;">
                {{ paginate | default_pagination }}
              </div>
            {%- endif -%}

          {%- else -%}
            <div class="wm-empty-orders">
              <div class="wm-empty-icon">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
              </div>
              <h3 class="wm-empty-title">No orders placed yet</h3>
              <p class="wm-empty-desc">Your order history will appear here once you make your first purchase.</p>
              <a href="{{ routes.all_products_collection_url }}" class="wm-empty-btn">
                <span>Start Shopping</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}

      </div>

      {% comment %} Right: Account Details & Default Address {% endcomment %}
      <div class="wm-account-card">
        <h2 class="wm-account-card-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
          </svg>
          <span>Account Details</span>
        </h2>

        <div class="wm-address-box">
          <p style="font-weight: 700; color: #18181B; margin-bottom: 6px;">{{ customer.name }}</p>
          <p>{{ customer.email }}</p>
          {%- assign customer_phone = customer.phone | default: customer.default_address.phone -%}
          {%- if customer_phone != blank -%}
            <p>{{ customer_phone }}</p>
          {%- endif -%}
          <div style="margin-top: 12px; padding-top: 12px; border-top: 1px solid #E4E4E7; display: flex; justify-content: space-between; gap: 12px; font-size: 13px;">
            <span><strong>Orders:</strong> {{ customer.orders_count }}</span>
            <span><strong>Total Spent:</strong> {{ customer.total_spent | money }}</span>
          </div>
          {%- if customer.default_address -%}
            <div style="margin-top: 14px; padding-top: 12px; border-top: 1px solid #E4E4E7;">
              <p style="font-size: 12px; font-weight: 700; color: #71717A; text-transform: uppercase; margin-bottom: 6px;">Default Shipping Address</p>
              {{ customer.default_address | format_address }}
            </div>
          {%- else -%}
            <p style="color: #71717A; font-size: 13px; margin-top: 10px;">No default address saved.</p>
          {%- endif -%}
        </div>

        <a href="{{ routes.account_addresses_url }}" class="wm-address-manage-link">
          <span>Manage Saved Addresses ({{ customer.addresses_count }})</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>

      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}
