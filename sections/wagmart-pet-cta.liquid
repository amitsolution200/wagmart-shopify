{% comment %}
  Wagmart Premium Pet Store CTA Banner Section
  - Minimal, warm cream / off-white palette with dark forest-green typography
  - Two-column responsive layout (Image Left, CTA Content Right)
  - Pure transparent PNG product composition
  - Fully accessible, keyboard friendly, and SEO optimized
  - Online Store 2.0 Theme Editor Schema settings
{% endcomment %}

{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.color_bg | default: '#FAF8F5'
  assign heading_color = section.settings.color_heading | default: '#183B2B'
  assign eyebrow_color = section.settings.color_eyebrow | default: '#2E604A'
  assign text_color = section.settings.color_text | default: '#44564C'
  assign btn_bg = section.settings.color_btn_bg | default: '#183B2B'
  assign btn_text = section.settings.color_btn_text | default: '#FFFFFF'
  assign btn_hover_bg = section.settings.color_btn_hover | default: '#234E39'
  assign img_width_pct = section.settings.desktop_image_width | default: 50
  assign pad_top = section.settings.padding_top | default: 64
  assign pad_bottom = section.settings.padding_bottom | default: 64
  assign pad_top_mobile = section.settings.padding_top_mobile | default: 40
  assign pad_bottom_mobile = section.settings.padding_bottom_mobile | default: 48
  assign layout_order = section.settings.desktop_layout | default: 'image_first'
  
  if section.settings.image != blank
    assign cta_image = section.settings.image
    assign img_src = cta_image | image_url: width: 1400
    assign img_alt = section.settings.image_alt | default: cta_image.alt | default: 'Wagmart premium pet essentials collection'
  else
    assign img_src = 'wagmart-pet-products.png' | asset_url
    assign img_alt = section.settings.image_alt | default: 'Wagmart premium pet essentials collection: dog food, ceramic bowl, grooming brush, herbal shampoo, rope toy and ball'
  endif

  assign button_url = section.settings.button_link
  if button_url == blank
    assign button_url = routes.all_products_collection_url | default: '/collections/all'
  endif
-%}

<style>
  #shopify-section-{{ section_id }} .wm-pet-cta-banner {
    background-color: {{ bg_color }};
    padding-top: {{ pad_top_mobile }}px;
    padding-bottom: {{ pad_bottom_mobile }}px;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner {
      padding-top: {{ pad_top }}px;
      padding-bottom: {{ pad_bottom }}px;
    }
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__container {
    max-width: 1400px;
    margin: 0 auto;
    padding-left: clamp(16px, 4vw, 48px);
    padding-right: clamp(16px, 4vw, 48px);
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__grid {
      display: grid;
      grid-template-columns: minmax(0, {{ img_width_pct }}fr) minmax(0, {{ 100 | minus: img_width_pct }}fr);
      align-items: center;
      gap: clamp(32px, 5vw, 72px);
      {% if layout_order == 'content_first' %}
      direction: rtl;
      {% endif %}
    }
    {% if layout_order == 'content_first' %}
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__grid > * {
      direction: ltr;
    }
    {% endif %}
  }

  /* Left Column: Image wrapper */
  #shopify-section-{{ section_id }} .wm-pet-cta-banner__media {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__img {
    width: 100%;
    max-width: 640px;
    height: auto;
    max-height: 480px;
    object-fit: contain;
    aspect-ratio: 1200 / 896;
    display: block;
    margin: 0 auto;
    background: transparent;
    filter: drop-shadow(0 12px 28px rgba(24, 59, 43, 0.08));
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (min-width: 1200px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__img {
      max-height: 520px;
    }
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner:hover .wm-pet-cta-banner__img {
    transform: scale(1.015);
  }

  /* Right Column: CTA Content */
  #shopify-section-{{ section_id }} .wm-pet-cta-banner__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 580px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__content {
      align-items: flex-start;
      text-align: left;
      margin: 0;
    }
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__eyebrow {
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ eyebrow_color }};
    margin-bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: currentColor;
    display: inline-block;
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 48px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: {{ heading_color }};
    margin: 0 0 16px 0;
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__description {
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-weight: 500;
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.6;
    color: {{ text_color }};
    margin: 0 0 28px 0;
    max-width: 480px;
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 440px;
    gap: 14px;
    margin-bottom: 24px;
  }

  @media (min-width: 600px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__actions {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      width: auto;
      max-width: none;
      gap: 18px;
    }
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__actions {
      justify-content: flex-start;
      gap: 18px;
    }
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background-color: {{ btn_bg }};
    color: {{ btn_text }};
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(24, 59, 43, 0.16);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    border: none;
    text-align: center;
    width: 100%;
    box-sizing: border-box;
    white-space: nowrap;
  }

  @media (min-width: 600px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn {
      width: auto;
      padding: 16px 32px;
    }
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn:hover {
    background-color: {{ btn_hover_bg }};
    color: {{ btn_text }};
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(24, 59, 43, 0.22);
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(24, 59, 43, 0.14);
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn:focus-visible {
    outline: 3px solid #7a46e5;
    outline-offset: 3px;
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn-arrow {
    width: 14px;
    height: 14px;
    transition: transform 0.25s ease;
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn:hover .wm-pet-cta-banner__btn-arrow {
    transform: translateX(4px);
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #ffffff;
    color: #183B2B !important;
    border: 1.5px solid #D5CEBF;
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 13.5px;
    text-decoration: none;
    padding: 13px 22px;
    border-radius: 9999px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    text-align: center;
    width: 100%;
    box-sizing: border-box;
    white-space: nowrap;
  }

  @media (min-width: 600px) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn-secondary {
      width: auto;
      padding: 15px 26px;
    }
  }

  #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn-secondary:hover {
    border-color: #183B2B;
    background-color: #FAF8F5;
    transform: translateY(-1px);
  }

  /* Accessibility: Respect Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__img,
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn,
    #shopify-section-{{ section_id }} .wm-pet-cta-banner__btn-arrow {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<section
  id="wm-pet-cta-{{ section_id }}"
  class="wm-pet-cta-banner"
  aria-labelledby="wm-pet-cta-heading-{{ section_id }}"
>
  <div class="wm-pet-cta-banner__container">
    <div class="wm-pet-cta-banner__grid">
      
      {% comment %} Left Column: Transparent Pet Product Image {% endcomment %}
      <figure class="wm-pet-cta-banner__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1400',
            sizes: '(min-width: 1200px) 640px, (min-width: 768px) 50vw, 90vw',
            alt: img_alt,
            class: 'wm-pet-cta-banner__img'
          }}
        {%- else -%}
          <img
            src="{{ img_src }}"
            alt="{{ img_alt | escape }}"
            class="wm-pet-cta-banner__img"
            loading="lazy"
            width="1200"
            height="896"
          >
        {%- endif -%}
      </figure>

      {% comment %} Right Column: CTA Content {% endcomment %}
      <div class="wm-pet-cta-banner__content">
        {%- if section.settings.eyebrow != blank -%}
          <div class="wm-pet-cta-banner__eyebrow">
            <span class="wm-pet-cta-banner__eyebrow-dot" aria-hidden="true"></span>
            <span>{{ section.settings.eyebrow }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2
            id="wm-pet-cta-heading-{{ section_id }}"
            class="wm-pet-cta-banner__heading"
          >
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="wm-pet-cta-banner__description">
            {{ section.settings.description }}
          </p>
        {%- endif -%}

        <div class="wm-pet-cta-banner__actions">
          {%- if section.settings.button_label != blank -%}
            <a
              href="{{ button_url }}"
              class="wm-pet-cta-banner__btn"
              aria-label="{{ section.settings.button_label | escape }} - {{ section.settings.heading | default: 'Shop Pet Products' | escape }}"
            >
              <span>{{ section.settings.button_label }}</span>
              <svg class="wm-pet-cta-banner__btn-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a
              href="{{ section.settings.secondary_button_link | default: 'tel:+917777985896' }}"
              class="wm-pet-cta-banner__btn-secondary"
              aria-label="{{ section.settings.secondary_button_label | escape }}"
            >
              <svg style="width:16px;height:16px;color:#2E604A;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>{{ section.settings.secondary_button_label }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pet Store CTA Banner",
  "tag": "section",
  "class": "section-wagmart-pet-cta",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small Eyebrow Text",
      "default": "MADE FOR HAPPY PETS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Everything Your Pet Needs"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Supporting Description Text",
      "default": "Discover everyday essentials for happier, healthier pets."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary CTA Button Label",
      "default": "SHOP PET PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA Button Destination Link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary CTA Button Label",
      "default": "Call Us Now"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary CTA Button Link",
      "info": "Leave blank to default to telephone link"
    },
    {
      "type": "header",
      "content": "Product Composition Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product Composition Image",
      "info": "Upload a high-quality transparent PNG of your pet product composition. Default uses wagmart-pet-products.png"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alternative Text",
      "default": "Wagmart premium pet essentials collection"
    },
    {
      "type": "header",
      "content": "Color Palette"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Section Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "color_eyebrow",
      "label": "Eyebrow Accent Color",
      "default": "#2E604A"
    },
    {
      "type": "color",
      "id": "color_heading",
      "label": "Heading Text Color",
      "default": "#183B2B"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Description Text Color",
      "default": "#44564C"
    },
    {
      "type": "color",
      "id": "color_btn_bg",
      "label": "CTA Button Background Color",
      "default": "#183B2B"
    },
    {
      "type": "color",
      "id": "color_btn_text",
      "label": "CTA Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "CTA Button Hover Color",
      "default": "#234E39"
    },
    {
      "type": "header",
      "content": "Layout & Spacing"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop Layout Alignment",
      "options": [
        {
          "value": "image_first",
          "label": "Product Image Left, CTA Right"
        },
        {
          "value": "content_first",
          "label": "CTA Left, Product Image Right"
        }
      ],
      "default": "image_first"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "min": 40,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Desktop Product Image Column Width",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Wagmart Pet CTA Banner",
      "settings": {
        "eyebrow": "MADE FOR HAPPY PETS",
        "heading": "Everything Your Pet Needs",
        "description": "Discover everyday essentials for happier, healthier pets.",
        "button_label": "SHOP PET PRODUCTS",
        "color_bg": "#FAF8F5",
        "color_heading": "#183B2B",
        "color_eyebrow": "#2E604A",
        "color_text": "#44564C",
        "color_btn_bg": "#183B2B",
        "color_btn_text": "#FFFFFF",
        "desktop_image_width": 50
      }
    }
  ]
}
{% endschema %}
