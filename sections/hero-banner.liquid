{% comment %}
  Wagmart Hero Carousel Section
{% endcomment %}

<style>
  /* Full-screen hero that starts at the very top of the page, underneath the floating navbar */
  .wm-hero-full {
    --hero-offset: var(--wm-header-total, 76px);
    height: 100vh;                 /* fallback */
    height: 100svh;                /* stable on mobile (address bar visible) */
    min-height: 480px;             /* safety for very short landscape screens */
    margin-top: calc(-1 * var(--hero-offset));
  }
  /* Keep slide content optically centred in the visible area below the navbar */
  .wm-hero-full .hero-slide-content {
    padding-top: var(--hero-offset);
  }
  .wm-hero-full [data-hero-prev],
  .wm-hero-full [data-hero-next] {
    top: calc(50% + (var(--hero-offset) / 2));
  }

  /* Overlay: Mobile & Tablet for ALL sliders */
  .wm-hero-overlay-mobile {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.55) 45%, rgba(255, 255, 255, 0.12) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* Overlay: Laptop (Slides 2 to 5 / layout-left) */
  .wm-hero-overlay-laptop-left {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 58%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.72) 55%, rgba(255, 255, 255, 0) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* Slide Flex container */
  .wm-hero-slide-flex {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
  }

  /* Mobile and Tablet rules (< 1024px) */
  @media (max-width: 1023px) {
    .wm-hero-overlay-mobile {
      display: block !important;
    }
    .wm-hero-overlay-laptop-left {
      display: none !important;
    }
    .wm-hero-slide-flex {
      justify-content: center !important;
      padding-left: 2.75rem !important;
      padding-right: 2.75rem !important;
      padding-bottom: 2rem !important;
    }
    .wm-hero-content-box {
      text-align: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
      width: 100% !important;
      max-width: 460px !important;
    }
    .wm-hero-content-box .wm-hero-desc {
      margin-left: auto !important;
      margin-right: auto !important;
      text-align: center !important;
    }
    .wm-hero-content-box .wm-hero-btn-wrap {
      display: flex !important;
      justify-content: center !important;
      width: 100% !important;
    }
    .wm-hero-slide-img {
      object-position: center !important;
    }
  }

  /* Laptop & Desktop rules (>= 1024px) */
  @media (min-width: 1024px) {
    .wm-hero-overlay-mobile {
      display: none !important;
    }
    .wm-hero-overlay-laptop-left {
      display: block !important;
    }

    /* Layout Center (Slide 1) */
    .wm-hero-slide-flex.layout-center {
      justify-content: center !important;
      padding-left: 2rem !important;
      padding-right: 2rem !important;
      padding-bottom: 0 !important;
    }
    .wm-hero-content-box.layout-center {
      text-align: center !important;
      margin-left: auto !important;
      margin-right: auto !important;
      max-width: 640px !important;
    }
    .wm-hero-content-box.layout-center .wm-hero-desc {
      margin-left: auto !important;
      margin-right: auto !important;
      text-align: center !important;
    }
    .wm-hero-content-box.layout-center .wm-hero-btn-wrap {
      display: flex !important;
      justify-content: center !important;
    }
    .wm-hero-slide-img.layout-center {
      object-position: center !important;
    }

    /* Layout Left (Slides 2 to 5) */
    .wm-hero-slide-flex.layout-left {
      justify-content: flex-start !important;
      padding-left: 4.5rem !important;
      padding-right: 2rem !important;
      padding-bottom: 0 !important;
    }
    .wm-hero-content-box.layout-left {
      text-align: left !important;
      margin-left: 0 !important;
      margin-right: auto !important;
      max-width: 520px !important;
    }
    .wm-hero-content-box.layout-left .wm-hero-desc {
      margin-left: 0 !important;
      margin-right: auto !important;
      text-align: left !important;
    }
    .wm-hero-content-box.layout-left .wm-hero-btn-wrap {
      display: flex !important;
      justify-content: flex-start !important;
    }
    .wm-hero-slide-img.layout-left {
      object-position: right center !important;
    }
  }
</style>

<section
  id="hero"
  aria-label="Pet Care Featured Highlights"
  class="wm-hero-full relative w-full bg-white overflow-hidden"
>
  {% comment %} Slides Container {% endcomment %}
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div
        class="absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out select-none {% if forloop.first %}opacity-100 z-10{% else %}opacity-0 pointer-events-none -z-10{% endif %}"
        data-hero-slide
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1920 }}"
            alt="{{ block.settings.title | escape }}"
            class="wm-hero-slide-img layout-{{ block.settings.layout }} absolute inset-0 w-full h-full object-cover select-none pointer-events-none"
            {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {%- else -%}
          {%- assign default_img_index = forloop.index -%}
          {%- if section.blocks.size == 4 -%}
            {%- assign default_img_index = forloop.index | plus: 1 -%}
          {%- endif -%}
          {%- assign default_img = 'hero-banner-' | append: default_img_index | append: '.webp' -%}
          <img
            src="{{ default_img | asset_url }}"
            alt="{{ block.settings.title | escape }}"
            class="wm-hero-slide-img layout-{{ block.settings.layout }} absolute inset-0 w-full h-full object-cover select-none pointer-events-none"
            {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}
            width="1920"
            height="700"
          >
        {%- endif -%}

        {% comment %} Mobile & Tablet gentle readability overlay for ALL slides {% endcomment %}
        <div class="wm-hero-overlay-mobile"></div>

        {% comment %} Left-side gradient overlay for slides 2 to 5 on Laptop {% endcomment %}
        {%- if block.settings.layout == 'left' -%}
          <div class="wm-hero-overlay-laptop-left"></div>
        {%- endif -%}

        {% comment %} Slide Content Overlay {% endcomment %}
        <div class="hero-slide-content wm-hero-slide-flex layout-{{ block.settings.layout }} max-w-7xl mx-auto select-text">
          <div class="wm-hero-content-box layout-{{ block.settings.layout }} py-6 sm:py-8 pointer-events-auto">
            <h1 class="font-nunito font-extrabold text-2xl sm:text-3xl md:text-4xl lg:text-[3.25rem] xl:text-[3.5rem] tracking-tight leading-[1.15] text-[#1E2228]">
              <span>{{ block.settings.title }}</span><br>
              <span class="text-[#7a46e5]">{{ block.settings.title_accent }}</span>
            </h1>
            <p class="wm-hero-desc mt-3 sm:mt-4 text-xs sm:text-sm md:text-base lg:text-[16px] text-[#4F463E] font-medium leading-relaxed max-w-xs sm:max-w-sm md:max-w-[430px]">
              {{ block.settings.subtitle }}
            </p>
            <div class="wm-hero-btn-wrap mt-6 sm:mt-7 select-none">
              {%- assign btn_href = block.settings.button_link | default: '#shop' -%}
              {% render 'theme-button', text: block.settings.button_text, href: btn_href %}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  {%- else -%}
    {% comment %} Default Fallback: 4 Left-aligned Slides {% endcomment %}
    {% comment %} Slide 1: Clean Pets {% endcomment %}
    <div class="absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out select-none opacity-100 z-10" data-hero-slide>
      <img src="{{ 'hero-banner-2.webp' | asset_url }}" alt="Hero banner 2" class="wm-hero-slide-img layout-left absolute inset-0 w-full h-full object-cover select-none pointer-events-none" loading="eager" width="1920" height="700">
      <div class="wm-hero-overlay-mobile"></div>
      <div class="wm-hero-overlay-laptop-left"></div>
      <div class="hero-slide-content wm-hero-slide-flex layout-left max-w-7xl mx-auto select-text">
        <div class="wm-hero-content-box layout-left py-6 sm:py-8 pointer-events-auto">
          <h1 class="font-nunito font-extrabold text-2xl sm:text-3xl md:text-4xl lg:text-[3.25rem] xl:text-[3.5rem] tracking-tight leading-[1.12] text-[#1E2228]">
            <span>Clean Pets,</span><br>
            <span class="text-[#7a46e5]">Happier Days</span>
          </h1>
          <p class="wm-hero-desc mt-3 sm:mt-4 text-xs sm:text-sm md:text-base lg:text-[16px] text-[#4F463E] font-medium leading-relaxed max-w-xs sm:max-w-sm md:max-w-[430px]">
            Wagmart Neem & Aloevera Shampoo keeps your pet’s coat clean, soft, fresh and naturally healthy.
          </p>
          <div class="wm-hero-btn-wrap mt-6 sm:mt-7 select-none">
            {% render 'theme-button', text: 'Shop Now', href: '#shop' %}
          </div>
        </div>
      </div>
    </div>

    {% comment %} Slide 2: A Cleaner Home {% endcomment %}
    <div class="absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out select-none opacity-0 pointer-events-none -z-10" data-hero-slide>
      <img src="{{ 'hero-banner-3.webp' | asset_url }}" alt="Hero banner 3" class="wm-hero-slide-img layout-left absolute inset-0 w-full h-full object-cover select-none pointer-events-none" loading="lazy" width="1920" height="700">
      <div class="wm-hero-overlay-mobile"></div>
      <div class="wm-hero-overlay-laptop-left"></div>
      <div class="hero-slide-content wm-hero-slide-flex layout-left max-w-7xl mx-auto select-text">
        <div class="wm-hero-content-box layout-left py-6 sm:py-8 pointer-events-auto">
          <h1 class="font-nunito font-extrabold text-2xl sm:text-3xl md:text-4xl lg:text-[3.25rem] xl:text-[3.5rem] tracking-tight leading-[1.12] text-[#1E2228]">
            <span>A Cleaner Home,</span><br>
            <span class="text-[#7a46e5]">A Happier Pet</span>
          </h1>
          <p class="wm-hero-desc mt-3 sm:mt-4 text-xs sm:text-sm md:text-base lg:text-[16px] text-[#4F463E] font-medium leading-relaxed max-w-xs sm:max-w-sm md:max-w-[430px]">
            Easily remove loose pet hair from your pet, sofa, bed, clothes and more.
          </p>
          <div class="wm-hero-btn-wrap mt-6 sm:mt-7 select-none">
            {% render 'theme-button', text: 'Shop Now', href: '#shop' %}
          </div>
        </div>
      </div>
    </div>

    {% comment %} Slide 3: Gentle Grooming {% endcomment %}
    <div class="absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out select-none opacity-0 pointer-events-none -z-10" data-hero-slide>
      <img src="{{ 'hero-banner-4.webp' | asset_url }}" alt="Hero banner 4" class="wm-hero-slide-img layout-left absolute inset-0 w-full h-full object-cover select-none pointer-events-none" loading="lazy" width="1920" height="700">
      <div class="wm-hero-overlay-mobile"></div>
      <div class="wm-hero-overlay-laptop-left"></div>
      <div class="hero-slide-content wm-hero-slide-flex layout-left max-w-7xl mx-auto select-text">
        <div class="wm-hero-content-box layout-left py-6 sm:py-8 pointer-events-auto">
          <h1 class="font-nunito font-extrabold text-2xl sm:text-3xl md:text-4xl lg:text-[3.25rem] xl:text-[3.5rem] tracking-tight leading-[1.12] text-[#1E2228]">
            <span>Gentle Grooming</span><br>
            <span class="text-[#7a46e5]">for a Happier Cat</span>
          </h1>
          <p class="wm-hero-desc mt-3 sm:mt-4 text-xs sm:text-sm md:text-base lg:text-[16px] text-[#4F463E] font-medium leading-relaxed max-w-xs sm:max-w-sm md:max-w-[430px]">
            Remove loose hair and make grooming a relaxing part of your cat’s day.
          </p>
          <div class="wm-hero-btn-wrap mt-6 sm:mt-7 select-none">
            {% render 'theme-button', text: 'Shop Now', href: '#shop' %}
          </div>
        </div>
      </div>
    </div>

    {% comment %} Slide 4: Fresh Water {% endcomment %}
    <div class="absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out select-none opacity-0 pointer-events-none -z-10" data-hero-slide>
      <img src="{{ 'hero-banner-5.webp' | asset_url }}" alt="Hero banner 5" class="wm-hero-slide-img layout-left absolute inset-0 w-full h-full object-cover select-none pointer-events-none" loading="lazy" width="1920" height="700">
      <div class="wm-hero-overlay-mobile"></div>
      <div class="wm-hero-overlay-laptop-left"></div>
      <div class="hero-slide-content wm-hero-slide-flex layout-left max-w-7xl mx-auto select-text">
        <div class="wm-hero-content-box layout-left py-6 sm:py-8 pointer-events-auto">
          <h1 class="font-nunito font-extrabold text-2xl sm:text-3xl md:text-4xl lg:text-[3.25rem] xl:text-[3.5rem] tracking-tight leading-[1.12] text-[#1E2228]">
            <span>Fresh Water,</span><br>
            <span class="text-[#7a46e5]">Happy Pets</span>
          </h1>
          <p class="wm-hero-desc mt-3 sm:mt-4 text-xs sm:text-sm md:text-base lg:text-[16px] text-[#4F463E] font-medium leading-relaxed max-w-xs sm:max-w-sm md:max-w-[430px]">
            Make every mealtime easier with a feeding station designed for daily comfort.
          </p>
          <div class="wm-hero-btn-wrap mt-6 sm:mt-7 select-none">
            {% render 'theme-button', text: 'Shop Now', href: '#shop' %}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {% comment %} Left Navigation Arrow Button {% endcomment %}
  <button
    type="button"
    data-hero-prev
    aria-label="Previous banner"
    class="absolute left-2 sm:left-4 md:left-6 lg:left-8 top-1/2 -translate-y-1/2 z-20 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/80 hover:bg-white text-gray-700 hover:text-black shadow-md hover:shadow-lg backdrop-blur-sm border border-white/60 flex items-center justify-center transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
  >
    {% render 'icon-chevron-left', class: 'w-5 h-5 sm:w-6 sm:h-6 stroke-[2.5]' %}
  </button>

  {% comment %} Right Navigation Arrow Button {% endcomment %}
  <button
    type="button"
    data-hero-next
    aria-label="Next banner"
    class="absolute right-2 sm:right-4 md:right-6 lg:right-8 top-1/2 -translate-y-1/2 z-20 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/80 hover:bg-white text-gray-700 hover:text-black shadow-md hover:shadow-lg backdrop-blur-sm border border-white/60 flex items-center justify-center transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
  >
    {% render 'icon-chevron-right', class: 'w-5 h-5 sm:w-6 sm:h-6 stroke-[2.5]' %}
  </button>

  {% comment %} Bottom Center Pagination Dots {% endcomment %}
  <nav aria-label="Banner pagination" class="absolute bottom-4 sm:bottom-6 md:bottom-7 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2 transition-all">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <button type="button" data-hero-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" class="transition-all duration-300 rounded-full cursor-pointer {% if forloop.first %}w-5 sm:w-6 h-2 sm:h-2 bg-[#7a46e5] shadow-xs{% else %}w-2 sm:w-2 h-2 sm:h-2 bg-black/25 hover:bg-black/45{% endif %}"></button>
      {%- endfor -%}
    {%- else -%}
      <button type="button" data-hero-dot="0" aria-label="Go to slide 1" class="transition-all duration-300 rounded-full cursor-pointer w-5 sm:w-6 h-2 sm:h-2 bg-[#7a46e5] shadow-xs"></button>
      <button type="button" data-hero-dot="1" aria-label="Go to slide 2" class="transition-all duration-300 rounded-full cursor-pointer w-2 sm:w-2 h-2 sm:h-2 bg-black/25 hover:bg-black/45"></button>
      <button type="button" data-hero-dot="2" aria-label="Go to slide 3" class="transition-all duration-300 rounded-full cursor-pointer w-2 sm:w-2 h-2 sm:h-2 bg-black/25 hover:bg-black/45"></button>
      <button type="button" data-hero-dot="3" aria-label="Go to slide 4" class="transition-all duration-300 rounded-full cursor-pointer w-2 sm:w-2 h-2 sm:h-2 bg-black/25 hover:bg-black/45"></button>
    {%- endif -%}
  </nav>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner image"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Text alignment",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "left", "label": "Left" }
          ],
          "default": "center"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title line",
          "default": "Premium Pet Products"
        },
        {
          "type": "text",
          "id": "title_accent",
          "label": "Accent title line",
          "default": "for Happier Paws"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Explore our wide range of pet toys, grooming, accessories and care products for a healthier and happier life."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Banner",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "layout": "left",
            "title": "Clean Pets,",
            "title_accent": "Happier Days",
            "subtitle": "Wagmart Neem & Aloevera Shampoo keeps your pet's coat clean, soft, fresh and naturally healthy.",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "layout": "left",
            "title": "A Cleaner Home,",
            "title_accent": "A Happier Pet",
            "subtitle": "Easily remove loose pet hair from your pet, sofa, bed, clothes and more.",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "layout": "left",
            "title": "Gentle Grooming",
            "title_accent": "for a Happier Cat",
            "subtitle": "Remove loose hair and make grooming a relaxing part of your cat's day.",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "slide",
          "settings": {
            "layout": "left",
            "title": "Fresh Water,",
            "title_accent": "Happy Pets",
            "subtitle": "Make every mealtime easier with a feeding station designed for daily comfort.",
            "button_text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
