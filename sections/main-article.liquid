{% comment %}
  Wagmart Single Article Section
{% endcomment %}

<article class="py-12 sm:py-16 bg-[#FAF8F5]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-[#EAE5D9] shadow-sm">
      <div class="mb-6">
        <span class="px-3 py-1 rounded-full bg-[#7a46e5]/10 text-[#7a46e5] text-xs font-bold uppercase tracking-wider">
          {{ article.tags.first | default: 'Pet Care' }}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#111827] mt-3 mb-2 leading-tight">
          {{ article.title }}
        </h1>
        <p class="text-xs text-neutral-400">
          Published on {{ article.published_at | date: "%B %d, %Y" }} by {{ article.author }}
        </p>
      </div>

      {%- if article.image -%}
        <div class="w-full aspect-[16/9] rounded-2xl overflow-hidden mb-8">
          <img
            src="{{ article.image | image_url: width: 1200 }}"
            alt="{{ article.title | escape }}"
            width="{{ article.image.width | default: 1200 }}"
            height="{{ article.image.height | default: 675 }}"
            loading="lazy"
            class="w-full h-full object-cover"
          >
        </div>
      {%- endif -%}

      <div class="prose max-w-none text-neutral-700 leading-relaxed space-y-4">
        {{ article.content }}
      </div>
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article Content",
  "settings": []
}
{% endschema %}
