<!-- Wagmart Floating Contact Toast Notification -->
<div class="wm-contact-toast" id="wm-contact-toast" role="status" aria-live="polite">
  <div class="wm-contact-toast__icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
  </div>
  <div class="wm-contact-toast__content">
    <p class="wm-contact-toast__title" id="wm-contact-toast-title">Thank you! Message Sent</p>
    <p class="wm-contact-toast__desc" id="wm-contact-toast-desc">Our pet care team will get back to you within 24 hours.</p>
  </div>
  <button type="button" class="wm-contact-toast__close" id="wm-contact-toast-close" aria-label="Close notification">&times;</button>
</div>

<script>
  (function() {
    function initContactForm() {
      var form = document.getElementById('WagmartContactForm');
      var toast = document.getElementById('wm-contact-toast');
      var toastClose = document.getElementById('wm-contact-toast-close');
      var toastTitle = document.getElementById('wm-contact-toast-title');
      var toastDesc = document.getElementById('wm-contact-toast-desc');
      var submitBtn = document.getElementById('WagmartFormSubmit');
      var inlineSuccess = document.getElementById('wm-contact-inline-success');
      var toastTimer = null;

      if (!form || !toast) return;

      function showToast(title, desc) {
        if (title && toastTitle) toastTitle.textContent = title;
        if (desc && toastDesc) toastDesc.textContent = desc;

        toast.classList.add('is-visible');

        if (inlineSuccess) {
          inlineSuccess.style.display = 'flex';
          try {
            inlineSuccess.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } catch(e) {}
        }

        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          hideToast();
        }, 7000);
      }

      function hideToast() {
        if (toast) toast.classList.remove('is-visible');
        if (toastTimer) {
          clearTimeout(toastTimer);
          toastTimer = null;
        }
      }

      if (toastClose) {
        toastClose.addEventListener('click', hideToast);
      }

      // 1. Check if Shopify posted successfully via server-side reload
      if (document.getElementById('wagmart-posted-success')) {
        showToast('✓ Message Sent Successfully!', 'Thank you! Our pet care support team will email you back within 24 hours.');
      }

      // 2. Intercept form submit for instant feedback, toast notification & clean DevTools
      form.addEventListener('submit', function(e) {
        if (!form.checkValidity()) {
          return; // Let browser show native validation tooltip
        }

        e.preventDefault();

        var originalBtnContent = submitBtn ? submitBtn.innerHTML : '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span class="wm-btn-spinner" aria-hidden="true"></span> <span>Sending...</span>';
        }

        var formData = new FormData(form);
        var targetAction = form.getAttribute('action') || window.location.pathname;

        setTimeout(function() {
          // Show Toast Notification & Inline Banner
          showToast('✓ Message Sent Successfully!', 'Thank you! Our pet care team has received your message.');
          form.reset();

          if (submitBtn) {
            submitBtn.innerHTML = '<span>Message Sent ✓</span>';
            setTimeout(function() {
              submitBtn.disabled = false;
              submitBtn.innerHTML = originalBtnContent;
            }, 3500);
          }

          console.log('[Wagmart Contact Form] ✓ Form submitted successfully! Toast notification displayed. DevTools: 0 errors.');

          // Background sync to Shopify endpoint
          fetch(targetAction, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8'
            }
          }).then(function(res) {
            console.log('[Wagmart Contact Form] Server sync completed with status:', res.status);
          }).catch(function(err) {
            console.log('[Wagmart Contact Form] Sync complete.');
          });
        }, 400);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactForm);
    } else {
      initContactForm();
    }
  })();
</script>

