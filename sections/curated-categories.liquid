{% comment %}
  Wagmart "Better Together" Curated Categories Section
{% endcomment %}

<style>
  /*
    Category cards layout
    - Mobile  (< 540px)          : Horizontal scroll, 1 card per view + pagination dots
    - Small Tablet (540-767px)   : Horizontal scroll, 2 cards per view + pagination dots
    - Tablet  (768-1023px)       : Horizontal scroll, 3 cards per view + pagination dots
    - Laptop  (1024-1279px)      : Horizontal scroll, 4 cards per view + pagination dots
    - Desktop (>= 1280px)        : 5-column grid row (no scroll, no dots)
  */
  @media (max-width: 1279px) {
    .wm-cat-grid {
      --gap: 16px;
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: var(--gap);
      padding: 6px 2px 14px 2px;
    }
    .wm-cat-grid::-webkit-scrollbar {
      display: none;
    }
    .wm-cat-grid > a {
      flex: 0 0 100%;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      scroll-snap-align: start;
      box-sizing: border-box;
    }
  }

  /* Large Mobile / Small Tablet (540px - 767px): 2 cards per view */
  @media (min-width: 540px) and (max-width: 767px) {
    .wm-cat-grid > a {
      flex: 0 0 calc((100% - var(--gap)) / 2);
      width: calc((100% - var(--gap)) / 2);
      max-width: calc((100% - var(--gap)) / 2);
      min-height: 360px !important;
      padding: 18px !important;
    }
  }

  /* Tablet View (768px - 1023px): 3 cards per view */
  @media (min-width: 768px) and (max-width: 1023px) {
    .wm-cat-grid {
      --gap: 16px;
    }
    .wm-cat-grid > a {
      flex: 0 0 calc((100% - (2 * var(--gap))) / 3);
      width: calc((100% - (2 * var(--gap))) / 3);
      max-width: calc((100% - (2 * var(--gap))) / 3);
      min-height: 350px !important;
      padding: 18px !important;
    }
    .wm-cat-grid > a h3 {
      font-size: 20px !important;
      line-height: 1.2 !important;
    }
    .wm-cat-grid > a p {
      font-size: 13px !important;
      line-height: 1.45 !important;
    }
    .wm-cat-grid > a img {
      max-height: 175px !important;
    }
  }

  /* Laptop View (1024px - 1279px): 4 cards per view */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .wm-cat-grid {
      --gap: 16px;
    }
    .wm-cat-grid > a {
      flex: 0 0 calc((100% - (3 * var(--gap))) / 4);
      width: calc((100% - (3 * var(--gap))) / 4);
      max-width: calc((100% - (3 * var(--gap))) / 4);
      min-height: 390px !important;
      padding: 20px !important;
    }
    .wm-cat-grid > a h3 {
      font-size: 22px !important;
      line-height: 1.2 !important;
    }
    .wm-cat-grid > a p {
      font-size: 13.5px !important;
      line-height: 1.5 !important;
    }
    .wm-cat-grid > a img {
      max-height: 195px !important;
    }
  }

  /* Desktop View (>= 1280px): 5-column grid layout */
  @media (min-width: 1280px) {
    .wm-cat-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 18px;
      overflow: visible;
    }
    .wm-cat-grid > a {
      flex: none;
      width: auto;
      max-width: none;
      min-width: 0;
    }
  }

  /* Header layout */
  .wm-cat-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    margin-bottom: 24px;
    position: relative;
  }
  .wm-cat-header__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    z-index: 10;
  }
  .wm-cat-header__title {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #1E2228;
  }
  .wm-cat-header__subtitle {
    margin: 6px 0 0 0;
    font-size: 14px;
    color: #6B7280;
    font-weight: 400;
    max-width: 460px;
  }
  .wm-cat-header__peeking {
    display: none !important;
  }
  .wm-cat-header__btn {
    display: flex;
    justify-content: center;
    align-self: center;
    z-index: 10;
  }

  /* Laptop & Desktop (>= 1024px): Heading Left, Button Right in one line, peeking pet in center */
  @media (min-width: 1024px) {
    .wm-cat-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      text-align: left;
      gap: 24px;
      margin-bottom: 32px;
    }
    .wm-cat-header__left {
      align-items: flex-start;
      text-align: left;
      width: auto;
      flex-shrink: 0;
    }
    .wm-cat-header__title {
      font-size: 44px;
    }
    .wm-cat-header__subtitle {
      font-size: 15px;
      margin-top: 4px;
      max-width: none;
    }
    .wm-cat-header__peeking {
      display: flex !important;
      align-items: flex-end;
      justify-content: center;
      flex: 1;
      margin-bottom: -4px;
      padding: 0 16px;
      pointer-events: none;
      user-select: none;
    }
    .wm-cat-header__btn {
      align-self: flex-end;
      justify-content: flex-end;
      flex-shrink: 0;
      padding-bottom: 4px;
    }
  }

  /* Pagination dots (mobile & tablet only) */
  .wm-cat-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
  }
  .wm-cat-dots[hidden] { display: none; }
  .wm-cat-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.2);
    cursor: pointer;
    transition: width 0.3s ease, background-color 0.3s ease;
  }
  .wm-cat-dot:hover { background: rgba(0, 0, 0, 0.4); }
  .wm-cat-dot.is-active {
    width: 22px;
    background: #7a46e5;
  }
  .wm-cat-dot:focus-visible {
    outline: 2px solid #7a46e5;
    outline-offset: 3px;
  }
  @media (min-width: 1280px) {
    .wm-cat-dots { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-cat-grid { scroll-behavior: auto; }
  }
</style>

<section id="categories" class="py-14 sm:py-20 bg-white overflow-hidden">
  <div class="max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">
    
    {% comment %} Header: Heading left & button right in one line on laptop/desktop, centered on mobile/tablet {% endcomment %}
    <div class="wm-cat-header">
      
      {% comment %} Left Title & Subtitle {% endcomment %}
      <div class="wm-cat-header__left">
        {%- assign badge_label = section.settings.badge_label | default: 'Curated Categories' -%}
        {% render 'section-badge', label: badge_label, class: 'mb-2' %}
        <h2 class="wm-cat-header__title">
          {{ section.settings.title | default: 'Better' }} <span class="text-[#7a46e5]">{{ section.settings.title_accent | default: 'Together' }}</span>
        </h2>
        <p class="wm-cat-header__subtitle">
          {{ section.settings.subtitle | default: 'Curated bundles for everyday pet care.' }}
        </p>
      </div>

      {% comment %} Center Peeking Dog and Cat Image (Laptop & Desktop only) {% endcomment %}
      <div class="wm-cat-header__peeking">
        <img
          src="{{ 'category-pet.webp' | asset_url }}"
          alt="Happy puppy and cat peeking"
          class="max-h-24 xl:max-h-28 w-auto object-contain"
          loading="eager"
          width="200"
          height="112"
        >
      </div>

      {% comment %} Right Action Button {% endcomment %}
      <div class="wm-cat-header__btn">
        {%- assign btn_text = section.settings.button_text | default: 'View All Bundles' -%}
        {%- assign all_col_url = routes.all_products_collection_url | default: '/collections/all' -%}
        {% render 'theme-button', text: btn_text, href: all_col_url %}
      </div>

    </div>

    {%- liquid
      assign base_all_url = routes.all_products_collection_url | default: '/collections/all'

      assign url_fashion = base_all_url | append: '?category=Accessories&title=Fashion+Store'
      assign url_accessories = base_all_url | append: '?category=Accessories&title=Accessories+Store'
      assign url_grooming = base_all_url | append: '?category=Grooming&title=Grooming+Store'
      assign url_supplements = base_all_url | append: '?category=Health+Care&title=Supplements+Store'
      assign url_toys = base_all_url | append: '?category=Toys&title=Toys+Store'

      for col in collections
        if col.products.size > 0 and col.handle != 'all' and col.handle != 'frontpage'
          assign ch = col.handle | downcase
          assign ct = col.title | downcase
          if ch contains 'fashion' or ct contains 'fashion' or ch contains 'apparel' or ct contains 'apparel' or ch contains 'collar'
            assign url_fashion = col.url
          elsif ch contains 'accessor' or ct contains 'accessor' or ch contains 'travel' or ct contains 'travel'
            assign url_accessories = col.url
          elsif ch contains 'groom' or ct contains 'groom' or ch contains 'bath' or ch contains 'shampoo'
            assign url_grooming = col.url
          elsif ch contains 'supplement' or ct contains 'supplement' or ch contains 'health' or ct contains 'health' or ch contains 'hygiene'
            assign url_supplements = col.url
          elsif ch contains 'toy' or ct contains 'toy'
            assign url_toys = col.url
          endif
        endif
      endfor
    -%}

    {% comment %} 5 Category Cards: 1 (mobile) / 2 (tablet) / 5 (laptop & desktop) {% endcomment %}
    <div class="wm-cat-grid" data-cat-track>
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = block.settings.collection
            assign card_url = col.url | default: routes.all_products_collection_url
            assign card_title = block.settings.title | default: col.title | default: 'Category'
            assign card_desc = block.settings.subtitle | default: col.description | strip_html | truncate: 90
            assign card_img = block.settings.image | default: col.featured_image
            assign card_bg = block.settings.bg_color | default: '#FDF0F0'
            assign card_border = block.settings.border_color | default: '#FADBD8'
          -%}
          <a
            href="{{ card_url }}"
            class="group flex flex-col justify-between text-left rounded-[1.5rem] p-5 sm:p-6 shadow-2xs hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer relative overflow-hidden min-h-[380px] sm:min-h-[420px]"
            style="background-color: {{ card_bg }}; border: 1px solid {{ card_border }};"
            {{ block.shopify_attributes }}
          >
            <div class="z-10 space-y-2">
              <h3 class="text-xl sm:text-2xl font-extrabold text-[#111827] leading-tight tracking-tight group-hover:text-[#7a46e5] transition-colors">
                {{ card_title }}
              </h3>
              {%- if card_desc != blank -%}
                <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
                  {{ card_desc }}
                </p>
              {%- endif -%}
            </div>
            <div class="mt-auto pt-6 flex items-end justify-center w-full z-10">
              {%- if card_img != blank -%}
                {{ card_img | image_url: width: 500 | image_tag:
                  class: 'w-full max-h-[200px] sm:max-h-[220px] object-contain object-bottom transition-transform duration-500 group-hover:scale-105',
                  loading: 'lazy',
                  widths: '250, 400, 500',
                  alt: card_title
                }}
              {%- else -%}
                <div class="w-full h-[180px] flex items-center justify-center bg-white/50 rounded-xl text-[#7a46e5]">
                  {% render 'wm-icon', name: 'image', class: 'w-10 h-10 opacity-50' %}
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
      {% comment %} Card 1: Fashion Store {% endcomment %}
      <a
        href="{{ url_fashion }}"
        class="group flex flex-col justify-between text-left rounded-[1.5rem] p-5 sm:p-6 bg-[#FDF0F0] border border-[#FADBD8] shadow-2xs hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer relative overflow-hidden min-h-[380px] sm:min-h-[420px]"
      >
        <div class="z-10 space-y-2">
          <h3 class="text-xl sm:text-2xl font-extrabold text-[#111827] leading-tight tracking-tight group-hover:text-[#7a46e5] transition-colors">
            <span>Fashion</span><br><span>Store</span>
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
            Stylish clothing, collars, harnesses and more for your furry friends.
          </p>
        </div>
        <div class="mt-auto pt-6 flex items-end justify-center w-full z-10">
          <img
            src="{{ 'category-1.webp' | asset_url }}"
            alt="Fashion Store"
            class="w-full max-h-[200px] sm:max-h-[220px] object-contain object-bottom transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="250"
            height="220"
          >
        </div>
      </a>

      {% comment %} Card 2: Accessories Store {% endcomment %}
      <a
        href="{{ url_accessories }}"
        class="group flex flex-col justify-between text-left rounded-[1.5rem] p-5 sm:p-6 bg-[#EAF4FB] border border-[#D4EBF8] shadow-2xs hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer relative overflow-hidden min-h-[380px] sm:min-h-[420px]"
      >
        <div class="z-10 space-y-2">
          <h3 class="text-xl sm:text-2xl font-extrabold text-[#111827] leading-tight tracking-tight group-hover:text-[#7a46e5] transition-colors">
            <span>Accessories</span><br><span>Store</span>
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
            Collars, leashes, beds, carriers and everyday essentials.
          </p>
        </div>
        <div class="mt-auto pt-6 flex items-end justify-center w-full z-10">
          <img
            src="{{ 'category-2.webp' | asset_url }}"
            alt="Accessories Store"
            class="w-full max-h-[200px] sm:max-h-[220px] object-contain object-bottom transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="250"
            height="220"
          >
        </div>
      </a>

      {% comment %} Card 3: Grooming Store {% endcomment %}
      <a
        href="{{ url_grooming }}"
        class="group flex flex-col justify-between text-left rounded-[1.5rem] p-5 sm:p-6 bg-[#FCF4E9] border border-[#F8E5CA] shadow-2xs hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer relative overflow-hidden min-h-[380px] sm:min-h-[420px]"
      >
        <div class="z-10 space-y-2">
          <h3 class="text-xl sm:text-2xl font-extrabold text-[#111827] leading-tight tracking-tight group-hover:text-[#7a46e5] transition-colors">
            <span>Grooming</span><br><span>Store</span>
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
            Shampoos, brushes, nail care and all grooming essentials.
          </p>
        </div>
        <div class="mt-auto pt-6 flex items-end justify-center w-full z-10">
          <img
            src="{{ 'category-3.webp' | asset_url }}"
            alt="Grooming Store"
            class="w-full max-h-[200px] sm:max-h-[220px] object-contain object-bottom transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="250"
            height="220"
          >
        </div>
      </a>

      {% comment %} Card 4: Supplements Store {% endcomment %}
      <a
        href="{{ url_supplements }}"
        class="group flex flex-col justify-between text-left rounded-[1.5rem] p-5 sm:p-6 bg-[#EAF7EE] border border-[#D0EFD8] shadow-2xs hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer relative overflow-hidden min-h-[380px] sm:min-h-[420px]"
      >
        <div class="z-10 space-y-2">
          <h3 class="text-xl sm:text-2xl font-extrabold text-[#111827] leading-tight tracking-tight group-hover:text-[#7a46e5] transition-colors">
            <span>Supplements</span><br><span>Store</span>
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
            Vitamins, supplements and healthcare products for a stronger, healthier pet.
          </p>
        </div>
        <div class="mt-auto pt-6 flex items-end justify-center w-full z-10">
          <img
            src="{{ 'category-4.webp' | asset_url }}"
            alt="Supplements Store"
            class="w-full max-h-[200px] sm:max-h-[220px] object-contain object-bottom transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="250"
            height="220"
          >
        </div>
      </a>

      {% comment %} Card 5: Toys Store {% endcomment %}
      <a
        href="{{ url_toys }}"
        class="group flex flex-col justify-between text-left rounded-[1.5rem] p-5 sm:p-6 bg-[#F5EEF8] border border-[#EBD7F0] shadow-2xs hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer relative overflow-hidden min-h-[380px] sm:min-h-[420px]"
      >
        <div class="z-10 space-y-2">
          <h3 class="text-xl sm:text-2xl font-extrabold text-[#111827] leading-tight tracking-tight group-hover:text-[#7a46e5] transition-colors">
            <span>Toys</span><br><span>Store</span>
          </h3>
          <p class="text-xs sm:text-sm text-[#4B5563] leading-relaxed">
            Fun and durable toys to keep your pets active, happy and engaged.
          </p>
        </div>
        <div class="mt-auto pt-6 flex items-end justify-center w-full z-10">
          <img
            src="{{ 'category-5.webp' | asset_url }}"
            alt="Toys Store"
            class="w-full max-h-[200px] sm:max-h-[220px] object-contain object-bottom transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
            width="250"
            height="220"
          >
        </div>
      </a>
      {%- endif -%}
    </div>

    {% comment %} Mobile & Tablet Pagination Dots {% endcomment %}
    <div class="wm-cat-dots" data-cat-dots role="group" aria-label="Curated categories pagination" hidden></div>

  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('categories');
    if (!section) return;
    var track = section.querySelector('[data-cat-track]');
    var dotsWrap = section.querySelector('[data-cat-dots]');
    if (!track || !dotsWrap || track.dataset.catInit) return;
    track.dataset.catInit = '1';

    var cards = Array.prototype.slice.call(track.children);
    var pages = 0;
    var ticking = false;

    function isCarousel() {
      return window.innerWidth < 1280 && track.scrollWidth > track.clientWidth + 1;
    }
    function step() {
      if (cards.length < 2) return track.clientWidth;
      return cards[1].offsetLeft - cards[0].offsetLeft;
    }
    function perView() {
      var s = step();
      return s ? Math.max(1, Math.round((track.clientWidth + (s - cards[0].offsetWidth)) / s)) : 1;
    }
    function setActive() {
      ticking = false;
      if (!pages) return;
      var s = step();
      var maxScroll = track.scrollWidth - track.clientWidth;
      var idx = track.scrollLeft >= maxScroll - 2 ? pages - 1 : Math.round(track.scrollLeft / s);
      idx = Math.min(pages - 1, Math.max(0, idx));
      Array.prototype.forEach.call(dotsWrap.children, function (dot, i) {
        var on = i === idx;
        dot.classList.toggle('is-active', on);
        dot.setAttribute('aria-current', on ? 'true' : 'false');
      });
    }
    function build() {
      if (!isCarousel()) {
        pages = 0;
        dotsWrap.innerHTML = '';
        dotsWrap.hidden = true;
        return;
      }
      var next = Math.max(1, cards.length - perView() + 1);
      if (next !== pages) {
        pages = next;
        dotsWrap.innerHTML = '';
        for (var i = 0; i < pages; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'wm-cat-dot';
          b.setAttribute('aria-label', 'Go to category ' + (i + 1));
          b.addEventListener('click', (function (n) {
            return function () { track.scrollTo({ left: n * step(), behavior: 'smooth' }); };
          })(i));
          dotsWrap.appendChild(b);
        }
      }
      dotsWrap.hidden = pages < 2;
      setActive();
    }

    track.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(setActive); }
    }, { passive: true });

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(build, 120);
    });
    window.addEventListener('load', build);
    build();
  })();
</script>

{% schema %}
{
  "name": "Curated Categories",
  "settings": [
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Curated Categories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Better"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title accent",
      "default": "Together"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated bundles for everyday pet care."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All Bundles"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Card Image",
          "info": "Optional. Defaults to the collection's featured image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "info": "Leave blank to use collection title."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Card Subtitle"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background Color",
          "default": "#FDF0F0"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Card Border Color",
          "default": "#FADBD8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated Categories"
    }
  ]
}
{% endschema %}
