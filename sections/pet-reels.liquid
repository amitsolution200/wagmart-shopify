{% comment %}
  Wagmart "Real Pets. Real Moments." Video Reels Section
{% endcomment %}

<section id="stories" class="bg-white py-16 md:py-20 overflow-hidden relative">
  <div class="max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    {% comment %} Header {% endcomment %}
    <div class="text-center max-w-2xl mx-auto mb-8 md:mb-12">
      {% render 'section-badge', label: section.settings.badge_label | default: 'Pet Stories & Reels', class: 'mb-4' %}
      <h2 class="font-nunito text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#1F2421] tracking-tight leading-tight">
        {{ section.settings.title | default: 'Real Pets.' }} <span class="text-[#7a46e5]">{{ section.settings.title_accent | default: 'Real Moments.' }}</span>
      </h2>
    </div>

    {% comment %} Carousel Container {% endcomment %}
    <div class="relative px-2 md:px-0">
      
      {% comment %} Left Arrow Button {% endcomment %}
      <button
        type="button"
        data-reels-prev
        class="cursor-pointer absolute -left-2 md:-left-4 lg:-left-6 top-1/2 -translate-y-1/2 z-30 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/95 border border-neutral-200/80 hover:border-[#7a46e5] text-neutral-800 hover:text-white shadow-lg flex items-center justify-center transition-all duration-300 hover:scale-105 active:scale-95 group focus:outline-none hover:bg-[#7a46e5]"
        aria-label="Previous reel"
      >
        {% render 'icon-chevron-left', class: 'w-5 h-5 md:w-6 md:h-6' %}
      </button>

      {% comment %} Carousel Viewport {% endcomment %}
      <div data-reels-carousel class="reels-carousel flex gap-6 overflow-x-auto no-scrollbar scroll-smooth py-3 px-1 snap-x snap-mandatory">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div
              class="reel-card shrink-0 relative rounded-[24px] overflow-hidden group cursor-pointer bg-neutral-900 select-none snap-start"
              data-reel-card
              data-reel-id="{{ block.id }}"
              data-youtube-id="{{ block.settings.youtube_id }}"
              data-reel-title="{{ block.settings.title | escape }}"
              data-reel-tag="{{ block.settings.tag | escape }}"
              data-reel-story="{{ block.settings.story | escape }}"
              {{ block.shopify_attributes }}
            >
              {%- assign fallback_img = 'reel-food_portrait.jpg' -%}
              {%- assign tag_bg = 'bg-[#DCE9D8]' -%}
              {%- assign tag_color = 'text-[#3B5438]' -%}
              {%- if block.settings.tag contains 'GROOM' -%}
                {%- assign fallback_img = 'reel-grooming_portrait.jpg' -%}
                {%- assign tag_bg = 'bg-[#EADCF5]' -%}
                {%- assign tag_color = 'text-[#5E387C]' -%}
              {%- elsif block.settings.tag contains 'TOY' -%}
                {%- assign fallback_img = 'reel-toys_portrait.jpg' -%}
                {%- assign tag_bg = 'bg-[#F8E7D2]' -%}
                {%- assign tag_color = 'text-[#7D5024]' -%}
              {%- elsif block.settings.tag contains 'BED' or block.settings.tag contains 'MAT' or block.settings.tag contains 'HOME' -%}
                {%- assign fallback_img = 'reel-beds_portrait.jpg' -%}
                {%- assign tag_bg = 'bg-[#D4EBF7]' -%}
                {%- assign tag_color = 'text-[#225774]' -%}
              {%- elsif block.settings.tag contains 'TRAVEL' -%}
                {%- assign fallback_img = 'reel-travel_portrait.jpg' -%}
                {%- assign tag_bg = 'bg-[#FAEED1]' -%}
                {%- assign tag_color = 'text-[#6D551E]' -%}
              {%- elsif block.settings.tag contains 'TRAIN' -%}
                {%- assign fallback_img = 'reel-toys_portrait.jpg' -%}
                {%- assign tag_bg = 'bg-[#E0E7FF]' -%}
                {%- assign tag_color = 'text-[#3730A3]' -%}
              {%- endif -%}

              {%- if block.settings.thumbnail != blank -%}
                <img
                  data-reel-thumb
                  src="{{ block.settings.thumbnail | image_url: width: 600 }}"
                  alt="{{ block.settings.title | escape }}"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="620"
                >
              {%- else -%}
                <img
                  data-reel-thumb
                  src="{{ fallback_img | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="620"
                >
              {%- endif -%}

              {% comment %} Category Tag {% endcomment %}
              <div class="absolute top-3.5 left-3.5 z-10">
                <span class="px-2.5 py-1 rounded-full text-[10px] font-nunito font-extrabold tracking-wider uppercase backdrop-blur-md shadow-xs {{ tag_bg }} {{ tag_color }}">
                  {{ block.settings.tag }}
                </span>
              </div>

              {% comment %} Audio / Sound Indicator Badge {% endcomment %}
              <div class="absolute top-3.5 right-3.5 z-20 transition-all duration-300 pointer-events-none" data-reel-sound-badge>
                <div class="h-8 w-8 rounded-full bg-black/40 backdrop-blur-md text-white border border-white/20 flex items-center justify-center shadow-md group-hover:scale-105 group-hover:bg-[#7a46e5]/90 transition-all duration-300">
                  <svg class="w-4 h-4 text-white drop-shadow-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                  </svg>
                </div>
              </div>

              {% comment %} Inline Video Container on Hover {% endcomment %}
              <div class="absolute inset-0 w-full h-full overflow-hidden opacity-0 pointer-events-none transition-opacity duration-300 z-10" data-reel-video></div>

              {% comment %} Play Button Indicator - Always Visible on All Cards {% endcomment %}
              <div class="absolute inset-0 z-20 flex items-center justify-center transition-all duration-300 pointer-events-none" data-play-indicator>
                <div class="flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-full bg-white/30 backdrop-blur-md text-white shadow-[0px_4px_24px_rgba(0,0,0,0.35)] border border-white/50 transition-all duration-300 group-hover:scale-110 group-hover:bg-[#7a46e5]/90">
                  <svg class="h-6 w-6 sm:h-7 sm:w-7 text-white fill-white translate-x-0.5 drop-shadow-md" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                </div>
              </div>

              {% comment %} Glassmorphism Overlay {% endcomment %}
              <div class="absolute inset-x-4 bottom-4 z-20 backdrop-blur-md bg-white/10 rounded-[20px] p-4 shadow-[0px_8px_32px_rgba(0,0,0,0.12)] transition-all duration-300 ease-in-out" data-card-overlay>
                <div class="flex items-center gap-2 mb-2">
                  <img
                    src="{{ 'WAGMART-Logo.webp' | asset_url }}"
                    alt="Wagmart"
                    class="h-5 w-auto object-contain filter brightness-0 invert"
                    width="80"
                    height="20"
                  >
                </div>
                <h3 class="font-nunito text-sm sm:text-base font-bold text-white line-clamp-2 leading-tight tracking-tight drop-shadow-sm">
                  {{ block.settings.title }}
                </h3>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          {% comment %} Default Reels matching React App with verified YouTube videos {% endcomment %}
          <div
            class="reel-card shrink-0 relative rounded-[24px] overflow-hidden group cursor-pointer bg-neutral-900 select-none snap-start"
            data-reel-card
            data-reel-id="reel-food"
            data-youtube-id="5H4sZNYtBFc"
            data-reel-title="Healthy Meals Happier Days"
            data-reel-tag="DOG FOOD"
            data-reel-story="Watch how excited Golden Max gets for his balanced, nutritious dinner served in our elevated stainless steel feeder!"
          >
            <img data-reel-thumb src="{{ 'reel-food_portrait.jpg' | asset_url }}" alt="Healthy Meals" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" width="400" height="620">
            <div class="absolute top-3.5 left-3.5 z-20">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-nunito font-extrabold tracking-wider uppercase backdrop-blur-md shadow-xs bg-[#DCE9D8] text-[#3B5438]">DOG FOOD</span>
            </div>
            <div class="absolute inset-0 w-full h-full overflow-hidden opacity-0 pointer-events-none transition-opacity duration-300 z-10" data-reel-video></div>
            <div class="absolute inset-0 z-20 flex items-center justify-center transition-all duration-300 pointer-events-none" data-play-indicator>
              <div class="flex h-14 w-14 sm:h-16 sm:w-16 items-center justify-center rounded-full bg-white/30 backdrop-blur-md text-white shadow-[0px_4px_24px_rgba(0,0,0,0.35)] border border-white/50 transition-all duration-300 group-hover:scale-110 group-hover:bg-[#7a46e5]/90">
                <svg class="h-6 w-6 sm:h-7 sm:w-7 text-white fill-white translate-x-0.5 drop-shadow-md" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              </div>
            </div>
            <div class="absolute inset-x-4 bottom-4 z-20 backdrop-blur-md bg-white/10 rounded-[20px] p-4 shadow-[0px_8px_32px_rgba(0,0,0,0.12)] transition-all duration-300 ease-in-out" data-card-overlay>
              <div class="flex items-center gap-2 mb-2">
                <img src="{{ 'WAGMART-Logo.webp' | asset_url }}" alt="Wagmart" class="h-5 w-auto object-contain filter brightness-0 invert" width="80" height="20">
