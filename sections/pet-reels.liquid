        type="button"
        data-reels-next
        class="cursor-pointer absolute -right-2 md:-right-4 lg:-right-6 top-1/2 -translate-y-1/2 z-30 w-10 h-10 md:w-12 md:h-12 rounded-full bg-white/95 border border-neutral-200/80 hover:border-[#7a46e5] text-neutral-800 hover:text-white shadow-lg flex items-center justify-center transition-all duration-300 hover:scale-105 active:scale-95 group focus:outline-none hover:bg-[#7a46e5]"
        aria-label="Next reel"
      >
        {% render 'icon-chevron-right', class: 'w-5 h-5 md:w-6 md:h-6' %}
      </button>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pet Reels & Stories",
  "settings": [
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Pet Stories & Reels"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Real Pets."
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Title accent",
      "default": "Real Moments."
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Category tag",
          "default": "GROOMING"
