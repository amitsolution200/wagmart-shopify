{% comment %}
  Wagmart "Good Dogs. Great Style." Video Reels Section
  Responsive 5-card grid on desktop (matching editorial reference),
  smooth swipeable carousel on mobile/tablet,
  and hover video playback with full sound (video properly fitted, no crop/cut).
{% endcomment %}

<section id="stories" class="bg-white py-14 sm:py-20 overflow-hidden relative" data-reels-section>
  <div class="max-w-[1460px] mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    {% comment %} Section Header {% endcomment %}
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
      {%- if section.settings.badge_label != blank -%}
        {% render 'section-badge', label: section.settings.badge_label, class: 'mb-4' %}
      {%- endif -%}
      <h2 class="font-serif-title sm:font-nunito text-3xl sm:text-4xl lg:text-[42px] font-bold text-[#111111] tracking-tight leading-tight">
        {{ section.settings.title | default: 'Good Dogs. Great Style.' }}
        {%- if section.settings.title_accent != blank -%}
          <span class="text-[#7a46e5] ml-1">{{ section.settings.title_accent }}</span>
        {%- endif -%}
      </h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="font-nunito text-sm sm:text-base text-neutral-600 max-w-2xl mx-auto mt-3 leading-relaxed">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
    </div>

    {% comment %} Reels Wrapper {% endcomment %}
    <div class="relative reels-wrapper">
      
      {% comment %} Left Navigation Arrow (Mobile/Tablet) {% endcomment %}
      <button
        type="button"
        data-reels-prev
        class="reels-nav-btn reels-nav-prev"
        aria-label="Previous reel"
      >
        <svg class="w-5 h-5 text-neutral-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      {% comment %} Reels Carousel / Grid 5 Track {% endcomment %}
      <div
        data-reels-carousel
        class="reels-carousel"
      >
        {%- if section.blocks.size > 0 -%}
          {%- assign store_all_products = collections['all'].products -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign prod = block.settings.product
              if prod == blank and store_all_products.size > 0
                assign prod = store_all_products.first
              endif

              if prod != blank
                assign prod_id = prod.selected_or_first_available_variant.id | default: prod.id
                assign prod_title = prod.title
                assign prod_price = prod.price | money
                if prod.compare_at_price > prod.price
                  assign prod_compare = prod.compare_at_price | money
                else
                  assign prod_compare = ''
                endif
                assign prod_url = prod.url
                if prod.featured_image
                  assign prod_thumb = prod.featured_image | image_url: width: 200
                else
                  assign prod_thumb = 'catalog-bath-massage-brush.webp' | asset_url
                endif
              else
                assign prod_id = block.id
                assign prod_title = block.settings.product_title | default: 'Wagmart Pet Essential'
                assign prod_price = block.settings.product_price | default: '₹330'
                assign prod_compare = block.settings.product_compare_price | default: ''
                assign prod_url = block.settings.product_url | default: routes.all_products_collection_url
                assign prod_thumb = 'catalog-bath-massage-brush.webp' | asset_url
              endif

              case forloop.index
                when 1
                  assign fallback_bg = 'reel-pawcleaner.webp' | asset_url
                  assign fallback_yt = 'AOr9WB0XIUY'
                  assign fallback_story = 'Gentle care for healthy, happy pets every single day.'
                when 2
                  assign fallback_bg = 'reel-food.webp' | asset_url
                  assign fallback_yt = '5H4sZNYtBFc'
                  assign fallback_story = 'Promotes healthy routine and mindful everyday care.'
                when 3
                  assign fallback_bg = 'reel-grooming.webp' | asset_url
                  assign fallback_yt = 'LB8Qfa9tTsU'
                  assign fallback_story = 'Effortless grooming for clean coats and happy smiles.'
                when 4
                  assign fallback_bg = 'reel-toys.webp' | asset_url
                  assign fallback_yt = 'vwz9XsIcRik'
                  assign fallback_story = 'Interactive play and enrichment for your energetic pet.'
                when 5
                  assign fallback_bg = 'reel-travel.webp' | asset_url
                  assign fallback_yt = 'GalPqZH1glY'
                  assign fallback_story = 'Comfortable travel gear designed for everyday pet adventures.'
                else
                  assign fallback_bg = 'reel-pawcleaner.webp' | asset_url
                  assign fallback_yt = 'AOr9WB0XIUY'
                  assign fallback_story = 'Everyday mindful care for happy pets.'
              endcase

              if block.settings.reel_image != blank
                assign reel_img_src = block.settings.reel_image | image_url: width: 800
              elsif fallback_bg != blank
                assign reel_img_src = fallback_bg
              else
                assign reel_img_src = 'reel-pawcleaner.webp' | asset_url
              endif

              assign yt_id = block.settings.youtube_id | default: fallback_yt
              assign reel_caption = block.settings.story | default: fallback_story
            -%}

            <div
              class="reel-card group relative overflow-hidden bg-neutral-900 select-none cursor-pointer snap-start shrink-0"
              data-reel-card
              data-reel-id="{{ block.id }}"
              data-youtube-id="{{ yt_id }}"
              data-reel-title="{{ prod_title | escape }}"
              data-reel-story="{{ reel_caption | escape }}"
              data-product-id="{{ prod_id }}"
              data-product-name="{{ prod_title | escape }}"
              data-product-price="{{ prod_price }}"
              data-product-image="{{ prod_thumb }}"
              data-product-url="{{ prod_url }}"
              data-card-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% comment %} Card Background Image (9:16 portrait fit) {% endcomment %}
              <img
                data-reel-thumb
                src="{{ reel_img_src }}"
                alt="{{ prod_title | escape }}"
                class="card-bg-img"
                loading="lazy"
                width="450"
                height="800"
              >

              {% comment %} Video preview container (Proper 9:16 fit, no scale crop) {% endcomment %}
              <div class="absolute inset-0 w-full h-full overflow-hidden opacity-0 pointer-events-none transition-opacity duration-300 z-10" data-reel-video></div>

              {% comment %} Floating Frosted-Glass Product Badge at Bottom {% endcomment %}
              <div class="reel-product-pill" data-product-pill>
                <div class="pill-thumb-box">
                  <img
                    src="{{ prod_thumb }}"
                    alt="{{ prod_title | escape }}"
                    class="pill-thumb-img"
                    loading="lazy"
                    width="88"
                    height="88"
                  >
                </div>

                <div class="pill-info">
                  <span class="pill-title" data-product-link title="{{ prod_title | escape }}">
                    {{ prod_title }}
                  </span>
                  <div class="pill-price-row">
                    <span class="pill-price">{{ prod_price }}</span>
                    {%- if prod_compare != blank and prod_compare != prod_price -%}
                      <span class="pill-compare">{{ prod_compare }}</span>
                    {%- endif -%}
                  </div>
                </div>

                <button
                  type="button"
                  class="pill-btn"
                  aria-label="Add {{ prod_title | escape }} to bag"
                  data-reel-quick-add
                  data-product-id="{{ prod_id }}"
                >
                  <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-[#111111] fill-current" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M8 1a2.5 2.5 0 0 0-2.5 2.5V4H3a1 1 0 0 0-1 1v9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V5a1 1 0 0 0-1-1h-2.5V3.5A2.5 2.5 0 0 0 8 1zm1.5 3h-3V3.5a1.5 1.5 0 0 1 3 0V4z"/>
                  </svg>
                </button>
              </div>

            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {% comment %} Right Navigation Arrow (Mobile/Tablet) {% endcomment %}
      <button
        type="button"
        data-reels-next
        class="reels-nav-btn reels-nav-next"
        aria-label="Next reel"
      >
        <svg class="w-5 h-5 text-neutral-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

    </div>

    {% comment %} Pagination Dots Below (Mobile/Tablet) {% endcomment %}
    <div class="reels-dots-container" data-reels-dots aria-label="Reels pagination">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="reels-dot-btn{% if forloop.first %} active{% endif %}"
          data-reels-dot="{{ forloop.index0 }}"
          aria-label="Go to reel {{ forloop.index }}"
        ></button>
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  /* =========================================================================
     SCOPED STYLES: PET REELS 5-CARD GRID & MOBILE CAROUSEL
     ========================================================================= */
  #stories .reels-wrapper {
    position: relative !important;
  }

  /* Reel Card Dimensions & Design (9:16 native YouTube Shorts ratio) */
  #stories [data-reel-card] {
    position: relative !important;
    overflow: hidden !important;
    border-radius: 22px !important;
    background-color: #171717 !important;
    aspect-ratio: 9 / 16 !important;
    box-shadow: 0px 4px 18px rgba(0, 0, 0, 0.08) !important;
    transition: transform 0.35s ease, box-shadow 0.35s ease !important;
    scroll-snap-align: start !important;
    flex-shrink: 0 !important;
  }
  #stories [data-reel-card]:hover {
    transform: translateY(-4px) !important;
    box-shadow: 0px 14px 32px rgba(0, 0, 0, 0.18) !important;
  }

  /* Background Image (edge-to-edge cover) */
  #stories .card-bg-img {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 22px !important;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  #stories [data-reel-card]:hover .card-bg-img {
    transform: scale(1.04) !important;
  }

  /* Video container & iframe - Exact card fit, DO NOT CUT OR SCALE */
  #stories [data-reel-video] {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    border-radius: 22px !important;
    z-index: 10 !important;
  }
  #stories [data-reel-video] iframe {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    border: 0 !important;
    border-radius: 22px !important;
    pointer-events: none !important;
    object-fit: cover !important;
    transform: none !important;
  }

  /* Frosted Glass Floating Badge at bottom */
  #stories .reel-product-pill {
    position: absolute !important;
    bottom: 12px !important;
    left: 12px !important;
    right: 12px !important;
    top: auto !important;
    z-index: 20 !important;
    background: rgba(45, 43, 40, 0.86) !important;
    backdrop-filter: blur(14px) !important;
    -webkit-backdrop-filter: blur(14px) !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    border-radius: 16px !important;
    padding: 7px 9px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 8px !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28) !important;
    transition: background 0.25s ease, border-color 0.25s ease !important;
  }
  #stories [data-reel-card]:hover .reel-product-pill {
    background: rgba(36, 34, 32, 0.94) !important;
    border-color: rgba(255, 255, 255, 0.26) !important;
  }

  #stories .pill-thumb-box {
    width: 44px !important;
    height: 44px !important;
    border-radius: 10px !important;
    background: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    overflow: hidden !important;
    flex-shrink: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 2px !important;
  }
  #stories .pill-thumb-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 7px !important;
  }

  #stories .pill-info {
    flex: 1 1 0% !important;
    min-width: 0 !important;
    text-align: left !important;
  }
  #stories .pill-title {
    color: #ffffff !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    line-height: 1.25 !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    display: block !important;
    font-family: inherit !important;
  }
  #stories .pill-price-row {
    display: flex !important;
    align-items: center !important;
    gap: 5px !important;
    margin-top: 3px !important;
  }
  #stories .pill-price {
    color: rgba(255, 255, 255, 0.95) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
    line-height: 1 !important;
  }
  #stories .pill-compare {
    color: rgba(255, 255, 255, 0.45) !important;
    font-size: 11px !important;
    text-decoration: line-through !important;
    line-height: 1 !important;
  }

  #stories .pill-btn {
    width: 36px !important;
    height: 36px !important;
    border-radius: 50% !important;
    background: #ffffff !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18) !important;
    cursor: pointer !important;
    transition: transform 0.2s ease, background-color 0.2s ease !important;
    border: none !important;
  }
  #stories .pill-btn:hover {
    transform: scale(1.1) !important;
  }
  #stories .pill-btn:active {
    transform: scale(0.95) !important;
  }

  /* Desktop View: Grid of 5 Cards side by side */
  @media (min-width: 1024px) {
    #stories [data-reels-carousel] {
      display: grid !important;
      grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
      gap: 16px !important;
      overflow: visible !important;
      padding: 8px 0 !important;
    }
    #stories [data-reel-card] {
      width: 100% !important;
      max-width: none !important;
      aspect-ratio: 9 / 16 !important;
      height: auto !important;
      min-height: 440px !important;
    }
    #stories .reels-nav-btn {
      display: none !important;
    }
    #stories .reels-dots-container {
      display: none !important;
    }
  }

  @media (min-width: 1280px) {
    #stories [data-reels-carousel] {
      gap: 18px !important;
    }
    #stories [data-reel-card] {
      min-height: 480px !important;
    }
  }

  /* Tablet & Mobile View: Smooth Horizontal Carousel */
  @media (max-width: 1023px) {
    #stories [data-reels-carousel] {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      overflow-y: hidden !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      gap: 14px !important;
      padding: 8px 0 16px 0 !important;
      scrollbar-width: none !important;
      scroll-behavior: smooth !important;
    }
    #stories [data-reels-carousel]::-webkit-scrollbar {
      display: none !important;
    }
    #stories [data-reel-card] {
      flex: 0 0 calc((100% - 14px) / 2.3) !important;
      max-width: 290px !important;
      aspect-ratio: 9 / 16 !important;
    }
    #stories .reels-nav-btn {
      display: flex !important;
    }
    #stories .reels-dots-container {
      display: flex !important;
    }
  }

  @media (max-width: 639px) {
    #stories [data-reel-card] {
      flex: 0 0 76vw !important;
      max-width: 285px !important;
      aspect-ratio: 9 / 16 !important;
    }
  }

  /* Navigation Arrows */
  #stories .reels-nav-btn {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    z-index: 30 !important;
    width: 42px !important;
    height: 42px !important;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.96) !important;
    border: 1px solid rgba(0, 0, 0, 0.12) !important;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12) !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    transition: transform 0.25s ease, background-color 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease !important;
    color: #111111 !important;
  }
  #stories .reels-nav-btn:hover {
    background: #ffffff !important;
    transform: translateY(-50%) scale(1.08) !important;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18) !important;
  }
  #stories .reels-nav-btn:active {
    transform: translateY(-50%) scale(0.95) !important;
  }
  #stories .reels-nav-btn:disabled {
    opacity: 0.3 !important;
    cursor: not-allowed !important;
    pointer-events: none !important;
  }
  #stories .reels-nav-prev {
    left: -10px !important;
  }
  #stories .reels-nav-next {
    right: -10px !important;
  }

  /* Pagination Dots */
  #stories .reels-dots-container {
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    margin-top: 24px !important;
  }
  #stories .reels-dot-btn {
    width: 8px !important;
    height: 8px !important;
    border-radius: 9999px !important;
    background-color: #d4d4d4 !important;
    border: none !important;
    padding: 0 !important;
    cursor: pointer !important;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  #stories .reels-dot-btn:hover {
    background-color: #999999 !important;
  }
  #stories .reels-dot-btn.active {
    width: 26px !important;
    background-color: #111111 !important;
  }
</style>

{% schema %}
