{{ 'cart.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_items = false
  if cart.item_count > 0
    assign has_items = true
  endif
-%}

<div class="wm-cart-page" data-cart-page data-default-img="{{ 'catalog-grooming-glove.webp' | asset_url }}">
  <script type="application/json" id="wm-cart-initial-json">
    {{ cart | json }}
  </script>

  <div class="wm-cart-container">
    {%- comment -%} =======================================================
       1. FILLED CART STATE (Matches reference design)
       ======================================================= {%- endcomment -%}
    <div class="wm-cart-filled-wrap" data-cart-filled-view {% unless has_items %}hidden{% endunless %}>
      <form action="{{ routes.cart_url | default: '/cart' }}" method="post" id="wm-cart-form" novalidate>
        <div class="wm-cart-grid">
          {%- comment -%} LEFT COLUMN: Cart Items Table {%- endcomment -%}
          <div class="wm-cart-left-col">
            <div class="wm-cart-items-table">
              <div class="wm-cart-table-head" aria-hidden="true">
                <span class="wm-cart-th wm-cart-th--product">Product</span>
                <span class="wm-cart-th wm-cart-th--price">Price</span>
                <span class="wm-cart-th wm-cart-th--qty">Quantity</span>
                <span class="wm-cart-th wm-cart-th--total">Total</span>
                <span class="wm-cart-th wm-cart-th--action"></span>
              </div>

              <div class="wm-cart-items-list" data-cart-page-items role="region" aria-live="polite" aria-label="Shopping cart items">
                {%- for item in cart.items -%}
                  {% render 'cart-item-row', item: item %}
                {%- endfor -%}
              </div>
            </div>
          </div>

          {%- comment -%} RIGHT COLUMN: Gray Summary Card {%- endcomment -%}
          <div class="wm-cart-right-col">
            {% render 'cart-order-summary', cart_obj: cart %}
          </div>
        </div>
      </form>
    </div>

    {%- comment -%} =======================================================
       2. EMPTY CART STATE
       ======================================================= {%- endcomment -%}
    <div data-cart-empty-container {% if has_items %}hidden{% endif %}>
      {% render 'cart-empty-state' %}
    </div>
  </div>
</div>

<script src="{{ 'cart.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
