{% comment %}
  Wagmart Main Cart Page Section
{% endcomment %}

<section class="py-12 sm:py-16 bg-white">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-xl mx-auto mb-10">
      {% render 'section-badge', label: 'Shopping Cart', class: 'mb-3' %}
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#111827]">
        Your Wagmart Cart
      </h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="bg-white rounded-3xl p-6 sm:p-10 border border-[#EAE5D9] shadow-sm space-y-6">
        <div class="divide-y divide-[#F0EBE1]">
          {%- for item in cart.items -%}
            <div class="py-4 flex items-center justify-between gap-4">
              <div class="flex items-center gap-4 min-w-0">
                <div class="w-20 h-20 bg-neutral-50 rounded-2xl p-2 border border-[#EAE5D9] shrink-0 flex items-center justify-center overflow-hidden">
                  {%- if item.image -%}
                    <img
                      src="{{ item.image | image_url: width: 160 }}"
                      alt="{{ item.title | escape }}"
                      width="80"
                      height="80"
                      loading="lazy"
                      class="w-full h-full object-contain"
                    >
                  {%- endif -%}
                </div>
                <div class="min-w-0">
                  <h3 class="font-bold text-base text-[#111827] truncate">
                    <a href="{{ item.url }}" class="hover:text-[#7a46e5]">{{ item.product.title }}</a>
                  </h3>
                  <p class="text-xs text-neutral-500">{{ item.variant.title }}</p>
                  <p class="text-sm font-extrabold text-[#7a46e5] mt-1">{{ item.final_price | money }}</p>
                </div>
              </div>

              <div class="flex items-center gap-4">
                <div class="flex items-center border border-[#D5CEBF] rounded-xl p-1 bg-white">
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="w-12 text-center text-sm font-bold focus:outline-hidden"
                  >
                </div>

                <a
                  href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                  class="p-2 text-neutral-400 hover:text-red-500 transition"
                  aria-label="Remove {{ item.title | escape }}"
                >
                  {% render 'icon-trash', class: 'w-5 h-5' %}
                </a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="pt-6 border-t border-[#F0EBE1] flex flex-col sm:flex-row items-center justify-between gap-4">
          <button type="submit" name="update" class="px-6 py-2.5 rounded-full border border-[#D5CEBF] text-xs font-bold text-gray-700 hover:bg-gray-50 cursor-pointer">
            Update Cart
          </button>

          <div class="text-right">
            <p class="text-xs text-neutral-500">Subtotal</p>
            <p class="text-2xl font-black text-[#111827]">{{ cart.total_price | money }}</p>
            <p class="text-[11px] text-neutral-400">Taxes and shipping calculated at checkout</p>
            <div class="mt-3">
              <button
                type="submit"
                name="checkout"
                class="px-8 py-3.5 rounded-full bg-gradient-to-r from-[#7a46e5] to-[#9361fa] text-white font-bold text-sm shadow-md hover:opacity-95 cursor-pointer"
              >
                Proceed to Checkout
              </button>
            </div>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="bg-white rounded-3xl p-12 text-center border border-[#EAE5D9] shadow-sm space-y-4">
        <div class="w-20 h-20 rounded-full bg-neutral-50 border border-[#EAE5D9] flex items-center justify-center text-neutral-400 mx-auto">
          {% render 'icon-bag', class: 'w-10 h-10' %}
        </div>
        <h2 class="text-xl font-bold text-[#111827]">Your cart is empty</h2>
        <p class="text-sm text-neutral-500 max-w-sm mx-auto">
          Explore Wagmart's best-selling supplies for dogs and cats.
        </p>
        <div class="pt-2">
          {% render 'theme-button', text: 'Start Shopping', href: '/collections/all' %}
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
