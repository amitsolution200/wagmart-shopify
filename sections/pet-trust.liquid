{% comment %}
  Wagmart "Why Choose Wagmart?" Editorial Brand Trust Section
  - Authentic, editorial 2-column layout (zero nested cards, zero rainbow icon bubbles, zero AI-slop clichés)
  - Side-by-side across Tablet (>= 768px), Laptop, and Desktop so it fits comfortably within a single screen
  - Compact 2x2 value grid + controlled landscape photography height so the image is never tall/long
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: 'Why Choose Wagmart?'
  if heading == blank or heading contains 'A Happier World'
    assign heading = 'Why Choose Wagmart?'
  endif

  assign description = section.settings.description | default: "We're passionate about pets and committed to making their lives happier, healthier and easier with high-quality products and trusted service."
  if description == blank or description contains 'Thoughtfully chosen essentials'
    assign description = "We're passionate about pets and committed to making their lives happier, healthier and easier with high-quality products and trusted service."
  endif

  assign item1_title = section.settings.item1_title | default: 'Premium Pet Essentials'
  assign item1_desc = section.settings.item1_desc | default: 'Carefully selected food, toys, grooming, and everyday care products.'

  assign item2_title = section.settings.item2_title | default: 'Fast & Reliable Delivery'
  assign item2_desc = section.settings.item2_desc | default: "Get your pet's favorites delivered quickly to your doorstep."

  assign item3_title = section.settings.item3_title | default: 'Trusted Quality & Safety'
  assign item3_desc = section.settings.item3_desc | default: 'Products chosen with comfort, durability, and pet safety in mind.'

  assign item4_title = section.settings.item4_title | default: 'Friendly Customer Support'
  assign item4_desc = section.settings.item4_desc | default: 'Helpful support for choosing the right products for your furry friend.'

  assign btn_text = section.settings.btn_text | default: 'Shop Now'
  assign btn_link = section.settings.btn_link
  if btn_link == blank
    assign btn_link = routes.all_products_collection_url | default: '/collections/all'
  endif

  if section.settings.image != blank
    assign feat_img_url = section.settings.image | image_url: width: 1200
  else
    assign feat_img_url = 'why-choose-wagmart.webp' | asset_url
  endif
-%}

<style>
  /* ==========================================================================
     WHY CHOOSE WAGMART — EDITORIAL, COMPACT, SCREEN-FITTING SECTION
     ========================================================================== */

  .wm-why-choose {
    background-color: #ffffff;
    padding: clamp(24px, 3.5vw, 44px) 0;
    position: relative;
    width: 100%;
    font-family: var(--font-sans, 'Plus Jakarta Sans', 'Nunito', system-ui, -apple-system, sans-serif);
  }

  .wm-why-choose__wrap {
    max-width: 1500px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3.5vw, 48px);
  }

  .wm-why-choose__surface {
    background-color: #F6F3EC;
    border-radius: 20px;
    padding: clamp(20px, 3vw, 36px);
  }

  .wm-why-choose__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: center;
  }

  /* Laptop & Desktop (>= 1024px): Exact 50% / 50% Side-by-Side Layout */
  @media (min-width: 1024px) {
    .wm-why-choose__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: clamp(24px, 3vw, 36px);
      align-items: center;
    }
  }

  /* Left Column: Editorial Copy + 2x2 Value Pillars + CTA */
  .wm-why-choose__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
  }

  .wm-why-choose__header {
    text-align: left;
    margin-bottom: clamp(16px, 2vw, 22px);
    max-width: 580px;
  }

  .wm-why-choose__title {
    font-family: inherit;
    font-size: clamp(24px, 2.5vw, 34px);
    font-weight: 800;
    color: #161A17;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 8px 0;
  }

  .wm-why-choose__desc {
    font-size: clamp(13.5px, 1.05vw, 15px);
    line-height: 1.55;
    color: #4A524C;
    margin: 0;
    max-width: 56ch;
  }

  /* 2x2 Architectural Pillars Grid (No nested cards, no pastel rainbow bubbles) */
  .wm-why-choose__pillars {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 20px;
    width: 100%;
    padding: 16px 0;
    margin-bottom: 18px;
    border-top: 1px solid #E4DECFE6;
    border-bottom: 1px solid #E4DECFE6;
  }

  .wm-why-choose__benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    text-align: left;
    min-width: 0;
  }

  .wm-why-choose__benefit-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background-color: #EAE4D7;
    color: #1B241E;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .wm-why-choose__benefit-icon svg {
    width: 16px;
    height: 16px;
  }

  .wm-why-choose__benefit-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .wm-why-choose__benefit-title {
    font-size: clamp(13.5px, 1.05vw, 15px);
    font-weight: 700;
    color: #161A17;
    line-height: 1.28;
    margin: 0;
  }

  .wm-why-choose__benefit-text {
    font-size: clamp(12px, 0.92vw, 13px);
    line-height: 1.42;
    color: #525B54;
    margin: 0;
  }

  /* Shop Now CTA Button */
  .wm-why-choose__cta-wrap {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
  }

  .wm-why-choose__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #000000;
    color: #ffffff !important;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    padding: 11px 24px;
    border-radius: 9999px;
    transition: background-color 0.2s ease, transform 0.2s ease;
    box-sizing: border-box;
    cursor: pointer;
  }

  .wm-why-choose__btn:hover {
    background-color: #222222;
    transform: translateY(-1px);
  }

  .wm-why-choose__btn svg {
    width: 15px;
    height: 15px;
    transition: transform 0.2s ease;
  }

  .wm-why-choose__btn:hover svg {
    transform: translateX(3px);
  }

  /* Right Column: Compact Landscape/Editorial Photo (Never Tall/Long) */
  .wm-why-choose__media-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background-color: #EAE4D7;
    width: 100%;
    height: 220px;
    max-height: 220px;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .wm-why-choose__surface {
      padding: 24px 28px;
    }

    .wm-why-choose__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .wm-why-choose__header {
      max-width: 100%;
      margin-bottom: 14px;
    }

    .wm-why-choose__desc {
      max-width: 70ch;
    }

    .wm-why-choose__pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 24px;
      padding: 14px 0;
      margin-bottom: 16px;
    }

    .wm-why-choose__media-card {
      height: 240px;
      max-height: 240px;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .wm-why-choose__media-card {
      height: 410px;
      max-height: 410px;
    }
  }

  @media (min-width: 1280px) {
    .wm-why-choose__media-card {
      height: 430px;
      max-height: 430px;
    }
  }

  @media (max-width: 767px) {
    .wm-why-choose {
      padding: 18px 0;
    }

    .wm-why-choose__surface {
      padding: 18px 16px;
      border-radius: 16px;
    }

    .wm-why-choose__grid {
      gap: 16px;
    }

    .wm-why-choose__header {
      margin-bottom: 12px;
    }

    .wm-why-choose__pillars {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 12px 0;
      margin-bottom: 14px;
    }

    .wm-why-choose__benefit-item {
      gap: 10px;
      align-items: center;
    }

    .wm-why-choose__benefit-icon {
      width: 30px;
      height: 30px;
      border-radius: 7px;
      margin-top: 0;
    }

    .wm-why-choose__benefit-icon svg {
      width: 15px;
      height: 15px;
    }

    .wm-why-choose__benefit-title {
      font-size: 13.5px;
    }

    .wm-why-choose__benefit-text {
      font-size: 12px;
      line-height: 1.35;
    }

    .wm-why-choose__media-card {
      height: 190px;
      max-height: 190px;
      border-radius: 14px;
    }
  }

  .wm-why-choose__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .wm-why-choose__media-card:hover .wm-why-choose__img {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-why-choose__btn,
    .wm-why-choose__img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<section
  id="about"
  role="region"
  aria-label="Why Choose Wagmart"
  class="wm-why-choose"
>
  <div class="wm-why-choose__wrap">
    <div class="wm-why-choose__surface">
      <div class="wm-why-choose__grid">
        {% comment %} LEFT: Editorial Value Proposition & 2x2 Pillars {% endcomment %}
        <div class="wm-why-choose__content">
          <div class="wm-why-choose__header">
            <h2 class="wm-why-choose__title">
              {{ heading }}
            </h2>
            <p class="wm-why-choose__desc">
              {{ description }}
            </p>
          </div>

          <div class="wm-why-choose__pillars">
            {% comment %} 1. Premium Pet Essentials {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                  <path d="M3 6h18"/>
                  <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item1_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item1_desc }}</p>
              </div>
            </div>

            {% comment %} 2. Fast & Reliable Delivery {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v11"/>
                  <path d="M14 9h4l4 4v4c0 .6-.4 1-1 1h-2"/>
                  <circle cx="7" cy="18" r="2"/>
                  <path d="M15 18H9"/>
                  <circle cx="17" cy="18" r="2"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item2_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item2_desc }}</p>
              </div>
            </div>

            {% comment %} 3. Trusted Quality & Safety {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item3_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item3_desc }}</p>
              </div>
            </div>

            {% comment %} 4. Friendly Customer Support {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item4_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item4_desc }}</p>
              </div>
            </div>
          </div>

          <div class="wm-why-choose__cta-wrap">
            <a
              href="{{ btn_link }}"
              class="wm-why-choose__btn"
              aria-label="{{ btn_text | escape }} - {{ heading | escape }}"
            >
              <span>{{ btn_text }}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>

        {% comment %} RIGHT: Compact Landscape Editorial Photo {% endcomment %}
        <div class="wm-why-choose__media-card">
          <img
            src="{{ feat_img_url }}"
            alt="Happy pet parent smiling and hugging a golden retriever in a sunlit meadow"
            class="wm-why-choose__img"
            loading="lazy"
            width="900"
            height="640"
          >
        </div>
      </div>
    </div>
  </div>
</section>

