{% comment %}
  Wagmart "Why Choose Wagmart?" Brand Trust & Pet Parent Value Section
  - Clean, modern, 2-column bespoke layout matching Reference Image 1
  - Left card: Warm linen card with headline, inner white 4-benefits container, and moss green CTA
  - Right card: Full-height lifestyle photography with golden retriever and smiling pet parent
  - 100% mobile-friendly and responsive across all devices
  - Configurable via Shopify Online Store 2.0 theme editor
{% endcomment %}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'WHY PET PARENTS LOVE US'
  assign heading = section.settings.heading | default: 'Why Choose Wagmart?'
  if heading == blank or heading contains 'A Happier World'
    assign heading = 'Why Choose Wagmart?'
  endif

  assign description = section.settings.description | default: "We're passionate about pets and committed to making their lives happier, healthier and easier with high-quality products and trusted service."
  if description == blank or description contains 'Thoughtfully chosen essentials'
    assign description = "We're passionate about pets and committed to making their lives happier, healthier and easier with high-quality products and trusted service."
  endif

  assign item1_title = section.settings.item1_title | default: 'Premium Pet Essentials'
  assign item1_desc = section.settings.item1_desc | default: 'Carefully selected food, toys, grooming, and everyday care products.'

  assign item2_title = section.settings.item2_title | default: 'Fast & Reliable Delivery'
  assign item2_desc = section.settings.item2_desc | default: "Get your pet's favorites delivered quickly to your doorstep."

  assign item3_title = section.settings.item3_title | default: 'Trusted Quality & Safety'
  assign item3_desc = section.settings.item3_desc | default: 'Products chosen with comfort, durability, and pet safety in mind.'

  assign item4_title = section.settings.item4_title | default: 'Friendly Customer Support'
  assign item4_desc = section.settings.item4_desc | default: 'Helpful support for choosing the right products for your furry friend.'

  assign btn_text = section.settings.btn_text | default: 'Shop Now'
  assign btn_link = section.settings.btn_link
  if btn_link == blank
    assign btn_link = routes.all_products_collection_url | default: '/collections/all'
  endif

  if section.settings.image != blank
    assign feat_img_url = section.settings.image | image_url: width: 1200
  else
    assign feat_img_url = 'why-choose-wagmart.webp' | asset_url
  endif
-%}

<style>
  /* ==========================================================================
     WHY CHOOSE WAGMART SECTION STYLING (MATCHING REFERENCE IMAGE 1)
     ========================================================================== */

  .wm-why-choose {
    background-color: #ffffff;
    padding: clamp(40px, 5vw, 72px) 0;
    position: relative;
    width: 100%;
    font-family: var(--font-sans, 'Nunito', 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif);
  }

  .wm-why-choose__wrap {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 56px);
  }

  .wm-why-choose__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .wm-why-choose__grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(24px, 3.5vw, 40px);
    }
  }

  /* Left Column: Card with Benefits & Actions */
  .wm-why-choose__card {
    background-color: #FAF8F5;
    border: 1px solid #ECE7DF;
    border-radius: clamp(20px, 3vw, 32px);
    padding: clamp(24px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.02);
  }

  .wm-why-choose__header {
    text-align: center;
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wm-why-choose__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #44684a;
    margin-bottom: 12px;
  }

  .wm-why-choose__sparkle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #E2A03F;
    margin-left: 2px;
  }

  .wm-why-choose__title {
    font-family: inherit;
    font-size: clamp(28px, 3.2vw, 42px);
    font-weight: 800;
    color: #142217;
    letter-spacing: -0.025em;
    line-height: 1.18;
    margin: 0 0 14px 0;
    text-align: center;
  }

  .wm-why-choose__desc {
    font-size: clamp(14px, 1.1vw, 15px);
    line-height: 1.6;
    color: #556658;
    margin: 0 auto;
    max-width: 520px;
    text-align: center;
  }

  /* Inner White Benefits Card */
  .wm-why-choose__benefits-box {
    background-color: #ffffff;
    border: 1px solid #EAE5DC;
    border-radius: clamp(16px, 2vw, 22px);
    padding: clamp(18px, 2.5vw, 24px);
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 20px);
    margin-bottom: 26px;
  }

  .wm-why-choose__benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    text-align: left;
  }

  .wm-why-choose__benefit-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .wm-why-choose__benefit-icon svg {
    width: 22px;
    height: 22px;
  }

  .wm-why-choose__benefit-icon--1 {
    background-color: #EEF5EB;
    border: 1px solid #DCEADA;
    color: #2F6343;
  }
  .wm-why-choose__benefit-icon--2 {
    background-color: #FDF3E7;
    border: 1px solid #F8E2C8;
    color: #C5631E;
  }
  .wm-why-choose__benefit-icon--3 {
    background-color: #ECF5F0;
    border: 1px solid #D8EBE1;
    color: #1F6C56;
  }
  .wm-why-choose__benefit-icon--4 {
    background-color: #FBF3E7;
    border: 1px solid #F3E4CD;
    color: #8E6426;
  }

  .wm-why-choose__benefit-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .wm-why-choose__benefit-title {
    font-size: 15px;
    font-weight: 700;
    color: #142217;
    line-height: 1.3;
    margin: 0;
  }

  .wm-why-choose__benefit-text {
    font-size: 13.5px;
    line-height: 1.45;
    color: #5d6d61;
    margin: 0;
  }

  /* Shop Now Button */
  .wm-why-choose__cta-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  .wm-why-choose__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    background-color: #000000;
    color: #ffffff !important;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    padding: 13px 32px;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    cursor: pointer;
  }
  .wm-why-choose__btn:hover {
    background-color: #222222;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
  }
  .wm-why-choose__btn svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }
  .wm-why-choose__btn:hover svg {
    transform: translateX(3px);
  }

  /* Right Column: Photo Card */
  .wm-why-choose__media-card {
    position: relative;
    border-radius: clamp(20px, 3vw, 32px);
    overflow: hidden;
    border: 1px solid #ECE7DF;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    aspect-ratio: 1.06 / 1;
    min-height: 280px;
    height: 100%;
    background-color: #f7f4ed;
  }
  @media (min-width: 1024px) {
    .wm-why-choose__media-card {
      aspect-ratio: auto;
      min-height: 100%;
    }
  }

  .wm-why-choose__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wm-why-choose__media-card:hover .wm-why-choose__img {
    transform: scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-why-choose__btn,
    .wm-why-choose__img {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<section
  id="about"
  role="region"
  aria-label="Why Choose Wagmart"
  class="wm-why-choose"
>
  <div class="wm-why-choose__wrap">
    <div class="wm-why-choose__grid">
      {% comment %} LEFT: Value Proposition & 4 Benefits Box {% endcomment %}
      <div class="wm-why-choose__card">
        <div>
          <div class="wm-why-choose__header">
            <div class="wm-why-choose__eyebrow">
              <span>{{ eyebrow }}</span>
              <span class="wm-why-choose__sparkle" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#E5A642" stroke-width="2.6" stroke-linecap="round">
                  <line x1="8" y1="4" x2="8" y2="8" />
                  <line x1="14" y1="5.5" x2="11.5" y2="9.5" />
                  <line x1="18.5" y1="11" x2="14" y2="11" />
                </svg>
              </span>
            </div>

            <h2 class="wm-why-choose__title">
              {{ heading }}
            </h2>

            <p class="wm-why-choose__desc">
              {{ description }}
            </p>
          </div>

          {% comment %} Inner White Box with 4 Benefits {% endcomment %}
          <div class="wm-why-choose__benefits-box">
            {% comment %} 1. Premium Pet Essentials {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon wm-why-choose__benefit-icon--1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3.5 12.5c.5 4.5 4 7.5 8.5 7.5s8-3 8.5-7.5H3.5z"/>
                  <ellipse cx="12" cy="12.5" rx="8.5" ry="2"/>
                  <path d="M12 16.5c-.8 0-1.4-.4-1.4-.9s.6-.9 1.4-.9 1.4.4 1.4.9-.6.9-1.4.9z" fill="currentColor"/>
                  <circle cx="10.2" cy="14.5" r="0.5" fill="currentColor"/>
                  <circle cx="13.8" cy="14.5" r="0.5" fill="currentColor"/>
                  <circle cx="12" cy="13.8" r="0.5" fill="currentColor"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item1_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item1_desc }}</p>
              </div>
            </div>

            {% comment %} 2. Fast & Reliable Delivery {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon wm-why-choose__benefit-icon--2">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 12h2"/>
                  <path d="M1 9.5h3"/>
                  <path d="M5 6.5h9a1 1 0 0 1 1 1V16H5V6.5z"/>
                  <path d="M15 9.5h3.5l3 3.5v3h-2"/>
                  <circle cx="8" cy="16.5" r="2.2"/>
                  <circle cx="17.5" cy="16.5" r="2.2"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item2_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item2_desc }}</p>
              </div>
            </div>

            {% comment %} 3. Trusted Quality & Safety {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon wm-why-choose__benefit-icon--3">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="M12 15.5c-1 0-1.8-.6-1.8-1.4 0-.7.7-1.3 1.8-1.3s1.8.6 1.8 1.3c0 .8-.8 1.4-1.8 1.4z" fill="currentColor"/>
                  <circle cx="9.8" cy="11.4" r="0.8" fill="currentColor"/>
                  <circle cx="14.2" cy="11.4" r="0.8" fill="currentColor"/>
                  <circle cx="11.2" cy="9.8" r="0.7" fill="currentColor"/>
                  <circle cx="12.8" cy="9.8" r="0.7" fill="currentColor"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item3_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item3_desc }}</p>
              </div>
            </div>

            {% comment %} 4. Friendly Customer Support {% endcomment %}
            <div class="wm-why-choose__benefit-item">
              <div class="wm-why-choose__benefit-icon wm-why-choose__benefit-icon--4">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 12a8 8 0 0 1 16 0"/>
                  <path d="M3 13a2 2 0 0 1 2-2h1a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4z"/>
                  <path d="M16 13a2 2 0 0 1 2-2h1a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-4z"/>
                  <path d="M18 19v1a2 2 0 0 1-2 2h-2"/>
                </svg>
              </div>
              <div class="wm-why-choose__benefit-content">
                <h3 class="wm-why-choose__benefit-title">{{ item4_title }}</h3>
                <p class="wm-why-choose__benefit-text">{{ item4_desc }}</p>
              </div>
            </div>
          </div>
        </div>

        {% comment %} CTA Button Centered {% endcomment %}
        <div class="wm-why-choose__cta-wrap">
          <a
            href="{{ btn_link }}"
            class="wm-why-choose__btn"
            aria-label="{{ btn_text | escape }} - {{ heading | escape }}"
          >
            <span>{{ btn_text }}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      {% comment %} RIGHT: Photo Card {% endcomment %}
      <div class="wm-why-choose__media-card">
        <img
          src="{{ feat_img_url }}"
          alt="Happy pet parent smiling and hugging a golden retriever in a sunlit meadow"
          class="wm-why-choose__img"
          loading="lazy"
          width="900"
          height="900"
        >
      </div>
    </div>
  </div>
</section>

