{% comment %}
  Wagmart Static Page Section
{% endcomment %}

<section class="py-12 sm:py-16 bg-[#FAF8F5]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl p-8 sm:p-12 border border-[#EAE5D9] shadow-sm">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#111827] mb-6">
        {{ page.title }}
      </h1>
      <div class="prose max-w-none text-neutral-700 leading-relaxed space-y-4">
        {{ page.content }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
