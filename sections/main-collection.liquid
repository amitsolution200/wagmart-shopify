    {%- comment -%} e) Sticky Toolbar & f) Active Filter Chips Row {%- endcomment -%}
    {% render 'collection-toolbar' %}

    {%- comment -%} g) Main Workspace: Filter Sidebar + Products Grid / List {%- endcomment -%}
    <div class="wm-plp-workspace" data-plp-workspace>
      {% render 'collection-filter-sidebar' %}

      <div class="wm-plp-main-col">
        {%- comment -%} Loading Shimmer Skeletons {%- endcomment -%}
        {% render 'collection-empty-state', state_type: 'skeleton' %}

        {%- comment -%} Products Grid / List Container {%- endcomment -%}
        <div
          id="wm-plp-products"
          class="wm-plp-products"
          data-plp-grid
          role="region"
          aria-label="Products"
        >
          {%- if collection.products.size > 0 -%}
            {%- for product in collection.products -%}
              {%- liquid
                assign real_price_inr = product.price | divided_by: 100.0 | round
                assign real_compare_inr = product.compare_at_price | divided_by: 100.0 | round
                if real_compare_inr <= real_price_inr
                  assign real_compare_inr = real_price_inr | times: 1.25 | round
                endif

                if product.featured_image != blank
                  assign real_img = product.featured_image | image_url: width: 640
                else
                  assign real_img = 'catalog-bath-massage-brush.webp' | asset_url
                endif

                assign second_img = ''
                if product.images.size > 1
                  assign second_img = product.images[1] | image_url: width: 640
                endif

                assign clean_cat = product.type
                if clean_cat == blank or clean_cat == 'My Store 2' or clean_cat == 'My Store'
                  assign clean_cat = 'Grooming'
                endif

                assign has_vars = false
                if product.variants.size > 1
                  assign has_vars = true
                endif
              -%}
              {% render 'collection-product-card',
                card_id: product.variants.first.id,
                card_title: product.title,
                card_url: product.url,
                card_category: clean_cat,
                card_pet: 'dog,cat',
                card_price_inr: real_price_inr,
                card_compare_inr: real_compare_inr,
                card_rating: '4.8',
                card_reviews: 126,
                card_image: real_img,
                card_hover_image: second_img,
                card_badge_promo: 'bestseller,sale',
                card_stock: 18,
                card_has_variants: has_vars,
                card_desc: product.description | strip_html | truncate: 140
              %}
            {%- endfor -%}
          {%- else -%}
