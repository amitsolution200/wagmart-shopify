          </div>
          <span class="wm-plp-subcat__name">Treats</span>
          <span class="wm-plp-subcat__count">24 items</span>
        </a>

        <a href="?category=toys" class="wm-plp-subcat" data-subcat-pill="toys" data-subcat-title="Interactive Pet Toys">
          <div class="wm-plp-subcat__circle">
            <img src="{{ 'catalog-rolling-cat-ball.webp' | asset_url }}" alt="Toys" width="92" height="92" loading="eager">
          </div>
          <span class="wm-plp-subcat__name">Toys</span>
          <span class="wm-plp-subcat__count">36 items</span>
