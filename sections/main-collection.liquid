{%- comment -%}
  Wagmart Collection / Product Listing Page (sections/main-collection.liquid)
  - Renders ONLY the real products added in Shopify Admin (collection.products)
  - Supports Grid View (with open or collapsed 260px Filter Sidebar) and Horizontal List View
  - Uses the exact site-wide Wagmart Product Card design with - 1 + quantity stepper on Add to Cart (no toast)
  - Pure INR (₹) pricing, dynamic collection title & description, pluralised result counts
  - Top announcement bar and bottom pagination numbers removed per user request
{%- endcomment -%}

{{ 'collection.css' | asset_url | stylesheet_tag }}



{%- comment -%} JSON-LD CollectionPage & ItemList Schema for SEO {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ display_title | json }},
  "description": {{ display_desc | json }},
  "url": "{{ shop.url }}{{ collection.url | default: '/collections/all' }}",
  "mainEntity": {
    "@type": "ItemList",
    "name": {{ display_title | json }},
    "numberOfItems": {{ total_count }}
  }
}
</script>

<div
  class="wm-plp"
  data-collection-page
  data-collection-handle="{{ collection.handle | default: 'all' }}"
  data-all-collection-url="{{ routes.all_products_collection_url | default: '/collections/all' }}"
  data-fallback-img="{{ fallback_img }}"
>
  <div class="wm-plp-container">
    {%- comment -%} 2b. Breadcrumb (13px, muted, current page in dark text) {%- endcomment -%}
    <nav class="wm-plp-breadcrumb" aria-label="Breadcrumb">
      <ol class="wm-plp-breadcrumb__list">
        <li class="wm-plp-breadcrumb__item">
          <a href="{{ routes.root_url | default: '/' }}" class="wm-plp-breadcrumb__link">Home</a>
        </li>
        <li class="wm-plp-breadcrumb__sep" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </li>
        <li class="wm-plp-breadcrumb__item">
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-breadcrumb__link">Shop</a>
        </li>
        <li class="wm-plp-breadcrumb__sep" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </li>
        <li class="wm-plp-breadcrumb__item wm-plp-breadcrumb__item--current" aria-current="page" data-plp-breadcrumb-current>
          {{ display_title }}
        </li>
      </ol>
    </nav>

    

    {%- comment -%} 2d. Category / Collection Sub-Navigation Circles {%- endcomment -%}
    <section class="wm-plp-subnav" data-plp-subnav aria-label="Shop by category">
      <div class="wm-plp-subnav__track" role="tablist">
        {%- assign custom_col_count = 0 -%}
        {%- for col in collections -%}
          {%- unless col.handle == 'all' or col.handle == 'frontpage' -%}
            {%- assign custom_col_count = custom_col_count | plus: 1 -%}
            {%- liquid
              assign is_active_col = false
              if collection.handle == col.handle
                assign is_active_col = true
              endif
              if is_active_col
                assign circle_href = routes.all_products_collection_url | default: '/collections/all'
              else
                assign circle_href = col.url
              endif
              assign col_img = col.image | default: col.products.first.featured_image
              if col_img != blank
                assign col_img_url = col_img | image_url: width: 400
              else
                assign col_img_url = img_kibble_2
              endif
              assign col_count = col.all_products_count | default: col.products_count | default: col.products.size | default: 0
            -%}
            <a
              href="{{ circle_href }}"
              class="wm-plp-subnav__item{% if is_active_col %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if is_active_col %}true{% else %}false{% endif %}"
              data-subnav-item
              data-col-handle="{{ col.handle }}"
              data-col-url="{{ col.url }}"
              data-all-url="{{ routes.all_products_collection_url | default: '/collections/all' }}"
            >
              <span class="wm-plp-subnav__ring">
                <img src="{{ col_img_url }}" alt="{{ col.title | escape }}" width="280" height="280" loading="eager">
              </span>
              {%- liquid
                assign formatted_col_title = col.title | escape
                if formatted_col_title contains ',' and formatted_col_title contains ' &amp; '
                  assign formatted_col_title = formatted_col_title | replace: ' &amp; ', '<br>&amp; '
                elsif formatted_col_title contains ' &amp; '
                  assign formatted_col_title = formatted_col_title | replace: ' &amp; ', ' &amp;<br>'
                endif
              -%}
              <span class="wm-plp-subnav__label">{{ formatted_col_title }}</span>
            </a>
          {%- endunless -%}
        {%- endfor -%}

        {%- if custom_col_count == 0 -%}
          {%- comment -%} Default demo categories when no custom collections exist yet {%- endcomment -%}
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_bed }}" alt="Beds" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Beds</span>
          </a>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_bowl }}" alt="Bowls &amp; Feeders" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Bowls &amp; Feeders</span>
          </a>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_kibble_2 }}" alt="Dog Food &amp; Treats" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Dog Food &amp; Treats</span>
          </a>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_brush }}" alt="Grooming" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Grooming</span>
          </a>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_kibble_3 }}" alt="Cat Food &amp; Treats" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Cat Food &amp; Treats</span>
          </a>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_rope }}" alt="Collars, Leashes &amp; Harnesses" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Collars, Leashes &amp; Harnesses</span>
          </a>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_paw }}" alt="Hygiene &amp; Cleaning" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Hygiene &amp; Cleaning</span>
          </a>

          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-plp-subnav__item" role="tab" aria-selected="false">
            <span class="wm-plp-subnav__ring">
              <img src="{{ img_kibble_1 }}" alt="Health &amp; Wellness" width="280" height="280" loading="eager">
            </span>
            <span class="wm-plp-subnav__label">Health &amp; Wellness</span>
          </a>
        {%- endif -%}
      </div>
    </section>

    {%- comment -%} 2e. Sticky Filter & Sort Toolbar + 2f. Active Filter Chips Row {%- endcomment -%}
    {% render 'collection-toolbar' %}

    {%- paginate collection.products by 16 -%}
    {%- comment -%} 2g. Main Workspace: 260px Collapsible Filter Sidebar + Product Grid / List {%- endcomment -%}
    <div class="wm-plp-workspace" data-plp-workspace data-sidebar="open" data-layout="grid">
      <div class="wm-plp-sidebar-backdrop" data-plp-sidebar-backdrop hidden></div>

      {% render 'collection-filter-sidebar' %}

      <div class="wm-plp-results-col">
        {%- comment -%} Loading Shimmer Skeletons {%- endcomment -%}
        {% render 'collection-empty-state', state_type: 'skeleton' %}

        {%- comment -%} Live Product Grid / List Container (Renders ONLY real Shopify Admin products) {%- endcomment -%}
        <div
          id="wm-plp-products"
          class="wm-plp-grid"
          data-plp-grid
          role="region"
          aria-label="Products"
        >
          {%- for product in collection.products -%}
            {%- liquid
              assign real_price_inr = product.price | divided_by: 100.0 | round
              assign real_compare_inr = 0
              if product.compare_at_price > product.price
                assign real_compare_inr = product.compare_at_price | divided_by: 100.0 | round
              endif

              if product.featured_image != blank
                assign real_img = product.featured_image | image_url: width: 640
              else
                assign real_img = img_brush
              endif

              assign second_img = ''
              if product.images.size > 1
                assign second_img = product.images[1] | image_url: width: 640
              endif

              assign gallery_imgs_str = ''
              if product.images.size > 0
                for g_img in product.images limit: 8
                  assign g_img_url = g_img | image_url: width: 800
                  if gallery_imgs_str == blank
                    assign gallery_imgs_str = g_img_url
                  else
                    assign gallery_imgs_str = gallery_imgs_str | append: '|' | append: g_img_url
                  endif
                endfor
              else
                assign gallery_imgs_str = real_img
              endif

              assign p_cols = ''
              for col in product.collections
                assign p_cols = p_cols | append: ',' | append: col.title | append: ',' | append: col.handle
              endfor
              assign p_tags = product.tags | join: ','
              assign raw_meta = product.title | append: ' ' | append: product.type | append: ' ' | append: p_tags | append: ' ' | append: p_cols | downcase

              assign matched_cats = ''
              assign primary_cat = ''

              if raw_meta contains 'toy' or raw_meta contains 'ball' or raw_meta contains 'rope' or raw_meta contains 'chew' or raw_meta contains 'plush' or raw_meta contains 'squeak' or raw_meta contains 'play' or raw_meta contains 'teaser'
                assign matched_cats = matched_cats | append: 'toys,'
                if primary_cat == blank
                  assign primary_cat = 'Toys'
                endif
              endif

              if raw_meta contains 'bed' or raw_meta contains 'mattress' or raw_meta contains 'cushion' or raw_meta contains 'blanket' or raw_meta contains 'orthopedic' or raw_meta contains 'lounger' or raw_meta contains 'crate' or raw_meta contains 'sleep'
                assign matched_cats = matched_cats | append: 'beds,'
                if primary_cat == blank
                  assign primary_cat = 'Beds'
                endif
              endif

              if raw_meta contains 'treat' or raw_meta contains 'biscuit' or raw_meta contains 'snack' or raw_meta contains 'jerky' or raw_meta contains 'bone'
                assign matched_cats = matched_cats | append: 'treats,'
                if primary_cat == blank
                  assign primary_cat = 'Treats'
                endif
              endif

              if raw_meta contains 'cat food' or raw_meta contains 'kitten food' or raw_meta contains 'feline food' or raw_meta contains 'wet cat'
                assign matched_cats = matched_cats | append: 'cat food,'
                if primary_cat == blank
                  assign primary_cat = 'Cat Food'
                endif
              endif

              if raw_meta contains 'dog food' or raw_meta contains 'puppy food' or raw_meta contains 'kibble' or raw_meta contains 'dry food' or raw_meta contains 'bowl' or raw_meta contains 'feeder' or raw_meta contains 'water' or raw_meta contains 'dispenser' or raw_meta contains 'feeding' or raw_meta contains 'food'
                assign matched_cats = matched_cats | append: 'dog food,feeding,'
                if primary_cat == blank
                  assign primary_cat = 'Dog Food'
                endif
              endif

              if raw_meta contains 'health' or raw_meta contains 'supplement' or raw_meta contains 'vitamin' or raw_meta contains 'dental' or raw_meta contains 'tooth' or raw_meta contains 'oral' or raw_meta contains 'paw' or raw_meta contains 'balm' or raw_meta contains 'cleaner' or raw_meta contains 'flea' or raw_meta contains 'tick' or raw_meta contains 'hygiene' or raw_meta contains 'care'
                assign matched_cats = matched_cats | append: 'health care,supplements,hygiene,'
                if primary_cat == blank
                  assign primary_cat = 'Health Care'
                endif
              endif

              if raw_meta contains 'collar' or raw_meta contains 'leash' or raw_meta contains 'harness' or raw_meta contains 'fashion' or raw_meta contains 'apparel' or raw_meta contains 'shirt' or raw_meta contains 'coat' or raw_meta contains 'hoodie' or raw_meta contains 'bandana' or raw_meta contains 'walk' or raw_meta contains 'carrier' or raw_meta contains 'travel' or raw_meta contains 'seat' or raw_meta contains 'hammock' or raw_meta contains 'bag' or raw_meta contains 'accessor' or raw_meta contains 'gear' or raw_meta contains 'bowl' or raw_meta contains 'feeder'
                assign matched_cats = matched_cats | append: 'accessories,fashion,travel,collars,'
                if primary_cat == blank
                  assign primary_cat = 'Accessories'
                endif
              endif

              if raw_meta contains 'groom' or raw_meta contains 'brush' or raw_meta contains 'glove' or raw_meta contains 'shampoo' or raw_meta contains 'bath' or raw_meta contains 'massage' or raw_meta contains 'slicker' or raw_meta contains 'comb' or raw_meta contains 'rake' or raw_meta contains 'deshed' or raw_meta contains 'trimmer' or raw_meta contains 'clipper' or raw_meta contains 'nail' or raw_meta contains 'grinder' or raw_meta contains 'roller' or raw_meta contains 'hair' or raw_meta contains 'fur' or raw_meta contains 'wipe'
                assign matched_cats = matched_cats | append: 'grooming,'
                if primary_cat == blank
                  assign primary_cat = 'Grooming'
                endif
              endif

              if primary_cat == blank
                if product.type != blank and product.type != 'My Store 2' and product.type != 'My Store'
                  assign primary_cat = product.type
                else
                  assign primary_cat = 'Grooming'
                endif
              endif

              assign all_cats_combined = matched_cats | append: primary_cat | append: ',' | append: product.type | append: p_cols | append: ',' | append: p_tags

              assign detected_pets = 'dog,cat,puppy,senior'
              if raw_meta contains 'cat' or raw_meta contains 'kitten'
                unless raw_meta contains 'dog' or raw_meta contains 'puppy'
                  assign detected_pets = 'cat,puppy,senior'
                endunless
              elsif raw_meta contains 'dog' or raw_meta contains 'puppy'
                assign detected_pets = 'dog,puppy,senior'
              endif

              assign has_vars = false
              if product.variants.size > 1
                assign has_vars = true
              endif

              assign card_desc_text = product.description | strip_html | strip
              if card_desc_text == blank
                assign card_desc_text = 'Crafted with pet-safe, vet-approved materials for daily comfort and care.'
              endif

              assign unique_prod_id = product.selected_or_first_available_variant.id | default: product.variants.first.id | default: product.id
              assign prod_sku_val = product.selected_or_first_available_variant.sku | default: ''
              assign prod_stock_val = 15
              if product.available == false
                assign prod_stock_val = 0
              endif
            -%}
            {% render 'collection-product-card',
              card_id: unique_prod_id,
              card_handle: product.handle,
              card_sku: prod_sku_val,
              card_title: product.title,
              card_url: product.url,
              card_category: primary_cat,
              card_categories: all_cats_combined,
              card_pet: detected_pets,
              card_price_inr: real_price_inr,
              card_compare_inr: real_compare_inr,
              card_image: real_img,
              card_images: gallery_imgs_str,
              card_hover_image: second_img,
              card_badge_promo: 'bestseller,sale,new',
              card_stock: prod_stock_val,
              card_has_variants: has_vars,
              card_desc: card_desc_text
            %}
          {%- endfor -%}
        </div>

        {%- comment -%} Empty Filter State ("No products match your filters") {%- endcomment -%}
        {% render 'collection-empty-state', state_type: 'empty' %}

        {%- comment -%} Pagination Controls {%- endcomment -%}
        <div class="wm-plp-pagination-wrap" data-plp-pagination-wrap {% if paginate.pages <= 1 %}hidden{% endif %}>
          {% render 'collection-pagination', paginate: paginate %}
        </div>
      </div>
    </div>
    {%- endpaginate -%}

  </div>

  {%- comment -%} 6. Quick View Modal is rendered globally in layout/theme.liquid {%- endcomment -%}
</div>

<script src="{{ 'collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Collection Title Override"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Collection Description Override"
    }
  ]
}
{% endschema %}
