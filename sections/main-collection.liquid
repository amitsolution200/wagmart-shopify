{%- comment -%}
  Wagmart Collection / Product Listing Page (sections/main-collection.liquid)
  - Supports Layout A (260px Filter Sidebar + 3-Col Grid), Layout B (Collapsed Sidebar + 4-Col Grid), and Layout C (List View)
  - Fixes broken product image pipeline (separates image_url from asset_url fallback)
  - Pure INR (₹) pricing, dynamic collection title & description, pluralised result counts
  - AJAX filtering, dual-handle price slider, active filter chips, numbered pagination & Quick View modal
{%- endcomment -%}

{{ 'collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign raw_title = collection.title | default: 'Shop by Collection'
  if raw_title == 'Products' or raw_title == 'All'
    assign display_title = 'All Pet Supplies'
  else
    assign display_title = raw_title
  endif

  if collection.description != blank
    assign display_desc = collection.description | strip_html
  elsif raw_title == 'Products' or raw_title == 'All'
    assign display_desc = 'Explore our complete range of vet-approved pet food, grooming essentials, interactive toys, and comfort gear for happier, healthier pets.'
  else
    assign display_desc = 'Explore our wide range of pet products crafted with wholesome ingredients and pet-safe materials for a happier, healthier life.'
  endif

  assign fallback_img = 'catalog-bath-massage-brush.webp' | asset_url
  assign img_kibble_1 = 'kibble-bulldog-adult.jpg' | asset_url
  assign img_kibble_2 = 'kibble-bulldog-puppy.jpg' | asset_url
  assign img_kibble_3 = 'kibble-queen-adult.jpg' | asset_url
  assign img_kibble_4 = 'kibble-queen-kitten.jpg' | asset_url
  assign img_brush = 'catalog-bath-massage-brush.webp' | asset_url
  assign img_slicker = 'catalog-slicker-brush.webp' | asset_url
  assign img_bowl = 'catalog-slow-feeder-bowl.webp' | asset_url
  assign img_rope = 'catalog-rope-leash.webp' | asset_url
  assign img_paw = 'paw-cleaner-kit.webp' | asset_url
  assign img_chews = 'Premium WAGMART Dog Chews Ad.png' | asset_url
  assign img_leash = 'catalog-retractable-leash.webp' | asset_url
  assign img_ball = 'catalog-rolling-cat-ball.webp' | asset_url
  assign img_bed = 'catalog-orthopedic-bed.webp' | asset_url
-%}

{%- comment -%} JSON-LD CollectionPage & ItemList Schema for SEO {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ display_title | json }},
  "description": {{ display_desc | json }},
  "url": "{{ shop.url }}{{ collection.url | default: '/collections/all' }}",
  "mainEntity": {
    "@type": "ItemList",
    "name": {{ display_title | json }},
    "numberOfItems": {{ collection.products_count | default: 12 }}
  }
}
</script>

<div
  class="wm-plp"
  data-collection-page
  data-layout="grid-3"
  data-sidebar="open"
  data-fallback-img="{{ fallback_img }}"
>
  {%- comment -%} a) Slim Top Announcement Bar {%- endcomment -%}
  <div class="wm-plp-announce">
    <div class="wm-plp-container wm-plp-announce__inner">
      <div class="wm-plp-announce__msg">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <span>Free express shipping on orders over <strong>&#8377;499</strong></span>
      </div>
      <div class="wm-plp-announce__links">
        <a href="/pages/contact">Track Order</a>
        <span aria-hidden="true">|</span>
        <a href="/pages/faq">Help</a>
        <span aria-hidden="true">|</span>
        <span class="wm-plp-announce__currency">India (INR &#8377;)</span>
      </div>
    </div>
  </div>

  <div class="wm-plp-container">
    {%- comment -%} b) Breadcrumb (13px, muted, current page in dark text) {%- endcomment -%}
    <nav class="wm-plp-breadcrumb" aria-label="Breadcrumb">
      <ol class="wm-plp-breadcrumb__list">
        <li><a href="{{ routes.root_url | default: '/' }}">Home</a></li>
        <li class="wm-plp-breadcrumb__sep" aria-hidden="true">&rsaquo;</li>
        <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}">Shop</a></li>
        <li class="wm-plp-breadcrumb__sep" aria-hidden="true">&rsaquo;</li>
        <li class="wm-plp-breadcrumb__current" aria-current="page" data-collection-crumb>{{ display_title }}</li>
      </ol>
    </nav>

    {%- comment -%} c) Compact Collection Hero + d) Subcollection Category Circles Row {%- endcomment -%}
