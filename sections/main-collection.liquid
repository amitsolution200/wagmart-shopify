{% schema %}
{
  "name": "Collection Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Collection Title Override"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Collection Description Override"
    }
  ]
}
{% endschema %}
