          <div class="wm-plp-subcat__circle">
            <img src="{{ 'cat-relaxing.webp' | asset_url }}" alt="Cat Food" width="92" height="92" loading="eager">
          </div>
          <span class="wm-plp-subcat__name">Cat Food</span>
          <span class="wm-plp-subcat__count">32 items</span>
        </a>

        <a href="?category=treats" class="wm-plp-subcat" data-subcat-pill="treats" data-subcat-title="Dental Chews & Treats">
          <div class="wm-plp-subcat__circle">
