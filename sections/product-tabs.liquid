{%- comment -%}
  Wagmart Product Tabs Section (sections/product-tabs.liquid)
  Accessible ARIA tablist with 3 panels:
  1. Description (two-column editorial layout + dynamic product highlights from Shopify Admin data)
  2. Specifications (structured responsive technical specifications table from Shopify Admin data)
  3. Reviews (rating summary, 5-to-1 star distribution, accessible review form with validation, review list with pagination, and accurate zero-reviews empty state)
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | plus: 0
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0
  assign specs_meta = product.metafields.custom.specifications

  assign raw_desc_text = product.description | strip_html | strip
  assign desc_sentences = raw_desc_text | split: '. '
  assign lead_sentence = product.metafields.custom.short_description.value | default: product.metafields.custom.short_description | strip
  if lead_sentence == blank and desc_sentences.size > 0
    assign first_s = desc_sentences.first | strip
    if first_s != blank
      assign last_char = first_s | slice: -1, 1
      if last_char == '.'
        assign lead_sentence = first_s
      else
        assign lead_sentence = first_s | append: '.'
      endif
    endif
  endif

  assign custom_heading = product.metafields.custom.description_heading.value | default: product.metafields.custom.description_heading | default: section.settings.desc_heading | strip
  if custom_heading == blank
    assign custom_heading = product.title
  endif
-%}

<section
  class="wm-section wm-tabs-section"
  id="ProductTabs-{{ section.id }}"
  data-product-tabs
  data-product-id="{{ product.id }}"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-server-rating="{{ rating_val }}"
  data-server-count="{{ rating_count }}"
>
  <div class="wm-container">
    {%- comment -%} ARIA Tablist {%- endcomment -%}
    <div
      class="wm-tabs__tablist"
      role="tablist"
      aria-label="Product details and customer reviews"
    >
      <button
        type="button"
        role="tab"
        id="wm-tab-btn-description-{{ section.id }}"
        aria-controls="wm-tab-panel-description-{{ section.id }}"
        aria-selected="true"
        tabindex="0"
        class="wm-tabs__tab is-active"
        data-tab-trigger="description"
      >
        <span>{{ 'products.tabs.description' | t }}</span>
      </button>

      <button
        type="button"
        role="tab"
        id="wm-tab-btn-specifications-{{ section.id }}"
        aria-controls="wm-tab-panel-specifications-{{ section.id }}"
        aria-selected="false"
        tabindex="-1"
        class="wm-tabs__tab"
        data-tab-trigger="specifications"
      >
        <span>{{ 'products.tabs.specifications' | t }}</span>
      </button>

      <button
        type="button"
        role="tab"
        id="wm-tab-btn-reviews-{{ section.id }}"
        aria-controls="product-tabs-reviews"
        aria-selected="false"
        tabindex="-1"
        class="wm-tabs__tab"
        data-tab-trigger="reviews"
      >
        <span>{{ 'products.tabs.reviews' | t }}</span>
        <span class="wm-tabs__count" data-reviews-tab-badge>({{ rating_count }})</span>
      </button>
    </div>

    {%- comment -%} PANEL 1: DESCRIPTION (100% Shopify Admin Product Description only) {%- endcomment -%}
    <div
      id="wm-tab-panel-description-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="wm-tab-btn-description-{{ section.id }}"
      tabindex="0"
      class="wm-tabs__panel is-active"
      data-tab-panel="description"
    >
      <div class="wm-desc-admin wm-prose">
        {%- if product.description != blank -%}
          <div class="wm-prose__admin-description">
            {{ product.description }}
          </div>
        {%- else -%}
          <p class="wm-desc-admin__empty">{{ 'products.product.description' | t }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} PANEL 2: SPECIFICATIONS (Structured Technical Specifications Table) {%- endcomment -%}
    <div
      id="wm-tab-panel-specifications-{{ section.id }}"
      role="tabpanel"
      aria-labelledby="wm-tab-btn-specifications-{{ section.id }}"
      tabindex="0"
      class="wm-tabs__panel"
      data-tab-panel="specifications"
      hidden
    >
      <div class="wm-specs">
        <div class="wm-specs__header">
          <h2 class="wm-specs__heading">
            {{ section.settings.specs_heading | default: 'Technical Specifications' }}
          </h2>
          <p class="wm-specs__subcopy">
            Verified product details and catalog attributes for {{ product.title }}.
          </p>
        </div>

        {%- if specs_meta != blank and specs_meta.type == 'rich_text_field' -%}
          <div class="wm-prose">
            {{ specs_meta | metafield_tag }}
          </div>
        {%- else -%}
          <div class="wm-specs-table-wrap">
            <table class="wm-specs-table" aria-label="{{ 'products.tabs.specifications' | t }}">
              <thead>
                <tr class="wm-specs-table__head-row">
                  <th scope="col" class="wm-specs-table__col-head">Specification</th>
                  <th scope="col" class="wm-specs-table__col-head">Details</th>
                </tr>
              </thead>
              <tbody>
                {%- if product.title != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Product Name</th>
                    <td class="wm-specs-table__td">{{ product.title }}</td>
                  </tr>
                {%- endif -%}
                {%- if product.vendor != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Brand / Vendor</th>
                    <td class="wm-specs-table__td">{{ product.vendor }}</td>
                  </tr>
                {%- endif -%}
                {%- if product.type != blank or product.collections.first != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Category</th>
                    <td class="wm-specs-table__td">{{ product.type | default: product.collections.first.title }}</td>
                  </tr>
                {%- endif -%}
                {%- assign tab_sku = current_variant.sku | strip -%}
                {%- if tab_sku != blank -%}
                  <tr class="wm-specs-table__row" data-sku-wrapper>
                    <th scope="row" class="wm-specs-table__th">{{ 'products.product.sku' | t }}</th>
                    <td class="wm-specs-table__td" data-product-sku>{{ tab_sku }}</td>
                  </tr>
                {%- endif -%}
                {%- if current_variant.barcode != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Barcode / GTIN</th>
                    <td class="wm-specs-table__td">{{ current_variant.barcode }}</td>
                  </tr>
                {%- endif -%}
                {%- if current_variant.weight > 0 -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Weight</th>
                    <td class="wm-specs-table__td">{{ current_variant.weight | weight_with_unit }}</td>
                  </tr>
                {%- endif -%}
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <tr class="wm-specs-table__row">
                      <th scope="row" class="wm-specs-table__th">{{ option.name }}</th>
                      <td class="wm-specs-table__td">{{ option.values | join: ', ' }}</td>
                    </tr>
                  {%- endfor -%}
                {%- endunless -%}
                {%- if product.tags.size > 0 -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Product Tags</th>
                    <td class="wm-specs-table__td">{{ product.tags | join: ', ' }}</td>
                  </tr>
                {%- endif -%}
                {%- if specs_meta.value != blank and specs_meta.value.size > 0 -%}
                  {%- for spec in specs_meta.value -%}
                    <tr class="wm-specs-table__row">
                      <th scope="row" class="wm-specs-table__th">{{ spec.label | default: spec.title }}</th>
                      <td class="wm-specs-table__td">{{ spec.value | default: spec.text }}</td>
                    </tr>
                  {%- endfor -%}
                {%- endif -%}
                {%- if product.metafields.custom.material != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Material</th>
                    <td class="wm-specs-table__td">{{ product.metafields.custom.material.value | default: product.metafields.custom.material }}</td>
                  </tr>
                {%- endif -%}
                {%- if product.metafields.custom.dimensions != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Dimensions</th>
                    <td class="wm-specs-table__td">{{ product.metafields.custom.dimensions.value | default: product.metafields.custom.dimensions }}</td>
                  </tr>
                {%- endif -%}
                {%- if product.metafields.custom.suitable_for != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Suitable For</th>
                    <td class="wm-specs-table__td">{{ product.metafields.custom.suitable_for.value | default: product.metafields.custom.suitable_for }}</td>
                  </tr>
                {%- endif -%}
                {%- if product.metafields.custom.care_instructions != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Care & Cleaning</th>
                    <td class="wm-specs-table__td">{{ product.metafields.custom.care_instructions.value | default: product.metafields.custom.care_instructions }}</td>
                  </tr>
                {%- endif -%}
                {%- if product.metafields.custom.country_of_origin != blank -%}
                  <tr class="wm-specs-table__row">
                    <th scope="row" class="wm-specs-table__th">Country of Origin</th>
                    <td class="wm-specs-table__td">{{ product.metafields.custom.country_of_origin.value | default: product.metafields.custom.country_of_origin }}</td>
                  </tr>
                {%- endif -%}
                {%- assign spec_blocks = section.blocks | where: 'type', 'spec_row' -%}
                {%- if spec_blocks.size > 0 -%}
                  {%- for block in spec_blocks -%}
                    {%- if block.settings.label != blank and block.settings.value != blank -%}
                      <tr class="wm-specs-table__row" {{ block.shopify_attributes }}>
                        <th scope="row" class="wm-specs-table__th">{{ block.settings.label }}</th>
                        <td class="wm-specs-table__td">{{ block.settings.value }}</td>
                      </tr>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} PANEL 3: REVIEWS (Summary + Rating Distribution + Review Form + Review List + Empty State) {%- endcomment -%}
    <div
      id="product-tabs-reviews"
      role="tabpanel"
      aria-labelledby="wm-tab-btn-reviews-{{ section.id }}"
      tabindex="0"
      class="wm-tabs__panel"
      data-tab-panel="reviews"
      hidden
    >
      <div class="wm-reviews" data-reviews-root>
        {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
        {%- if app_blocks.size > 0 -%}
          {%- for block in app_blocks -%}
            <div class="wm-reviews__app-block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- assign admin_review_blocks = section.blocks | where: 'type', 'review' -%}
        <script type="application/json" data-admin-reviews>
          [
            {%- for block in admin_review_blocks -%}
              {%- unless forloop.first -%},{%- endunless -%}
              {
                "id": {{ block.id | json }},
                "author": {{ block.settings.author | strip | default: 'Customer' | json }},
                "pet": {{ block.settings.pet | strip | json }},
                "rating": {{ block.settings.rating | default: 5 }},
                "date": {{ block.settings.date | strip | json }},
                "title": {{ block.settings.title | strip | json }},
                "body": {{ block.settings.body | strip | json }}
              }
            {%- endfor -%}
          ]
        </script>
        {%- if product.metafields.custom.reviews != blank -%}
          <script type="application/json" data-metafield-reviews>
            {{ product.metafields.custom.reviews.value | default: product.metafields.custom.reviews | json }}
          </script>
        {%- endif -%}

        {%- comment -%} Top Header: Reviews (count) + Refine & Sort Controls (Matching Reference Screenshot 1 & 2) {%- endcomment -%}
        <div class="wm-reviews__header">
          <h2 class="wm-reviews__heading">
            Reviews <span class="wm-reviews__heading-count" data-reviews-heading-count>({{ rating_count }})</span>
          </h2>

          <div class="wm-reviews__controls">
            <!-- Mobile Popover Backdrop Overlay -->
            <div class="wm-reviews__popover-backdrop" data-reviews-popover-backdrop hidden></div>

            <!-- Refine Dropdown Popover (Exact Match for Screenshot 2) -->
            <div class="wm-reviews__ctrl-wrapper" data-refine-dropdown-wrap>
              <button
                type="button"
                class="wm-reviews__pill-btn wm-reviews__refine-btn"
                data-refine-toggle-btn
                aria-expanded="false"
                aria-haspopup="dialog"
                aria-label="Refine reviews by rating"
              >
                <svg class="wm-reviews__ctrl-icon" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="3" y1="5" x2="17" y2="5"></line>
                  <line x1="5" y1="10" x2="15" y2="10"></line>
                  <line x1="8" y1="15" x2="12" y2="15"></line>
                </svg>
                <span>Refine</span>
              </button>

              <!-- Refine Popover Dropdown (Screenshot 2: "By rating", 1..5 stars, Apply button) -->
              <div
                class="wm-reviews__popover wm-reviews__popover--refine"
                data-refine-popover
                role="dialog"
                aria-label="Filter reviews by rating"
                hidden
              >
                <div class="wm-reviews__popover-header">
                  <span>By rating</span>
                  <button type="button" class="wm-reviews__popover-close-btn" data-reviews-popover-close aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="M12 4L4 12M4 4l8 8"></path>
                    </svg>
                  </button>
                </div>
                <div class="wm-reviews__refine-list">
                  {%- for star in (1..5) -%}
                    <label class="wm-reviews__refine-item" for="RefineStar-{{ section.id }}-{{ star }}">
                      <input
                        type="checkbox"
                        id="RefineStar-{{ section.id }}-{{ star }}"
                        class="wm-reviews__refine-checkbox"
                        value="{{ star }}"
                        data-refine-checkbox="{{ star }}"
                      >
                      <span class="wm-reviews__refine-custom-check" aria-hidden="true">
                        <svg class="wm-reviews__refine-check-icon" width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="3 8.5 6.5 12 13 4"></polyline>
                        </svg>
                      </span>
                      <span class="wm-reviews__refine-label">
                        <span class="wm-reviews__refine-star-num">{{ star }}</span>
                        <span class="wm-reviews__refine-star-icon">★</span>
                        <span class="wm-reviews__refine-star-count" data-refine-star-count="{{ star }}">(0)</span>
                      </span>
                    </label>
                  {%- endfor -%}
                </div>
                <button
                  type="button"
                  class="wm-reviews__popover-apply-btn"
                  data-refine-apply-btn
                >
                  Apply
                </button>
              </div>
            </div>

            <!-- Sort Dropdown Popover -->
            <div class="wm-reviews__ctrl-wrapper" data-sort-dropdown-wrap>
              <button
                type="button"
                class="wm-reviews__pill-btn wm-reviews__sort-btn"
                data-sort-toggle-btn
                aria-expanded="false"
                aria-haspopup="dialog"
                aria-label="Sort reviews"
              >
                <svg class="wm-reviews__ctrl-icon" width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 4v12M3 8l4-4 4 4M13 16V4M9 12l4 4 4-4"></path>
                </svg>
                <span>Sort</span>
              </button>

              <!-- Sort Popover Dropdown -->
              <div
                class="wm-reviews__popover wm-reviews__popover--sort"
                data-sort-popover
                role="dialog"
                aria-label="Sort reviews options"
                hidden
              >
                <div class="wm-reviews__popover-header">
                  <span>Sort by</span>
                  <button type="button" class="wm-reviews__popover-close-btn" data-reviews-popover-close aria-label="Close">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="M12 4L4 12M4 4l8 8"></path>
                    </svg>
                  </button>
                </div>
                <div class="wm-reviews__sort-list">
                  <label class="wm-reviews__sort-item">
                    <input type="radio" name="review_sort_{{ section.id }}" value="recent" checked class="wm-reviews__sort-radio" data-sort-radio="recent">
                    <span class="wm-reviews__sort-custom-radio" aria-hidden="true"></span>
                    <span class="wm-reviews__sort-label">Most recent</span>
                  </label>
                  <label class="wm-reviews__sort-item">
                    <input type="radio" name="review_sort_{{ section.id }}" value="highest" class="wm-reviews__sort-radio" data-sort-radio="highest">
                    <span class="wm-reviews__sort-custom-radio" aria-hidden="true"></span>
                    <span class="wm-reviews__sort-label">Highest rating</span>
                  </label>
                  <label class="wm-reviews__sort-item">
                    <input type="radio" name="review_sort_{{ section.id }}" value="lowest" class="wm-reviews__sort-radio" data-sort-radio="lowest">
                    <span class="wm-reviews__sort-custom-radio" aria-hidden="true"></span>
                    <span class="wm-reviews__sort-label">Lowest rating</span>
                  </label>
                  <label class="wm-reviews__sort-item">
                    <input type="radio" name="review_sort_{{ section.id }}" value="oldest" class="wm-reviews__sort-radio" data-sort-radio="oldest">
                    <span class="wm-reviews__sort-custom-radio" aria-hidden="true"></span>
                    <span class="wm-reviews__sort-label">Oldest</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} Status / Notification Toast Banner {%- endcomment -%}
        <div
          class="wm-reviews__status-banner"
          role="status"
          aria-live="polite"
          data-review-status-banner
          hidden
        ></div>

        {%- comment -%} Main Two-Column Layout (Matching Screenshot 1) {%- endcomment -%}
        <div class="wm-reviews__main-grid">
          <!-- LEFT COLUMN: Overall rating & 5-Star Distribution -->
          <div class="wm-reviews__summary-col">
            <h3 class="wm-reviews__summary-eyebrow">Overall rating</h3>
            <div class="wm-reviews__score-row">
              {%- assign half_score = rating_val | times: 2.0 | round | divided_by: 2.0 -%}
              {%- assign half_mod = half_score | modulo: 1 -%}
              <span class="wm-reviews__big-score" data-reviews-avg>
                {%- if rating_count > 0 -%}
                  {%- if half_mod == 0 -%}{{ half_score | round }}{%- else -%}{{ half_score }}{%- endif -%}
                {%- else -%}
                  0
                {%- endif -%}
              </span>
              <div class="wm-reviews__stars-wrap">
                <div class="wm-reviews__stars" data-reviews-stars aria-hidden="true" aria-label="{% if rating_count > 0 %}{% if half_mod == 0 %}{{ half_score | round }}{% else %}{{ half_score }}{% endif %} out of 5 stars{% else %}0 out of 5 stars{% endif %}">
                  {%- for i in (1..5) -%}
                    {%- assign star_diff = half_score | minus: i -%}
                    <span class="wm-reviews__star-symbol{% if rating_count > 0 and star_diff >= 0 %} is-filled{% elsif rating_count > 0 and star_diff >= -0.5 %} is-half{% else %} is-empty{% endif %}">★</span>
                  {%- endfor -%}
                </div>
              </div>
            </div>

            <!-- 5-to-1 Star Distribution Breakdown -->
            <div class="wm-reviews__bars" aria-label="Rating distribution from 5 stars to 1 star">
              {%- for star in (1..5) reversed -%}
                <div class="wm-reviews__bar-row" data-star-bar-row="{{ star }}">
                  <span class="wm-reviews__bar-label">{{ star }} <span class="wm-reviews__bar-star">★</span></span>
                  <div class="wm-reviews__bar-track">
                    <div class="wm-reviews__bar-fill" data-star-bar-fill="{{ star }}" style="width: 0%;"></div>
                  </div>
                  <button
                    type="button"
                    class="wm-reviews__bar-count"
                    data-star-bar-count="{{ star }}"
                    title="Filter by {{ star }} star reviews"
                  >
                    0
                  </button>
                </div>
              {%- endfor -%}
            </div>

            <button
              type="button"
              class="wm-reviews__write-btn"
              data-review-modal-trigger
              aria-haspopup="dialog"
            >
              Write a review
            </button>
          </div>

          <!-- RIGHT COLUMN: Customer Reviews List & Empty State -->
          <div class="wm-reviews__list-col" data-reviews-list-col>
            <div class="wm-reviews__filter-feedback" data-reviews-filter-feedback hidden>
              <span data-reviews-filter-feedback-text>Showing filtered reviews</span>
              <button type="button" class="wm-reviews__clear-filter-btn" data-reviews-clear-filter>Clear filter</button>
            </div>

            <div
              class="wm-reviews__empty"
              data-reviews-empty-state
              hidden
            >
              <h4 class="wm-reviews__empty-title">No reviews found</h4>
              <p class="wm-reviews__empty-text">Be the first to share your thoughts on this product.</p>
              <button
                type="button"
                class="wm-reviews__empty-cta"
                data-review-modal-trigger
              >
                Write a review
              </button>
            </div>

            <div class="wm-reviews__list" data-reviews-list></div>

            <div class="wm-reviews__load-more-wrap" data-reviews-load-more-wrap hidden>
              <button
                type="button"
                class="wm-reviews__load-more-btn"
                data-reviews-load-more
              >
                Show more reviews
              </button>
            </div>
          </div>
        </div>

        {%- comment -%} WRITE A REVIEW POPUP MODAL (User explicit requirement: "write revew click popup modul open okey") {%- endcomment -%}
        <div
          class="wm-review-modal"
          id="wm-review-modal-{{ section.id }}"
          role="dialog"
          aria-modal="true"
          aria-labelledby="ReviewModalTitle-{{ section.id }}"
          data-review-modal
          hidden
        >
          <div class="wm-review-modal__backdrop" data-review-modal-close tabindex="-1"></div>
          <div class="wm-review-modal__dialog" role="document">
            <div class="wm-review-modal__header">
              <h3 class="wm-review-modal__title" id="ReviewModalTitle-{{ section.id }}" data-review-modal-title>
                Write a review
              </h3>
              <button
                type="button"
                class="wm-review-modal__close-btn"
                aria-label="Close dialog"
                data-review-modal-close
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            <form class="wm-review-form" data-review-form novalidate>
              <input type="hidden" name="editing_id" data-review-editing-id value="">

              <!-- Rating Selection -->
              <div class="wm-review-form__field">
                <label class="wm-review-form__label" id="ModalStarLabel-{{ section.id }}">
                  Overall rating <span class="wm-review-form__req" aria-hidden="true">*</span>
                </label>
                <div class="wm-star-picker-row">
                  <div
                    class="wm-star-picker"
                    role="radiogroup"
                    aria-labelledby="ModalStarLabel-{{ section.id }}"
                    data-star-picker
                  >
                    {%- for i in (1..5) -%}
                      <button
                        type="button"
                        role="radio"
                        aria-checked="{% if i == 5 %}true{% else %}false{% endif %}"
                        class="wm-star-picker__btn is-selected"
                        data-star-value="{{ i }}"
                        aria-label="{{ i }} out of 5 stars"
                      >
                        <svg class="wm-star-picker__star-icon" width="24" height="24" viewBox="0 0 24 24" fill="#FFA41C" stroke="none" aria-hidden="true">
                          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                        </svg>
                      </button>
                    {%- endfor -%}
                    <input type="hidden" name="rating" value="5" data-star-input>
                  </div>
                  <span class="wm-star-picker__caption" data-star-rating-text>5 out of 5 stars</span>
                </div>
              </div>

              <!-- First Name & Last Name (Removed Pet Breed & Coat as instructed) -->
              <div class="wm-review-form__row">
                <div class="wm-review-form__field">
                  <label for="ModalFirstName-{{ section.id }}" class="wm-review-form__label">
                    First Name <span class="wm-review-form__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    type="text"
                    id="ModalFirstName-{{ section.id }}"
                    name="first_name"
                    required
                    autocomplete="given-name"
                    class="wm-review-form__input"
                    placeholder="e.g. Rahul"
                    value="{% if customer %}{{ customer.first_name | escape }}{% endif %}"
                  >
                  <span class="wm-review-form__field-error" data-field-error="first_name" hidden>First name is required</span>
                </div>
                <div class="wm-review-form__field">
                  <label for="ModalLastName-{{ section.id }}" class="wm-review-form__label">
                    Last Name <span class="wm-review-form__req" aria-hidden="true">*</span>
                  </label>
                  <input
                    type="text"
                    id="ModalLastName-{{ section.id }}"
                    name="last_name"
                    required
                    autocomplete="family-name"
                    class="wm-review-form__input"
                    placeholder="e.g. Sharma"
                    value="{% if customer %}{{ customer.last_name | escape }}{% endif %}"
                  >
                  <span class="wm-review-form__field-error" data-field-error="last_name" hidden>Last name is required</span>
                </div>
              </div>

              <!-- Email Field (Required by Judge.me) -->
              <div class="wm-review-form__field">
                <label for="ModalEmail-{{ section.id }}" class="wm-review-form__label">
                  Email Address <span class="wm-review-form__req" aria-hidden="true">*</span>
                </label>
                <input
                  type="email"
                  id="ModalEmail-{{ section.id }}"
                  name="email"
                  required
                  autocomplete="email"
                  class="wm-review-form__input"
                  placeholder="you@example.com"
                  value="{% if customer %}{{ customer.email | escape }}{% endif %}"
                >
                <span class="wm-review-form__field-error" data-field-error="email" hidden>Please enter a valid email address</span>
                <p class="wm-review-form__hint" style="font-size: 12px; color: #6b7280; margin-top: 4px; margin-bottom: 0;">
                  Required by Judge.me to verify your review. We never spam.
                </p>
              </div>

              <!-- Review Title -->
              <div class="wm-review-form__field">
                <label for="ModalTitle-{{ section.id }}" class="wm-review-form__label">
                  Review Headline <span class="wm-review-form__req" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="ModalTitle-{{ section.id }}"
                  name="title"
                  required
                  class="wm-review-form__input"
                  placeholder="Give your review a title"
                >
                <span class="wm-review-form__field-error" data-field-error="title" hidden>Review headline is required</span>
              </div>

              <!-- Review Body -->
              <div class="wm-review-form__field">
                <label for="ModalBody-{{ section.id }}" class="wm-review-form__label">
                  Your Review <span class="wm-review-form__req" aria-hidden="true">*</span>
                </label>
                <textarea
                  id="ModalBody-{{ section.id }}"
                  name="body"
                  rows="4"
                  required
                  class="wm-review-form__textarea"
                  placeholder="Write your review here... How did your pet react to this product?"
                ></textarea>
                <span class="wm-review-form__field-error" data-field-error="body" hidden>Review is required</span>
              </div>

              <!-- Actions -->
              <div class="wm-review-form__actions">
                <button
                  type="submit"
                  class="wm-review-form__submit-btn"
                  data-review-submit-btn
                >
                  <span data-review-submit-text>Submit Review</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "class": "section-product-tabs",
  "settings": [
    {
      "type": "checkbox",
      "id": "use_product_description",
      "label": "Use Shopify product description HTML when present",
      "default": true
    },
    {
      "type": "text",
      "id": "desc_heading",
      "label": "Custom description heading (optional)"
    },
    {
      "type": "textarea",
      "id": "desc_lead",
      "label": "Custom description lead (optional)"
    },
    {
      "type": "textarea",
      "id": "desc_paragraph_1",
      "label": "Additional paragraph 1 (optional)"
    },
    {
      "type": "textarea",
      "id": "desc_paragraph_2",
      "label": "Additional paragraph 2 (optional)"
    },
    {
      "type": "text",
      "id": "highlight_1",
      "label": "Custom highlight bullet 1 (optional)"
    },
    {
      "type": "text",
      "id": "highlight_2",
      "label": "Custom highlight bullet 2 (optional)"
    },
    {
      "type": "text",
      "id": "highlight_3",
      "label": "Custom highlight bullet 3 (optional)"
    },
    {
      "type": "text",
      "id": "specs_heading",
      "label": "Specifications heading",
      "default": "Technical Specifications"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "spec_row",
      "name": "Specification row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Specification label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Specification value"
        }
      ]
    },
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer name",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "pet",
          "label": "Pet details or buyer badge (optional)",
          "default": "Verified Buyer"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating (stars)",
          "default": 5
        },
        {
          "type": "text",
          "id": "date",
          "label": "Review date"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review headline"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Tabs"
    }
  ]
}
{% endschema %}
