{% comment %}
  ============================================================================
  Wagmart "Shop by Need / Bundles" Bento Grid Section
  - Exact reference layout reproduction with 6 asymmetrical cards
  - Top row: Card 1 (6 cols), Card 2 (3 cols), Card 3 (3 cols)
  - Bottom row: Card 4 (3 cols), Card 5 (3 cols), Card 6 (6 cols)
  ============================================================================
{% endcomment %}

{{ 'bento-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign base_all_url = routes.all_products_collection_url | default: '/collections/all'

  assign url_1 = section.settings.link_1 | default: ''
  if url_1 == blank
    assign url_1 = base_all_url | append: '?category=Dog+Food&title=Dog+Nutrition'
  endif

  assign url_2 = section.settings.link_2 | default: ''
  if url_2 == blank
    assign url_2 = base_all_url | append: '?category=Accessories&title=New+Pet+Parents'
  endif

  assign url_3 = section.settings.link_3 | default: ''
  if url_3 == blank
    assign url_3 = base_all_url | append: '?category=Toys&title=Toys+%26+Treats'
  endif

  assign url_4 = section.settings.link_4 | default: ''
  if url_4 == blank
    assign url_4 = base_all_url | append: '?category=Accessories&title=Dog+Essentials'
  endif

  assign url_5 = section.settings.link_5 | default: ''
  if url_5 == blank
    assign url_5 = base_all_url | append: '?pet=cat&title=Cat+Care'
  endif

  assign url_6 = section.settings.link_6 | default: ''
  if url_6 == blank
    assign url_6 = base_all_url | append: '?category=Dog+Food&title=Food+%26+Treats'
  endif

  for col in collections
    if col.products.size > 0 and col.handle != 'all' and col.handle != 'frontpage'
      assign ch = col.handle | downcase
      assign ct = col.title | downcase
      if ch contains 'dog-food' or ct contains 'dog food'
        assign url_1 = col.url
        assign url_6 = col.url
      elsif ch contains 'toy' or ct contains 'toy'
        assign url_3 = col.url
      elsif ch contains 'cat' or ct contains 'cat'
        assign url_5 = col.url
      elsif ch contains 'access' or ch contains 'essential'
        assign url_4 = col.url
      endif
    endif
  endfor
-%}

<section
  id="bundles"
  class="wm-bento-section scroll-mt-20"
  aria-label="Pet Products Bento Grid"
>
  <div class="wm-bento-container">
    <div class="wm-bento-grid">
      
      {% comment %} ==================== ROW 1: CARD 1 (Top-Left Large) ==================== {% endcomment %}
      <a
        href="{{ url_1 }}"
        class="wm-bento-card wm-bento-card--1"
        aria-label="Dog Nutrition — Subscribe to dog food"
      >
        <img
          src="{{ 'bento-grid-1.webp' | asset_url }}"
          alt="Golden retriever with dog treats"
          class="wm-bento-card__bg-img"
          loading="eager"
          width="1539"
          height="1022"
        >
        <div class="wm-bento-card__overlay wm-bento-card__overlay--card1"></div>
        <div class="wm-bento-card__content">
          <span class="wm-bento-card__category">Dog Nutrition</span>
          <h2 class="wm-bento-card__title">
            Subscribe to<br>dog food.
          </h2>
          <p class="wm-bento-card__desc">
            Healthy meals, on schedule, for a happier, brighter dog.
          </p>
          <span class="wm-bento-card__cta">Shop food</span>
        </div>
      </a>

      {% comment %} ==================== ROW 1: CARD 2 (Top-Center Portrait) ==================== {% endcomment %}
      <a
        href="{{ url_2 }}"
        class="wm-bento-card wm-bento-card--2"
        aria-label="New Pet Parents — Everything for week one"
      >
        <img
          src="{{ 'bento-grid-2.webp' | asset_url }}"
          alt="Puppy resting cozily in knit blanket"
          class="wm-bento-card__bg-img"
          loading="lazy"
          width="1156"
          height="1360"
        >
        <div class="wm-bento-card__overlay wm-bento-card__overlay--card2"></div>
        <div class="wm-bento-card__content">
          <span class="wm-bento-card__category">New Pet Parents</span>
          <h3 class="wm-bento-card__title">
            Everything for week one.
          </h3>
          <p class="wm-bento-card__desc">
            Food, bowls, beds and toys &mdash; all in one place.
          </p>
          <span class="wm-bento-card__cta">Shop the set</span>
        </div>
      </a>

      {% comment %} ==================== ROW 1: CARD 3 (Top-Right Portrait) ==================== {% endcomment %}
      <a
        href="{{ url_3 }}"
        class="wm-bento-card wm-bento-card--3"
        aria-label="Toys & Treats — Playtime made better"
      >
        <img
          src="{{ 'bento-grid-3.webp' | asset_url }}"
          alt="Puppy with playful rope toy"
          class="wm-bento-card__bg-img"
          loading="lazy"
          width="1156"
          height="1360"
        >
        <div class="wm-bento-card__overlay wm-bento-card__overlay--card3"></div>
        <div class="wm-bento-card__content">
          <span class="wm-bento-card__category">Toys &amp; Treats</span>
          <h3 class="wm-bento-card__title">
            Playtime<br>made better.
          </h3>
          <p class="wm-bento-card__desc">
            Toys, treats and more for everyday joy.
          </p>
          <span class="wm-bento-card__cta">Shop now</span>
        </div>
      </a>

      {% comment %} ==================== ROW 2: CARD 4 (Bottom-Left Portrait) ==================== {% endcomment %}
      <a
        href="{{ url_4 }}"
        class="wm-bento-card wm-bento-card--4"
        aria-label="Dog Essentials — Everyday essentials"
      >
        <img
          src="{{ 'bento-grid-4.webp' | asset_url }}"
          alt="Playful dog with rope knot toy"
          class="wm-bento-card__bg-img"
          loading="lazy"
          width="1156"
          height="1360"
        >
        <div class="wm-bento-card__overlay wm-bento-card__overlay--card4"></div>
        <div class="wm-bento-card__content">
          <span class="wm-bento-card__category">Dog Essentials</span>
          <h3 class="wm-bento-card__title">
            Everyday essentials.
          </h3>
          <p class="wm-bento-card__desc">
            Toys, beds, leashes and more for real-life adventures.
          </p>
          <span class="wm-bento-card__cta">Shop essentials</span>
        </div>
      </a>

      {% comment %} ==================== ROW 2: CARD 5 (Bottom-Center Portrait) ==================== {% endcomment %}
      <a
        href="{{ url_5 }}"
        class="wm-bento-card wm-bento-card--5"
        aria-label="Cat Care — Happier cats. Longer naps."
      >
        <img
          src="{{ 'bento-grid-5.webp' | asset_url }}"
          alt="Cat being gently groomed with wooden brush"
          class="wm-bento-card__bg-img"
          loading="lazy"
          width="1156"
          height="1360"
        >
        <div class="wm-bento-card__overlay wm-bento-card__overlay--card5"></div>
        <div class="wm-bento-card__content">
          <span class="wm-bento-card__category">Cat Care</span>
          <h3 class="wm-bento-card__title">
            Happier cats.<br>Longer naps.
          </h3>
          <p class="wm-bento-card__desc">
            Grooming, wellness and daily care for a calmer, happier cat.
          </p>
          <span class="wm-bento-card__cta">Shop cat care</span>
        </div>
      </a>

      {% comment %} ==================== ROW 2: CARD 6 (Bottom-Right Large) ==================== {% endcomment %}
      <a
        href="{{ url_6 }}"
        class="wm-bento-card wm-bento-card--6"
        aria-label="Food & Treats — Real ingredients for happy pets"
      >
        <img
          src="{{ 'bento-grid-6.webp' | asset_url }}"
          alt="Bowl of pet food with dog paw reaching"
          class="wm-bento-card__bg-img"
          loading="lazy"
          width="1539"
          height="1022"
        >
        <div class="wm-bento-card__overlay wm-bento-card__overlay--card6"></div>
        <div class="wm-bento-card__content">
          <span class="wm-bento-card__category">Food &amp; Treats</span>
          <h2 class="wm-bento-card__title">
            Real ingredients<br>for happy pets.
          </h2>
          <p class="wm-bento-card__desc">
            Nutritious food and tasty treats they'll love.
          </p>
          <span class="wm-bento-card__cta">Shop food &amp; treats</span>
        </div>
      </a>

    </div>
  </div>
</section>

