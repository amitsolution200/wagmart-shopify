{% comment %}
  Wagmart Classic Customer Login & Password Recovery Section
  Matches Wagmart design tokens: #7A46E5 primary, #F5F2EF cream, Lucide icons
{% endcomment %}

<style>
  .wm-auth-section {
    background-color: #FBF9F7;
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px 80px;
    font-family: inherit;
  }

  .wm-auth-container {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .wm-auth-card {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
    padding: 40px 36px;
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 480px) {
    .wm-auth-card {
      padding: 32px 24px;
      border-radius: 16px;
    }
  }

  .wm-auth-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .wm-auth-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #F5F2EF;
    color: #4F463E;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 14px;
  }

  .wm-auth-title {
    font-size: 28px;
    font-weight: 800;
    color: #18181B;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .wm-auth-subtitle {
    font-size: 14px;
    color: #71717A;
    margin: 0;
    line-height: 1.5;
  }

  .wm-auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .wm-auth-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .wm-auth-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .wm-auth-label {
    font-size: 13.5px;
    font-weight: 700;
    color: #27272A;
  }

  .wm-auth-forgot-link {
    font-size: 13px;
    color: #7A46E5;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.15s ease;
    cursor: pointer;
  }

  .wm-auth-forgot-link:hover {
    color: #6333C4;
    text-decoration: underline;
  }

  .wm-auth-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .wm-auth-input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    border: 1.5px solid #E4E4E7;
    border-radius: 12px;
    font-size: 14.5px;
    color: #18181B;
    background-color: #FAFAFA;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    font-family: inherit;
    box-sizing: border-box;
  }

  .wm-auth-input:focus {
    outline: none;
    border-color: #7A46E5;
    background-color: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(122, 70, 229, 0.15);
  }

  .wm-auth-input--password {
    padding-right: 46px;
  }

  .wm-auth-eye-btn {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #71717A;
    cursor: pointer;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: color 0.15s ease;
  }

  .wm-auth-eye-btn:hover {
    color: #18181B;
  }

  .wm-auth-submit-btn {
    width: 100%;
    height: 50px;
    background-color: transparent;
    color: #000000;
    border: 2px solid #000000;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 6px;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.1s ease;
    box-shadow: none;
    font-family: inherit;
  }

  .wm-auth-submit-btn:hover {
    background-color: #000000;
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .wm-auth-submit-btn:active {
    transform: translateY(0);
  }

  .wm-auth-cancel-btn {
    width: 100%;
    height: 46px;
    background-color: #F4F4F5;
    color: #3F3F46;
    border: 1px solid #E4E4E7;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease;
    font-family: inherit;
  }

  .wm-auth-cancel-btn:hover {
    background-color: #E4E4E7;
  }

  .wm-auth-alert {
    padding: 12px 16px;
    border-radius: 10px;
    font-size: 13.5px;
    margin-bottom: 20px;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    line-height: 1.4;
  }

  .wm-auth-alert--error {
    background-color: #FEF2F2;
    border: 1px solid #FECACA;
    color: #991B1B;
  }

  .wm-auth-alert--success {
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    color: #065F46;
  }

  .wm-auth-alert svg {
    flex-shrink: 0;
    margin-top: 1px;
  }

  .wm-auth-footer {
    text-align: center;
    margin-top: 24px;
    padding-top: 22px;
    border-top: 1px solid #F4F4F5;
    font-size: 14px;
    color: #71717A;
  }

  .wm-auth-footer a {
    color: #7A46E5;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .wm-auth-footer a:hover {
    color: #6333C4;
    text-decoration: underline;
  }

  .wm-auth-panel {
    display: none;
  }

  .wm-auth-panel.is-active {
    display: block;
  }
</style>

<section class="wm-auth-section">
  <div class="wm-auth-container">
    
    <div class="wm-auth-card">

      {% comment %} 1. LOGIN PANEL {% endcomment %}
      <div id="WmCustomerLoginPanel" class="wm-auth-panel is-active">
        
        <div class="wm-auth-header">
          <div class="wm-auth-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
            </svg>
            <span>Wagmart Account</span>
          </div>
          <h1 class="wm-auth-title">{{ section.settings.login_title | default: 'Welcome Back' }}</h1>
          <p class="wm-auth-subtitle">{{ section.settings.login_subtitle | default: 'Sign in to access your orders, pet profiles, and saved details.' }}</p>
        </div>

        {%- form 'customer_login', id: 'CustomerLoginForm', class: 'wm-auth-form' -%}

          {%- if form.errors -%}
            <div class="wm-auth-alert wm-auth-alert--error" role="alert">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <div>{{ form.errors | default_errors }}</div>
            </div>
          {%- endif -%}

          <div class="wm-auth-field">
            <label for="CustomerEmail" class="wm-auth-label">Email Address <span style="color:#EF4444;">*</span></label>
            <div class="wm-auth-input-wrap">
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                placeholder="you@example.com"
                class="wm-auth-input"
              >
            </div>
          </div>

          <div class="wm-auth-field">
            <div class="wm-auth-label-row">
              <label for="CustomerPassword" class="wm-auth-label">Password <span style="color:#EF4444;">*</span></label>
              <button type="button" class="wm-auth-forgot-link" id="WmShowRecoverBtn">Forgot password?</button>
            </div>
            <div class="wm-auth-input-wrap">
              <input
                type="password"
                name="customer[password]"
                id="CustomerPassword"
                autocomplete="current-password"
                required
                placeholder="Enter your password"
                class="wm-auth-input wm-auth-input--password"
              >
              <button type="button" class="wm-auth-eye-btn" data-toggle-password="CustomerPassword" aria-label="Toggle password visibility">
                <svg class="wm-eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                <svg class="wm-eye-closed" style="display:none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m15 18-.722-3.25"/><path d="M2 8a10.645 10.645 0 0 0 20 0"/><path d="m20 15-1.726-2.05"/><path d="m4 15 1.726-2.05"/><path d="m9 18 .722-3.25"/>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" class="wm-auth-submit-btn">
            <span>Sign In</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </button>

        {%- endform -%}

        <div class="wm-auth-footer">
          Don't have an account? <a href="{{ routes.account_register_url }}">Create one now</a>
        </div>

      </div>

      {% comment %} 2. FORGOT PASSWORD RECOVERY PANEL {% endcomment %}
      <div id="WmCustomerRecoverPanel" class="wm-auth-panel">
        
        <div class="wm-auth-header">
          <div class="wm-auth-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>Password Recovery</span>
          </div>
          <h2 class="wm-auth-title">Reset Password</h2>
          <p class="wm-auth-subtitle">Enter your email and we'll send you instructions to reset your password.</p>
        </div>

        {%- form 'recover_customer_password', id: 'RecoverCustomerPasswordForm', class: 'wm-auth-form' -%}

          {%- if form.posted_successfully? -%}
            <div class="wm-auth-alert wm-auth-alert--success" role="status">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
              </svg>
              <div>We've sent an email with a link to update your password.</div>
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="wm-auth-alert wm-auth-alert--error" role="alert">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              <div>{{ form.errors | default_errors }}</div>
            </div>
          {%- endif -%}

          <div class="wm-auth-field">
            <label for="RecoverEmail" class="wm-auth-label">Email Address <span style="color:#EF4444;">*</span></label>
            <div class="wm-auth-input-wrap">
              <input
                type="email"
                name="email"
                id="RecoverEmail"
                autocorrect="off"
                autocapitalize="off"
                required
                placeholder="you@example.com"
                class="wm-auth-input"
              >
            </div>
          </div>

          <button type="submit" class="wm-auth-submit-btn">
            <span>Send Reset Instructions</span>
          </button>

          <button type="button" class="wm-auth-cancel-btn" id="WmHideRecoverBtn">
            Cancel
          </button>

        {%- endform -%}

      </div>

    </div>

  </div>
</section>

<script>
  (function() {
    var loginPanel = document.getElementById('WmCustomerLoginPanel');
    var recoverPanel = document.getElementById('WmCustomerRecoverPanel');
    var showRecoverBtn = document.getElementById('WmShowRecoverBtn');
    var hideRecoverBtn = document.getElementById('WmHideRecoverBtn');

    function showRecover() {
      if (loginPanel && recoverPanel) {
        loginPanel.classList.remove('is-active');
        recoverPanel.classList.add('is-active');
      }
    }

    function showLogin() {
      if (loginPanel && recoverPanel) {
        recoverPanel.classList.remove('is-active');
        loginPanel.classList.add('is-active');
      }
    }

    if (showRecoverBtn) {
      showRecoverBtn.addEventListener('click', function(e) {
        e.preventDefault();
        showRecover();
        window.location.hash = '#recover';
      });
    }

    if (hideRecoverBtn) {
      hideRecoverBtn.addEventListener('click', function(e) {
        e.preventDefault();
        showLogin();
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname);
        }
      });
    }

    if (window.location.hash === '#recover') {
      showRecover();
    }

    // Password visibility toggles
    document.querySelectorAll('[data-toggle-password]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var inputId = btn.getAttribute('data-toggle-password');
        var input = document.getElementById(inputId);
        if (!input) return;
        var openIcon = btn.querySelector('.wm-eye-open');
        var closedIcon = btn.querySelector('.wm-eye-closed');

        if (input.type === 'password') {
          input.type = 'text';
          if (openIcon) openIcon.style.display = 'none';
          if (closedIcon) closedIcon.style.display = 'block';
        } else {
          input.type = 'password';
          if (openIcon) openIcon.style.display = 'block';
          if (closedIcon) closedIcon.style.display = 'none';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Customer Login",
  "settings": [
    {
      "type": "text",
      "id": "login_title",
      "label": "Login Title",
      "default": "Welcome Back"
    },
    {
      "type": "text",
      "id": "login_subtitle",
      "label": "Login Subtitle",
      "default": "Sign in to access your orders, pet profiles, and saved details."
    }
  ]
}
{% endschema %}
