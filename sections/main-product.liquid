    class="wm-lightbox"
    id="ProductLightbox-{{ section.id }}"
    aria-label="{{ 'products.product.media.gallery_label' | t }}"
    data-gallery-lightbox
  >
    <div class="wm-lightbox__inner">
      <div class="wm-lightbox__topbar">
        <span class="wm-lightbox__counter" data-lightbox-counter>1 / {{ slide_idx | default: 1 }}</span>
        <button
          type="button"
          class="wm-lightbox__close"
          data-lightbox-close
          aria-label="{{ 'products.product.media.close_lightbox' | t }}"
        >
          {% render 'icon', name: 'close', size: 22 %}
        </button>
      </div>

      <div class="wm-lightbox__stage">
        <button
          type="button"
          class="wm-lightbox__nav wm-lightbox__nav--prev"
          data-lightbox-prev
          aria-label="{{ 'products.product.media.previous' | t }}"
        >
          {% render 'icon', name: 'chevron-left', size: 24 %}
        </button>

        <figure class="wm-lightbox__figure">
          {%- assign lightbox_initial_src = product.featured_media.preview_image | image_url: width: 1600 | default: fallback_glove_img -%}
          <img
            src="{{ lightbox_initial_src }}"
            alt="{{ prod_title | escape }}"
            width="{{ product.featured_media.preview_image.width | default: 1200 }}"
            height="{{ product.featured_media.preview_image.height | default: 1200 }}"
            class="wm-lightbox__img"
            data-lightbox-img
          >
        </figure>

        <button
          type="button"
          class="wm-lightbox__nav wm-lightbox__nav--next"
          data-lightbox-next
          aria-label="{{ 'products.product.media.next' | t }}"
        >
          {% render 'icon', name: 'chevron-right', size: 24 %}
        </button>
      </div>
    </div>
  </dialog>

  {%- comment -%} 10. Sticky Add to Cart Floating Card (Matches Reference Image 1: Product Title + ₹ Price on left, + Add / - 1 + Stepper on right) {%- endcomment -%}
  <div
    class="wm-sticky-bar"
    id="StickyAtcBar-{{ section.id }}"
    data-sticky-bar
    aria-hidden="true"
  >
    <div class="wm-sticky-bar__card">
      {%- liquid
        assign sticky_raw_price = current_variant.price | default: product.price | default: 33000
        assign sticky_price_inr = sticky_raw_price | divided_by: 100.0 | round
        if current_variant.compare_at_price > sticky_raw_price
          assign sticky_comp_inr = current_variant.compare_at_price | divided_by: 100.0 | round
        else
          assign sticky_comp_inr = sticky_price_inr | times: 125 | divided_by: 100.0 | round
        endif
      -%}
      <div class="wm-sticky-bar__meta">
        <p class="wm-sticky-bar__title">{{ prod_title }}</p>
        <div class="wm-sticky-bar__price-row" data-sticky-price>
          <span class="wm-sticky-bar__price" data-price-current>₹{{ sticky_price_inr }}</span>
          <s class="wm-sticky-bar__compare" data-price-compare>₹{{ sticky_comp_inr }}</s>
        </div>
      </div>

      <div class="wm-sticky-bar__actions">
        <button
          type="button"
          class="wm-sticky-bar__btn"
          data-sticky-atc-trigger
          data-text-default="+ Add"
          data-text-sold-out="{{ 'products.product.sold_out' | t | escape }}"
          {% unless is_available %}disabled{% endunless %}
        >
          <span data-sticky-atc-text>
            {%- if is_available -%}
              + Add
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>

        <div class="wm-sticky-bar__stepper" data-sticky-atc-stepper hidden>
          <button
            type="button"
            class="wm-sticky-bar__stepper-btn"
            data-sticky-atc-delta="-1"
            aria-label="{{ 'products.product.quantity.decrease' | t }}"
          >
            −
          </button>
          <span class="wm-sticky-bar__stepper-val" data-sticky-atc-qty>1</span>
          <button
            type="button"
            class="wm-sticky-bar__stepper-btn"
            data-sticky-atc-delta="1"
            aria-label="{{ 'products.product.quantity.increase' | t }}"
          >
            +
          </button>
        </div>
      </div>
    </div>
  </div>
</product-page>

<script src="{{ 'product.js' | asset_url }}" defer></script>

