{% comment %}
  Wagmart Shopify Product Details Page (sections/main-product.liquid)
  Converted from React ProductDetailsPage component & fully responsive across all devices:
  - Mobile / Tablet (< 1024px): Infinity loop touch/drag image slider with pill/dot indicators
  - Laptop / Desktop (>= 1024px): Vertically stacked square rounded-[20px] images on left, sticky info panel on right
  - Category, Title + Wishlist Heart button, Price in Rupees (₹), Short Description
  - NO Size / Material dropdowns
  - Only Two Buttons:
    1) "Add to Cart" button -> clicking transforms into [- qty +] stepper synced with Shopify Cart
    2) "Buy Now" button below -> redirects to /checkout
  - Three Accordions:
    1) Product Description (open by default)
    2) Specifications
    3) Benefits (text only, no icons)
{% endcomment %}

{{ 'product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign prod_title = product.title | default: 'Pet Grooming Glove'
  assign prod_category = product.type
  if prod_category == blank and product.collections.first != blank
    assign prod_category = product.collections.first.title
  endif
  if prod_category == blank
    assign prod_category = 'Pet Care'
  endif

  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign prod_id = current_variant.id | default: product.id | default: 'pet-grooming-glove'
  assign price_rupees = product.price | default: 33000 | divided_by: 100
  assign compare_rupees = product.compare_at_price | default: 0 | divided_by: 100
  assign is_available = current_variant.available | default: product.available | default: true

  assign inv_mgmt = current_variant.inventory_management
  assign inv_policy = current_variant.inventory_policy
  assign inv_qty = current_variant.inventory_quantity

  if inv_mgmt == blank
    assign track_stock = false
    assign real_stock = 999
  else
    assign track_stock = true
    assign real_stock = inv_qty
  endif

  assign fallback_img_1 = 'catalog-bath-massage-brush.webp' | asset_url

  if product.featured_image != blank
    assign schema_img = product.featured_image | image_url: width: 1000
  else
    assign schema_img = fallback_img_1
  endif

  # IN-CART QUANTITY DETECTION:
  assign in_cart_qty = 0
  for item in cart.items
    assign item_prod_id = item.product_id | default: item.product.id
    assign item_var_id = item.variant_id | default: item.variant.id | default: item.id
    if item_var_id == current_variant.id or item_var_id == prod_id or item_prod_id == product.id or item.handle == product.handle
      assign in_cart_qty = in_cart_qty | plus: item.quantity
    endif
  endfor

  assign short_desc = product.metafields.custom.short_description | default: product.description | strip_html | truncatewords: 28
  if short_desc == blank
    assign short_desc = 'Thoughtfully crafted with pet-safe materials for everyday comfort, gentle care, and lasting durability.'
  endif
-%}

{%- comment -%} JSON-LD Structured Data for SEO {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ prod_title | json }},
  "image": [{{ schema_img | json }}],
  "description": {{ product.description | strip_html | default: prod_title | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: shop.name | json }}
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "INR",
    "price": "{{ price_rupees }}",
    "availability": "https://schema.org/{% if is_available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>

<section
  class="wm-pdp-react px-4 lg:px-8 pt-8 lg:pt-16 pb-16"
  data-wm-pdp
  data-product-id="{{ prod_id }}"
  data-shopify-product-id="{{ product.id }}"
  data-handle="{{ product.handle }}"
  data-product-title="{{ prod_title | escape }}"
  data-base-price="{{ price_rupees }}"
  data-compare-price="{{ compare_rupees }}"
  data-max-stock="{% if track_stock %}{{ real_stock }}{% else %}99{% endif %}"
  data-inventory-tracked="{{ track_stock }}"
  data-in-cart-qty="{{ in_cart_qty }}"
>
  <div class="wm-pdp-react__container max-w-[1250px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">

    {%- comment -%} =========================================================
       LEFT COLUMN:
       - Mobile/Tablet view (< 1024px): Infinity loop slider with pill/dot indicators + thumbnail gallery below
       - Laptop/Desktop view (>= 1024px): Stacked rounded-[20px] images
       ========================================================= {%- endcomment -%}
    <div class="wm-pdp-react__media-col">

      {%- comment -%} Mobile/Tablet view: Infinity loop slider + Gallery Thumbnails below {%- endcomment -%}
      <div class="wm-pdp-react__mobile-slider block lg:hidden relative" data-pdp-slider>
        <div class="wm-pdp-react__slider-stage relative">
          <div class="wm-pdp-react__slider-viewport overflow-hidden rounded-[20px]" data-pdp-slider-viewport>
            <div class="wm-pdp-react__slider-track flex" data-pdp-slider-track>
              {%- if product.images.size > 0 -%}
                {%- for image in product.images -%}
                  {%- assign img_url = image | image_url: width: 1000 -%}
                  <div class="wm-pdp-react__slide min-w-0 shrink-0 basis-full relative" data-pdp-slide="{{ forloop.index0 }}">
                    <div class="wm-pdp-react__image-card relative bg-[#FBFBF7] overflow-hidden rounded-[20px]">
                      <img
                        src="{{ img_url }}"
                        alt="{{ image.alt | default: prod_title | escape }} {{ forloop.index }}"
                        class="wm-pdp-react__img absolute inset-0 w-full h-full object-cover"
                        width="800"
                        height="1000"
                        {% if forloop.first %}id="wm-main-product-image" fetchpriority="high"{% else %}loading="eager"{% endif %}
                        onerror="this.onerror=null;this.src='{{ fallback_img_1 }}';"
                      >
                    </div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                <div class="wm-pdp-react__slide min-w-0 shrink-0 basis-full relative" data-pdp-slide="0">
                  <div class="wm-pdp-react__image-card relative bg-[#FBFBF7] overflow-hidden rounded-[20px]">
                    <img
                      src="{{ schema_img }}"
                      alt="{{ prod_title | escape }}"
                      id="wm-main-product-image"
                      class="wm-pdp-react__img absolute inset-0 w-full h-full object-cover"
                      width="800"
                      height="1000"
                      fetchpriority="high"
                      onerror="this.onerror=null;this.src='{{ fallback_img_1 }}';"
                    >
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Properly centered Dot/pill indicators (only shown if multiple images exist) {%- endcomment -%}
          {%- if product.images.size > 1 -%}
            <div class="wm-pdp-react__dots" data-pdp-dots>
              {%- for image in product.images -%}
                <button
                  type="button"
                  data-pdp-dot="{{ forloop.index0 }}"
                  class="wm-pdp-react__dot h-1.5 rounded-full transition-all duration-300 cursor-pointer{% if forloop.first %} is-active w-6 bg-black{% else %} w-1.5 bg-black/25{% endif %}"
                  aria-label="Go to slide {{ forloop.index }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Gallery thumbnails below main image (only shown if multiple images exist) {%- endcomment -%}
        {%- if product.images.size > 1 -%}
          <div class="wm-pdp-react__thumbs" data-pdp-thumbs role="tablist" aria-label="Product gallery thumbnails">
            {%- for image in product.images -%}
              {%- assign thumb_url = image | image_url: width: 320 -%}
              <button
                type="button"
                class="wm-pdp-react__thumb{% if forloop.first %} is-active{% endif %}"
                data-pdp-thumb="{{ forloop.index0 }}"
                aria-label="View image {{ forloop.index }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <img
                  src="{{ thumb_url }}"
                  alt="{{ image.alt | default: prod_title | escape }} thumbnail {{ forloop.index }}"
                  class="wm-pdp-react__thumb-img"
                  width="160"
                  height="160"
                  loading="eager"
                  onerror="this.onerror=null;this.src='{{ fallback_img_1 }}';"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Laptop/Desktop view: Stacked images {%- endcomment -%}
      <div class="wm-pdp-react__desktop-stack hidden lg:block space-y-4" data-pdp-desktop-stack>
        {%- if product.images.size > 0 -%}
          {%- for image in product.images -%}
            {%- assign img_url = image | image_url: width: 1000 -%}
            <div class="wm-pdp-react__stack-card relative aspect-4/4 rounded-[20px] bg-[#FBFBF7] overflow-hidden">
              <img
                src="{{ img_url }}"
                alt="{{ image.alt | default: prod_title | escape }} {{ forloop.index }}"
                class="wm-pdp-react__img absolute inset-0 w-full h-full object-cover"
                width="900"
                height="900"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                onerror="this.onerror=null;this.src='{{ fallback_img_1 }}';"
              >
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="wm-pdp-react__stack-card relative aspect-4/4 rounded-[20px] bg-[#FBFBF7] overflow-hidden">
            <img
              src="{{ schema_img }}"
              alt="{{ prod_title | escape }}"
              class="wm-pdp-react__img absolute inset-0 w-full h-full object-cover"
              width="900"
              height="900"
              fetchpriority="high"
              onerror="this.onerror=null;this.src='{{ fallback_img_1 }}';"
            >
          </div>
        {%- endif -%}
      </div>

    </div>

    {%- comment -%} =========================================================
       RIGHT COLUMN: Sticky Product Info, Actions & Accordions
       ========================================================= {%- endcomment -%}
    <div class="wm-pdp-react__info lg:sticky lg:top-28 self-start">

      {%- comment -%} Category {%- endcomment -%}
      <div class="wm-pdp-react__category text-[12px] text-meta tracking-wider uppercase mb-2">
        {{ prod_category }}
      </div>

      {%- comment -%} Title + Wishlist Heart Button {%- endcomment -%}
      <div class="wm-pdp-react__title-row flex items-start justify-between gap-4">
        <h1 class="wm-pdp-react__title text-[28px] md:text-[36px] leading-tight text-black">
          {{ prod_title }}
        </h1>
        <button
          type="button"
          data-pdp-wishlist
          data-wishlist-btn
          data-product-id="{{ prod_id }}"
          aria-label="Favorite"
          aria-pressed="false"
          class="wm-pdp-react__fav-btn w-10 h-10 cursor-pointer flex items-center justify-center shrink-0"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="wm-pdp-react__heart-svg text-black"
            aria-hidden="true"
          >
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
        </button>
      </div>

      {%- comment -%} Price in Rupees (₹), never USD {%- endcomment -%}
      <div class="wm-pdp-react__price text-[16px] text-black mt-2" data-pdp-price>
        ₹{{ price_rupees }}
      </div>

      {%- comment -%} Short Description {%- endcomment -%}
      <p class="wm-pdp-react__short-desc mt-4 text-[14px] leading-[24px] text-[#555]">
        {{ short_desc }}
      </p>

      {%- comment -%} Purchase Form:
         - NO Size or Material dropdowns
         - Button 1: Add to Cart -> transforms into [- qty +] stepper when clicked
         - Button 2 (Below): Buy Now -> redirects directly to /checkout
      {%- endcomment -%}
      {%- form 'product', product, id: 'product-form', class: 'wm-pdp-react__form mt-8' -%}
        <input type="hidden" name="id" value="{{ prod_id }}" data-product-variant-id>
        <input
          type="hidden"
          id="wm-pdp-qty-input"
          name="quantity"
          value="{% if in_cart_qty > 0 %}{{ in_cart_qty }}{% else %}1{% endif %}"
          data-qty-input
        >

        <div class="wm-pdp-react__buttons flex flex-col md:grid md:grid-cols-2 gap-3">
          {%- comment -%} Top / Left Slot: Add to Cart Button OR [- qty +] Quantity Stepper {%- endcomment -%}
          <div class="wm-pdp-react__primary-slot w-full">
            <button
              type="button"
              id="wm-pdp-atc-btn"
              data-pdp-atc-btn
              class="wm-pdp-react__atc-btn{% if in_cart_qty > 0 %} hidden{% endif %} w-full cursor-pointer bg-black text-white text-[14px] rounded-[10px] py-3 hover:bg-[#222] transition-colors"
              {% if track_stock and real_stock <= 0 and inv_policy != 'continue' %}disabled{% endif %}
            >
              <span data-atc-text>
                {%- if track_stock and real_stock <= 0 and inv_policy != 'continue' -%}
                  Sold Out
                {%- else -%}
                  Add to Cart
                {%- endif -%}
              </span>
            </button>

            <div
              id="wm-pdp-stepper"
              data-pdp-stepper
              class="wm-pdp-react__stepper{% if in_cart_qty == 0 %} hidden{% endif %} flex items-center justify-between rounded-[10px] border border-black bg-black text-white w-full text-[14px] transition-colors"
              role="group"
              aria-label="Quantity"
            >
              <button
                type="button"
                data-qty-minus
                class="wm-pdp-react__stepper-btn px-5 py-3 cursor-pointer flex items-center justify-center text-white"
                aria-label="Decrease"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>

              <span class="wm-pdp-react__stepper-qty font-normal select-none" data-pdp-qty-display>
                {%- if in_cart_qty > 0 -%}{{ in_cart_qty }}{%- else -%}1{%- endif -%}
              </span>

              <button
                type="button"
                data-qty-plus
                class="wm-pdp-react__stepper-btn px-5 py-3 cursor-pointer flex items-center justify-center text-white"
                aria-label="Increase"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>
          </div>

          {%- comment -%} Bottom Slot: Buy Now Button (redirects to checkout) {%- endcomment -%}
          <button
            type="button"
            id="wm-pdp-buy-now-btn"
            data-pdp-buy-now
            class="wm-pdp-react__buynow-btn w-full border cursor-pointer border-black text-black text-[14px] rounded-[10px] py-3 text-center hover:bg-black hover:text-white transition-colors"
            {% if track_stock and real_stock <= 0 and inv_policy != 'continue' %}style="display: none;"{% endif %}
          >
            Buy Now
          </button>
        </div>
      {%- endform -%}

      {%- comment -%} =========================================================
         THREE ACCORDIONS:
         1. Product Description (open by default)
         2. Specifications
         3. Benefits (no icons)
         ========================================================= {%- endcomment -%}
      <div class="wm-pdp-react__accordions mt-10" data-pdp-accordions>

        {%- comment -%} 1. Product Description {%- endcomment -%}
        <div class="wm-pdp-accordion is-open" id="pdp-description" data-pdp-accordion="description">
          <button
            type="button"
            class="wm-pdp-accordion__trigger"
            data-pdp-accordion-trigger="description"
            aria-expanded="true"
            aria-controls="pdp-accordion-body-description"
          >
            <span class="wm-pdp-accordion__title">Product Description</span>
            <span class="wm-pdp-accordion__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div
            id="pdp-accordion-body-description"
            class="wm-pdp-accordion__body"
            data-pdp-accordion-body
          >
            <div class="wm-pdp-accordion__content">
              {%- if product.description != blank -%}
                {{ product.description | replace: '<img', '<span style="display:none"' | replace: '</img>', '</span>' }}
              {%- else -%}
                <p>{{ short_desc }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- comment -%} 2. Specifications {%- endcomment -%}
        <div class="wm-pdp-accordion" id="pdp-specifications" data-pdp-accordion="specifications">
          <button
            type="button"
            class="wm-pdp-accordion__trigger"
            data-pdp-accordion-trigger="specifications"
            aria-expanded="false"
            aria-controls="pdp-accordion-body-specifications"
          >
            <span class="wm-pdp-accordion__title">Specifications</span>
            <span class="wm-pdp-accordion__icon" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </span>
          </button>
          <div
            id="pdp-accordion-body-specifications"
            class="wm-pdp-accordion__body"
            data-pdp-accordion-body
            hidden
          >
            <div class="wm-pdp-accordion__content">
              <table class="wm-pdp-specs-list" aria-label="Product Specifications">
                <tbody>
                  {%- if product.type != blank -%}
                    <tr>
                      <th scope="row">Product Type</th>
                      <td>{{ product.type }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if product.vendor != blank -%}
                    <tr>
                      <th scope="row">Brand</th>
                      <td>{{ product.vendor }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if current_variant.sku != blank -%}
                    <tr>
                      <th scope="row">SKU</th>
                      <td>{{ current_variant.sku }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if product.metafields.custom.material != blank -%}
                    <tr>
                      <th scope="row">Material</th>
                      <td>{{ product.metafields.custom.material }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if product.metafields.custom.suitable_for != blank -%}
                    <tr>
                      <th scope="row">Suitable For</th>
                      <td>{{ product.metafields.custom.suitable_for }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if product.metafields.custom.dimensions != blank -%}
                    <tr>
                      <th scope="row">Dimensions</th>
                      <td>{{ product.metafields.custom.dimensions }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if product.metafields.custom.color != blank -%}
                    <tr>
                      <th scope="row">Color</th>
                      <td>{{ product.metafields.custom.color }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if product.metafields.custom.package_includes != blank -%}
                    <tr>
                      <th scope="row">Package Includes</th>
                      <td>{{ product.metafields.custom.package_includes }}</td>
                    </tr>
                  {%- endif -%}
                  {%- if product.metafields.custom.care_instructions != blank -%}
                    <tr>
                      <th scope="row">Care Instructions</th>
                      <td>{{ product.metafields.custom.care_instructions }}</td>
                    </tr>
                  {%- endif -%}
                  <tr>
                    <th scope="row">Availability</th>
                    <td>{% if is_available %}In Stock{% else %}Out of Stock{% endif %}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        {%- comment -%} 3. Benefits (NO ICONS per user requirement) {%- endcomment -%}
        {%- unless section.settings.show_benefits == false -%}
          <div class="wm-pdp-accordion" id="pdp-benefits" data-pdp-accordion="benefits">
            <button
              type="button"
              class="wm-pdp-accordion__trigger"
              data-pdp-accordion-trigger="benefits"
              aria-expanded="false"
              aria-controls="pdp-accordion-body-benefits"
            >
              <span class="wm-pdp-accordion__title">{{ section.settings.benefits_heading | default: 'Benefits' }}</span>
              <span class="wm-pdp-accordion__icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </span>
            </button>
            <div
              id="pdp-accordion-body-benefits"
              class="wm-pdp-accordion__body"
              data-pdp-accordion-body
              hidden
            >
              <div class="wm-pdp-accordion__content">
                {%- liquid
                  assign p_text = product.title | append: ' ' | append: product.type | downcase
                  assign is_feeding = false
                  assign is_toy = false
                  if p_text contains 'bowl' or p_text contains 'feed' or p_text contains 'water' or p_text contains 'dish'
                    assign is_feeding = true
                  elsif p_text contains 'ball' or p_text contains 'toy' or p_text contains 'play' or p_text contains 'chew'
                    assign is_toy = true
                  endif
                -%}

                <div class="wm-pdp-benefits-editorial">
                  {%- if is_feeding -%}
                    <p class="wm-pdp-benefits-editorial__lead">
                      Built for clean, steady daily meals. A balanced base helps reduce tipping and spills, while the smooth interior wipes down in seconds after wet or dry food.
                    </p>
                    <dl class="wm-pdp-benefits-rows">
                      <div class="wm-pdp-benefits-row">
                        <dt>Daily Use</dt>
                        <dd>Suitable for dry kibble, wet food, and fresh water</dd>
                      </div>
                      <div class="wm-pdp-benefits-row">
                        <dt>Surface Finish</dt>
                        <dd>Non-porous, odor-resistant interior that rinses clean easily</dd>
                      </div>
                      <div class="wm-pdp-benefits-row">
                        <dt>Stability</dt>
                        <dd>Low-center profile stays put during enthusiastic mealtime</dd>
                      </div>
                    </dl>
                  {%- elsif is_toy -%}
                    <p class="wm-pdp-benefits-editorial__lead">
                      Made for active daily play, indoors or at the park. A textured grip makes it easy for dogs to pick up and carry while remaining gentle on teeth and gums.
                    </p>
                    <dl class="wm-pdp-benefits-rows">
                      <div class="wm-pdp-benefits-row">
                        <dt>Play Style</dt>
                        <dd>Ideal for fetch, solo chewing, and interactive training</dd>
                      </div>
                      <div class="wm-pdp-benefits-row">
                        <dt>Mouth Feel</dt>
                        <dd>Resilient, non-abrasive surface that is easy on gums</dd>
                      </div>
                      <div class="wm-pdp-benefits-row">
                        <dt>Care &amp; Cleaning</dt>
                        <dd>Rinses clean with water after outdoor sessions</dd>
                      </div>
                    </dl>
                  {%- else -%}
                    <p class="wm-pdp-benefits-editorial__lead">
