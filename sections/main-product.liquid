{% comment %}
  Wagmart Main Product Details Page Section (sections/main-product.liquid)
  High-converting e-commerce layout inspired by Amazon, Chewy, Nykaa & Shopify Dawn/Impulse.
{% endcomment %}

{{ 'product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign prod_title = product.title | default: 'Pet Grooming Glove'
  assign prod_category = product.type | default: 'Pet Care Essentials'
  assign prod_id = product.selected_or_first_available_variant.id | default: product.id | default: 'pet-grooming-glove'
  assign price_rupees = product.price | default: 33000 | divided_by: 100
  assign compare_rupees = product.compare_at_price | default: 41500 | divided_by: 100
  if compare_rupees <= price_rupees
    assign compare_rupees = price_rupees | times: 125 | divided_by: 100
  endif
  assign is_available = product.available | default: true
  if product.featured_image != blank
    assign schema_img = product.featured_image | image_url: width: 900
  else
    assign schema_img = 'catalog-bath-massage-brush.webp' | asset_url
  endif
-%}

{%- comment -%} JSON-LD Structured Data for SEO & Rich Snippets {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ prod_title | json }},
  "image": [{{ schema_img | json }}],
  "description": "Gently remove loose fur and mats while your pet enjoys a soothing bath or dry massage. Soft food-grade silicone bristles, ergonomic non-slip grip, suitable for dogs and cats.",
  "brand": {
    "@type": "Brand",
    "name": "Wagmart Pet Supplies"
  },
  "offers": {
    "@type": "Offer",
    "url": "{{ shop.url }}{{ product.url }}",
    "priceCurrency": "INR",
    "price": "{{ price_rupees }}",
    "availability": "https://schema.org/{% if is_available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "126"
  }
}
</script>

<div
  class="wm-pdp"
  data-wm-pdp
  data-product-id="{{ prod_id }}"
  data-product-title="{{ prod_title | escape }}"
  data-base-price="{{ price_rupees }}"
  data-compare-price="{{ compare_rupees }}"
  data-max-stock="18"
>
  <div class="wm-pdp__container">

    {%- comment -%} 1. BREADCRUMB NAVIGATION {%- endcomment -%}
    <nav class="wm-breadcrumb" aria-label="Breadcrumb">
      <ol class="wm-breadcrumb__list">
        <li class="wm-breadcrumb__item">
          <a href="{{ routes.root_url | default: '/' }}" class="wm-breadcrumb__link">Home</a>
          <span class="wm-breadcrumb__sep" aria-hidden="true">/</span>
        </li>
        <li class="wm-breadcrumb__item">
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-breadcrumb__link">{{ prod_category }}</a>
          <span class="wm-breadcrumb__sep" aria-hidden="true">/</span>
        </li>
        <li class="wm-breadcrumb__item">
          <span class="wm-breadcrumb__current" aria-current="page">{{ prod_title }}</span>
        </li>
      </ol>
    </nav>

    {%- comment -%} 2. TWO-COLUMN PRODUCT SECTION (55% Gallery / 45% Sticky Info Panel) {%- endcomment -%}
    <section class="wm-pdp__main-grid" aria-label="Product details">

      {%- comment -%} LEFT COLUMN: Gallery Component {%- endcomment -%}
      <div>
        {% render 'product-gallery', product: product %}
      </div>

      {%- comment -%} RIGHT COLUMN: Sticky Product Info Panel {%- endcomment -%}
      <div class="wm-info-panel">

        {%- comment -%} 1. Category Label & Subtle Brand Pill (replaces "MY STORE 2") {%- endcomment -%}
        <div class="wm-info__top-meta">
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-info__category">
            <span>{{ prod_category }}</span>
          </a>
          <span class="wm-info__brand-pill">By Wagmart Originals</span>
        </div>

        {%- comment -%} 2. Product Title H1 {%- endcomment -%}
        <h1 class="wm-info__title">{{ prod_title }}</h1>

        {%- comment -%} 3. Clickable Star Rating Row -> scrolls to #reviews {%- endcomment -%}
        <a href="#reviews" class="wm-info__rating-row" aria-label="Rated 4.8 out of 5 stars based on 126 reviews. Click to read reviews.">
          <span class="wm-stars" aria-hidden="true">
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </span>
          <span class="wm-info__rating-score">4.8</span>
          <span class="wm-info__review-count">(126 reviews)</span>
          <span class="wm-info__verified-tag">✓ Vet Recommended</span>
        </a>

        {%- comment -%} 4. Price Row Block {%- endcomment -%}
        {% render 'product-price-block', product: product %}

        {%- comment -%} 5. Short Description (2-3 lines) + 4 Bullet Highlights {%- endcomment -%}
        <p class="wm-info__short-desc">
          Gently lift loose fur, dander, and tangles while treating your furry companion to a calming spa massage. Designed with ultra-soft food-grade silicone tips and a built-in shampoo reservoir for effortless wet or dry grooming.
        </p>

        <ul class="wm-info__highlights" aria-label="Key product highlights">
          <li class="wm-info__highlight-item">
            <span class="wm-info__highlight-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span>Soft silicone bristles</span>
          </li>
          <li class="wm-info__highlight-item">
            <span class="wm-info__highlight-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span>Gentle soothing massage</span>
          </li>
          <li class="wm-info__highlight-item">
            <span class="wm-info__highlight-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span>Works on dogs &amp; cats</span>
          </li>
          <li class="wm-info__highlight-item">
            <span class="wm-info__highlight-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span>Machine washable &amp; durable</span>
          </li>
        </ul>

        {%- comment -%} 6, 7, 8. Product Form: Variants + Quantity Stepper + ATC / Buy Now {%- endcomment -%}
        {%- form 'product', product, id: 'product-form' -%}
          <input type="hidden" name="id" value="{{ prod_id }}">

          <div class="wm-variants">
            {%- comment -%} Color Swatches {%- endcomment -%}
            <div>
              <div class="wm-variant-group__header">
                <div>
                  <span class="wm-variant-group__label">Color:</span>
                  <span class="wm-variant-group__selected" data-selected-color>Aqua Mint</span>
                </div>
              </div>
              <div class="wm-swatches" role="radiogroup" aria-label="Select color">
                <button
                  type="button"
                  class="wm-swatch is-active"
                  role="radio"
                  aria-checked="true"
                  data-color-swatch="Aqua Mint"
                  data-color-filter="none"
                >
                  <span class="wm-swatch__dot" style="background-color:#5CE1C6;"></span>
                  <span>Aqua Mint</span>
                </button>
                <button
                  type="button"
                  class="wm-swatch"
                  role="radio"
                  aria-checked="false"
                  data-color-swatch="Sky Blue"
                  data-color-filter="hue-rotate(28deg) saturate(1.05)"
                >
                  <span class="wm-swatch__dot" style="background-color:#60A5FA;"></span>
                  <span>Sky Blue</span>
                </button>
                <button
                  type="button"
                  class="wm-swatch"
                  role="radio"
                  aria-checked="false"
                  data-color-swatch="Blush Pink"
                  data-color-filter="hue-rotate(155deg) saturate(0.95)"
                >
                  <span class="wm-swatch__dot" style="background-color:#F472B6;"></span>
                  <span>Blush Pink</span>
                </button>
              </div>
            </div>

            {%- comment -%} Size / Pack Pills {%- endcomment -%}
            <div>
              <div class="wm-variant-group__header">
                <div>
                  <span class="wm-variant-group__label">Pack Size:</span>
                  <span class="wm-variant-group__selected" data-selected-size>Single Pack (1 Pc)</span>
                </div>
              </div>
              <div class="wm-size-pills" role="radiogroup" aria-label="Select pack size">
                <button
                  type="button"
                  class="wm-size-pill is-active"
                  role="radio"
                  aria-checked="true"
                  data-size-pill="Single Pack (1 Pc)"
                  data-price="{{ price_rupees }}"
                  data-compare="{{ compare_rupees }}"
                  data-stock="18"
                  data-variant-id="{{ prod_id }}"
                >
                  Single Pack (1 Pc)
                </button>
                <button
                  type="button"
                  class="wm-size-pill"
                  role="radio"
                  aria-checked="false"
                  data-size-pill="Value Duo (Pack of 2)"
                  data-price="599"
                  data-compare="830"
                  data-stock="5"
                  data-variant-id="{{ prod_id }}"
                >
                  Value Duo (Pack of 2) &bull; Save 28%
                </button>
                <button
                  type="button"
                  class="wm-size-pill"
                  role="radio"
                  aria-checked="false"
                  data-size-pill="Universal Fit (All Breeds)"
                  data-price="{{ price_rupees }}"
                  data-compare="{{ compare_rupees }}"
                  data-stock="12"
                  data-variant-id="{{ prod_id }}"
                >
                  Universal Fit (All Breeds)
                </button>
              </div>
            </div>
          </div>

          <div style="margin-top:16px;">
            {% render 'product-quantity-stepper', product: product %}
          </div>
        {%- endform -%}

        {%- comment -%} 9. Stock Indicator {%- endcomment -%}
        <div class="wm-stock-status" data-pdp-stock role="status" aria-live="polite">
          <span class="wm-stock-status__dot" aria-hidden="true"></span>
          <span data-pdp-stock-text>In stock &ndash; ships in 24 hrs from Surat warehouse</span>
        </div>

        {%- comment -%} 10. Pincode Delivery Checker {%- endcomment -%}
        <div class="wm-pincode">
          <div class="wm-pincode__label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#1B3A2A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Check Delivery Date &amp; COD Eligibility</span>
          </div>
          <form class="wm-pincode__form" data-pincode-form>
            <div class="wm-pincode__input-wrap">
              <svg class="wm-pincode__pin-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <input
                type="text"
                id="wm-pincode-input"
                class="wm-pincode__input"
                placeholder="Enter 6-digit pincode (e.g. 395004)"
                maxlength="6"
                inputmode="numeric"
                aria-label="Enter 6-digit delivery pincode"
              >
            </div>
            <button type="submit" class="wm-pincode__btn">Check</button>
          </form>
          <div class="wm-pincode__result" data-pincode-result aria-live="polite">
            <div class="wm-pincode__result-line">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong data-default-delivery-date>Delivery by Tue, 27 Oct</strong> &bull; Free shipping above ₹499</span>
            </div>
            <div class="wm-pincode__result-line">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Pay on Delivery (COD) &amp; UPI available across India</span>
            </div>
          </div>
        </div>

        {%- comment -%} 11, 12, 13. Trust Badges + Payment Icons + Share Row {%- endcomment -%}
        {% render 'product-trust-badges', product: product %}

      </div>
    </section>

    {%- comment -%} =========================================================
       3. BELOW THE FOLD SECTION 1: TABS (Desktop) / ACCORDIONS (Mobile)
       ========================================================= {%- endcomment -%}
    <section class="wm-pdp-section" aria-label="Product Information Tabs">
      <div class="wm-tabs__nav" role="tablist" aria-label="Product details tabs">
        <button type="button" class="wm-tabs__tab-btn is-active" role="tab" aria-selected="true" data-tab-target="desc">Description</button>
        <button type="button" class="wm-tabs__tab-btn" role="tab" aria-selected="false" data-tab-target="specs">Specifications</button>
        <button type="button" class="wm-tabs__tab-btn" role="tab" aria-selected="false" data-tab-target="howto">How to Use</button>
        <button type="button" class="wm-tabs__tab-btn" role="tab" aria-selected="false" data-tab-target="shipping">Shipping &amp; Returns</button>
      </div>

      {%- comment -%} TAB 1: Description {%- endcomment -%}
      <div class="wm-tab-panel is-active" data-tab-panel="desc">
        <button type="button" class="wm-tab-panel__accordion-btn" data-accordion-toggle aria-expanded="true">
          <span>Description</span>
          <svg class="wm-tab-panel__accordion-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="wm-tab-panel__body">
          <div class="wm-desc-grid">
            <div class="wm-desc-copy">
              <p>
                Transform everyday shedding control and bath time into a bonding experience your pet loves. The <strong>Wagmart {{ prod_title }}</strong> fits comfortably in your hand, giving you effortless control around sensitive areas like legs, tail, and chest without pulling or tugging.
              </p>
              <p>
                Crafted from 100% BPA-free, medical-grade soft silicone bristles, it reaches deep beneath the topcoat to lift loose fur, dander, and trapped dirt while stimulating natural skin oils for a healthier, shinier coat.
              </p>
              <h3>Why Pet Parents Love It:</h3>
              <ul class="wm-desc-bullets">
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><strong>2-in-1 Wet &amp; Dry Grooming:</strong> Use dry for daily deshedding or fill the top dispenser with pet shampoo for rich, foaming bath massages.</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><strong>Zero Scratch Guarantee:</strong> Rounded silicone tips massage the skin gently without irritating sensitive skin or puppies/kittens.</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><strong>Ergonomic Non-Slip Loop:</strong> Side finger loop keeps the brush securely anchored on your palm even when covered in soapy lather.</span>
                </li>
                <li>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><strong>10-Second Easy Clean:</strong> Peel off collected fur in a single sheet and rinse under running water or toss in the top rack.</span>
                </li>
              </ul>
            </div>

            <div class="wm-desc-callout">
              <h4>Ideal For All Coat Types</h4>
              <p style="font-size:14.5px;color:#333;margin:0 0 14px;">
                Tested by veterinarians across short, medium, and long-haired breeds including Golden Retrievers, Labradors, Indies, Pugs, Shih Tzus, Beagles, and Persian Cats.
              </p>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:13px;font-weight:700;color:#1B3A2A;">
                <div style="background:#FFFFFF;padding:10px 12px;border-radius:10px;border:1px solid #E5E2DC;">✓ 95% Less Couch Fur</div>
                <div style="background:#FFFFFF;padding:10px 12px;border-radius:10px;border:1px solid #E5E2DC;">✓ Saves 40% Shampoo</div>
                <div style="background:#FFFFFF;padding:10px 12px;border-radius:10px;border:1px solid #E5E2DC;">✓ Boosts Coat Shine</div>
                <div style="background:#FFFFFF;padding:10px 12px;border-radius:10px;border:1px solid #E5E2DC;">✓ Calms Anxious Pets</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} TAB 2: Specifications (Clean 2-Column Table) {%- endcomment -%}
      <div class="wm-tab-panel" data-tab-panel="specs">
        <button type="button" class="wm-tab-panel__accordion-btn" data-accordion-toggle aria-expanded="false">
          <span>Specifications</span>
          <svg class="wm-tab-panel__accordion-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="wm-tab-panel__body">
          <table class="wm-specs-table" aria-label="Product Technical Specifications">
            <tbody>
              <tr>
                <th scope="row">Material</th>
                <td>100% Food-Grade BPA-Free Soft Silicone &amp; Breathable TRP Grip</td>
              </tr>
              <tr>
                <th scope="row">Size</th>
                <td>11.5 cm &times; 10.5 cm &times; 6.2 cm (Ergonomic Universal Palm Fit, 125g)</td>
              </tr>
              <tr>
                <th scope="row">Color</th>
                <td>Aqua Mint, Sky Blue, Blush Pink</td>
              </tr>
              <tr>
                <th scope="row">Suitable For</th>
                <td>Dogs, Cats, Puppies &amp; Kittens (Short, Medium &amp; Long Coats)</td>
              </tr>
              <tr>
                <th scope="row">Care</th>
                <td>Peel off hair, rinse with warm soapy water or machine wash gentle cycle</td>
              </tr>
              <tr>
                <th scope="row">Country of Origin</th>
                <td>India (Packed &amp; Dispatched by Wagmart Pet Supplies, Surat, Gujarat)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      {%- comment -%} TAB 3: How to Use {%- endcomment -%}
      <div class="wm-tab-panel" data-tab-panel="howto">
        <button type="button" class="wm-tab-panel__accordion-btn" data-accordion-toggle aria-expanded="false">
          <span>How to Use</span>
          <svg class="wm-tab-panel__accordion-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="wm-tab-panel__body">
          <div class="wm-steps-grid">
            <div class="wm-step-card">
              <span class="wm-step-card__num">1</span>
              <h4>Slip On &amp; Optional Fill</h4>
              <p>Slide your fingers through the side grip strap. For bath time, pop open the top cap and add pet shampoo + water.</p>
            </div>
            <div class="wm-step-card">
              <span class="wm-step-card__num">2</span>
              <h4>Brush in Gentle Strokes</h4>
              <p>Glide along your pet's back, neck, and legs in the direction of hair growth using circular massaging motions.</p>
            </div>
            <div class="wm-step-card">
              <span class="wm-step-card__num">3</span>
              <h4>Peel &amp; Rinse Clean</h4>
              <p>Once finished, lift the collected fur layer right off the silicone tips and rinse under tap water.</p>
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} TAB 4: Shipping & Returns {%- endcomment -%}
      <div class="wm-tab-panel" data-tab-panel="shipping">
        <button type="button" class="wm-tab-panel__accordion-btn" data-accordion-toggle aria-expanded="false">
          <span>Shipping &amp; Returns</span>
          <svg class="wm-tab-panel__accordion-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="wm-tab-panel__body">
          <div class="wm-steps-grid">
            <div class="wm-step-card">
              <h4>24-Hour Express Dispatch</h4>
              <p>All orders placed before 4:00 PM IST ship the same day from our Surat, Gujarat fulfillment center.</p>
            </div>
            <div class="wm-step-card">
              <h4>Free Shipping Above ₹499</h4>
              <p>Enjoy free express shipping across India on orders of ₹499+. Flat ₹49 shipping on smaller orders.</p>
            </div>
            <div class="wm-step-card">
              <h4>Easy 7-Day Returns</h4>
              <p>Not satisfied? Return unused items within 7 days of delivery for a full refund or instant replacement.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {%- comment -%} =========================================================
       4. BELOW THE FOLD SECTION 2: FREQUENTLY BOUGHT TOGETHER
       ========================================================= {%- endcomment -%}
    <section class="wm-pdp-section" aria-labelledby="wm-fbt-heading">
      <div class="wm-section-header">
        <div>
          <p class="wm-section-eyebrow">COMPLETE GROOMING ROUTINE</p>
          <h2 id="wm-fbt-heading" class="wm-section-title">Frequently Bought Together</h2>
        </div>
      </div>

      <div class="wm-fbt-box">
        <div class="wm-fbt__items">
          {%- comment -%} Bundle Item 1: Current Product {%- endcomment -%}
          <div class="wm-fbt-card is-selected" data-fbt-card>
            <label class="wm-fbt-card__check-label">
              <input
                type="checkbox"
                class="wm-fbt-card__checkbox"
                checked
                data-fbt-checkbox
                data-fbt-main
                data-id="{{ prod_id }}"
                data-name="{{ prod_title | escape }}"
                data-price="{{ price_rupees }}"
                data-compare="{{ compare_rupees }}"
                data-image="{{ schema_img }}"
              >
              <span>This Item</span>
            </label>
            <div class="wm-fbt-card__media">
              <img src="{{ schema_img }}" alt="{{ prod_title | escape }}" width="110" height="110" loading="lazy">
            </div>
            <h3 class="wm-fbt-card__title">{{ prod_title }}</h3>
            <div class="wm-fbt-card__price-row">
              <span class="wm-fbt-card__price" data-fbt-item-price>₹{{ price_rupees }}</span>
              <span class="wm-fbt-card__compare">₹{{ compare_rupees }}</span>
