{%- comment -%}
  Wagmart Editorial Product Hero Section (sections/main-product.liquid)
  Online Store 2.0 Dawn-compatible section:
  - Breadcrumb navigation
  - Two-column 12-grid hero:
    - Left: Main media stage (image, video, external_video, model) + vertical thumbnail rail on desktop / horizontal rail on mobile + swipe/pinch-zoom + accessible <dialog> lightbox
    - Right: Sticky buy box with block architecture (@app support, title, rating, price, description, variant picker, quantity + AJAX Add to Cart + dynamic Buy Now, trust points, Indian pincode checker)
  - Mobile sticky bottom bar driven by IntersectionObserver
{%- endcomment -%}

{{ 'product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign product_form_id = 'product-form-' | append: section.id
  assign prod_title = product.title
  assign is_available = current_variant.available | default: true
  if current_variant != blank and current_variant.available == false
    assign is_available = false
  endif

  assign rating_val = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | plus: 0
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | plus: 0

  assign current_sku = current_variant.sku | strip

  assign fallback_glove_img = 'catalog-grooming-glove.webp' | asset_url
  assign filter_unrelated = section.settings.filter_unrelated_media | default: false
-%}

{%- comment -%} Product JSON-LD Structured Data {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ prod_title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.featured_media != blank -%}
  "image": [
    {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}
  ],
  {%- endif -%}
  "description": {{ product.description | strip_html | default: prod_title | json }},
  "sku": {{ current_sku | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | default: 'Wagmart' | json }}
  },
  {%- if rating_count > 0 and rating_val > 0 -%}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating_val | json }},
    "reviewCount": {{ rating_count | json }}
  },
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": {{ shop.url | append: current_variant.url | default: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | default: 'INR' | json }},
    "price": {{ current_variant.price | default: 33000 | divided_by: 100.0 | json }},
    "availability": "https://schema.org/{% if is_available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>

<product-page
  class="wm-pdp"
  id="MainProduct-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle | default: 'pet-grooming-glove' }}"
  data-product-url="{{ product.url }}"
  data-update-url="true"
>
  <div class="wm-container">
    {%- comment -%} 1. Breadcrumb Navigation {%- endcomment -%}
    {%- if section.settings.show_breadcrumb -%}
      <nav class="wm-breadcrumb" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <ol class="wm-breadcrumb__list">
          <li class="wm-breadcrumb__item">
            <a href="{{ routes.root_url }}" class="wm-breadcrumb__link">{{ 'general.breadcrumbs.home' | t }}</a>
          </li>
          {%- if collection != blank -%}
            <li class="wm-breadcrumb__item">
              <span class="wm-breadcrumb__sep" aria-hidden="true">/</span>
              <a href="{{ collection.url }}" class="wm-breadcrumb__link">{{ collection.title }}</a>
            </li>
          {%- elsif product.collections.first != blank -%}
            <li class="wm-breadcrumb__item">
              <span class="wm-breadcrumb__sep" aria-hidden="true">/</span>
              <a href="{{ product.collections.first.url }}" class="wm-breadcrumb__link">{{ product.collections.first.title }}</a>
            </li>
          {%- else -%}
            <li class="wm-breadcrumb__item">
              <span class="wm-breadcrumb__sep" aria-hidden="true">/</span>
              <a href="{{ routes.all_products_collection_url }}" class="wm-breadcrumb__link">{{ 'general.breadcrumbs.collections' | t }}</a>
            </li>
          {%- endif -%}
          <li class="wm-breadcrumb__item" aria-current="page">
            <span class="wm-breadcrumb__sep" aria-hidden="true">/</span>
            <span class="wm-breadcrumb__current">{{ prod_title }}</span>
          </li>
        </ol>
      </nav>
    {%- endif -%}

    {%- comment -%} 2. Two-Column Product Hero (12-Column Grid) {%- endcomment -%}
    <div class="wm-pdp__grid">
      {%- comment -%} LEFT COLUMN: Media Gallery + Thumbnail Rail {%- endcomment -%}
      <div class="wm-pdp__gallery-col">
        {%- liquid
          assign valid_media_count = 0
          for media in product.media
            assign m_src = media.preview_image.src | default: '' | downcase
            assign m_alt = media.alt | default: '' | downcase
            assign is_unrelated = false
            if filter_unrelated
              if m_src contains 'leash' or m_src contains 'ball' or m_src contains 'collar' or m_src contains 'hammock' or m_src contains 'bowl' or m_src contains 'image_copy' or m_alt contains 'leash' or m_alt contains 'collar'
                assign is_unrelated = true
              endif
            endif
            unless is_unrelated
              assign valid_media_count = valid_media_count | plus: 1
            endunless
          endfor
        -%}

        <div
          class="wm-gallery{% if valid_media_count <= 1 and product.media.size > 0 %} wm-gallery--single{% endif %}"
          data-product-gallery
          aria-label="{{ 'products.product.media.gallery_label' | t }}"
        >
          {%- comment -%} Thumbnail Rail (Vertical on Desktop >=1024px, Horizontal below main image on Mobile/Tablet) {%- endcomment -%}
          <div
            class="wm-gallery__thumbs"
            role="tablist"
            aria-label="{{ 'products.product.media.thumbnails_label' | t }}"
            data-gallery-thumbs
          >
            {%- if valid_media_count > 0 -%}
              {%- assign render_idx = 0 -%}
              {%- for media in product.media -%}
                {%- liquid
                  assign m_src = media.preview_image.src | default: '' | downcase
                  assign m_alt = media.alt | default: '' | downcase
                  assign is_unrelated = false
                  if filter_unrelated
                    if m_src contains 'leash' or m_src contains 'ball' or m_src contains 'collar' or m_src contains 'hammock' or m_src contains 'bowl' or m_src contains 'image_copy' or m_alt contains 'leash' or m_alt contains 'collar'
                      assign is_unrelated = true
                    endif
                  endif
                -%}
                {%- unless is_unrelated -%}
                  {%- assign is_first_thumb = false -%}
                  {%- if render_idx == 0 -%}
                    {%- assign is_first_thumb = true -%}
                  {%- endif -%}
                  {% render 'gallery-thumb',
                    media: media,
                    index: render_idx,
                    is_active: is_first_thumb,
                    product_title: prod_title
                  %}
                  {%- assign render_idx = render_idx | plus: 1 -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- else -%}
              {% render 'gallery-thumb',
                media: product.featured_media,
                index: 0,
                is_active: true,
                product_title: prod_title,
                fallback_src: fallback_glove_img
              %}
            {%- endif -%}
          </div>

          {%- comment -%} Main Media Stage {%- endcomment -%}
          <div class="wm-gallery__stage">
            <div class="wm-gallery__viewport" data-gallery-viewport>
              <div class="wm-gallery__track" data-gallery-track>
                {%- if valid_media_count > 0 -%}
                  {%- assign slide_idx = 0 -%}
                  {%- for media in product.media -%}
                    {%- liquid
                      assign m_src = media.preview_image.src | default: '' | downcase
                      assign m_alt = media.alt | default: '' | downcase
                      assign is_unrelated = false
                      if filter_unrelated
                        if m_src contains 'leash' or m_src contains 'ball' or m_src contains 'collar' or m_src contains 'hammock' or m_src contains 'bowl' or m_src contains 'image_copy' or m_alt contains 'leash' or m_alt contains 'collar'
                          assign is_unrelated = true
                        endif
                      endif
                    -%}
                    {%- unless is_unrelated -%}
                      {%- liquid
                        assign is_first_slide = false
                        assign img_loading = 'lazy'
                        assign img_priority = 'auto'
                        if slide_idx == 0
                          assign is_first_slide = true
                          assign img_loading = 'eager'
                          assign img_priority = 'high'
                        endif
                        assign media_alt = media.alt | default: prod_title | escape
                      -%}
                      <div
                        id="wm-gallery-slide-{{ section.id }}-{{ slide_idx }}"
                        role="tabpanel"
                        aria-labelledby="wm-gallery-thumb-{{ section.id }}-{{ slide_idx }}"
                        class="wm-gallery__slide{% if is_first_slide %} is-active{% endif %}"
                        data-gallery-slide="{{ slide_idx }}"
                        data-media-id="{{ media.id }}"
                        data-zoom-src="{{ media.preview_image | image_url: width: 2000 }}"
                      >
                        {%- case media.media_type -%}
                          {%- when 'image' -%}
                            <div class="wm-gallery__zoom-wrap" data-zoom-container>
                              {{
                                media
                                | image_url: width: 1600
                                | image_tag:
                                  widths: '360, 540, 720, 960, 1200, 1600',
                                  sizes: '(min-width: 1280px) 620px, (min-width: 1024px) 50vw, (min-width: 768px) 52vw, 100vw',
                                  loading: img_loading,
                                  fetchpriority: img_priority,
                                  width: media.width,
                                  height: media.height,
                                  alt: media_alt,
                                  class: 'wm-gallery__img'
                              }}
                            </div>
                          {%- when 'video' -%}
                            <div class="wm-gallery__video-wrap">
                              {{
                                media
                                | video_tag:
                                  image_size: '1200x',
                                  controls: true,
                                  muted: false,
                                  loop: section.settings.enable_video_looping,
                                  preload: 'metadata',
                                  class: 'wm-gallery__video'
                              }}
                            </div>
                          {%- when 'external_video' -%}
                            <div class="wm-gallery__video-wrap">
                              {{
                                media
                                | external_video_tag:
                                  class: 'wm-gallery__external-video',
                                  loading: 'lazy'
                              }}
                            </div>
                          {%- when 'model' -%}
                            <div class="wm-gallery__model-wrap">
                              {{
                                media
                                | model_viewer_tag:
                                  image_size: '1200x',
                                  reveal: 'interaction',
                                  toggleable: true,
                                  class: 'wm-gallery__model'
                              }}
                            </div>
                        {%- endcase -%}
                      </div>
                      {%- assign slide_idx = slide_idx | plus: 1 -%}
                    {%- endunless -%}
                  {%- endfor -%}
                {%- else -%}
                  <div
                    id="wm-gallery-slide-{{ section.id }}-0"
                    role="tabpanel"
                    aria-labelledby="wm-gallery-thumb-{{ section.id }}-0"
                    class="wm-gallery__slide is-active"
                    data-gallery-slide="0"
                    data-zoom-src="{{ fallback_glove_img }}"
                  >
                    <div class="wm-gallery__zoom-wrap" data-zoom-container>
                      <img
                        src="{{ fallback_glove_img }}"
                        alt="{{ prod_title | escape }}"
                        width="1000"
                        height="1000"
                        loading="eager"
                        fetchpriority="high"
                        class="wm-gallery__img"
                      >
                    </div>
                  </div>
                  {%- assign slide_idx = 1 -%}
                {%- endif -%}
              </div>

              {%- comment -%} Top-Right Wishlist Heart Button {%- endcomment -%}
              <button
                type="button"
                class="wm-gallery__wishlist-btn"
                data-pdp-wishlist
                data-wishlist-btn
                data-product-id="{{ current_variant.id | default: product.id }}"
                aria-label="{{ 'products.wishlist.add' | t }}"
                aria-pressed="false"
              >
                {% render 'icon', name: 'heart', size: 17, filled: true %}
              </button>

              {%- comment -%} Lightbox Expand Trigger {%- endcomment -%}
              <button
                type="button"
                class="wm-gallery__lightbox-btn"
                data-lightbox-open
                aria-label="{{ 'products.product.media.open_lightbox' | t }}"
              >
                {% render 'icon', name: 'zoom-in', size: 18 %}
              </button>
            </div>

            {%- comment -%} Mobile Dot Indicators (360-767px) {%- endcomment -%}
            {%- if slide_idx > 1 -%}
              <div class="wm-gallery__dots" data-gallery-dots role="tablist" aria-label="{{ 'products.product.media.gallery_label' | t }}">
                {%- for i in (1..slide_idx) -%}
                  {%- assign dot_idx = i | minus: 1 -%}
                  <button
                    type="button"
                    role="tab"
                    class="wm-gallery__dot{% if forloop.first %} is-active{% endif %}"
                    data-gallery-dot="{{ dot_idx }}"
                    aria-label="{{ 'products.product.media.load_image' | t: index: i }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  >
                    <span class="wm-gallery__dot-pip"></span>
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- comment -%} RIGHT COLUMN: Sticky Buy Box {%- endcomment -%}
      <div class="wm-pdp__info-col">
        <div class="wm-buy-box" data-buy-box>
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  <div class="wm-buy-box__app-block" {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>

                {%- when 'title' -%}
                  <div class="wm-buy-box__title-group" {{ block.shopify_attributes }}>
                    <div class="wm-buy-box__title-row">
                      <h1 class="wm-buy-box__title">{{ prod_title }}</h1>
                    </div>
                    {%- if section.settings.show_sku != false -%}
                      <div class="wm-buy-box__sku" data-sku-wrapper {% if current_sku == blank %}hidden{% endif %}>
                        <span class="wm-buy-box__sku-label">{{ 'products.product.sku' | t }}:</span>
                        <span class="wm-buy-box__sku-value" data-product-sku>{{ current_sku }}</span>
                      </div>
                    {%- endif -%}
                  </div>

                {%- when 'rating' -%}
                  <div class="wm-buy-box__rating" {{ block.shopify_attributes }}>
                    <a
                      href="#product-tabs-reviews"
                      class="wm-rating-link"
                      data-review-anchor
                      {% if rating_count > 0 %}
                        aria-label="{{ 'products.product.reviews.rating_aria' | t: rating: rating_val, count: rating_count }}"
                      {% endif %}
                    >
                      <span class="wm-rating-link__stars" aria-hidden="true">
                        {%- for i in (1..5) -%}
                          {%- if rating_count > 0 and i > rating_val -%}
                            {% render 'icon', name: 'star-empty', size: 16 %}
                          {%- else -%}
                            {% render 'icon', name: 'star', size: 16, filled: true %}
                          {%- endif -%}
                        {%- endfor -%}
                      </span>
                      {%- if rating_count > 0 -%}
                        <span class="wm-rating-link__score">{{ rating_val | round: 1 }}</span>
                        <span class="wm-rating-link__count" data-pdp-rating-count>
                          {{ 'products.product.reviews.count_label' | t: count: rating_count }}
                        </span>
                      {%- else -%}
                        <span class="wm-rating-link__empty" data-pdp-rating-count>No reviews yet</span>
                      {%- endif -%}
                    </a>
                  </div>

                {%- when 'price' -%}
                  <div class="wm-buy-box__price" {{ block.shopify_attributes }}>
                    {% render 'price',
                      product: product,
                      variant: current_variant,
                      show_badges: true,
                      show_tax_note: true
                    %}
                  </div>

                {%- when 'inventory_status' -%}
                  {%- liquid
                    assign low_threshold = block.settings.low_stock_threshold | default: 10
                    assign show_qty = block.settings.show_inventory_quantity
                    assign inv_qty = current_variant.inventory_quantity | default: 0
                    assign inv_mgmt = current_variant.inventory_management
                    assign inv_state = 'in-stock'

                    if is_available == false
                      assign inv_state = 'out-of-stock'
                      assign inv_label = block.settings.out_of_stock_label | default: 'Out of stock' | replace: ' — ', ', '
                    elsif inv_mgmt == 'shopify' and inv_qty > 0 and inv_qty <= low_threshold
                      assign inv_state = 'low-stock'
                      if show_qty
                        assign inv_label = 'Only ' | append: inv_qty | append: ' left in stock - order soon'
                      else
                        assign inv_label = block.settings.low_stock_label | default: 'Low stock - order soon' | replace: ' — ', ' - '
                      endif
                    else
                      assign inv_state = 'in-stock'
                      if inv_mgmt == 'shopify' and inv_qty > 0 and show_qty
                        assign inv_label = 'In stock (' | append: inv_qty | append: ' available), ready to ship'
                      else
                        assign inv_label = block.settings.in_stock_label | default: 'In stock, ready to ship' | replace: ' — ', ', '
                      endif
                    endif
                  -%}
                  <div
                    class="wm-stock-indicator is-{{ inv_state }}"
                    data-stock-indicator
                    data-low-threshold="{{ low_threshold }}"
                    data-show-qty="{{ show_qty }}"
                    data-label-in-stock="{{ block.settings.in_stock_label | default: 'In stock, ready to ship' | replace: ' — ', ', ' | escape }}"
                    data-label-low-stock="{{ block.settings.low_stock_label | default: 'Low stock - order soon' | replace: ' — ', ' - ' | escape }}"
                    data-label-out-of-stock="{{ block.settings.out_of_stock_label | default: 'Out of stock' | replace: ' — ', ', ' | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="wm-stock-indicator__row">
                      <span class="wm-stock-indicator__dot" aria-hidden="true"></span>
                      <span class="wm-stock-indicator__text" data-stock-text>{{ inv_label }}</span>
                    </div>
                    <script type="application/json" data-variant-inventory>
                      {
                        {%- for v in product.variants -%}
                          "{{ v.id }}": {
                            "available": {{ v.available | json }},
                            "quantity": {{ v.inventory_quantity | default: 0 | json }},
                            "management": {{ v.inventory_management | json }},
                            "policy": {{ v.inventory_policy | json }}
                          }{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      }
                    </script>
                  </div>

                {%- when 'description' -%}
                  {%- assign admin_short_desc = product.metafields.custom.short_description.value | default: product.metafields.custom.short_description | default: product.description | strip_html | strip -%}
                  {%- if admin_short_desc != blank -%}
                    <div class="wm-buy-box__lead-wrap" {{ block.shopify_attributes }}>
                      <p class="wm-buy-box__lead">
                        {{ admin_short_desc }}
                      </p>
                      <a
                        href="#ProductTabs-{{ section.id }}"
                        class="wm-buy-box__view-more"
                        data-description-anchor
                      >
                        View more
                      </a>
                    </div>
                  {%- endif -%}

                {%- when 'variant_picker' -%}
                  {%- unless product.has_only_default_variant -%}
                    <div class="wm-variants" data-variant-picker {{ block.shopify_attributes }}>
                      {%- for option in product.options_with_values -%}
                        <fieldset class="wm-variants__fieldset" data-option-position="{{ option.position }}">
                          <div class="wm-variants__legend-row">
                            <legend class="wm-variants__legend">
                              {{ option.name }}:
                              <span class="wm-variants__selected" data-option-selected-value>{{ option.selected_value }}</span>
                            </legend>
                          </div>
                          <div class="wm-variants__options">
                            {%- for value in option.values -%}
                              {%- liquid
                                assign option_disabled = true
                                for variant in product.variants
                                  case option.position
                                    when 1
                                      if variant.option1 == value and variant.available
                                        assign option_disabled = false
                                      endif
                                    when 2
                                      if variant.option1 == current_variant.option1 and variant.option2 == value and variant.available
                                        assign option_disabled = false
                                      endif
                                    when 3
                                      if variant.option1 == current_variant.option1 and variant.option2 == current_variant.option2 and variant.option3 == value and variant.available
                                        assign option_disabled = false
                                      endif
                                  endcase
                                endfor
                              -%}
                              <label
                                class="wm-variants__pill{% if option.selected_value == value %} is-selected{% endif %}{% if option_disabled %} is-unavailable{% endif %}"
                              >
                                <input
                                  type="radio"
                                  class="wm-sr-only"
                                  name="option-{{ section.id }}-{{ option.position }}"
                                  value="{{ value | escape }}"
                                  {% if option.selected_value == value %}checked{% endif %}
                                  data-variant-option-input
                                  data-option-index="{{ forloop.parentloop.index0 }}"
                                >
                                <span class="wm-variants__pill-text">{{ value }}</span>
                              </label>
                            {%- endfor -%}
                          </div>
                        </fieldset>
                      {%- endfor -%}

                      <script type="application/json" data-product-variants>
                        {{ product.variants | json }}
                      </script>
                    </div>
                  {%- endunless -%}

                {%- when 'buy_buttons' -%}
                  <div class="wm-buy-box__actions" {{ block.shopify_attributes }}>
                    {%- form 'product', product, id: product_form_id, class: 'wm-pdp-form', novalidate: 'novalidate', data-product-form: '' -%}
                      <input
                        type="hidden"
                        name="id"
                        value="{{ current_variant.id }}"
                        data-variant-id-input
                      >
                      <input
                        type="hidden"
                        id="Quantity-{{ section.id }}"
                        name="quantity"
                        value="1"
                        data-qty-input
                      >

                      {%- comment -%} 2-Column CTA Grid (Mobile, Tablet & Laptop): [Add to Cart / - 1 + Stepper] | [Buy it now] {%- endcomment -%}
                      <div class="wm-pdp-form__cta-grid">
                        <div class="wm-pdp-form__atc-cell">
                          {%- comment -%} Primary Add to Cart Button {%- endcomment -%}
                          <button
                            type="submit"
                            name="add"
                            id="ProductSubmitButton-{{ section.id }}"
                            class="wm-btn wm-btn--primary wm-pdp-form__submit"
                            data-atc-button
                            data-text-default="{{ 'products.product.add_to_cart' | t | escape }}"
                            data-text-adding="{{ 'products.product.adding' | t | escape }}"
                            data-text-added="{{ 'products.product.added' | t | escape }}"
                            data-text-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                            data-text-unavailable="{{ 'products.product.unavailable' | t | escape }}"
                            {% unless is_available %}disabled{% endunless %}
                          >
                            {% render 'icon', name: 'bag', size: 18 %}
                            <span data-atc-text>
                              {%- if is_available -%}
                                {{ 'products.product.add_to_cart' | t }}
                              {%- else -%}
                                {{ 'products.product.sold_out' | t }}
                              {%- endif -%}
                            </span>
                            <span class="wm-btn__spinner" data-atc-spinner hidden aria-hidden="true"></span>
                          </button>

                          {%- comment -%} Active Cart Quantity Stepper (- / qty / +) replacing Add to Cart when clicked {%- endcomment -%}
                          <div class="wm-pdp-atc-stepper" data-pdp-atc-stepper hidden>
                            <button
                              type="button"
                              class="wm-pdp-atc-stepper__btn"
                              data-pdp-atc-delta="-1"
                              aria-label="{{ 'products.product.quantity.decrease' | t }}"
                            >
                              {% render 'icon', name: 'minus', size: 16 %}
                            </button>
                            <span class="wm-pdp-atc-stepper__val" data-pdp-atc-qty>1</span>
                            <button
                              type="button"
                              class="wm-pdp-atc-stepper__btn"
                              data-pdp-atc-delta="1"
                              aria-label="{{ 'products.product.quantity.increase' | t }}"
                            >
                              {% render 'icon', name: 'plus', size: 16 %}
                            </button>
                          </div>
                        </div>

