{% comment %}
  Wagmart "The Latest from Majestic Pet" Editorial Blog Section
  Clean 4-column layout matching the reference design.
  Styles are scoped below (theme.css is a precompiled Tailwind build, so arbitrary utilities are not available).
{% endcomment %}

<style>
  .wm-blog {
    background: #ffffff;
    padding: 32px 0 40px;
    scroll-margin-top: 96px;
  }
  /*
    Side spacing mirrors the navbar exactly:
    outer = .wm-header side padding, inner = .wm-header__bar side padding, max = .wm-header__shell max-width.
  */
  .wm-blog__wrap {
    --nav-outer: clamp(10px, 1.6vw, 20px);
    --nav-inner: clamp(16px, 2vw, 30px);
    box-sizing: border-box;
    max-width: calc(1500px + (2 * var(--nav-outer)));
    margin: 0 auto;
    padding: 0 calc(var(--nav-outer) + var(--nav-inner));
  }
  @media (max-width: 767px) {
    .wm-blog__wrap { --nav-inner: 8px; }
  }
  /* Header: centered + button below (mobile/tablet), heading left + button right (laptop/desktop) */
  .wm-blog__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    margin: 0 0 22px;
  }
  .wm-blog__btn { flex-shrink: 0; }
  .wm-blog__title {
    margin: 0;
    font-family: 'Nunito', sans-serif;
    font-size: 24px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #111111;
  }
  /*
    Responsive Blog Grid:
    - Mobile (<640px)    : 1 grid (single card per row)
    - Tablet (640-1023px): 2 grid (2 cards per row)
    - Laptop & Desktop (>=1024px): 4 grid (4 cards per row, as above)
    - No pagination dots
  */
  .wm-blog__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  /* Card */
  .wm-blog-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-align: left;
  }
  .wm-blog-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    background: #f2f2f2;
    aspect-ratio: 4 / 3;
    margin-bottom: 12px;
  }
  .wm-blog-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wm-blog-card:hover .wm-blog-card__media img {
    transform: scale(1.05);
  }
  .wm-blog-card__title {
    margin: 0 0 4px;
    font-family: 'Nunito', sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: #111111;
  }
  .wm-blog-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .wm-blog-card:hover .wm-blog-card__title a,
  .wm-blog-card__title a:hover {
    color: #7a46e5;
  }

  .wm-blog-card__date {
    margin: 0 0 8px;
    font-size: 12.5px;
    color: #9a9a9a;
  }
  .wm-blog-card__excerpt {
    margin: 0 0 12px;
    font-size: 13.5px;
    line-height: 1.6;
    color: #555555;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .wm-blog-card__foot {
    margin-top: auto;
  }

  /* Read more: no underline by default; underline grows left -> right only while the card is hovered */
  .wm-blog-card__more {
    display: inline-block;
    position: relative;
    padding-bottom: 3px;
    font-size: 13.5px;
    font-weight: 600;
    color: #2b3a55;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: left 100%;
    background-size: 0% 1.5px;
    transition:
      background-size 0.4s cubic-bezier(0.65, 0, 0.35, 1),
      color 0.3s ease;
  }
  .wm-blog-card:hover .wm-blog-card__more,
  .wm-blog-card__more:focus-visible {
    color: #7a46e5;
    background-size: 100% 1.5px;
  }

  .wm-blog-title-br {
    display: inline;
  }
  @media (min-width: 640px) {
    .wm-blog-title-br { display: none; }
    .wm-blog { padding: 40px 0 44px; }
    .wm-blog__head { margin-bottom: 24px; }
    .wm-blog__title { font-size: 28px; }
    .wm-blog__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  /* Laptop & Desktop (>= 1024px): Heading left, button right in one line, 4-column static grid, no dots */
  @media (min-width: 1024px) {
    .wm-blog { padding: 44px 0 48px; }
    .wm-blog__head {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      text-align: left;
      margin-bottom: 26px;
    }
    .wm-blog__title { font-size: 30px; }
    .wm-blog__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-blog__grid { scroll-behavior: auto; }
    .wm-blog-card__media img,
    .wm-blog-card__more { transition: none; }
  }
</style>

{%- liquid
  # Dynamic Blog selection: selected blog > 'news' blog > 'blog' blog
  assign target_blog = section.settings.blog
  if target_blog == blank
    if blogs.news.articles.size > 0
      assign target_blog = blogs.news
    elsif blogs.blog.articles.size > 0
      assign target_blog = blogs.blog
    endif
  endif

  # Button -> blog page
  assign blog_page_url = section.settings.button_link
  if blog_page_url == blank and target_blog != blank
    assign blog_page_url = target_blog.url
  endif
  if blog_page_url == blank
    assign blog_page_url = '/blogs/news'
  endif
  assign blog_btn_text = section.settings.button_text | default: 'View All Blogs'
-%}

<section id="blog" class="wm-blog" aria-label="Wagmart Pet Journal and Blog">
  <div class="wm-blog__wrap">
    <div class="wm-blog__head">
      <h2 class="wm-blog__title">
        {%- if section.settings.title != blank -%}
          {{ section.settings.title }}
        {%- else -%}
          The Latest from<br class="wm-blog-title-br"> Wagmart Pet Journal
        {%- endif -%}
      </h2>
      {% render 'theme-button', text: blog_btn_text, href: blog_page_url, class: 'wm-blog__btn' %}
    </div>

    <div class="wm-blog__grid">
      {%- if target_blog != blank and target_blog.articles.size > 0 -%}
        {%- for article in target_blog.articles limit: 4 -%}
          <article class="wm-blog-card">
            <a href="{{ article.url }}" class="wm-blog-card__media" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800',
                  sizes: '(min-width: 1280px) 25vw, (min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw',
                  alt: article.title
                }}
              {%- else -%}
                <div class="w-full h-full min-h-[200px] flex items-center justify-center bg-[#f6f2fe] text-[#7a46e5]">
                  {% render 'wm-icon', name: 'image', class: 'w-8 h-8 opacity-60' %}
                </div>
              {%- endif -%}
            </a>
            <h3 class="wm-blog-card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>
            <p class="wm-blog-card__date">{{ article.published_at | date: '%b %d, %Y' }}</p>
            <p class="wm-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
            <div class="wm-blog-card__foot">
              <a href="{{ article.url }}" class="wm-blog-card__more">Read more</a>
            </div>
          </article>
        {%- endfor -%}

      {%- else -%}
        <div class="wm-blog-empty text-center py-12 px-4 col-span-full w-full">
          <div class="w-12 h-12 rounded-full bg-[#f6f2fe] text-[#7a46e5] flex items-center justify-center mx-auto mb-3 shadow-2xs">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </div>
          <p class="text-base font-semibold text-[#111827]">No blog articles published yet</p>
          <p class="text-xs text-neutral-500 mt-1">Articles published in Shopify Admin will appear here automatically.</p>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Blog Section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Latest from Wagmart Pet Journal"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View All Blogs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Defaults to the selected blog, or the blog with handle 'news' / 'blog'."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog (optional)",
      "info": "Select the blog from which articles should be loaded. Defaults to 'news'."
    }
  ],
  "presets": [
    {
      "name": "Blog Section",
      "settings": {
        "title": "The Latest from Wagmart Pet Journal",
        "button_text": "View All Blogs"
      }
    }
  ]
}
{% endschema %}
