{%- comment -%}
  WAGMART Header
  - Desktop (≥1100px): Bestsellers ▾ | All Products | Blog | Contact — centred logo — Search / Account / Cart
  - Tablet & mobile: Menu — centred logo — Search / (Account ≥768px) / Cart, with a slide-in navigation drawer
  - Bestsellers carousel, account popover, search panel and cart drawer are wired up in assets/header.js
{%- endcomment -%}

{%- liquid
  assign blog_url = section.settings.blog_url
  if blog_url == blank
    if blogs.news.id != blank
      assign blog_url = blogs.news.url
    elsif blogs.blog.id != blank
      assign blog_url = blogs.blog.url
    endif
  endif

  assign contact_url = section.settings.contact_url
  if contact_url == blank
    if pages['contact'].id != blank
      assign contact_url = pages['contact'].url
    elsif pages['contact-us'].id != blank
      assign contact_url = pages['contact-us'].url
    endif
  endif

  assign about_url = section.settings.about_url
  if about_url == blank
    if pages['about'].id != blank
      assign about_url = pages['about'].url
    elsif pages['about-us'].id != blank
      assign about_url = pages['about-us'].url
    else
      assign about_url = '/pages/about-us'
    endif
  endif

  assign accounts_legacy = false
  if routes.account_login_url contains '/account/login'
    assign accounts_legacy = true
  endif

  assign account_menu_handle = section.settings.customer_account_menu.handle | default: 'customer-account-main-menu'
  assign best_limit = section.settings.bestsellers_limit | default: 10
  assign all_products_current = false
  if request.path == routes.all_products_collection_url
    assign all_products_current = true
  endif

  assign nav_menu_handle = section.settings.main_menu | default: 'main-menu'
  assign nav_links = linklists[nav_menu_handle].links
-%}

{%- capture logo_markup -%}
  {%- if section.settings.logo != blank -%}
    {{-
      section.settings.logo
      | image_url: width: 560
      | image_tag:
        alt: shop.name,
        widths: '180, 280, 400, 560',
        sizes: '180px',
        loading: 'eager',
        fetchpriority: 'high'
    -}}
  {%- else -%}
    <img
      src="{{ 'wagmart-logo-header.webp' | asset_url }}"
      alt="{{ shop.name | default: 'WAGMART' | escape }}"
      width="520"
      height="176"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  {%- endif -%}
{%- endcapture -%}

<a class="wm-skip-link" href="#MainContent">Skip to content</a>

<header class="wm-header" data-wm-header>
  <div class="wm-header__shell" data-header-shell>
    <div class="wm-header__bar">

      {%- comment -%} ============ START: menu button (mobile) + primary nav (desktop) ============ {%- endcomment -%}
      <div class="wm-header__start">
        <button
          type="button"
          class="wm-icon-btn wm-only-mobile"
          data-drawer-open
          aria-controls="WmMobileDrawer"
          aria-expanded="false"
          aria-label="Open menu"
        >
          {% render 'wm-icon', name: 'menu' %}
        </button>

        <nav class="wm-nav" aria-label="Main">
          <ul class="wm-nav__list">
            {%- if nav_links.size > 0 -%}
              {%- for link in nav_links -%}
                {%- assign link_handle = link.title | downcase -%}
                {%- if link_handle == 'shop' or link_handle contains 'bestseller' -%}
                  <li>
                    <button
                      type="button"
                      class="wm-nav__link"
                      id="WmTriggerBest"
                      data-panel-trigger="bestsellers"
                      aria-expanded="false"
                      aria-controls="WmPanelBest"
                    >
                      {{ link.title }} {% render 'wm-icon', name: 'chevron-down', class: 'wm-nav__chevron', stroke: 1.75 %}
                    </button>
                  </li>
                {%- else -%}
                  <li>
                    <a class="wm-nav__link" data-nav-plain href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <li>
                <button
                  type="button"
                  class="wm-nav__link"
                  id="WmTriggerBest"
                  data-panel-trigger="bestsellers"
                  aria-expanded="false"
                  aria-controls="WmPanelBest"
                >
                  Shop {% render 'wm-icon', name: 'chevron-down', class: 'wm-nav__chevron', stroke: 1.75 %}
                </button>
              </li>
              <li>
                <a class="wm-nav__link" data-nav-plain href="{{ routes.all_products_collection_url }}"{% if all_products_current %} aria-current="page"{% endif %}>Collection</a>
              </li>
              <li>
                {%- if blog_url != blank -%}
                  <a class="wm-nav__link" data-nav-plain href="{{ blog_url }}"{% if request.path contains blog_url %} aria-current="page"{% endif %}>Blog</a>
                {%- else -%}
                  <span class="wm-nav__link is-placeholder" data-nav-plain aria-disabled="true" title="Create a blog or set the link in the header settings">Blog</span>
                {%- endif -%}
              </li>
              <li>
                {%- if contact_url != blank -%}
                  <a class="wm-nav__link" data-nav-plain href="{{ contact_url }}"{% if request.path == contact_url %} aria-current="page"{% endif %}>Contact</a>
                {%- else -%}
                  <span class="wm-nav__link is-placeholder" data-nav-plain aria-disabled="true" title="Create a Contact page or set the link in the header settings">Contact</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          </ul>
        </nav>
      </div>

      {%- comment -%} ============ CENTER: original WAGMART logo ============ {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="wm-header__logo" aria-label="{{ shop.name | escape }} — home" data-nav-plain>
        {{ logo_markup }}
      </a>

      {%- comment -%} ============ END: search, account, cart ============ {%- endcomment -%}
      <div class="wm-header__end">
        <button
          type="button"
          class="wm-icon-btn"
          data-search-open
          aria-controls="WmSearch"
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-label="Search products"
        >
          {% render 'wm-icon', name: 'search' %}
        </button>

        {%- if shop.customer_accounts_enabled -%}
          <div class="wm-account" data-account>
            {%- comment -%}
              Shopify's own account component (passwordless email, Shop and social sign-in).
              It is controlled and secured by Shopify. If it is not available (e.g. local preview),
              the accessible fallback popover below is used instead.
            {%- endcomment -%}
            <shopify-account class="wm-account__component" menu="{{ account_menu_handle }}">
              <span slot="signed-out-avatar" class="wm-account__slot">
                {% render 'wm-icon', name: 'user' %}
                <span class="wm-sr-only">Account</span>
              </span>
            </shopify-account>

            <button
              type="button"
              class="wm-icon-btn wm-account__fallback"
              data-account-toggle
              aria-controls="WmAccountPop"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-label="{% if customer %}Your account{% else %}Sign in or create account{% endif %}"
            >
              {% render 'wm-icon', name: 'user' %}
            </button>

            <div
              class="wm-account-pop"
              id="WmAccountPop"
              role="dialog"
              aria-modal="false"
              aria-labelledby="WmAccountTitle"
              aria-hidden="true"
              data-account-pop
            >
              <div class="wm-account-pop__head">
                <h2 class="wm-account-pop__title" id="WmAccountTitle">
                  {%- if customer -%}
                    Hi{% if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif %}
                  {%- else -%}
                    Sign in or create account
                  {%- endif -%}
                </h2>
                <button type="button" class="wm-close-btn" data-account-close aria-label="Close account panel">
                  {% render 'wm-icon', name: 'close', class: 'wm-icon wm-icon--sm', stroke: 2 %}
                </button>
              </div>

              {%- if customer -%}
                <div class="wm-account-pop__stack">
                  <a class="wm-btn wm-btn--outline" href="{{ routes.account_logout_url }}">
                    {% render 'wm-icon', name: 'log-out', class: 'wm-icon wm-icon--sm' %}
                    <span class="wm-btn__label">Sign out</span>
                  </a>
                </div>
              {%- elsif accounts_legacy -%}
                {%- form 'customer_login', novalidate: 'novalidate', class: 'wm-login', data-login-form: '' -%}
                  <div class="wm-field">
                    <label class="wm-sr-only" for="WmLoginEmail">Email</label>
                    <input
                      class="wm-field__input"
                      type="email"
                      id="WmLoginEmail"
                      name="customer[email]"
                      autocomplete="email"
                      autocapitalize="off"
                      spellcheck="false"
                      placeholder="Email"
                      required
                      aria-describedby="WmLoginError"
                      data-login-email
                    >
                    <button type="submit" class="wm-field__submit" aria-label="Continue with email" data-login-continue>
                      {% render 'wm-icon', name: 'arrow-right', class: 'wm-icon wm-icon--sm', stroke: 1.75 %}
                    </button>
                  </div>
                  <div class="wm-field" data-login-password-row hidden>
                    <label class="wm-sr-only" for="WmLoginPassword">Password</label>
                    <input
                      class="wm-field__input"
                      type="password"
                      id="WmLoginPassword"
                      name="customer[password]"
                      autocomplete="current-password"
                      placeholder="Password"
                      aria-describedby="WmLoginError"
                      data-login-password
                    >
                  </div>
                  <p class="wm-error" id="WmLoginError" role="alert" aria-live="polite" data-login-error>
                    {%- if form.errors -%}{{ form.errors.messages['form'] | default: 'Incorrect email or password.' }}{%- endif -%}
                  </p>
                  <div class="wm-account-pop__stack" style="margin-top: 12px;">
                    <button type="submit" class="wm-btn wm-btn--primary" data-login-submit hidden>
                      <span class="wm-btn__label">Sign in</span>
                    </button>
                  </div>
                {%- endform -%}
                <div class="wm-divider">or</div>
                <a class="wm-btn wm-btn--outline" href="{{ routes.account_register_url }}">
                  <span class="wm-btn__label">Create account</span>
                </a>
              {%- else -%}
                <div class="wm-account-pop__stack">
                  <a class="wm-btn wm-btn--primary" href="{{ routes.account_login_url }}" data-account-link>
                    <span class="wm-btn__label">Continue with email</span>
                    {% render 'wm-icon', name: 'arrow-right', class: 'wm-icon wm-icon--sm', stroke: 1.75 %}
                  </a>
                  <a class="wm-btn wm-btn--outline" href="{{ routes.account_register_url }}" data-account-link>
                    <span class="wm-btn__label">Create account</span>
                  </a>
                </div>
                <p class="wm-account-pop__hint">Secure, passwordless sign-in powered by Shopify — we’ll email you a one-time code.</p>
              {%- endif -%}

              <div class="wm-account-pop__grid">
                <a class="wm-btn wm-btn--outline" href="{{ routes.account_url }}">
                  {% render 'wm-icon', name: 'package', class: 'wm-icon wm-icon--sm' %}
                  <span class="wm-btn__label">Orders</span>
                </a>
                <a class="wm-btn wm-btn--outline" href="{% if accounts_legacy %}{{ routes.account_addresses_url }}{% else %}{{ routes.account_url }}{% endif %}">
                  {% render 'wm-icon', name: 'user-circle', class: 'wm-icon wm-icon--sm' %}
                  <span class="wm-btn__label">Profile</span>
                </a>
              </div>
            </div>
          </div>
        {%- endif -%}

        <button
          type="button"
          class="wm-icon-btn"
          data-open-cart
          aria-controls="cart-drawer"
          aria-expanded="false"
          aria-haspopup="dialog"
          aria-label="Open cart"
        >
          {% render 'wm-icon', name: 'bag' %}
          <span class="wm-badge{% if cart.item_count == 0 %} hidden{% endif %}" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
          <span class="wm-sr-only" data-cart-count-label>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} in cart</span>
        </button>
      </div>
    </div>

    {%- comment -%} ============ DESKTOP DROPDOWN PANELS ============ {%- endcomment -%}
    <div class="wm-panel" id="WmPanelBest" data-panel="bestsellers" aria-labelledby="WmTriggerBest">
      <div class="wm-panel__inner">
        {% render 'header-bestsellers',
          layout: 'desktop',
          source_collection: section.settings.bestsellers_collection,
          limit: best_limit,
          show_preview: section.settings.show_catalog_preview,
          id_prefix: 'WmBest'
        %}
      </div>
    </div>
  </div>

  {%- comment -%} ============ MOBILE / TABLET NAVIGATION DRAWER ============ {%- endcomment -%}
  <div class="wm-drawer" id="WmMobileDrawer" data-drawer aria-hidden="true">
    <div class="wm-backdrop" data-drawer-close></div>
    <div class="wm-drawer__panel" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1">
      <div class="wm-drawer__head">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — home">{{ logo_markup }}</a>
        <button type="button" class="wm-close-btn" data-drawer-close aria-label="Close menu">
          {% render 'wm-icon', name: 'close', class: 'wm-icon wm-icon--sm', stroke: 2 %}
        </button>
      </div>

      <div class="wm-drawer__body">
        <ul class="wm-mnav">
          {%- if nav_links.size > 0 -%}
            {%- for link in nav_links -%}
              {%- assign link_handle = link.title | downcase -%}
              {%- if link_handle == 'shop' or link_handle contains 'bestseller' -%}
                <li>
                  <div class="wm-mnav__row">
                    <button type="button" class="wm-mnav__link" aria-expanded="false" aria-controls="WmMBest" data-accordion-toggle>{{ link.title }}</button>
                    <button type="button" class="wm-mnav__toggle" aria-expanded="false" aria-controls="WmMBest" aria-label="Show {{ link.title }} products" data-accordion-toggle>
                      {% render 'wm-icon', name: 'chevron-down', class: 'wm-nav__chevron' %}
                    </button>
                  </div>
                  <div class="wm-acc" id="WmMBest">
                    <div class="wm-acc__inner">
                      <div class="wm-acc__content">
                        {% render 'header-bestsellers',
                          layout: 'mobile',
                          source_collection: section.settings.bestsellers_collection,
                          limit: best_limit,
                          show_preview: section.settings.show_catalog_preview,
                          id_prefix: 'WmMBestC'
                        %}
                      </div>
                    </div>
                  </div>
                </li>
              {%- else -%}
                <li><a class="wm-mnav__link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <li>
              <div class="wm-mnav__row">
                <button type="button" class="wm-mnav__link" aria-expanded="false" aria-controls="WmMBest" data-accordion-toggle>Shop</button>
                <button type="button" class="wm-mnav__toggle" aria-expanded="false" aria-controls="WmMBest" aria-label="Show Shop products" data-accordion-toggle>
                  {% render 'wm-icon', name: 'chevron-down', class: 'wm-nav__chevron' %}
                </button>
              </div>
              <div class="wm-acc" id="WmMBest">
                <div class="wm-acc__inner">
                  <div class="wm-acc__content">
                    {% render 'header-bestsellers',
                      layout: 'mobile',
                      source_collection: section.settings.bestsellers_collection,
                      limit: best_limit,
                      show_preview: section.settings.show_catalog_preview,
                      id_prefix: 'WmMBestC'
                    %}
                  </div>
                </div>
              </div>
            </li>
            <li><a class="wm-mnav__link" href="{{ routes.all_products_collection_url }}">Collection</a></li>
            <li><a class="wm-mnav__link" href="{{ blog_url }}">Blog</a></li>
            <li><a class="wm-mnav__link" href="{{ contact_url }}">Contact</a></li>
          {%- endif -%}
          {%- if shop.customer_accounts_enabled -%}
            <li>
              <a class="wm-mnav__link" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
                <span>{% if customer %}My Account{% else %}My Account · Sign in{% endif %}</span>
                {% render 'wm-icon', name: 'user', class: 'wm-icon wm-icon--sm' %}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </div>

      {%- if section.settings.phone_number != blank -%}
        <div class="wm-drawer__foot">
          <a class="wm-btn wm-btn--outline" href="tel:{{ section.settings.phone_number | remove: ' ' }}">
            <span class="wm-btn__label">Order by phone · {{ section.settings.phone_number }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to use the bundled original WAGMART logo."
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Main navigation menu",
      "default": "main-menu",
      "info": "Select the menu created in Shopify Admin > Online Store > Navigation."
    },
    {
      "type": "header",
      "content": "Shop mega menu"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu",
      "info": "Optional. Top-level links become columns and their nested links become categories. If empty, the built-in WAGMART categories are used and each links to the collection with the matching handle."
    },
    {
      "type": "header",
      "content": "Bestsellers dropdown"
    },
    {
      "type": "collection",
      "id": "bestsellers_collection",
      "label": "Bestsellers collection",
      "info": "Choose a collection sorted by best selling. If empty, a collection with the handle 'bestsellers' is used, otherwise all products are shown as 'Featured picks'."
    },
    {
      "type": "range",
      "id": "bestsellers_limit",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_catalog_preview",
      "label": "Show catalog preview while the store has no products",
      "info": "Displays tagged, non-purchasable preview cards from the WAGMART catalog. Hidden automatically once real products exist.",
      "default": true
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "About link",
      "info": "Defaults to the page with handle 'about' or 'about-us'."
    },
    {
      "type": "url",
      "id": "blog_url",
      "label": "Blog link",
      "info": "Defaults to the blog with handle 'news' or 'blog'."
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link",
      "info": "Defaults to the page with handle 'contact' or 'contact-us'."
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "info": "Used by Shopify's account sheet. Defaults to 'customer-account-main-menu' (Orders, Profile)."
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Order phone number",
      "default": "+91 77779 85896"
    }
  ]
}
{% endschema %}
