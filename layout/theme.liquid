<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#7a46e5">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/x-icon" href="{{ 'favicon.ico' | asset_url }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% else %}
    <meta name="description" content="Wagmart offers curated, high-quality pet supplies for dogs and cats: grooming brushes, feeding bowls, collars, leashes, travel essentials, and hygiene products.">
  {% endif %}

  {% comment %} Open Graph & Social Sharing Meta Tags {% endcomment %}
  <meta property="og:site_name" content="{{ shop.name | default: 'Wagmart Pet Supplies' | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: 'Wagmart Pet Supplies' | escape }}">
  <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:description" content="{{ page_description | default: 'Curated, vet-tested pet supplies for happier, healthier dogs and cats.' | escape }}">
  {%- if template.name == 'product' and product.featured_image -%}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    <meta property="product:price:amount" content="{{ product.price | divided_by: 100 }}">
    <meta property="product:price:currency" content="INR">
  {%- endif -%}

  {% comment %} Google Fonts {% endcomment %}
  {%- # theme-check-disable RemoteAsset -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
  {%- # theme-check-enable RemoteAsset -%}

  {% comment %} Compiled Theme CSS with Tailwind utilities {% endcomment %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% comment %} WAGMART header / navigation (unlayered so it overrides Tailwind layers) {% endcomment %}
  {{ 'header.css' | asset_url | stylesheet_tag }}

  <script>
    window.Wagmart = { moneyFormat: {{ shop.money_format | json }} };
  </script>

  {{ content_for_header }}
</head>

<body class="bg-white text-[#1F2937] antialiased selection:bg-[#7a46e5]/20 selection:text-[#7a46e5] overflow-x-clip min-h-screen flex flex-col font-sans" style="background-color: #ffffff !important;">
 

  {% section 'header' %}

  <main id="MainContent" role="main" class="flex-1">
    {%- if request.path contains 'privacy-policy' or policy.title contains 'Privacy' -%}
      {% section 'main-privacy-policy' %}
    {%- elsif request.path contains 'refund' or request.path contains 'return' or policy.title contains 'Refund' or policy.title contains 'Return' -%}
      {% section 'main-refund-policy' %}
    {%- elsif request.path contains 'shipping' or policy.title contains 'Shipping' -%}
      {% section 'main-shipping-policy' %}
    {%- elsif request.path contains 'faq' or page.handle == 'faq' -%}
      {% section 'main-faq' %}
    {%- elsif request.path contains '/blogs/' and request.path != '/blogs/news' and request.path != '/blogs/news/' and request.path != '/blogs' and request.path != '/blogs/' -%}
      {% section 'main-article' %}
    {%- else -%}
      {{ content_for_layout }}
    {%- endif -%}
  </main>

  {% section 'footer' %}

  {% comment %} Drawers & Modals {% endcomment %}
  {% render 'cart-drawer' %}
  {% render 'wishlist-modal' %}
  {% render 'search-modal' %}
  {% render 'quick-view-modal' %}
  {% render 'reel-modal' %}

  {% comment %} Theme Engine Script {% endcomment %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'header.js' | asset_url }}" defer></script>
</body>
</html>
