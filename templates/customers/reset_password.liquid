{% comment %}
  Wagmart Reset Password Page
{% endcomment %}

<style>
  .wm-reset-section {
    background-color: #FBF9F7;
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px 80px;
    font-family: inherit;
  }
  .wm-reset-card {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 10px 40px -10px rgba(0, 0, 0, 0.05);
    padding: 40px 36px;
    width: 100%;
    max-width: 480px;
  }
  .wm-reset-title {
    font-size: 26px;
    font-weight: 800;
    color: #18181B;
    margin: 0 0 8px;
    text-align: center;
  }
  .wm-reset-subtitle {
    font-size: 14px;
    color: #71717A;
    margin: 0 0 24px;
    text-align: center;
  }
  .wm-reset-input {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    border: 1.5px solid #E4E4E7;
    border-radius: 12px;
    font-size: 14.5px;
    margin-bottom: 16px;
    box-sizing: border-box;
    font-family: inherit;
  }
  .wm-reset-input:focus {
    outline: none;
    border-color: #7A46E5;
  }
  .wm-reset-btn {
    width: 100%;
    height: 48px;
    background: #000000;
    color: #FFFFFF;
    border: none;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s ease;
  }
  .wm-reset-btn:hover {
    background: #222222;
  }
</style>

<div class="wm-reset-section">
  <div class="wm-reset-card">
    <h1 class="wm-reset-title">Reset Account Password</h1>
    <p class="wm-reset-subtitle">Enter a new password for your account</p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div style="background:#FEF2F2; color:#991B1B; border:1px solid #FECACA; padding:12px; border-radius:10px; margin-bottom:16px; font-size:13.5px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <label for="password" style="display:block; font-size:13.5px; font-weight:700; margin-bottom:6px;">New Password</label>
      <input type="password" name="customer[password]" id="password" required class="wm-reset-input" placeholder="New password">

      <label for="password_confirmation" style="display:block; font-size:13.5px; font-weight:700; margin-bottom:6px;">Confirm New Password</label>
      <input type="password" name="customer[password_confirmation]" id="password_confirmation" required class="wm-reset-input" placeholder="Confirm new password">

      <button type="submit" class="wm-reset-btn">Reset Password</button>
    {%- endform -%}
  </div>
</div>
