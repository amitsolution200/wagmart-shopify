{% comment %}
  Wagmart Customer Addresses Management Page
{% endcomment %}

<style>
  .wm-addr-section {
    background-color: #FBF9F7;
    min-height: calc(100vh - 200px);
    padding: 48px 20px 80px;
    font-family: inherit;
  }
  .wm-addr-container {
    max-width: 960px;
    margin: 0 auto;
  }
  .wm-addr-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .wm-addr-title {
    font-size: 26px;
    font-weight: 800;
    color: #18181B;
    margin: 0;
  }
  .wm-addr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }
  .wm-addr-card {
    background: #FFFFFF;
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 24px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02);
    position: relative;
    line-height: 1.6;
    font-size: 14px;
    color: #3F3F46;
  }
  .wm-addr-default-badge {
    display: inline-block;
    background: #ECFDF5;
    color: #065F46;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 9999px;
    margin-bottom: 10px;
  }
  .wm-addr-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background: #7A46E5;
    color: #FFFFFF;
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .wm-addr-btn:hover {
    background: #6938CE;
  }
  .wm-addr-btn--secondary {
    background: #F4F4F5;
    color: #27272A;
  }
  .wm-addr-btn--secondary:hover {
    background: #E4E4E7;
  }
  .wm-addr-back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #7A46E5;
    font-weight: 700;
    text-decoration: none;
    font-size: 14px;
    margin-bottom: 16px;
  }
</style>

<div class="wm-addr-section">
  <div class="wm-addr-container">

    <a href="{{ routes.account_url }}" class="wm-addr-back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      <span>Back to Account</span>
    </a>

    <div class="wm-addr-header">
      <h1 class="wm-addr-title">Your Addresses ({{ customer.addresses_count }})</h1>
    </div>

    <div class="wm-addr-grid">
      {%- for address in customer.addresses -%}
        <div class="wm-addr-card">
          {%- if address == customer.default_address -%}
            <span class="wm-addr-default-badge">Default Address</span>
          {%- endif -%}
          <p style="font-weight: 700; color: #18181B; margin: 0 0 4px;">{{ address.first_name }} {{ address.last_name }}</p>
          {{ address | format_address }}
        </div>
      {%- else -%}
        <div class="wm-addr-card" style="grid-column: 1 / -1; text-align: center; padding: 40px;">
          <p style="color: #71717A;">You have no saved addresses.</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>
