{% comment %}
  Wagmart Order Details Page
{% endcomment %}

<style>
  .wm-order-section {
    background-color: #FBF9F7;
    min-height: calc(100vh - 200px);
    padding: 48px 20px 80px;
    font-family: inherit;
  }
  .wm-order-container {
    max-width: 960px;
    margin: 0 auto;
  }
  .wm-order-card {
    background: #FFFFFF;
    border-radius: 20px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    padding: 32px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.02);
    margin-bottom: 24px;
  }
  .wm-order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #F4F4F5;
    padding-bottom: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .wm-order-title {
    font-size: 24px;
    font-weight: 800;
    color: #18181B;
    margin: 0 0 6px;
  }
  .wm-order-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-bottom: 24px;
  }
  .wm-order-table th {
    padding: 12px 14px;
    font-weight: 700;
    color: #71717A;
    font-size: 12.5px;
    text-transform: uppercase;
    border-bottom: 1.5px solid #F4F4F5;
    text-align: left;
  }
  .wm-order-table td {
    padding: 16px 14px;
    border-bottom: 1px solid #F4F4F5;
    color: #27272A;
  }
  .wm-order-summary-row {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 14px;
    color: #52525B;
  }
  .wm-order-summary-total {
    font-size: 17px;
    font-weight: 800;
    color: #18181B;
    border-top: 1.5px solid #E4E4E7;
    padding-top: 12px;
    margin-top: 8px;
  }
</style>

<div class="wm-order-section">
  <div class="wm-order-container">

    <a href="{{ routes.account_url }}" style="display:inline-flex; align-items:center; gap:6px; color:#7A46E5; font-weight:700; font-size:14px; text-decoration:none; margin-bottom:16px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      <span>Back to Account</span>
    </a>

    <div class="wm-order-card">
      <div class="wm-order-header">
        <div>
          <h1 class="wm-order-title">Order {{ order.name }}</h1>
          <p style="margin:0; font-size:14px; color:#71717A;">Placed on {{ order.created_at | time_tag: format: 'date_at_time' }}</p>
        </div>
        <div>
          <span style="background:#ECFDF5; color:#065F46; padding:6px 12px; border-radius:9999px; font-size:12.5px; font-weight:700;">
            {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}
          </span>
        </div>
      </div>

      {%- if order.cancelled -%}
        <div style="background:#FEF2F2; border:1px solid #FECACA; color:#991B1B; padding:12px 16px; border-radius:12px; margin-bottom:20px; font-size:13.5px;">
          <strong>Order Cancelled</strong> on {{ order.cancelled_at | time_tag: format: 'date_at_time' }} — Reason: {{ order.cancel_reason_label }}
        </div>
      {%- endif -%}

      <table class="wm-order-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>SKU</th>
            <th>Quantity</th>
            <th style="text-align:right;">Total</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr>
              <td>
                <div style="display:flex; align-items:center; gap:12px;">
                  {%- if line_item.image != blank -%}
                    <img
                      src="{{ line_item.image | image_url: width: 120 }}"
                      alt="{{ line_item.title | escape }}"
                      width="48"
                      height="48"
                      style="width:48px; height:48px; object-fit:contain; border-radius:8px; border:1px solid #E4E4E7; background:#FFFFFF;"
                    >
                  {%- endif -%}
                  <div>
                    <div style="font-weight:700;">
                      {%- if line_item.url != blank -%}
                        <a href="{{ line_item.url }}" style="color:#18181B; text-decoration:none;">{{ line_item.title }}</a>
                      {%- else -%}
                        {{ line_item.title }}
                      {%- endif -%}
                    </div>
                    {%- if line_item.variant.title != 'Default Title' and line_item.variant.title != blank -%}
                      <div style="font-size:13px; color:#71717A;">{{ line_item.variant.title }}</div>
                    {%- endif -%}
                    {%- if line_item.fulfillment -%}
                      <div style="font-size:12px; color:#065F46; margin-top:4px;">
                        Fulfilled {{ line_item.fulfillment.created_at | time_tag: format: 'date' }}
                        {%- if line_item.fulfillment.tracking_number -%}
                          · {{ line_item.fulfillment.tracking_company }}
                          {%- if line_item.fulfillment.tracking_url -%}
                            (<a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener" style="color:#7A46E5; font-weight:600;">#{{ line_item.fulfillment.tracking_number }}</a>)
                          {%- else -%}
                            (#{{ line_item.fulfillment.tracking_number }})
                          {%- endif -%}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </td>
              <td style="color:#71717A; font-size:13px;">{{ line_item.sku | default: '—' }}</td>
              <td>{{ line_item.quantity }}</td>
              <td style="text-align:right; font-weight:700;">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div style="max-width:320px; margin-left:auto;">
        <div class="wm-order-summary-row">
          <span>Subtotal</span>
          <span>{{ order.line_items_subtotal_price | money }}</span>
        </div>
        {%- for discount_application in order.cart_level_discount_applications -%}
          <div class="wm-order-summary-row" style="color:#065F46;">
            <span>Discount ({{ discount_application.title }})</span>
            <span>-{{ discount_application.total_allocated_amount | money }}</span>
          </div>
        {%- endfor -%}
        {%- for shipping_method in order.shipping_methods -%}
          <div class="wm-order-summary-row">
            <span>Shipping ({{ shipping_method.title }})</span>
            <span>{{ shipping_method.price | money }}</span>
          </div>
        {%- endfor -%}
        {%- for tax_line in order.tax_lines -%}
          <div class="wm-order-summary-row">
            <span>Tax ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</span>
            <span>{{ tax_line.price | money }}</span>
          </div>
        {%- endfor -%}
        <div class="wm-order-summary-row wm-order-summary-total">
          <span>Total</span>
          <span>{{ order.total_net_amount | default: order.total_price | money }}</span>
        </div>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:20px; margin-top:28px; padding-top:24px; border-top:1px solid #F4F4F5;">
        <div>
          <h2 style="font-size:13px; font-weight:700; text-transform:uppercase; color:#71717A; margin:0 0 8px;">Shipping Address</h2>
          <p style="font-size:13px; color:#52525B; margin:0 0 6px;"><strong>Fulfillment Status:</strong> {{ order.fulfillment_status_label }}</p>
          <div style="font-size:14px; color:#27272A; line-height:1.5;">
            {{ order.shipping_address | format_address }}
          </div>
        </div>
        <div>
          <h2 style="font-size:13px; font-weight:700; text-transform:uppercase; color:#71717A; margin:0 0 8px;">Billing Address</h2>
          <p style="font-size:13px; color:#52525B; margin:0 0 6px;"><strong>Payment Status:</strong> {{ order.financial_status_label }}</p>
          <div style="font-size:14px; color:#27272A; line-height:1.5;">
            {{ order.billing_address | format_address }}
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
