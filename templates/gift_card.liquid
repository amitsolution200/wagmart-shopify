{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} - Gift Card</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="bg-white text-[#111827] flex items-center justify-center min-h-screen p-4 font-sans">
  <div class="max-w-md w-full bg-white rounded-3xl p-8 border border-[#EAE5D9] text-center space-y-4 shadow-sm">
    <h1 class="text-2xl font-bold text-[#111827]">{{ shop.name }} Gift Card</h1>
    <div class="py-4">
      <p class="text-3xl font-extrabold text-[#7a46e5]">{{ gift_card.initial_value | money_with_currency }}</p>
      {% if gift_card.enabled == false or gift_card.expired %}
        <p class="text-xs text-red-500 font-semibold mt-2">Expired or Disabled</p>
      {% endif %}
    </div>
    <div class="p-3 bg-neutral-50 rounded-xl border border-dashed border-[#D5CEBF] font-mono text-sm font-bold">
      {{ gift_card.code | format_code }}
    </div>
    <a href="{{ shop.url }}" class="inline-block mt-4 px-6 py-2.5 rounded-full bg-[#7a46e5] text-white text-xs font-bold hover:opacity-90 transition">
      Start Shopping
    </a>
  </div>
</body>
</html>
