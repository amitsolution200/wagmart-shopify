# ============================================================================
# WAGMART SHOPIFY STORE & MCP CONFIGURATION (.env.example)
# Copy this file to `.env` (which is gitignored) and fill in your token.
# NEVER commit `.env` or any `shpat_...` token to Git.
# ============================================================================

# Connected Shopify Store Domain
SHOPIFY_STORE_DOMAIN=gk2scz-zu.myshopify.com

# Shopify Theme IDs (Verified via `shopify theme list`)
SHOPIFY_DEV_THEME_ID=159000527020
SHOPIFY_LIVE_THEME_ID=158971429036

# Official Shopify Admin GraphQL API Version
SHOPIFY_API_VERSION=2025-01

# Shopify Custom App Admin API Access Token (starts with shpat_...)
# How to generate in Shopify Admin (https://admin.shopify.com/store/gk2scz-zu):
# 1. Go to Settings -> Apps and sales channels -> Develop apps -> Create an app ("Wagmart AI Editor MCP")
# 2. Click "Configure Admin API scopes" and select minimum required scopes:
#    - Read scopes: read_products, read_inventory, read_content, read_themes,
#      read_online_store_navigation, read_metaobject_definitions, read_metaobjects,
#      read_locales, read_markets, read_discounts, read_shipping, read_orders, read_customers
#    - Optional Write scopes (approval-gated): write_products, write_content, write_themes
# 3. Click "Install app" and copy the Admin API access token below:
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional Storefront API Public Access Token
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
