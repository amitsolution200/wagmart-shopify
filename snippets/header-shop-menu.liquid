{%- comment -%}
  WAGMART Shop menu (desktop mega menu columns OR mobile accordion groups).

  Data source priority:
    1. `shop_menu` (a Shopify navigation menu chosen in the header settings).
       Top-level links become columns, their child links become category links.
    2. Built-in WAGMART taxonomy (derived from the product catalog PDF).
       Each category resolves to a collection by handle. If the collection does
       not exist yet, the item renders as a non-clickable, clearly marked
       "Soon" placeholder instead of a broken link.

  Params:
    layout    - 'desktop' (default) | 'mobile'
    shop_menu - linklist (optional)
    id_prefix - string for unique ids
{%- endcomment -%}

{%- liquid
  assign layout = layout | default: 'desktop'
  assign id_prefix = id_prefix | default: 'wm-shop'
  assign use_menu = false
  if shop_menu != blank and shop_menu.links.size > 0
    assign use_menu = true
  endif
-%}

{%- capture wm_taxonomy -%}
Grooming & Care~grooming-care~Grooming Brushes:grooming-brushes|Deshedding Tools:deshedding-tools|Grooming Gloves:grooming-gloves|Pet Combs:pet-combs|Nail Clippers & Grinders:nail-clippers-grinders|Bath & Massage Brushes:bath-massage-brushes|Pet Grooming Kits:pet-grooming-kits
^^Hygiene & Cleaning~hygiene-cleaning~Pet Wipes:pet-wipes|Ear Cleaning Products:ear-cleaning|Lint Removers:lint-removers|Pet Hair Removers:pet-hair-removers|Cleaning Accessories:cleaning-accessories|Pet Care Sprays:pet-care-sprays
^^Walking & Travel~walking-travel~Dog Collars:dog-collars|Dog Leashes:dog-leashes|Retractable Leashes:retractable-leashes|Harnesses & Walking Accessories:harnesses-walking-accessories|Car Seat Covers & Barriers:car-seat-covers-barriers|Pet Travel Accessories:pet-travel-accessories
^^Feeding & Play~feeding-play~Feeding Bowls:feeding-bowls|Food & Water Dispensers:food-water-dispensers|Slow Feeders:slow-feeders|Treats & Chews:treats-chews|Dog Toys:dog-toys|Interactive Toys:interactive-toys
{%- endcapture -%}

{%- assign wm_columns = wm_taxonomy | strip | split: '^^' -%}

{%- if layout == 'desktop' -%}
  <div class="wm-mega">
    {%- if use_menu -%}
      {%- for column in shop_menu.links -%}
        <div class="wm-mega__col">
          <a class="wm-mega__heading" id="{{ id_prefix }}-h-{{ forloop.index }}" href="{{ column.url }}">
            <span class="wm-mega__heading-dot" aria-hidden="true"></span>{{ column.title | escape }}
          </a>
          {%- if column.links.size > 0 -%}
            <ul class="wm-mega__list" aria-labelledby="{{ id_prefix }}-h-{{ forloop.index }}">
              {%- for child in column.links -%}
                <li><a class="wm-mega__link" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for column_raw in wm_columns -%}
        {%- liquid
          assign parts = column_raw | strip | split: '~'
          assign col_title = parts[0] | strip
          assign col_handle = parts[1] | strip
          assign col_collection = collections[col_handle]
          assign col_items = parts[2] | strip | split: '|'
          assign col_id = id_prefix | append: '-h-' | append: forloop.index
        -%}
        <div class="wm-mega__col">
          {%- if col_collection.id != blank -%}
            <a class="wm-mega__heading" id="{{ col_id }}" href="{{ col_collection.url }}">
              <span class="wm-mega__heading-dot" aria-hidden="true"></span>{{ col_title | escape }}
            </a>
          {%- else -%}
            <p class="wm-mega__heading" id="{{ col_id }}">
              <span class="wm-mega__heading-dot" aria-hidden="true"></span>{{ col_title | escape }}
            </p>
          {%- endif -%}
          <ul class="wm-mega__list" aria-labelledby="{{ col_id }}">
            {%- for item_raw in col_items -%}
              {%- liquid
                assign item_parts = item_raw | split: ':'
                assign item_title = item_parts[0] | strip
                assign item_handle = item_parts[1] | strip
                assign item_collection = collections[item_handle]
              -%}
              <li>
                {%- if item_collection.id != blank -%}
                  <a class="wm-mega__link" href="{{ item_collection.url }}"{% if collection.handle == item_handle %} aria-current="page"{% endif %}>{{ item_title | escape }}</a>
                {%- else -%}
                  <span class="wm-mega__link is-placeholder" data-missing-collection="{{ item_handle }}" title="This collection ({{ item_handle }}) has not been created yet">
                    {{- item_title | escape -}}
                    <span class="wm-soon">Soon<span class="wm-sr-only"> — collection not available yet</span></span>
                  </span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

{%- else -%}
  {%- comment -%} Mobile: nested accordion groups {%- endcomment -%}
  <div class="wm-mgroups">
    {%- if use_menu -%}
      {%- for column in shop_menu.links -%}
        {%- assign group_id = id_prefix | append: '-g-' | append: forloop.index -%}
        <div class="wm-mgroup">
          {%- if column.links.size > 0 -%}
            <button type="button" class="wm-mgroup__toggle" aria-expanded="false" aria-controls="{{ group_id }}" data-accordion-toggle>
              <span>{{ column.title | escape }}</span>
              {% render 'wm-icon', name: 'chevron-down', class: 'wm-nav__chevron' %}
            </button>
            <div class="wm-acc" id="{{ group_id }}">
              <div class="wm-acc__inner">
                <ul class="wm-mega__list">
                  <li><a class="wm-mega__link" href="{{ column.url }}">View all {{ column.title | escape }}</a></li>
                  {%- for child in column.links -%}
                    <li><a class="wm-mega__link" href="{{ child.url }}">{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          {%- else -%}
            <a class="wm-mgroup__toggle" href="{{ column.url }}">{{ column.title | escape }}</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for column_raw in wm_columns -%}
        {%- liquid
          assign parts = column_raw | strip | split: '~'
          assign col_title = parts[0] | strip
          assign col_handle = parts[1] | strip
          assign col_collection = collections[col_handle]
          assign col_items = parts[2] | strip | split: '|'
          assign group_id = id_prefix | append: '-g-' | append: forloop.index
        -%}
        <div class="wm-mgroup">
          <button type="button" class="wm-mgroup__toggle" aria-expanded="false" aria-controls="{{ group_id }}" data-accordion-toggle>
            <span>{{ col_title | escape }}</span>
            {% render 'wm-icon', name: 'chevron-down', class: 'wm-nav__chevron' %}
          </button>
          <div class="wm-acc" id="{{ group_id }}">
            <div class="wm-acc__inner">
              <ul class="wm-mega__list">
                {%- if col_collection.id != blank -%}
                  <li><a class="wm-mega__link" href="{{ col_collection.url }}">View all {{ col_title | escape }}</a></li>
                {%- endif -%}
                {%- for item_raw in col_items -%}
                  {%- liquid
                    assign item_parts = item_raw | split: ':'
                    assign item_title = item_parts[0] | strip
                    assign item_handle = item_parts[1] | strip
                    assign item_collection = collections[item_handle]
                  -%}
                  <li>
                    {%- if item_collection.id != blank -%}
                      <a class="wm-mega__link" href="{{ item_collection.url }}">{{ item_title | escape }}</a>
                    {%- else -%}
                      <span class="wm-mega__link is-placeholder" data-missing-collection="{{ item_handle }}">
                        {{- item_title | escape -}}
                        <span class="wm-soon">Soon<span class="wm-sr-only"> — collection not available yet</span></span>
                      </span>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}
