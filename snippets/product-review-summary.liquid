{%- comment -%}
  Reusable Customer Reviews & Rating Summary Component (snippets/product-review-summary.liquid)
{%- endcomment -%}

<section id="reviews" class="wm-pdp-section scroll-mt-24" aria-labelledby="wm-reviews-heading">
  <div class="wm-section-header">
    <div>
      <p class="wm-section-eyebrow">VERIFIED PET PARENTS</p>
      <h2 id="wm-reviews-heading" class="wm-section-title">Customer Reviews &amp; Ratings</h2>
    </div>
  </div>

  <div class="wm-reviews-layout">
    {%- comment -%} Left: Rating Summary & Star Bar Breakdown (5 -> 1) {%- endcomment -%}
    <aside class="wm-reviews-summary" aria-label="Overall rating breakdown">
      <div class="wm-reviews-summary__top">
        <span class="wm-reviews-summary__big-score">4.8</span>
        <div>
          <div class="wm-stars" aria-label="4.8 out of 5 stars">
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <p style="margin:4px 0 0;font-size:13px;color:#6B7280;font-weight:600;">Based on 126 verified reviews</p>
        </div>
      </div>

      <div class="wm-reviews-summary__bars">
        <div class="wm-review-bar">
          <span class="wm-review-bar__label">5 ★</span>
          <div class="wm-review-bar__track"><div class="wm-review-bar__fill" style="width: 82%"></div></div>
          <span class="wm-review-bar__pct">82%</span>
        </div>
        <div class="wm-review-bar">
          <span class="wm-review-bar__label">4 ★</span>
          <div class="wm-review-bar__track"><div class="wm-review-bar__fill" style="width: 13%"></div></div>
          <span class="wm-review-bar__pct">13%</span>
        </div>
        <div class="wm-review-bar">
          <span class="wm-review-bar__label">3 ★</span>
          <div class="wm-review-bar__track"><div class="wm-review-bar__fill" style="width: 3%"></div></div>
          <span class="wm-review-bar__pct">3%</span>
        </div>
        <div class="wm-review-bar">
          <span class="wm-review-bar__label">2 ★</span>
          <div class="wm-review-bar__track"><div class="wm-review-bar__fill" style="width: 1%"></div></div>
          <span class="wm-review-bar__pct">1%</span>
        </div>
        <div class="wm-review-bar">
          <span class="wm-review-bar__label">1 ★</span>
          <div class="wm-review-bar__track"><div class="wm-review-bar__fill" style="width: 1%"></div></div>
          <span class="wm-review-bar__pct">1%</span>
        </div>
      </div>

      <button type="button" class="wm-btn-write-review" data-toggle-review-form>
        Write a Review
      </button>
    </aside>

    {%- comment -%} Right: Review Form + Sort Toolbar + Review Cards {%- endcomment -%}
    <div>
      {%- comment -%} Write a Review Expandable Form {%- endcomment -%}
      <div id="wm-review-form-box" class="wm-review-form-box hidden">
        <h3 style="margin:0 0 12px;font-size:17px;font-weight:700;color:#111827;">Share Your Experience</h3>
        <form id="wm-new-review-form">
          <div class="wm-review-form__grid" style="margin-bottom:12px;">
            <input type="text" name="reviewer_name" class="wm-review-form__input" placeholder="Your Name (e.g. Priya Desai, Surat)" required>
            <input type="text" name="review_title" class="wm-review-form__input" placeholder="Review Headline" required>
          </div>
          <textarea name="review_body" rows="3" class="wm-review-form__textarea" placeholder="How did your dog or cat like the grooming glove?" required style="margin-bottom:12px;"></textarea>
          <button type="submit" class="wm-pincode__btn">Submit Review</button>
        </form>
      </div>

      <div class="wm-reviews-toolbar">
        <span style="font-size:14px;font-weight:700;color:#111827;">Showing 4 of 126 Reviews</span>
        <div style="display:flex;align-items:center;gap:8px;">
          <label for="wm-reviews-sort" style="font-size:13px;color:#6B7280;font-weight:600;">Sort by:</label>
          <select id="wm-reviews-sort" class="wm-reviews-sort">
            <option value="helpful">Most Helpful</option>
            <option value="newest">Newest First</option>
            <option value="highest">Highest Rating</option>
            <option value="lowest">Lowest Rating</option>
            <option value="photos">With Photos</option>
          </select>
        </div>
      </div>

      <div class="wm-review-cards" id="wm-reviews-list">
        {%- comment -%} Review 1 {%- endcomment -%}
        <article class="wm-review-card" data-review-card data-rating="5" data-date="20261018" data-has-photo="true">
          <div class="wm-review-card__head">
            <div class="wm-review-card__author">
              <span class="wm-review-card__avatar">AP</span>
              <div>
                <div class="wm-review-card__name">
                  <span>Aarav Patel &bull; Surat</span>
                  <span class="wm-verified-badge">✓ Verified Buyer</span>
                </div>
                <div class="wm-stars" aria-label="5 out of 5 stars">★★★★★</div>
              </div>
            </div>
            <span class="wm-review-card__date">18 Oct 2026</span>
          </div>
          <h4 class="wm-review-card__title">My Golden Retriever actually looks forward to bath &amp; brush time now!</h4>
          <p class="wm-review-card__body">
            Traditional wire slicker brushes always made Bruno run away. These soft silicone bristles feel like a gentle massage while trapping so much loose undercoat fur. Built-in shampoo dispenser ring on top lathers up effortlessly during bath time!
          </p>
          <div class="wm-review-card__photos">
            <img src="{{ 'Happy Soapy Dog Grooming Scene.png' | asset_url }}" alt="Customer photo of Golden Retriever being brushed" class="wm-review-card__photo" width="68" height="68" loading="lazy">
            <img src="{{ 'dog-groomed.webp' | asset_url }}" alt="Customer photo after grooming" class="wm-review-card__photo" width="68" height="68" loading="lazy">
          </div>
        </article>

        {%- comment -%} Review 2 {%- endcomment -%}
        <article class="wm-review-card" data-review-card data-rating="5" data-date="20261012" data-has-photo="true">
          <div class="wm-review-card__head">
            <div class="wm-review-card__author">
              <span class="wm-review-card__avatar">NM</span>
              <div>
                <div class="wm-review-card__name">
                  <span>Neha Mehta &bull; Mumbai</span>
                  <span class="wm-verified-badge">✓ Verified Buyer</span>
                </div>
                <div class="wm-stars" aria-label="5 out of 5 stars">★★★★★</div>
              </div>
            </div>
            <span class="wm-review-card__date">12 Oct 2026</span>
          </div>
          <h4 class="wm-review-card__title">Works wonders on both my Persian cat and Indie dog</h4>
          <p class="wm-review-card__body">
            Super gentle on sensitive skin and pulls off shed hair in one neat sheet. Rinses clean under the tap in 10 seconds. At ₹330 this is easily the best grooming investment we've made.
          </p>
          <div class="wm-review-card__photos">
            <img src="{{ 'cat-relaxing.webp' | asset_url }}" alt="Relaxed cat after brushing" class="wm-review-card__photo" width="68" height="68" loading="lazy">
          </div>
        </article>

        {%- comment -%} Review 3 {%- endcomment -%}
        <article class="wm-review-card" data-review-card data-rating="4" data-date="20261004" data-has-photo="false">
          <div class="wm-review-card__head">
            <div class="wm-review-card__author">
              <span class="wm-review-card__avatar">RS</span>
              <div>
                <div class="wm-review-card__name">
                  <span>Rohan Sharma &bull; Ahmedabad</span>
                  <span class="wm-verified-badge">✓ Verified Buyer</span>
                </div>
                <div class="wm-stars" aria-label="4 out of 5 stars">★★★★☆</div>
              </div>
            </div>
            <span class="wm-review-card__date">4 Oct 2026</span>
          </div>
          <h4 class="wm-review-card__title">Very ergonomic grip and fast next-day delivery</h4>
          <p class="wm-review-card__body">
            Fits snugly in the palm without slipping even when soapy. Reduced shedding on our sofa by at least 70%. Highly recommend getting the 2-pack if you have two pets.
          </p>
        </article>
      </div>
    </div>
  </div>
</section>
