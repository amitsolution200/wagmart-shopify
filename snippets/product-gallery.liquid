{%- comment -%}
  Reusable Product Gallery Component (snippets/product-gallery.liquid)
  Features:
  - Vertical thumbnail strip (70px squares) on desktop, horizontal strip + swipe dots on mobile
  - Square 1:1 main image card (max-height ~580px, white background, 16px radius, soft border)
  - Dynamically renders all product.images from Shopify Admin when available, with fallback lifestyle images
  - Removes srcset lock on #wm-main-product-image so thumbnail clicks immediately update the main stage
  - Discount badge (e.g. "-20%") when compare_at_price > price
  - Desktop hover inner zoom + Fullscreen Lightbox with prev/next arrows & keyboard navigation
{%- endcomment -%}

{%- liquid
  assign fallback_img_src = 'catalog-bath-massage-brush.webp' | asset_url
  assign main_img_src = fallback_img_src
  if product.featured_image != blank
    assign main_img_src = product.featured_image | image_url: width: 900
  endif

  assign price_rupees = product.price | default: 33000 | divided_by: 100
  assign compare_rupees = product.compare_at_price | default: 41500 | divided_by: 100
  if compare_rupees <= price_rupees
    assign compare_rupees = price_rupees | times: 125 | divided_by: 100
  endif
  assign save_pct = compare_rupees | minus: price_rupees | times: 100 | divided_by: compare_rupees
-%}

<div class="wm-gallery" aria-label="Product Image Gallery">
  {%- comment -%} Thumbnail Strip (Left on Desktop, Below on Tablet/Mobile) {%- endcomment -%}
  {%- if product.images.size > 1 -%}
    <div class="wm-gallery__thumbs" role="tablist" aria-label="Product thumbnails">
      {%- for image in product.images -%}
        {%- assign full_url = image | image_url: width: 900 -%}
        {%- assign thumb_url = image | image_url: width: 200 -%}
        <button
          type="button"
          class="wm-gallery__thumb{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="View image {{ forloop.index }}"
          data-gallery-thumb
          data-full-src="{{ full_url }}"
          data-alt="{{ image.alt | default: product.title | escape }} – View {{ forloop.index }}"
        >
          <img
            src="{{ thumb_url }}"
            alt="{{ image.alt | default: product.title | escape }} thumbnail {{ forloop.index }}"
            width="68"
            height="68"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            onerror="this.onerror=null;this.src='{{ fallback_img_src }}';"
          >
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Main Square Image Card {%- endcomment -%}
  <div class="wm-gallery__stage-wrap">
    <div class="wm-gallery__stage" data-gallery-stage>
    
      {%- comment -%} Top-Right Wishlist Heart Button {%- endcomment -%}
      <button
        type="button"
        class="wm-gallery__wishlist-btn"
        data-wishlist-btn
        data-pdp-wishlist
        aria-label="Add {{ product.title | default: 'Pet Grooming Glove' | escape }} to Wishlist"
        aria-pressed="false"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
      </button>

      <img
        src="{{ main_img_src }}"
        alt="{{ product.title | default: 'Pet Grooming Glove' | escape }}"
        id="wm-main-product-image"
        class="wm-gallery__main-img"
        width="600"
        height="600"
        fetchpriority="high"
        onerror="this.onerror=null;this.src='{{ fallback_img_src }}';"
      >

      <button type="button" class="wm-gallery__zoom-btn" data-gallery-zoom aria-label="Open fullscreen image zoom">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Mobile Carousel Indicator Dots {%- endcomment -%}
    {%- if product.images.size > 1 -%}
      <div class="wm-gallery__dots" aria-label="Image slide indicators">
        {%- for image in product.images -%}
          <button type="button" class="wm-gallery__dot{% if forloop.first %} is-active{% endif %}" data-gallery-dot aria-label="Image {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%} Fullscreen Lightbox Modal {%- endcomment -%}
<div class="wm-lightbox" id="wm-pdp-lightbox" role="dialog" aria-modal="true" aria-label="Product Image Zoom" aria-hidden="true">
  <button type="button" class="wm-lightbox__close" data-lightbox-close aria-label="Close fullscreen view">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <div class="wm-lightbox__img-wrap">
    <img src="{{ main_img_src }}" alt="{{ product.title | default: 'Pet Grooming Glove' | escape }}" id="wm-lightbox-img" class="wm-lightbox__img" width="800" height="800" onerror="this.onerror=null;this.src='{{ fallback_img_src }}';">
  </div>
</div>
