{%- comment -%}
  Reusable Product Gallery Component (snippets/product-gallery.liquid)
  Features:
  - Vertical thumbnail strip (70px squares) on desktop, horizontal strip + swipe dots on mobile
  - Square 1:1 main image card (max-height ~580px, white background, 16px radius, soft border)
  - Dynamically renders all product.images from Shopify Admin when available, with fallback lifestyle images
  - Removes srcset lock on #wm-main-product-image so thumbnail clicks immediately update the main stage
  - Discount badge (e.g. "-20%") when compare_at_price > price
  - Desktop hover inner zoom + Fullscreen Lightbox with prev/next arrows & keyboard navigation
{%- endcomment -%}

{%- liquid
  assign fallback_img_src = 'catalog-bath-massage-brush.webp' | asset_url
  assign main_img_src = fallback_img_src
  if product.featured_image != blank
    assign main_img_src = product.featured_image | image_url: width: 900
  endif

  assign img_2_src = 'Happy Soapy Dog Grooming Scene.png' | asset_url
  assign img_3_src = 'Gentle Pet Bath Brush Guide.png' | asset_url
  assign img_4_src = 'Gentle Pet Bath Brush Essentials.png' | asset_url

  assign price_rupees = product.price | default: 33000 | divided_by: 100
  assign compare_rupees = product.compare_at_price | default: 41500 | divided_by: 100
  if compare_rupees <= price_rupees
    assign compare_rupees = price_rupees | times: 125 | divided_by: 100
  endif
  assign save_pct = compare_rupees | minus: price_rupees | times: 100 | divided_by: compare_rupees
-%}

<div class="wm-gallery" aria-label="Product Image Gallery">
  {%- comment -%} Thumbnail Strip (Left on Desktop, Below on Tablet/Mobile) {%- endcomment -%}
  <div class="wm-gallery__thumbs" role="tablist" aria-label="Product thumbnails">
    {%- if product.images.size > 1 -%}
      {%- for image in product.images -%}
        {%- assign full_url = image | image_url: width: 900 -%}
        {%- assign thumb_url = image | image_url: width: 200 -%}
        <button
          type="button"
          class="wm-gallery__thumb{% if forloop.first %} is-active{% endif %}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-label="View image {{ forloop.index }}"
          data-gallery-thumb
          data-full-src="{{ full_url }}"
          data-alt="{{ image.alt | default: product.title | escape }} – View {{ forloop.index }}"
        >
          <img
            src="{{ thumb_url }}"
            alt="{{ image.alt | default: product.title | escape }} thumbnail {{ forloop.index }}"
            width="68"
            height="68"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            onerror="this.onerror=null;this.src='{{ fallback_img_src }}';"
          >
        </button>
      {%- endfor -%}
    {%- else -%}
      <button
        type="button"
        class="wm-gallery__thumb is-active"
        role="tab"
        aria-selected="true"
        aria-label="View image 1: Studio Front View"
        data-gallery-thumb
        data-full-src="{{ main_img_src }}"
        data-alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} – Studio Front View"
      >
        <img
          src="{{ main_img_src }}"
          alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} thumbnail 1"
          width="68"
          height="68"
          onerror="this.onerror=null;this.src='{{ fallback_img_src }}';"
        >
      </button>

      <button
        type="button"
        class="wm-gallery__thumb"
        role="tab"
        aria-selected="false"
        aria-label="View image 2: Soft Silicone Bristles in Action"
        data-gallery-thumb
        data-full-src="{{ img_2_src }}"
        data-alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} – Gentle Soapy Massage in Action"
      >
        <img
          src="{{ img_2_src }}"
          alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} thumbnail 2"
          width="68"
          height="68"
          loading="lazy"
        >
      </button>

      <button
        type="button"
        class="wm-gallery__thumb"
        role="tab"
        aria-selected="false"
        aria-label="View image 3: Features & Benefits Guide"
        data-gallery-thumb
        data-full-src="{{ img_3_src }}"
        data-alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} – Key Benefits & Silicone Bristles"
      >
        <img
          src="{{ img_3_src }}"
          alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} thumbnail 3"
          width="68"
          height="68"
          loading="lazy"
        >
      </button>

      <button
        type="button"
        class="wm-gallery__thumb"
        role="tab"
        aria-selected="false"
        aria-label="View image 4: Deep Cleansing & Care Guide"
        data-gallery-thumb
        data-full-src="{{ img_4_src }}"
        data-alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} – Deep Cleansing Care"
      >
        <img
          src="{{ img_4_src }}"
          alt="{{ product.title | default: 'Pet Grooming Glove' | escape }} thumbnail 4"
          width="68"
          height="68"
          loading="lazy"
        >
      </button>
    {%- endif -%}
  </div>

  {%- comment -%} Main Square Image Card {%- endcomment -%}
  <div class="wm-gallery__stage-wrap">
    <div class="wm-gallery__stage" data-gallery-stage>
      {%- if save_pct > 0 -%}
        <span class="wm-gallery__discount-badge">{{ save_pct }}% off</span>
      {%- endif -%}

      <button type="button" class="wm-gallery__nav-btn wm-gallery__nav-btn--prev" data-gallery-prev aria-label="Previous image">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <img
        src="{{ main_img_src }}"
        alt="{{ product.title | default: 'Pet Grooming Glove' | escape }}"
        id="wm-main-product-image"
        class="wm-gallery__main-img"
        width="600"
        height="600"
        fetchpriority="high"
        onerror="this.onerror=null;this.src='{{ fallback_img_src }}';"
      >

      <button type="button" class="wm-gallery__nav-btn wm-gallery__nav-btn--next" data-gallery-next aria-label="Next image">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <button type="button" class="wm-gallery__zoom-btn" data-gallery-zoom aria-label="Open fullscreen image zoom">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Mobile Carousel Indicator Dots {%- endcomment -%}
    <div class="wm-gallery__dots" aria-label="Image slide indicators">
      {%- if product.images.size > 1 -%}
        {%- for image in product.images -%}
          <button type="button" class="wm-gallery__dot{% if forloop.first %} is-active{% endif %}" data-gallery-dot aria-label="Image {{ forloop.index }}"></button>
        {%- endfor -%}
      {%- else -%}
        <button type="button" class="wm-gallery__dot is-active" data-gallery-dot aria-label="Image 1"></button>
        <button type="button" class="wm-gallery__dot" data-gallery-dot aria-label="Image 2"></button>
        <button type="button" class="wm-gallery__dot" data-gallery-dot aria-label="Image 3"></button>
        <button type="button" class="wm-gallery__dot" data-gallery-dot aria-label="Image 4"></button>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} Fullscreen Lightbox Modal {%- endcomment -%}
<div class="wm-lightbox" id="wm-pdp-lightbox" role="dialog" aria-modal="true" aria-label="Product Image Zoom" aria-hidden="true">
  <button type="button" class="wm-lightbox__close" data-lightbox-close aria-label="Close fullscreen view">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <button type="button" class="wm-lightbox__arrow wm-lightbox__arrow--prev" data-lightbox-prev aria-label="Previous image">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <div class="wm-lightbox__img-wrap">
    <img src="{{ main_img_src }}" alt="{{ product.title | default: 'Pet Grooming Glove' | escape }}" id="wm-lightbox-img" class="wm-lightbox__img" width="800" height="800" onerror="this.onerror=null;this.src='{{ fallback_img_src }}';">
  </div>
  <button type="button" class="wm-lightbox__arrow wm-lightbox__arrow--next" data-lightbox-next aria-label="Next image">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
</div>
