{% comment %}
  Renders interactive Wagmart Product Card (Converted from React ProductCard)
  - 4:5 aspect ratio with rounded-[20px] and overflow-hidden
  - Smooth 500ms hover image swap (fades out primary image, zooms in secondary image)
  - Inside content: bottom left (title + price in default store Rupees ₹)
  - Heart toggle: top right (toggles wishlist / favorite)
  - Inside bottom right: On-hover Add to Cart button that transforms into - / + quantity stepper
  - Fully responsive across mobile, tablet, and desktop
{% endcomment %}

{%- liquid
  assign is_related = is_related | default: false
  assign fallback_asset_img = 'catalog-bath-massage-brush.webp' | asset_url
  if product != blank and mock_id == blank
    assign prod_id = product.selected_or_first_available_variant.id | default: product.variants.first.id | default: product.id
    assign prod_handle = product.handle
    assign prod_sku = product.selected_or_first_available_variant.sku | default: ''
    assign prod_available = true
    assign prod_title = product.title
    assign prod_url = product.url
    assign prod_desc = product.description | strip_html | strip
    if prod_desc == blank
      assign prod_desc = 'Crafted with pet-safe, vet-approved materials for daily comfort and care.'
    endif
    assign prod_price_num = product.price | divided_by: 100
    assign prod_price = '₹' | append: prod_price_num
    assign prod_comp_num = 0
    assign prod_compare_price = ''
    if product.compare_at_price > product.price
      assign prod_comp_num = product.compare_at_price | divided_by: 100
      assign prod_compare_price = '₹' | append: prod_comp_num
    else
      assign prod_comp_num = prod_price_num | times: 125 | divided_by: 100 | round
      assign prod_compare_price = '₹' | append: prod_comp_num
    endif

    if product.featured_image != blank
      assign prod_image = product.featured_image | image_url: width: 700
    else
      assign prod_image = fallback_asset_img
    endif

    assign prod_hover_image = ''
    if product.images.size > 1
      assign prod_hover_image = product.images[1] | image_url: width: 700
    endif

    assign prod_images_list = ''
    if product.images.size > 0
      for img_obj in product.images limit: 8
        assign img_u = img_obj | image_url: width: 800
        if prod_images_list == blank
          assign prod_images_list = img_u
        else
          assign prod_images_list = prod_images_list | append: '|' | append: img_u
        endif
      endfor
    else
      assign prod_images_list = prod_image
    endif
    assign prod_badge = mock_badge | default: ''

    assign p_cols_text = ''
    for col in product.collections
      assign p_cols_text = p_cols_text | append: ' ' | append: col.title | append: ' ' | append: col.handle
    endfor
    assign p_tags_text = product.tags | join: ' '
    assign search_meta = product.title | append: ' ' | append: product.type | append: ' ' | append: p_tags_text | append: ' ' | append: p_cols_text | downcase

    assign cat_list = ''
    if search_meta contains 'groom' or search_meta contains 'brush' or search_meta contains 'glove' or search_meta contains 'shampoo' or search_meta contains 'bath' or search_meta contains 'massage' or search_meta contains 'slicker' or search_meta contains 'comb' or search_meta contains 'rake' or search_meta contains 'deshed' or search_meta contains 'roller' or search_meta contains 'hair' or search_meta contains 'fur' or search_meta contains 'nail' or search_meta contains 'clipper' or search_meta contains 'grinder'
      assign cat_list = cat_list | append: 'grooming,'
    endif
    if search_meta contains 'feed' or search_meta contains 'bowl' or search_meta contains 'water' or search_meta contains 'dispenser' or search_meta contains 'bottle' or search_meta contains 'food' or search_meta contains 'kibble' or search_meta contains 'treat' or search_meta contains 'meal'
      assign cat_list = cat_list | append: 'feeding,'
    endif
    if search_meta contains 'hygiene' or search_meta contains 'care' or search_meta contains 'health' or search_meta contains 'supplement' or search_meta contains 'vitamin' or search_meta contains 'dental' or search_meta contains 'tooth' or search_meta contains 'oral' or search_meta contains 'paw' or search_meta contains 'cleaner' or search_meta contains 'shampoo' or search_meta contains 'wipe' or search_meta contains 'nail' or search_meta contains 'grinder' or search_meta contains 'clipper'
      assign cat_list = cat_list | append: 'hygiene,'
    endif
    if search_meta contains 'toy' or search_meta contains 'ball' or search_meta contains 'rope' or search_meta contains 'chew' or search_meta contains 'plush' or search_meta contains 'squeak' or search_meta contains 'play' or search_meta contains 'teaser'
      assign cat_list = cat_list | append: 'toys,'
    endif
    if search_meta contains 'travel' or search_meta contains 'carrier' or search_meta contains 'car' or search_meta contains 'seat' or search_meta contains 'hammock' or search_meta contains 'walk' or search_meta contains 'leash' or search_meta contains 'harness' or search_meta contains 'bottle' or search_meta contains 'bag' or search_meta contains 'accessor'
      assign cat_list = cat_list | append: 'travel,'
    endif
    if search_meta contains 'collar' or search_meta contains 'leash' or search_meta contains 'harness' or search_meta contains 'rope' or search_meta contains 'retractable' or search_meta contains 'fashion' or search_meta contains 'apparel' or search_meta contains 'bandana' or search_meta contains 'accessor'
      assign cat_list = cat_list | append: 'collars,'
    endif
    if cat_list == blank
      assign cat_list = product.type | default: 'grooming' | downcase
    endif
    assign prod_category = cat_list
  else
    assign prod_id = mock_id | default: 'prod-default'
    assign prod_handle = ''
    assign prod_sku = ''
    assign prod_available = true
    assign prod_title = mock_title | default: 'Paw Cleaner Kit'
    assign prod_url = mock_url | default: collections['all'].products.first.url | default: '/products/pet-grooming-glove'
    assign prod_desc = mock_subtitle | default: mock_desc | default: 'All-in-one gentle silicone dog paw washing cup and grooming slicker brush kit.'
    assign prod_price = mock_price | default: '₹799'
    assign prod_compare_price = mock_original_price | default: mock_compare_price | default: ''
    if mock_image contains '/'
      assign prod_image = mock_image
    else
      assign prod_image = mock_image | default: 'paw-cleaner-kit.webp' | asset_url
    endif
    assign prod_hover_image = mock_hover_image | default: ''
    assign prod_images_list = prod_image
    assign prod_badge = mock_badge | default: ''
    assign prod_category = mock_category | default: 'grooming'
  endif
-%}

{%- assign discount_pct = 0 -%}
{%- if prod_comp_num > prod_price_num and prod_comp_num > 0 -%}
  {%- assign diff = prod_comp_num | minus: prod_price_num -%}
  {%- assign discount_pct = diff | times: 100 | divided_by: prod_comp_num | round -%}
{%- endif -%}

{%- assign badge_label = '' -%}
{%- assign cat_first = prod_category | split: ',' | first | default: 'Grooming' | strip | capitalize -%}
{%- if cat_first != blank -%}
  {%- assign badge_label = cat_first -%}
{%- elsif prod_badge != blank -%}
  {%- assign badge_label = prod_badge | capitalize -%}
{%- else -%}
  {%- assign badge_label = 'Grooming' -%}
{%- endif -%}

<div
  class="wm-unified-card wm-react-card group relative w-full flex flex-col select-none transition-all duration-300 cursor-pointer"
  data-product-card
  data-product-id="{{ prod_id }}"
  data-handle="{{ prod_handle | escape }}"
  data-sku="{{ prod_sku | escape }}"
  data-available="{{ prod_available }}"
  data-product-url="{{ prod_url }}"
  data-product-name="{{ prod_title | escape }}"
  data-product-price="{{ prod_price }}"
  data-product-original-price="{{ prod_compare_price }}"
  data-product-compare-price="{{ prod_compare_price }}"
  data-product-image="{{ prod_image }}"
  data-images="{{ prod_images_list | escape }}"
  data-product-category="{{ prod_category | escape }}"
  data-product-desc="{{ prod_desc | escape }}"
  data-title="{{ prod_title | escape }}"
  data-category="{{ prod_category | split: ',' | first | default: 'Grooming' | escape }}"
  data-price="{{ prod_price_num | default: 330 }}"
  data-compare-price="{{ prod_comp_num | default: 0 }}"
  data-image="{{ prod_image }}"
  data-url="{{ prod_url }}"
  data-desc="{{ prod_desc | escape }}"
  role="region"
  aria-label="{{ prod_title | escape }}"
>
  <!-- Image Container (Rounded 20px, Overflow Hidden, #FBFBF7 Background, No Border) -->
  <div class="wm-react-card__image-box relative w-full aspect-[4/5] rounded-[20px] overflow-hidden bg-[#FBFBF7] border-0 transition-all duration-500">
    <!-- Full card product link -->
    <a href="{{ prod_url }}" class="wm-unified-card__media block w-full h-full relative" aria-label="{{ prod_title | escape }}">
      <!-- Primary Image -->
      <img
        src="{{ prod_image }}"
        alt="{{ prod_title | escape }}"
        loading="lazy"
        width="600"
        height="750"
        class="wm-react-card__img-primary absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        onerror="this.onerror=null;this.src='{{ fallback_asset_img }}';"
      >
    </a>

    <!-- Top Left: Category Badge (Glassmorphic pill with black text) -->
    {%- if badge_label != blank -%}
      <span class="wm-card__badge" aria-label="Category {{ badge_label | escape }}">
        {{ badge_label }}
      </span>
    {%- endif -%}

    <!-- Top Right Actions: Heart Wishlist & Eye Quick View directly below it -->
    <div class="wm-card__top-right-actions absolute top-2 right-2 sm:top-2.5 sm:right-2.5 z-20 flex flex-col items-center gap-1.5 pointer-events-auto">
      <!-- 1. Heart Wishlist Button -->
      <button
        type="button"
        class="wm-react-card__wishlist w-7 h-7 rounded-full bg-white/95 hover:bg-white text-neutral-800 shadow-sm backdrop-blur-xs flex items-center justify-center p-0.5 cursor-pointer transition-all duration-200 hover:scale-110 active:scale-95"
        data-wishlist-btn
        data-wishlist-toggle
        data-product-id="{{ prod_id }}"
        aria-label="Wishlist {{ prod_title | escape }}"
      >
        <svg class="w-3.5 h-3.5 transition-colors duration-200 stroke-2 text-neutral-700 hover:text-[#E11D48]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
        </svg>
      </button>

      <!-- 2. Eye Quick View Button Below Heart (Opens Quick View on Click) -->
      <button
        type="button"
        class="wm-card__side-qv w-7 h-7 rounded-full bg-white/95 hover:bg-white text-neutral-800 shadow-sm backdrop-blur-xs flex items-center justify-center p-0.5 cursor-pointer transition-all duration-200 hover:scale-110 active:scale-95"
        data-quick-view-trigger
        data-quick-view="{{ prod_handle | default: prod_id | default: 'pet-grooming-glove' | escape }}"
        aria-label="Quick View {{ prod_title | escape }}"
      >
        <svg class="w-3.5 h-3.5 stroke-[2] text-neutral-700 hover:text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
    </div>

    <!-- Bottom Inside Image: Add To Bag Button (White Pill) & Active Stepper -->
    <div class="wm-card__img-qv-wrap absolute inset-x-2.5 bottom-2.5 sm:bottom-3 z-20 flex justify-center pointer-events-none">
      <button
        type="button"
        class="wm-card__img-qv-btn pointer-events-auto flex items-center justify-center gap-1.5 w-full h-7 sm:h-7.5 px-3 rounded-full bg-white/95 hover:bg-white text-neutral-900 text-[10.5px] sm:text-[11px] font-semibold shadow-md backdrop-blur-xs transition-all duration-200 hover:scale-[1.02] active:scale-95 cursor-pointer whitespace-nowrap"
        data-add-to-cart
        aria-label="Add {{ prod_title | escape }} to Bag"
      >
        {% render 'icon-bag', class: 'w-3.5 h-3.5 stroke-[2.2]' %}
        <span>Add To Bag</span>
      </button>

      <!-- Stepper when product is in cart -->
      <div
        class="hidden pointer-events-auto w-full"
        data-card-stepper
      >
        <button
          type="button"
          data-card-stepper-btn
          data-delta="-1"
          aria-label="Decrease quantity"
        >
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>

        <span data-card-qty>
          1
        </span>

        <button
          type="button"
          data-card-stepper-btn
          data-delta="1"
          aria-label="Increase quantity"
        >
          <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Content Below Image Box (Reference matching layout) -->
  <div class="wm-card__info pt-2 pb-0.5 text-left flex flex-col items-start w-full flex-1">
    <!-- Product Heading / Title -->
    <h3 class="wm-card__title text-[13px] sm:text-[14.5px] leading-tight font-bold text-neutral-900 truncate w-full">
      <a href="{{ prod_url }}" class="hover:underline text-neutral-900 block truncate" aria-label="{{ prod_title | escape }}">
        {{ prod_title }}
      </a>
    </h3>

    <!-- Bottom Row: Price -->
    <div class="wm-card__bottom-row flex items-center justify-between gap-1.5 w-full pt-2">
      <div data-price-wrap class="flex flex-col items-start leading-none shrink min-w-0">
        <div class="flex items-baseline gap-1.5 truncate">
          <span class="wm-card__price font-bold text-[13.5px] sm:text-[15px] text-neutral-900 tracking-tight" data-price-val>{{ prod_price }}</span>
          {%- if prod_compare_price != blank -%}
            <span class="wm-card__compare-price text-neutral-400 line-through text-[9px] sm:text-[11px]" data-compare-val>{{ prod_compare_price }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>
