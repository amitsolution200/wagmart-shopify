{% comment %}
  Renders interactive Wagmart Product Card (Exact Unified Design across Homepage, Collection Page, Cart Page & Product Details Page)
  Accepts:
  - product: {Object} Shopify Product Object (optional)
  - mock_id: {String} Fallback product ID
  - mock_title: {String} Fallback title
  - mock_subtitle: {String} Fallback subtitle
  - mock_price: {String} Fallback price string
  - mock_original_price: {String} Fallback compare price
  - mock_image: {String} Fallback image asset name or URL
  - mock_badge: {String} Fallback badge label
  - mock_category: {String} Fallback category key
{% endcomment %}

{%- liquid
  assign fallback_asset_img = 'catalog-bath-massage-brush.webp' | asset_url
  if product != blank and mock_id == blank
    assign prod_id = product.selected_or_first_available_variant.id | default: product.variants.first.id | default: product.id
    assign prod_handle = product.handle
    assign prod_sku = product.selected_or_first_available_variant.sku | default: ''
    assign prod_available = true
    assign prod_title = product.title
    assign prod_url = product.url
    assign prod_desc = product.description | strip_html | strip
    if prod_desc == blank
      assign prod_desc = 'Crafted with pet-safe, vet-approved materials for daily comfort and care.'
    endif
    assign prod_price_num = product.price | divided_by: 100
    assign prod_price = '₹' | append: prod_price_num
    assign prod_comp_num = 0
    assign prod_compare_price = ''
    if product.compare_at_price > product.price
      assign prod_comp_num = product.compare_at_price | divided_by: 100
      assign prod_compare_price = '₹' | append: prod_comp_num
    endif
    if product.featured_image != blank
      assign prod_image = product.featured_image | image_url: width: 640
    else
      assign prod_image = fallback_asset_img
    endif
    assign prod_images_list = ''
    if product.images.size > 0
      for img_obj in product.images limit: 8
        assign img_u = img_obj | image_url: width: 800
        if prod_images_list == blank
          assign prod_images_list = img_u
        else
          assign prod_images_list = prod_images_list | append: '|' | append: img_u
        endif
      endfor
    else
      assign prod_images_list = prod_image
    endif
    assign prod_badge = mock_badge | default: 'Best Seller'

    assign p_cols_text = ''
    for col in product.collections
      assign p_cols_text = p_cols_text | append: ' ' | append: col.title | append: ' ' | append: col.handle
    endfor
    assign p_tags_text = product.tags | join: ' '
    assign search_meta = product.title | append: ' ' | append: product.type | append: ' ' | append: p_tags_text | append: ' ' | append: p_cols_text | downcase

    assign cat_list = ''
    if search_meta contains 'groom' or search_meta contains 'brush' or search_meta contains 'glove' or search_meta contains 'shampoo' or search_meta contains 'bath' or search_meta contains 'massage' or search_meta contains 'slicker' or search_meta contains 'comb' or search_meta contains 'rake' or search_meta contains 'deshed' or search_meta contains 'roller' or search_meta contains 'hair' or search_meta contains 'fur' or search_meta contains 'nail' or search_meta contains 'clipper' or search_meta contains 'grinder'
      assign cat_list = cat_list | append: 'grooming,'
    endif
    if search_meta contains 'feed' or search_meta contains 'bowl' or search_meta contains 'water' or search_meta contains 'dispenser' or search_meta contains 'bottle' or search_meta contains 'food' or search_meta contains 'kibble' or search_meta contains 'treat' or search_meta contains 'meal'
      assign cat_list = cat_list | append: 'feeding,'
    endif
    if search_meta contains 'hygiene' or search_meta contains 'care' or search_meta contains 'health' or search_meta contains 'supplement' or search_meta contains 'vitamin' or search_meta contains 'dental' or search_meta contains 'tooth' or search_meta contains 'oral' or search_meta contains 'paw' or search_meta contains 'cleaner' or search_meta contains 'shampoo' or search_meta contains 'wipe' or search_meta contains 'nail' or search_meta contains 'grinder' or search_meta contains 'clipper'
      assign cat_list = cat_list | append: 'hygiene,'
    endif
    if search_meta contains 'toy' or search_meta contains 'ball' or search_meta contains 'rope' or search_meta contains 'chew' or search_meta contains 'plush' or search_meta contains 'squeak' or search_meta contains 'play' or search_meta contains 'teaser'
      assign cat_list = cat_list | append: 'toys,'
    endif
    if search_meta contains 'travel' or search_meta contains 'carrier' or search_meta contains 'car' or search_meta contains 'seat' or search_meta contains 'hammock' or search_meta contains 'walk' or search_meta contains 'leash' or search_meta contains 'harness' or search_meta contains 'bottle' or search_meta contains 'bag' or search_meta contains 'accessor'
      assign cat_list = cat_list | append: 'travel,'
    endif
    if search_meta contains 'collar' or search_meta contains 'leash' or search_meta contains 'harness' or search_meta contains 'rope' or search_meta contains 'retractable' or search_meta contains 'fashion' or search_meta contains 'apparel' or search_meta contains 'bandana' or search_meta contains 'accessor'
      assign cat_list = cat_list | append: 'collars,'
    endif
    if cat_list == blank
      assign cat_list = product.type | default: 'grooming' | downcase
    endif
    assign prod_category = cat_list
  else
    assign prod_id = mock_id | default: 'prod-default'
    assign prod_handle = ''
    assign prod_sku = ''
    assign prod_available = true
    assign prod_title = mock_title | default: 'Paw Cleaner Kit'
    assign prod_url = mock_url | default: collections['all'].products.first.url | default: '/products/pet-grooming-glove'
    assign prod_desc = mock_subtitle | default: mock_desc | default: 'All-in-one gentle silicone dog paw washing cup and grooming slicker brush kit.'
    assign prod_price = mock_price | default: '₹799'
    assign prod_compare_price = mock_original_price | default: mock_compare_price | default: ''
    if mock_image contains '/'
      assign prod_image = mock_image
    else
      assign prod_image = mock_image | default: 'paw-cleaner-kit.webp' | asset_url
    endif
    assign prod_images_list = prod_image
    assign prod_badge = mock_badge | default: 'Best Seller'
    assign prod_category = mock_category | default: 'grooming'
  endif
-%}

<div
  class="wm-unified-card group relative shrink-0 w-[85vw] max-w-[340px] sm:w-[320px] md:w-[325px] lg:w-[335px] bg-[#FAF8F5] rounded-[22px] p-3 pb-4 border border-[#EAE5D9] hover:border-[#D5CEBF] select-none transition-all duration-300 flex flex-col justify-between snap-start cursor-pointer"
  data-product-card
  data-product-id="{{ prod_id }}"
  data-handle="{{ prod_handle | escape }}"
  data-sku="{{ prod_sku | escape }}"
  data-available="{{ prod_available }}"
  data-product-url="{{ prod_url }}"
  data-product-name="{{ prod_title | escape }}"
  data-product-price="{{ prod_price }}"
  data-product-original-price="{{ prod_compare_price }}"
  data-product-compare-price="{{ prod_compare_price }}"
  data-product-image="{{ prod_image }}"
  data-images="{{ prod_images_list | escape }}"
  data-product-category="{{ prod_category | escape }}"
  data-product-desc="{{ prod_desc | escape }}"
  data-title="{{ prod_title | escape }}"
  data-category="{{ prod_category | split: ',' | first | default: 'Grooming' | escape }}"
  data-price="{{ prod_price_num | default: 330 }}"
  data-compare-price="{{ prod_comp_num | default: 0 }}"
  data-image="{{ prod_image }}"
  data-url="{{ prod_url }}"
  data-desc="{{ prod_desc | escape }}"
  role="region"
  aria-label="{{ prod_title | escape }}"
>
  <div class="wm-unified-card__top">
    {% comment %} 1. HERO IMAGE STAGE {% endcomment %}
    <div class="wm-unified-card__media relative w-full h-[205px] sm:h-[210px] rounded-[14px] overflow-hidden bg-white/80 shrink-0 select-none flex items-center justify-center p-2.5">
      <a href="{{ prod_url }}" class="w-full h-full flex items-center justify-center" aria-label="{{ prod_title | escape }}">
        <img
          src="{{ prod_image }}"
          alt="{{ prod_title | escape }}"
          class="w-full h-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
          loading="lazy"
          width="300"
          height="210"
          onerror="this.onerror=null;this.src='{{ fallback_asset_img }}';"
        >
      </a>

      {% comment %} Top-Left Category Badge {% endcomment %}
      <div class="absolute top-[12px] left-[12px] z-10 pointer-events-none">
        <span class="h-[24px] px-3 inline-flex items-center justify-center rounded-[7px] text-[11px] font-semibold leading-none tracking-normal bg-white text-neutral-800 shadow-[0_1px_3px_rgba(0,0,0,0.08)]">
          {{ prod_badge }}
        </span>
      </div>

      {% comment %} Top-Right Wishlist Heart + Quick View Eye Buttons {% endcomment %}
      <div class="absolute top-[12px] right-[12px] z-10 flex flex-col gap-1.5">
        <button
          type="button"
          class="w-9 h-9 rounded-full bg-white text-neutral-800 shadow-[0_1px_4px_rgba(0,0,0,0.1)] flex items-center justify-center cursor-pointer transition-all hover:scale-105 active:scale-95"
          data-wishlist-btn
          aria-label="Wishlist {{ prod_title | escape }}"
        >
          <svg class="w-4.5 h-4.5 transition-transform duration-200 stroke-2 text-neutral-700 hover:text-[#E11D48]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
          </svg>
        </button>

        <button
          type="button"
          class="w-9 h-9 rounded-full bg-white text-neutral-800 shadow-[0_1px_4px_rgba(0,0,0,0.1)] flex items-center justify-center cursor-pointer transition-all hover:scale-105 active:scale-95"
          data-plp-qv-trigger
          data-quick-view-trigger
          aria-label="Quick view {{ prod_title | escape }}"
        >
          <svg class="w-4 h-4 text-neutral-700 hover:text-[#1B3A2A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>
    </div>

    {% comment %} 2. PRODUCT TITLE & SUBTITLE {% endcomment %}
    <div class="wm-unified-card__info px-1.5 pt-3.5">
      <h3 class="font-jakarta text-[17.5px] font-bold text-[#111827] leading-[25px] line-clamp-2 group-hover:text-[#7a46e5] transition-colors duration-200">
        <a href="{{ prod_url }}" class="hover:underline">{{ prod_title }}</a>
      </h3>

      <p class="mt-2 text-[13px] text-neutral-500 leading-[19.5px] line-clamp-2 font-normal">
        {{ prod_desc }}
      </p>
    </div>
  </div>

  {% comment %} 3. BOTTOM ROW: PRICE LOCKUP & ADD TO CART / STEPPER {% endcomment %}
  <div class="wm-unified-card__bottom px-1 mt-auto pt-3 sm:pt-4 flex items-center justify-between gap-2">
    {% comment %} Price Lockup {% endcomment %}
    <div data-price-wrap class="flex items-baseline flex-wrap gap-x-1.5 gap-y-0.5 min-w-0 pr-1">
      <span data-price-val class="font-extrabold text-[19px] sm:text-[22px] text-[#111827] tracking-tight leading-none whitespace-nowrap">
        {{ prod_price }}
      </span>
      {%- if prod_compare_price != blank -%}
        <span data-compare-val class="text-[11.5px] sm:text-[13px] text-neutral-400 line-through font-normal whitespace-nowrap">
          {{ prod_compare_price }}
        </span>
      {%- endif -%}
    </div>

    {% comment %} Right CTA Button / Quantity Stepper Transformation {% endcomment %}
    <div class="relative shrink-0 flex items-center justify-end">
      {% comment %} Default Add to Cart Button {% endcomment %}
      <button
        type="button"
        class="h-[38px] sm:h-[42px] bg-black hover:bg-neutral-900 active:scale-95 text-white pl-1.5 pr-3.5 sm:pr-4 py-1 rounded-full flex items-center gap-1.5 sm:gap-2 shadow-sm transition-all duration-200 cursor-pointer group/btn shrink-0"
        data-add-to-cart
        aria-label="Add {{ prod_title | escape }} to Cart"
      >
        <span class="w-7 h-7 sm:w-7.5 sm:h-7.5 rounded-full bg-white text-black flex items-center justify-center shrink-0 group-hover/btn:scale-105 transition-transform duration-200 shadow-xs">
          {% render 'icon-bag', class: 'w-3.5 h-3.5 stroke-[2.2]' %}
        </span>
        <span class="font-bold text-[12px] sm:text-[13px] tracking-tight whitespace-nowrap">
          Add to Cart
        </span>
      </button>

      {% comment %} Active Quantity Stepper (Shown when in cart) {% endcomment %}
      <div
        class="hidden h-[38px] sm:h-[42px] bg-black text-white px-1.5 py-1 rounded-full flex items-center gap-1.5 shadow-sm transition-all duration-200 shrink-0"
        data-card-stepper
      >
        <button
          type="button"
          class="w-7 h-7 sm:w-7.5 sm:h-7.5 rounded-full bg-white hover:bg-gray-100 active:scale-90 text-black flex items-center justify-center transition-all cursor-pointer shadow-xs shrink-0"
          data-card-stepper-btn
          data-delta="-1"
          aria-label="Decrease quantity"
        >
          <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>

        <span class="text-white font-extrabold text-[12.5px] sm:text-[13px] px-1 sm:px-1.5 min-w-[18px] text-center select-none shrink-0" data-card-qty>
          1
        </span>

        <button
          type="button"
          class="w-7 h-7 sm:w-7.5 sm:h-7.5 rounded-full bg-white hover:bg-gray-100 active:scale-90 text-black flex items-center justify-center transition-all cursor-pointer shadow-xs shrink-0"
          data-card-stepper-btn
          data-delta="1"
          aria-label="Increase quantity"
        >
          <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>
      </div>
    </div>
  </div>
</div>
