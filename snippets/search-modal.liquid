{% comment %}
  Renders Wagmart Instant Predictive Search Modal
{% endcomment %}

<div id="search-modal" class="hidden fixed inset-0 z-50 overflow-y-auto p-4 sm:p-6 lg:p-20 flex items-start justify-center" role="dialog" aria-modal="true" aria-label="Search Catalog">
  {% comment %} Backdrop {% endcomment %}
  <div class="fixed inset-0 bg-black/50 backdrop-blur-xs transition-opacity" data-close-search></div>

  <div class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl border border-[#EAE5D9] overflow-hidden z-10 animate-in fade-in zoom-in-95 duration-200">
    
    {% comment %} Search Input Bar {% endcomment %}
    <div class="p-4 sm:p-5 border-b border-[#F0EBE1] flex items-center gap-3 bg-[#FAF8F5]">
      {% render 'icon-search', class: 'w-5 h-5 text-gray-400 flex-shrink-0' %}
      <input
        type="text"
        id="search-modal-input"
        placeholder="Search Wagmart catalog (e.g. glove, bowls, wipes, leash)..."
        class="w-full text-base sm:text-lg bg-transparent text-gray-900 placeholder-gray-400 focus:outline-hidden"
        autocomplete="off"
      >
      <button
        type="button"
        class="px-2.5 py-1 text-xs font-semibold text-gray-500 hover:text-gray-900 rounded-lg hover:bg-gray-100 cursor-pointer"
        data-close-search
      >
        ESC
      </button>
    </div>

    {% comment %} Quick Search Pills {% endcomment %}
    <div class="px-5 py-3 bg-[#F9F7F2] border-b border-[#F0EBE1] flex items-center gap-2 overflow-x-auto no-scrollbar">
      <span class="text-xs font-semibold text-gray-500 whitespace-nowrap">Popular:</span>
      <button type="button" class="px-3 py-1 rounded-full text-xs font-medium bg-white hover:bg-[#7a46e5] hover:text-white border border-[#EAE5D9] text-gray-700 transition cursor-pointer whitespace-nowrap shadow-2xs" data-search-pill="Grooming">Grooming</button>
      <button type="button" class="px-3 py-1 rounded-full text-xs font-medium bg-white hover:bg-[#7a46e5] hover:text-white border border-[#EAE5D9] text-gray-700 transition cursor-pointer whitespace-nowrap shadow-2xs" data-search-pill="Bowls">Bowls</button>
      <button type="button" class="px-3 py-1 rounded-full text-xs font-medium bg-white hover:bg-[#7a46e5] hover:text-white border border-[#EAE5D9] text-gray-700 transition cursor-pointer whitespace-nowrap shadow-2xs" data-search-pill="Leash">Leash</button>
      <button type="button" class="px-3 py-1 rounded-full text-xs font-medium bg-white hover:bg-[#7a46e5] hover:text-white border border-[#EAE5D9] text-gray-700 transition cursor-pointer whitespace-nowrap shadow-2xs" data-search-pill="Seat Cover">Seat Cover</button>
      <button type="button" class="px-3 py-1 rounded-full text-xs font-medium bg-white hover:bg-[#7a46e5] hover:text-white border border-[#EAE5D9] text-gray-700 transition cursor-pointer whitespace-nowrap shadow-2xs" data-search-pill="Wipes">Wipes</button>
      <button type="button" class="px-3 py-1 rounded-full text-xs font-medium bg-white hover:bg-[#7a46e5] hover:text-white border border-[#EAE5D9] text-gray-700 transition cursor-pointer whitespace-nowrap shadow-2xs" data-search-pill="Toys">Toys</button>
    </div>

    {% comment %} Results Container {% endcomment %}
    <div id="search-results-list" class="max-h-[60vh] overflow-y-auto p-4 sm:p-5 space-y-3">
      <div class="text-center py-10 text-gray-400 text-sm">
        Type keywords above to search all authentic Wagmart catalog supplies.
      </div>
    </div>

  </div>
</div>
