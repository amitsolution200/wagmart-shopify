{%- comment -%}
  WAGMART search panel.
  Live suggestions come from Shopify's Predictive Search API (routes.predictive_search_url),
  i.e. only real, indexed store products and collections. Pressing Enter submits to the
  standard search results page.
{%- endcomment -%}

<div
  class="wm-search"
  id="WmSearch"
  data-search
  data-predictive-url="{{ routes.predictive_search_url }}"
  data-search-url="{{ routes.search_url }}"
  aria-hidden="true"
>
  <div class="wm-backdrop" data-search-close></div>

  <div class="wm-search__panel" role="dialog" aria-modal="true" aria-label="Search products">
    <form class="wm-search__form" action="{{ routes.search_url }}" method="get" role="search" data-search-form>
      {% render 'wm-icon', name: 'search' %}
      <label class="wm-sr-only" for="WmSearchInput">Search pet products</label>
      <input
        class="wm-search__input"
        id="WmSearchInput"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search pet products..."
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="WmSearchResults"
        data-search-input
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="button" class="wm-search__clear" data-search-clear hidden>Clear</button>
      <button type="button" class="wm-close-btn" data-search-close aria-label="Close search">
        {% render 'wm-icon', name: 'close', class: 'wm-icon wm-icon--sm', stroke: 2 %}
      </button>
    </form>

    <div class="wm-search__body">
      {%- comment -%} Idle state: suggested queries {%- endcomment -%}
      <div data-search-idle>
        <p class="wm-search__label">Popular searches</p>
        <div class="wm-chips">
          {%- assign suggestions = 'Dog brush,Pet wipes,Dog leash,Slow feeder,Grooming glove' | split: ',' -%}
          {%- for term in suggestions -%}
            <button type="button" class="wm-chip" data-search-term="{{ term }}">
              {% render 'wm-icon', name: 'search', class: 'wm-icon wm-icon--xs', stroke: 2 %}
              {{ term }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Live region: loading / results / empty / error (rendered by header.js) {%- endcomment -%}
      <div id="WmSearchResults" data-search-results aria-live="polite" hidden></div>
    </div>
  </div>
</div>
