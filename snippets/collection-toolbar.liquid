{%- comment -%}
  Wagmart Collection Toolbar & Active Filter Chips Row (snippets/collection-toolbar.liquid)
  - Sticky under header when scrolling
  - Left: "Filter" toggle button with active count badge + dynamic result count
  - Right: "Sort by:" dropdown + 2 View Switcher buttons ONLY (Grid View & List View)
  - Active Filter Chips row below toolbar with removable dark-green pills and "Clear All" link
{%- endcomment -%}

{%- assign total_items = collection.products.size | default: 0 -%}
{%- assign active_filter_count = 0 -%}
{%- for filter in collection.filters -%}
  {%- case filter.type -%}
    {%- when 'list', 'boolean' -%}
      {%- for value in filter.values -%}
        {%- if value.active -%}
          {%- assign active_filter_count = active_filter_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- when 'price_range' -%}
      {%- if filter.min_value.value or filter.max_value.value -%}
        {%- assign active_filter_count = active_filter_count | plus: 1 -%}
      {%- endif -%}
  {%- endcase -%}
{%- endfor -%}

<div class="wm-plp-toolbar-wrap" data-plp-toolbar-wrap>
  <div class="wm-plp-toolbar" role="region" aria-label="Collection controls">
    <div class="wm-plp-toolbar__left">
      <button
        type="button"
        class="wm-plp-toolbar__filter-btn"
        data-plp-filter-toggle
        aria-expanded="true"
        aria-controls="wm-plp-sidebar"
      >
        {%- comment -%} Lucide: list-collapse {%- endcomment -%}
        <svg class="lucide lucide-list-collapse" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M10 5h11"/><path d="M10 12h11"/><path d="M10 19h11"/><path d="m3 10 3-3-3-3"/><path d="m3 20 3-3-3-3"/>
        </svg>
        <span>Filter</span>
        <span class="wm-plp-toolbar__filter-badge" data-plp-filter-badge {% if active_filter_count == 0 %}hidden{% endif %}>{{ active_filter_count }}</span>
      </button>

      <p class="wm-plp-toolbar__results" data-plp-results-text aria-live="polite">
        {%- if total_items == 1 -%}
          Showing <strong>1</strong> of <strong>1</strong> result (1 product)
        {%- elsif total_items > 1 -%}
          Showing <strong>1&ndash;{{ total_items }}</strong> of <strong>{{ total_items }}</strong> results ({{ total_items }} products)
        {%- else -%}
          Showing <strong>0</strong> results
        {%- endif -%}
      </p>
    </div>

    <div class="wm-plp-toolbar__right">
      <div class="wm-plp-toolbar__sort">
        <label for="wm-plp-sort-select" class="wm-plp-toolbar__sort-label">Sort by:</label>
        <div class="wm-plp-toolbar__sort-select-wrap">
          <select id="wm-plp-sort-select" class="wm-plp-toolbar__sort-select" data-plp-sort-select aria-label="Sort products by">
            <option value="featured">Default Sorting</option>
            <option value="best-selling">Best Selling</option>
            <option value="price-ascending">Price: Low to High</option>
            <option value="price-descending">Price: High to Low</option>
            <option value="created-descending">Newest Arrivals</option>
            <option value="rating-descending">Customer Rating</option>
            <option value="title-ascending">Alphabetical (A&ndash;Z)</option>
          </select>
          <svg class="wm-plp-toolbar__sort-chevron" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
      </div>

      {%- comment -%} ONLY 2 View Icons: Grid View and List View {%- endcomment -%}
      <div class="wm-plp-toolbar__views" role="group" aria-label="Layout view switcher">
        <button
          type="button"
          class="wm-plp-toolbar__view-btn is-active"
          data-plp-view="grid"
          aria-pressed="true"
          aria-label="Grid view"
          title="Grid View"
        >
          {%- comment -%} Lucide: layout-grid {%- endcomment -%}
          <svg class="lucide lucide-layout-grid" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/>
            <rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>
          </svg>
        </button>

        <button
          type="button"
          class="wm-plp-toolbar__view-btn"
          data-plp-view="list"
          aria-pressed="false"
          aria-label="List view"
          title="List View"
        >
          {%- comment -%} Lucide: layout-list {%- endcomment -%}
          <svg class="lucide lucide-layout-list" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/>
            <path d="M14 4h7"/><path d="M14 9h7"/><path d="M14 15h7"/><path d="M14 20h7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Mobile Sticky 50/50 Filter + Sort Bar (<768px) {%- endcomment -%}
  <div class="wm-plp-mobile-bar">
    <button type="button" class="wm-plp-mobile-bar__btn" data-plp-mobile-filter-open>
      {%- comment -%} Lucide: list-collapse {%- endcomment -%}
      <svg class="lucide lucide-list-collapse" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 5h11"/><path d="M10 12h11"/><path d="M10 19h11"/><path d="m3 10 3-3-3-3"/><path d="m3 20 3-3-3-3"/>
      </svg>
      <span>Filter</span>
      <span class="wm-plp-mobile-bar__badge" data-plp-mobile-filter-badge {% if active_filter_count == 0 %}hidden{% endif %}>{{ active_filter_count }}</span>
    </button>

    <div class="wm-plp-mobile-bar__sort-wrap">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 16 4 4 4-4"/><path d="M7 20V4"/><path d="m21 8-4-4-4 4"/><path d="M17 4v16"/></svg>
      <span>Sort by</span>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      <select class="wm-plp-mobile-bar__sort" data-plp-mobile-sort aria-label="Sort products on mobile">
        <option value="featured">Default Sorting</option>
        <option value="best-selling">Best Selling</option>
        <option value="price-ascending">Price: Low to High</option>
        <option value="price-descending">Price: High to Low</option>
        <option value="created-descending">Newest Arrivals</option>
        <option value="rating-descending">Customer Rating</option>
      </select>
    </div>
  </div>

  {%- comment -%} 2f. Active Filter Chips Row {%- endcomment -%}
  <div class="wm-plp-active-filters" data-plp-active-filters {% if active_filter_count == 0 %}hidden{% endif %}>
    <span class="wm-plp-active-filters__label">Active Filter:</span>
    <div class="wm-plp-active-filters__list" data-plp-filter-chips role="list" aria-label="Active product filters">
      {%- for filter in collection.filters -%}
        {%- for value in filter.active_values -%}
          <a href="{{ value.url_to_remove }}" class="wm-plp-chip" data-remove-filter="{{ value.param_name | escape }}" data-filter-val="{{ value.value | escape }}" role="button">
            <span>{{ filter.label }}: {{ value.label }}</span>
            <span class="wm-plp-chip__close" aria-hidden="true">&times;</span>
          </a>
        {%- endfor -%}
        {%- if filter.type == 'price_range' and filter.min_value.value or filter.max_value.value -%}
          {%- liquid
            assign min_p = filter.min_value.value | default: 0 | divided_by: 100.0 | floor
            assign max_p = filter.max_value.value | default: filter.range_max | divided_by: 100.0 | ceil
          -%}
          <a href="{{ filter.url_to_remove }}" class="wm-plp-chip" data-remove-filter="price" role="button">
            <span>Price: {{ cart.currency.symbol }}{{ min_p }} &ndash; {{ cart.currency.symbol }}{{ max_p }}</span>
            <span class="wm-plp-chip__close" aria-hidden="true">&times;</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <button type="button" class="wm-plp-active-filters__clear" data-plp-clear-all>Clear All</button>
  </div>
</div>
