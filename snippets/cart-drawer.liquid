{% comment %}
  Renders Wagmart Ajax Cart Drawer
{% endcomment %}

<div id="cart-drawer" class="hidden fixed inset-0 z-50 overflow-hidden" role="dialog" aria-modal="true" aria-label="Shopping Cart">
  {% comment %} Backdrop {% endcomment %}
  <div class="absolute inset-0 bg-black/40 backdrop-blur-xs transition-opacity" data-close-cart></div>

  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col border-l border-[#EAE5D9] transition-transform duration-300">
      
      {% comment %} Header {% endcomment %}
      <div class="p-6 border-b border-[#F0EBE1] flex items-center justify-between bg-[#FAF8F5]">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-[#7a46e5]/10 text-[#7a46e5] flex items-center justify-center">
            {% render 'icon-bag', class: 'w-5 h-5' %}
          </div>
          <div>
            <h3 class="font-bold text-lg text-[#111827]">Your Cart</h3>
            <p class="text-xs text-[#6B7280]">
              <span data-cart-count>{{ cart.item_count | default: 0 }}</span> items selected
            </p>
          </div>
        </div>

        <button
          type="button"
          class="w-8 h-8 rounded-full hover:bg-gray-200 text-gray-500 hover:text-gray-800 flex items-center justify-center transition cursor-pointer"
          data-close-cart
          aria-label="Close cart"
        >
          {% render 'icon-close', class: 'w-5 h-5' %}
        </button>
      </div>

      {% comment %} Item List & Empty State {% endcomment %}
      <div class="flex-1 overflow-y-auto p-6 space-y-4">
        
        {% comment %} Empty State Container {% endcomment %}
        <div id="cart-drawer-empty" class="{% if cart.item_count > 0 %}hidden{% endif %} h-full flex flex-col items-center justify-center text-center p-6 space-y-4 text-gray-500">
          <div class="w-16 h-16 rounded-full bg-[#FAF8F5] border border-[#EAE5D9] flex items-center justify-center text-gray-400">
            {% render 'icon-bag', class: 'w-8 h-8' %}
          </div>
          <div class="space-y-1">
            <h4 class="font-bold text-base text-gray-900">Your cart is empty</h4>
            <p class="text-xs text-gray-500 max-w-xs">
              Explore Wagmart's best selling pet accessories and grooming essentials.
            </p>
          </div>
          {% render 'theme-button', text: 'Start Shopping', attributes: 'data-scroll-to-shop' %}
        </div>

        {% comment %} Dynamic Ajax Items Container {% endcomment %}
        <div class="flex justify-between items-center pb-2">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Selected Items</span>
          <button type="button" class="text-xs text-red-600 hover:text-red-700 font-semibold cursor-pointer" data-clear-cart>
            Clear All
          </button>
        </div>

        <div id="cart-drawer-items" class="space-y-3.5">
          {%- for item in cart.items -%}
            <div class="p-3.5 bg-[#FAF8F5] rounded-2xl border border-[#EAE5D9] flex items-center gap-3.5" data-cart-item-id="{{ item.key }}">
              <div class="w-16 h-16 bg-white rounded-xl p-1.5 border border-[#F0EBE1] shrink-0 flex items-center justify-center overflow-hidden">
                {% if item.image %}
                  <img
                    src="{{ item.image | image_url: width: 120 }}"
                    alt="{{ item.title | escape }}"
                    width="64"
                    height="64"
                    loading="lazy"
                    class="w-full h-full object-contain"
                  >
                {% endif %}
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wide">WAGMART</span>
                <h4 class="font-bold text-sm text-[#111827] truncate">{{ item.product.title }}</h4>
                <p class="text-xs text-[#7a46e5] font-semibold">{{ item.final_price | money }}</p>
                <div class="flex items-center gap-2 mt-2">
                  <button type="button" class="w-6 h-6 rounded-lg bg-white border border-[#D5CEBF] flex items-center justify-center text-gray-700 hover:bg-gray-100 cursor-pointer text-xs" data-cart-qty-btn="-1" data-key="{{ item.key }}">-</button>
                  <span class="text-xs font-bold text-gray-800 min-w-[20px] text-center">{{ item.quantity }}</span>
                  <button type="button" class="w-6 h-6 rounded-lg bg-white border border-[#D5CEBF] flex items-center justify-center text-gray-700 hover:bg-gray-100 cursor-pointer text-xs" data-cart-qty-btn="1" data-key="{{ item.key }}">+</button>
                </div>
              </div>
              <button type="button" class="p-2 text-gray-400 hover:text-red-500 transition cursor-pointer" data-cart-remove="{{ item.key }}" aria-label="Remove item">
                {% render 'icon-trash', class: 'w-4 h-4' %}
              </button>
            </div>
          {%- endfor -%}
        </div>

      </div>

      {% comment %} Footer & Checkout Area {% endcomment %}
      <div id="cart-drawer-footer" class="{% if cart.item_count == 0 %}hidden{% endif %} p-6 bg-[#FAF8F5] border-t border-[#F0EBE1] space-y-4">
        <div class="space-y-1.5 text-sm">
          <div class="flex justify-between text-gray-600">
            <span>Total Items</span>
            <span class="font-bold text-gray-900" id="cart-drawer-total-qty">{{ cart.item_count }}</span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span>Subtotal</span>
            <span class="font-bold text-[#7a46e5] text-base" id="cart-drawer-subtotal">{{ cart.total_price | money }}</span>
          </div>
        </div>

        <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
          <a
            href="/checkout"
            class="group relative w-full inline-flex items-center justify-center rounded-full bg-linear-to-r from-[#7a46e5] via-[#8451ed] to-[#9361fa] text-white font-semibold hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 cursor-pointer overflow-hidden border border-white/25 select-none shadow-[0_10px_25px_-5px_rgba(122,70,229,0.38)] py-3 px-6 text-sm gap-2"
          >
            <span class="relative z-10 tracking-wide">Proceed to Checkout</span>
            {% render 'icon-chevron-right', class: 'w-4 h-4 stroke-[2.5]' %}
          </a>
        </form>

        <a
          href="tel:+917777985896"
          class="w-full py-2 bg-white hover:bg-gray-50 border border-[#EAE5D9] rounded-xl text-xs font-semibold text-gray-700 flex items-center justify-center gap-1.5 transition"
        >
          {% render 'icon-phone', class: 'w-3.5 h-3.5 text-[#7a46e5]' %}
          <span>Call to Order via Phone: +91 77779 85896</span>
        </a>
      </div>

    </div>
  </div>
</div>
