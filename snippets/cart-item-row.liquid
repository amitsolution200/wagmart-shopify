{%- comment -%}
  Wagmart Cart Item Row Snippet (Matches reference screenshot)
  Columns:
  1. Product (Image + Title + Variant/Option)
  2. Price (Unit price)
  3. Quantity (White bordered [- qty +] stepper)
  4. Total (Line item total)
  5. Remove (Outline trash icon button)
{%- endcomment -%}

{%- liquid
  assign item_key = item.key | default: item.id
  assign item_title = item.product.title | default: item.product_title | default: item.title
  assign item_url = item.url | default: '/products/pet-grooming-glove'
  assign unit_price_inr = item.final_price | divided_by: 100.0 | round
  if item.variant.compare_at_price > item.final_price
    assign unit_comp_inr = item.variant.compare_at_price | divided_by: 100.0 | round
  elsif item.original_price > item.final_price
    assign unit_comp_inr = item.original_price | divided_by: 100.0 | round
  else
    assign unit_comp_inr = unit_price_inr | times: 125 | divided_by: 100.0 | round
  endif
  assign line_price_inr = unit_price_inr | times: item.quantity
  assign line_comp_inr = unit_comp_inr | times: item.quantity

  assign inv_qty = item.variant.inventory_quantity | default: 99
  if inv_qty <= 0
    assign inv_qty = 99
  endif
-%}

<div
  class="wm-cart-item"
  data-cart-row="{{ item_key }}"
  data-item-id="{{ item.variant_id | default: item.id }}"
  data-item-title="{{ item_title | escape }}"
  data-max-stock="{{ inv_qty }}"
>
  {%- comment -%} 1. Product Column (Image + Title + Option) {%- endcomment -%}
  <div class="wm-cart-item__product">
    <a href="{{ item_url }}" class="wm-cart-item__media" aria-label="{{ item_title | escape }}">
      {%- if item.image != blank -%}
        <img
          src="{{ item.image | image_url: width: 240 }}"
          alt="{{ item_title | escape }}"
          width="80"
          height="80"
          loading="lazy"
          onerror="this.onerror=null;this.src='{{ 'catalog-grooming-glove.webp' | asset_url }}';"
        >
      {%- else -%}
        <img
          src="{{ 'catalog-grooming-glove.webp' | asset_url }}"
          alt="{{ item_title | escape }}"
          width="80"
          height="80"
          loading="lazy"
        >
      {%- endif -%}
    </a>

    <div class="wm-cart-item__details">
      <a href="{{ item_url }}" class="wm-cart-item__title">{{ item_title }}</a>

      {%- unless item.product.has_only_default_variant -%}
        {%- if item.options_with_values != blank -%}
          {%- for option in item.options_with_values -%}
            <p class="wm-cart-item__variant">
              <span class="wm-cart-item__opt-label">{{ option.name }}:</span> {{ option.value }}
            </p>
          {%- endfor -%}
        {%- elsif item.variant.title != blank and item.variant.title != 'Default Title' -%}
          <p class="wm-cart-item__variant">
            <span class="wm-cart-item__opt-label">Type:</span> {{ item.variant.title }}
          </p>
        {%- endif -%}
      {%- endunless -%}

      <div class="wm-cart-item__mobile-price">
        &#8377;{{ unit_price_inr }} <s style="color:#9ca3af;font-weight:500;font-size:0.85em;margin-left:4px;">&#8377;{{ unit_comp_inr }}</s>
      </div>
    </div>
  </div>

  {%- comment -%} 2. Price Column {%- endcomment -%}
  <div class="wm-cart-item__unit-col">
    <span class="wm-cart-item__unit-price">&#8377;{{ unit_price_inr }} <s style="color:#9ca3af;font-weight:500;font-size:0.85em;margin-left:4px;">&#8377;{{ unit_comp_inr }}</s></span>
  </div>

  {%- comment -%} 3. Quantity Column {%- endcomment -%}
  <div class="wm-cart-item__qty-col">
    {% render 'cart-quantity-stepper',
      item_key: item_key,
      item_title: item_title,
      quantity: item.quantity,
      max_qty: inv_qty
    %}
  </div>

  {%- comment -%} 4. Total Column {%- endcomment -%}
  <div class="wm-cart-item__total-col">
    <span class="wm-cart-item__line-total" data-line-total>&#8377;{{ line_price_inr }} <s style="color:#9ca3af;font-weight:500;font-size:0.85em;margin-left:4px;">&#8377;{{ line_comp_inr }}</s></span>
  </div>

  {%- comment -%} 5. Trash Remove Button Column {%- endcomment -%}
  <div class="wm-cart-item__remove-col">
    <button
      type="button"
      class="wm-cart-item__trash-btn"
      data-cart-page-remove="{{ item_key }}"
      aria-label="Remove {{ item_title | escape }} from cart"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="3 6 5 6 21 6"></polyline>
        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
      </svg>
    </button>
  </div>
</div>
