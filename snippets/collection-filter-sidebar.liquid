{%- comment -%}
  Wagmart Collection Filter Sidebar (snippets/collection-filter-sidebar.liquid)
  - Uses REAL dynamic Shopify Storefront Filters (collection.filters) configured in Shopify Admin
  - No mock/fake data or hardcoded counts
  - Desktop: 260px collapsible sidebar
  - Mobile (<768px): Bottom-sheet modal (85vh) with sticky "Show N Products" + "Reset" bottom bar
{%- endcomment -%}

<aside
  id="wm-plp-sidebar"
  class="wm-plp-sidebar"
  aria-label="Product Filters"
  data-plp-sidebar
>
  <div class="wm-plp-sidebar__head">
    <span class="wm-plp-sidebar__head-title">
      <svg class="lucide lucide-list-collapse" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 5h11"/><path d="M10 12h11"/><path d="M10 19h11"/><path d="m3 10 3-3-3-3"/><path d="m3 20 3-3-3-3"/>
      </svg>
      Filter Options
    </span>
    <button type="button" class="wm-plp-sidebar__close" data-plp-sidebar-close aria-label="Close filters">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <form id="wm-plp-filter-form" class="wm-plp-filter-form" data-plp-filter-form action="{{ collection.url }}" method="get">
    {%- if collection.sort_by != blank -%}
      <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
    {%- endif -%}

    {%- if collection.filters.size > 0 -%}
      {%- for filter in collection.filters -%}
        {%- assign total_active = filter.active_values.size -%}
        <details class="wm-plp-filter-group" open data-filter-group>
          <summary class="wm-plp-filter-group__summary">
            <span>
              {{ filter.label | escape }}
              {%- if total_active > 0 -%}
                <span class="wm-plp-filter-group__active-count" style="font-size:12px;font-weight:700;color:#1B3A2A;margin-left:4px;">({{ total_active }})</span>
              {%- endif -%}
            </span>
            <svg class="wm-plp-filter-group__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="wm-plp-filter-group__content">
            {%- case filter.type -%}
              {%- when 'list', 'boolean' -%}
                <div class="wm-plp-filter-list">
                  {%- for value in filter.values -%}
                    <label class="wm-plp-check{% if value.count == 0 and value.active == false %} is-disabled opacity-45 cursor-not-allowed{% endif %}">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        id="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        data-filter-input
                        data-filter-param="{{ value.param_name | escape }}"
                        data-filter-value="{{ value.value | escape }}"
                        data-filter-label="{{ value.label | escape }}"
                      >
                      <span class="wm-plp-check__box" aria-hidden="true"></span>
                      <span class="wm-plp-check__label">{{ value.label }}</span>
                      <span class="wm-plp-check__count">({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- when 'price_range' -%}
                {%- liquid
                  assign max_price = filter.range_max | divided_by: 100.0 | ceil
                  if max_price == 0 or max_price == blank
                    assign max_price = 1000
                  endif

                  assign current_min = 0
                  if filter.min_value.value
                    assign current_min = filter.min_value.value | divided_by: 100.0 | floor
                  endif

                  assign current_max = max_price
                  if filter.max_value.value
                    assign current_max = filter.max_value.value | divided_by: 100.0 | ceil
                  endif
                -%}
                <div class="wm-plp-price-filter" data-price-filter data-range-max="{{ max_price }}">
                  <div class="wm-plp-price-filter__display" data-price-display>
                    Price: {{ cart.currency.symbol }}{{ current_min }} &ndash; {{ cart.currency.symbol }}{{ current_max }}
                  </div>

                  <div class="wm-plp-range-slider">
                    <div class="wm-plp-range-slider__track"></div>
                    <div class="wm-plp-range-slider__fill" data-price-range-fill></div>
                    <input
                      type="range"
                      class="wm-plp-range-slider__input"
                      min="0"
                      max="{{ max_price }}"
                      step="1"
                      value="{{ current_min }}"
                      data-price-range-min
                      aria-label="Minimum price in {{ cart.currency.iso_code }}"
                    >
                    <input
                      type="range"
                      class="wm-plp-range-slider__input"
                      min="0"
                      max="{{ max_price }}"
                      step="1"
                      value="{{ current_max }}"
                      data-price-range-max
                      aria-label="Maximum price in {{ cart.currency.iso_code }}"
                    >
                  </div>

                  <div class="wm-plp-price-inputs">
                    <div class="wm-plp-price-input-box">
                      <span class="wm-plp-price-input-box__prefix">{{ cart.currency.symbol }}</span>
                      <input
                        type="number"
                        name="{{ filter.min_value.param_name }}"
                        id="Filter-{{ filter.min_value.param_name | escape }}"
                        class="wm-plp-price-input-box__field"
                        min="0"
                        max="{{ max_price }}"
                        {% if filter.min_value.value %}value="{{ current_min }}"{% else %}value="0"{% endif %}
                        data-price-input-min
                        data-filter-param="{{ filter.min_value.param_name | escape }}"
                        aria-label="Minimum price input"
                      >
                    </div>
                    <span class="wm-plp-price-inputs__sep">&ndash;</span>
                    <div class="wm-plp-price-input-box">
                      <span class="wm-plp-price-input-box__prefix">{{ cart.currency.symbol }}</span>
                      <input
                        type="number"
                        name="{{ filter.max_value.param_name }}"
                        id="Filter-{{ filter.max_value.param_name | escape }}"
                        class="wm-plp-price-input-box__field"
                        min="0"
                        max="{{ max_price }}"
                        {% if filter.max_value.value %}value="{{ current_max }}"{% else %}value="{{ max_price }}"{% endif %}
                        data-price-input-max
                        data-filter-param="{{ filter.max_value.param_name | escape }}"
                        aria-label="Maximum price input"
                      >
                    </div>
                  </div>
                </div>
            {%- endcase -%}
          </div>
        </details>
      {%- endfor -%}
    {%- else -%}
      <div class="p-5 text-center text-sm text-neutral-500">
        <p class="font-medium text-neutral-700">No active filters configured.</p>
        <p class="text-xs text-neutral-400 mt-1">Configure filters in Shopify Admin &gt; Navigation &gt; Collection Filters.</p>
      </div>
    {%- endif -%}
  </form>

  {%- comment -%} Sticky Mobile/Tablet Bottom Bar {%- endcomment -%}
  <div class="wm-plp-sidebar__footer">
    <button type="button" class="wm-plp-sidebar__reset-btn" data-plp-clear-all>Reset</button>
    <button type="button" class="wm-plp-sidebar__apply-btn" data-plp-sidebar-apply>
      Show <span data-plp-apply-count>{{ collection.products_count | default: collection.products.size }}</span> Products
    </button>
  </div>
</aside>
