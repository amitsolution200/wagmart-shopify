{%- comment -%}
  Wagmart Filter Sidebar (snippets/collection-filter-sidebar.liquid)
  - Supports both Collection and Search Results pages (Shopify Storefront Filtering)
  - Uses dynamic Shopify filters (results.filters) configured in Shopify Admin Search & Discovery
  - Desktop: 260px collapsible sidebar
  - Mobile (<768px): Bottom-sheet modal drawer with sticky bottom bar
{%- endcomment -%}

{%- liquid
  if results == blank
    if search.performed or request.page_type == 'search'
      assign results = search
      assign form_action = routes.search_url
      assign is_search = true
    else
      assign results = collection
      assign form_action = collection.url | default: routes.all_products_collection_url
      assign is_search = false
    endif
  else
    if results == search
      assign form_action = routes.search_url
      assign is_search = true
    else
      assign form_action = collection.url | default: routes.all_products_collection_url
      assign is_search = false
    endif
  endif

  assign total_count = 0
  if is_search
    assign total_count = results.results_count | default: results.results.size | default: 0
  else
    assign total_count = results.products_count | default: results.products.size | default: 0
  endif

  assign current_sort = results.sort_by | default: results.default_sort_by
  if current_sort == blank or current_sort == 'featured'
    if is_search
      assign current_sort = 'relevance'
    else
      assign current_sort = 'manual'
    endif
  endif
-%}

<aside
  id="wm-plp-sidebar"
  class="wm-plp-sidebar"
  aria-label="Product Filters"
  data-plp-sidebar
>
  <div class="wm-plp-sidebar__head">
    <span class="wm-plp-sidebar__head-title">Filters</span>
    <div class="wm-plp-sidebar__head-actions">
      <button type="button" class="wm-plp-sidebar__head-reset" data-plp-clear-all>Reset</button>
      <button type="button" class="wm-plp-sidebar__close" data-plp-sidebar-close aria-label="Close filters">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <form id="wm-plp-filter-form" class="wm-plp-filter-form" data-plp-filter-form action="{{ form_action }}" method="get">
    {%- if is_search -%}
      <input type="hidden" name="q" value="{{ search.terms | escape }}">
      <input type="hidden" name="options[prefix]" value="last">
      <input type="hidden" name="type" value="product">
    {%- endif -%}

    <input type="hidden" name="sort_by" value="{{ current_sort }}" data-plp-sidebar-sort-input>

    {%- comment -%} Mobile-Only Sort Products Filter Group (<768px) {%- endcomment -%}
    <details class="wm-plp-filter-group wm-plp-filter-group--mobile-sort" open data-filter-group>
      <summary class="wm-plp-filter-group__summary">
        <span class="wm-plp-filter-group__title-wrap">Sort Products</span>
        <svg class="wm-plp-filter-group__chevron" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="wm-plp-filter-group__content">
        <div class="wm-plp-mobile-sort-drawer__options">
          {%- if results.sort_options.size > 0 -%}
            {%- for option in results.sort_options -%}
              <button
                type="button"
                class="wm-plp-mobile-sort-drawer__item{% if option.value == current_sort %} is-active{% endif %}"
                data-sort-value="{{ option.value }}"
              >
                <span>{{ option.name }}</span>
                <svg class="wm-plp-custom-sort__check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- assign fallback_options = "manual:Featured,most-relevant:Most relevant,best-selling:Best selling,title-ascending:Alphabetically, A-Z,title-descending:Alphabetically, Z-A,price-ascending:Price, low to high,price-descending:Price, high to low,created-ascending:Date, old to new,created-descending:Date, new to old" | split: "," -%}
            {%- for item in fallback_options -%}
              {%- assign parts = item | split: ":" -%}
              <button
                type="button"
                class="wm-plp-mobile-sort-drawer__item{% if parts[0] == current_sort %} is-active{% endif %}"
                data-sort-value="{{ parts[0] }}"
              >
                <span>{{ parts[1] }}</span>
                <svg class="wm-plp-custom-sort__check" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </details>

    {%- if results.filters.size > 0 -%}
      {%- for filter in results.filters -%}
        {%- assign total_active = filter.active_values.size -%}
        <details class="wm-plp-filter-group" open data-filter-group>
          <summary class="wm-plp-filter-group__summary">
            <span class="wm-plp-filter-group__title-wrap">
              {{ filter.label | escape }}
              {%- if total_active > 0 -%}
                <span class="wm-plp-filter-group__active-count">({{ total_active }})</span>
              {%- endif -%}
            </span>
            <svg class="wm-plp-filter-group__chevron" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="wm-plp-filter-group__content">
            {%- case filter.type -%}
              {%- when 'list', 'boolean' -%}
                <div class="wm-plp-filter-list">
                  {%- for value in filter.values -%}
                    <label class="wm-plp-check{% if value.count == 0 and value.active == false %} is-disabled opacity-45 cursor-not-allowed{% endif %}">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        id="Filter-{{ filter.param_name | escape }}-{{ forloop.index }}"
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        data-filter-input
                        data-filter-param="{{ value.param_name | escape }}"
                        data-filter-value="{{ value.value | escape }}"
                        data-filter-label="{{ value.label | escape }}"
                      >
                      <span class="wm-plp-check__box" aria-hidden="true"></span>
                      <span class="wm-plp-check__label">{{ value.label }}</span>
                      <span class="wm-plp-check__count">{{ value.count }}</span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- when 'price_range' -%}
                {%- liquid
                  assign max_price = filter.range_max | divided_by: 100.0 | ceil
                  if max_price == 0 or max_price == blank
                    assign max_price = 1000
                  endif

                  assign current_min = 0
                  if filter.min_value.value
                    assign current_min = filter.min_value.value | divided_by: 100.0 | floor
                  endif

                  assign current_max = max_price
                  if filter.max_value.value
                    assign current_max = filter.max_value.value | divided_by: 100.0 | ceil
                  endif
                -%}
                <div class="wm-plp-price-filter" data-price-filter data-range-max="{{ max_price }}">
                  <div class="wm-plp-price-filter__meta">
                    <span class="wm-plp-price-filter__meta-label">Range</span>
                    <span class="wm-plp-price-filter__display" data-price-display>
                      {{ cart.currency.symbol }}{{ current_min }} &ndash; {{ cart.currency.symbol }}{{ current_max }}
                    </span>
                  </div>

                  <div class="wm-plp-range-slider">
                    <div class="wm-plp-range-slider__track"></div>
                    <div class="wm-plp-range-slider__fill" data-price-range-fill></div>
                    <input
                      type="range"
                      class="wm-plp-range-slider__input"
                      min="0"
                      max="{{ max_price }}"
                      step="1"
                      value="{{ current_min }}"
                      data-price-range-min
                      aria-label="Minimum price in {{ cart.currency.iso_code }}"
                    >
                    <input
                      type="range"
                      class="wm-plp-range-slider__input"
                      min="0"
                      max="{{ max_price }}"
                      step="1"
                      value="{{ current_max }}"
                      data-price-range-max
                      aria-label="Maximum price in {{ cart.currency.iso_code }}"
                    >
                  </div>

                  <div class="wm-plp-price-inputs">
                    <div class="wm-plp-price-input-field">
                      <span class="wm-plp-price-input-field__caption">Min</span>
                      <div class="wm-plp-price-input-box">
                        <span class="wm-plp-price-input-box__prefix">{{ cart.currency.symbol }}</span>
                        <input
                          type="number"
                          name="{{ filter.min_value.param_name }}"
                          id="Filter-{{ filter.min_value.param_name | escape }}"
                          class="wm-plp-price-input-box__field"
                          min="0"
                          max="{{ max_price }}"
                          {% if filter.min_value.value %}value="{{ current_min }}"{% else %}value="0"{% endif %}
                          data-price-input-min
                          data-filter-param="{{ filter.min_value.param_name | escape }}"
                          aria-label="Minimum price input"
                        >
                      </div>
                    </div>
                    <span class="wm-plp-price-inputs__sep">&ndash;</span>
                    <div class="wm-plp-price-input-field">
                      <span class="wm-plp-price-input-field__caption">Max</span>
                      <div class="wm-plp-price-input-box">
                        <span class="wm-plp-price-input-box__prefix">{{ cart.currency.symbol }}</span>
                        <input
                          type="number"
                          name="{{ filter.max_value.param_name }}"
                          id="Filter-{{ filter.max_value.param_name | escape }}"
                          class="wm-plp-price-input-box__field"
                          min="0"
                          max="{{ max_price }}"
                          {% if filter.max_value.value %}value="{{ current_max }}"{% else %}value="{{ max_price }}"{% endif %}
                          data-price-input-max
                          data-filter-param="{{ filter.max_value.param_name | escape }}"
                          aria-label="Maximum price input"
                        >
                      </div>
                    </div>
                  </div>
                </div>
            {%- endcase -%}
          </div>
        </details>
      {%- endfor -%}
    {%- else -%}
      <div class="p-5 text-center text-sm text-neutral-500">
        <p class="font-medium text-neutral-700">No active filters configured.</p>
        <p class="text-xs text-neutral-400 mt-1">Configure filters (Availability, Price, Vendor, Product Type) in Shopify Admin &gt; Apps &gt; Search &amp; Discovery &gt; Filters.</p>
      </div>
    {%- endif -%}
  </form>

  {%- comment -%} Sticky Mobile/Tablet Bottom Bar {%- endcomment -%}
  <div class="wm-plp-sidebar__footer">
    <button type="button" class="wm-plp-sidebar__reset-btn" data-plp-clear-all>Reset</button>
    <button type="button" class="wm-plp-sidebar__apply-btn" data-plp-sidebar-apply>
      Show <span data-plp-apply-count>{{ total_count }}</span> Products
    </button>
  </div>
</aside>
