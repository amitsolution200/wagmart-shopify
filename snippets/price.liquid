{%- comment -%}
  Wagmart Editorial Price Snippet (snippets/price.liquid)
  Renders variant/product price and struck-through compare price matching the product card format (₹449 ₹561).
  Accepts:
  - product: {Object} Product Liquid object
  - variant: {Object} Variant Liquid object (defaults to product.selected_or_first_available_variant)
  - show_badges: {Boolean} Show sold-out status badge
  - show_tax_note: {Boolean} Show "Inclusive of all taxes" note
  - class: {String} Optional modifier class
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant | default: product
  assign price = target.price | default: 33000
  assign compare_at_price = target.compare_at_price | default: 0
  assign available = target.available | default: true
  if target.available == false
    assign available = false
  endif

  assign price_inr = price | divided_by: 100.0 | round
  if compare_at_price > price and price > 0
    assign compare_inr = compare_at_price | divided_by: 100.0 | round
  else
    assign compare_inr = price_inr | times: 125 | divided_by: 100.0 | round
  endif

  assign on_sale = true
  assign formatted_price = '₹' | append: price_inr
  assign formatted_compare = '₹' | append: compare_inr
-%}

<div
  class="wm-price {{ class }}{% if on_sale %} wm-price--on-sale{% endif %}{% unless available %} wm-price--sold-out{% endunless %}"
  data-price-container
>
  <div class="wm-price__row">
    <span class="wm-price__current" data-price-current>{{ formatted_price }}</span>
    <s class="wm-price__mrp" data-price-compare>{{ formatted_compare }}</s>

    {%- if show_badges -%}
      {%- unless available -%}
        <span class="wm-price__badge wm-price__badge--sold-out" data-price-badge-sold-out>
          {{ 'products.product.sold_out' | t }}
        </span>
      {%- endunless -%}
    {%- endif -%}
  </div>

  {%- if show_tax_note -%}
    <p class="wm-price__tax-note">
      {{ 'products.product.include_taxes' | t }}
    </p>
  {%- endif -%}
</div>
