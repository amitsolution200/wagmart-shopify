{%- comment -%}
  Wagmart Collection Quick View Modal Snippet
  - Image, category, title, rating, ₹ price + compare price + discount pill
  - Variant selectors (Pack Size / Weight pills)
  - Quantity stepper (- 1 +) + Add to Cart button
  - "View full details" link
  - Closes on ESC and backdrop click, traps focus inside
{%- endcomment -%}

<div
  id="wm-plp-quickview"
  class="wm-qv-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wm-qv-title"
  aria-hidden="true"
  data-plp-quickview-modal
  hidden
>
  <div class="wm-qv-modal__backdrop" data-qv-close></div>

  <div class="wm-qv-modal__dialog" role="document" tabindex="-1" data-qv-dialog>
    <button type="button" class="wm-qv-modal__close" data-qv-close aria-label="Close quick view">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="wm-qv-modal__grid">
      <div class="wm-qv-modal__media">
        <span class="wm-plp-badge wm-plp-badge--discount" data-qv-badge>20% off</span>
        <img
          src="{{ 'catalog-bath-massage-brush.webp' | asset_url }}"
          alt="Product preview"
          class="wm-qv-modal__img"
          width="420"
          height="420"
          data-qv-img
        >
      </div>

      <div class="wm-qv-modal__info">
        <span class="wm-qv-modal__cat" data-qv-cat>DOG FOOD</span>
        <h2 id="wm-qv-title" class="wm-qv-modal__title" data-qv-title>Bulldog Natural Choice Adult Dog Food</h2>

        <div class="wm-qv-modal__rating">
          <span class="wm-qv-modal__stars" aria-hidden="true">★★★★★</span>
          <span class="wm-qv-modal__rating-text" data-qv-rating>4.8 (126 reviews)</span>
        </div>

        <div class="wm-qv-modal__price-row">
          <span class="wm-qv-modal__price" data-qv-price>&#8377;1,299</span>
          <span class="wm-qv-modal__compare" data-qv-compare>&#8377;1,599</span>
          <span class="wm-qv-modal__save" data-qv-save>Save 19%</span>
        </div>
        <p class="wm-qv-modal__tax">Inclusive of all taxes &bull; Free shipping above &#8377;499</p>

        <p class="wm-qv-modal__desc" data-qv-desc>
          Complete and balanced nutrition crafted for everyday vitality, healthy digestion, and a shiny coat.
        </p>

        <div class="wm-qv-modal__variants">
          <span class="wm-qv-modal__label">Select Pack / Size:</span>
          <div class="wm-qv-modal__pills" data-qv-variants>
            <button type="button" class="wm-qv-pill is-selected" data-qv-variant-pill data-multiplier="1">Standard Pack</button>
            <button type="button" class="wm-qv-pill" data-qv-variant-pill data-multiplier="1.8">Value Pack (Save 10%)</button>
            <button type="button" class="wm-qv-pill" data-qv-variant-pill data-multiplier="2.5">Twin Combo</button>
          </div>
        </div>

        <div class="wm-qv-modal__actions">
          <div class="wm-qv-stepper" role="group" aria-label="Quantity">
            <button type="button" class="wm-qv-stepper__btn" data-qv-qty-btn="-1" aria-label="Decrease quantity">&minus;</button>
            <input type="number" class="wm-qv-stepper__input" value="1" min="1" max="15" data-qv-qty-input aria-label="Quantity">
            <button type="button" class="wm-qv-stepper__btn" data-qv-qty-btn="1" aria-label="Increase quantity">+</button>
          </div>

          <button type="button" class="wm-qv-modal__atc" data-qv-add-btn>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span>Add to Cart</span>
          </button>
        </div>

        <a href="/products/pet-grooming-glove" class="wm-qv-modal__full-link" data-qv-full-link>
          <span>View full product details</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>
