{%- comment -%}
  Wagmart Order Summary Card Snippet (Matches reference screenshot)
  - Soft grey rounded box (#F5F5F5, 12px radius)
  - 1. Cart note accordion
  - 2. Discount code accordion (open by default, white rounded input + green Apply button)
  - 3. Share cart accordion
  - 4. Total row + "Tax included and shipping calculated at checkout"
  - 5. Full-width green "Checkout" button
  - 6. Centered Payment Icons (Visa, Mastercard, Amex, PayPal, Diners Club, Discover)
{%- endcomment -%}

{%- liquid
  assign c = cart_obj | default: cart
  assign final_cents = c.total_price | default: 0
  assign subtotal_inr = final_cents | divided_by: 100.0 | round
-%}

<aside class="wm-cart-summary" aria-label="Cart summary" data-cart-summary>

  {%- comment -%} 1. Cart Note Accordion {%- endcomment -%}
  <div class="wm-cart-acc" data-summary-acc="note">
    <button
      type="button"
      class="wm-cart-acc__trigger"
      data-summary-acc-trigger="note"
      aria-expanded="false"
      aria-controls="wm-cart-acc-body-note"
    >
      <span class="wm-cart-acc__title">Cart note</span>
      <svg class="wm-cart-acc__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div id="wm-cart-acc-body-note" class="wm-cart-acc__body" data-summary-acc-body hidden>
      <label for="wm-cart-note-textarea" class="sr-only">Cart note</label>
      <textarea
        id="wm-cart-note-textarea"
        name="note"
        class="wm-cart-note__textarea"
        placeholder="Add special instructions for your order..."
        data-cart-note-input
      >{{ c.note }}</textarea>
      <div class="wm-cart-note__status" data-cart-note-status aria-live="polite"></div>
    </div>
  </div>

  {%- comment -%} 2. Discount Code Accordion (Open by default per screenshot) {%- endcomment -%}
  <div class="wm-cart-acc is-open" data-summary-acc="discount">
    <button
      type="button"
      class="wm-cart-acc__trigger"
      data-summary-acc-trigger="discount"
      aria-expanded="true"
      aria-controls="wm-cart-acc-body-discount"
    >
      <span class="wm-cart-acc__title">Discount code</span>
      <svg class="wm-cart-acc__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div id="wm-cart-acc-body-discount" class="wm-cart-acc__body" data-summary-acc-body>
      <div class="wm-cart-coupon" data-cart-coupon-box>
        <div class="wm-cart-coupon__form">
          <input
            type="text"
            class="wm-cart-coupon__input"
            placeholder="Please enter discount code"
            aria-label="Please enter discount code"
            data-coupon-input
          >
          <button type="button" class="wm-cart-coupon__btn" data-coupon-apply>Apply</button>
        </div>
        <p class="wm-cart-coupon__feedback" data-coupon-feedback aria-live="polite"></p>
        <div class="wm-cart-coupon__chip-wrap" data-coupon-chip-wrap hidden>
          <span class="wm-cart-coupon__chip">
            <span class="wm-cart-coupon__chip-code" data-coupon-code-text>WAGMART10</span>
            <button type="button" class="wm-cart-coupon__chip-remove" data-coupon-remove aria-label="Remove discount code">&times;</button>
          </span>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} 3. Share Cart Accordion {%- endcomment -%}
  <div class="wm-cart-acc" data-summary-acc="share">
    <button
      type="button"
      class="wm-cart-acc__trigger"
      data-summary-acc-trigger="share"
      aria-expanded="false"
      aria-controls="wm-cart-acc-body-share"
    >
      <span class="wm-cart-acc__title">Share cart</span>
      <svg class="wm-cart-acc__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div id="wm-cart-acc-body-share" class="wm-cart-acc__body" data-summary-acc-body hidden>
      <div class="wm-cart-share">
        <div class="wm-cart-coupon__form">
          <input
            type="text"
            class="wm-cart-coupon__input"
            value="{{ shop.url }}{{ routes.cart_url | default: '/cart' }}"
            readonly
            aria-label="Shareable cart link"
            data-share-cart-input
          >
          <button type="button" class="wm-cart-coupon__btn" data-share-cart-copy>Copy</button>
        </div>
        <p class="wm-cart-coupon__feedback" data-share-cart-feedback aria-live="polite"></p>
      </div>
    </div>
  </div>

  {%- comment -%} 4. Total & Tax/Shipping Note {%- endcomment -%}
  <div class="wm-cart-summary__totals">
    <div class="wm-cart-summary__total-row">
      <span class="wm-cart-summary__total-label">Total</span>
      <span class="wm-cart-summary__total-val" data-summary-total>&#8377;{{ subtotal_inr }}.00</span>
    </div>
    <p class="wm-cart-summary__tax-note">
      Tax included and shipping calculated at checkout
    </p>
  </div>

  {%- comment -%} 5. Checkout Button {%- endcomment -%}
  <button
    type="submit"
    name="checkout"
    form="wm-cart-form"
    class="wm-cart-summary__checkout-btn"
    data-cart-checkout-btn
  >
    Checkout
  </button>

  {%- comment -%} 6. Payment Icons Row (Visa, Mastercard, Amex, PayPal, Diners, Discover) {%- endcomment -%}
  <div class="wm-cart-summary__payments" aria-label="Accepted payment methods">
    <!-- Visa -->
    <span class="wm-pay-badge" title="Visa">
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Visa">
        <rect width="38" height="24" rx="3" fill="#1434CB"/>
        <text x="19" y="15.5" text-anchor="middle" fill="#FFFFFF" font-family="Arial, sans-serif" font-weight="900" font-style="italic" font-size="10.5" letter-spacing="0.5">VISA</text>
      </svg>
    </span>
    <!-- Mastercard -->
    <span class="wm-pay-badge" title="Mastercard">
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Mastercard">
        <rect width="38" height="24" rx="3" fill="#1F1F1F"/>
        <circle cx="15" cy="12" r="6.5" fill="#EB001B"/>
        <circle cx="23" cy="12" r="6.5" fill="#F79E1B" fill-opacity="0.9"/>
      </svg>
    </span>
    <!-- American Express -->
    <span class="wm-pay-badge" title="American Express">
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="American Express">
        <rect width="38" height="24" rx="3" fill="#016FD0"/>
        <text x="19" y="11.5" text-anchor="middle" fill="#FFFFFF" font-family="Arial, sans-serif" font-weight="800" font-size="6.5">AM</text>
        <text x="19" y="18" text-anchor="middle" fill="#FFFFFF" font-family="Arial, sans-serif" font-weight="800" font-size="6.5">EX</text>
      </svg>
    </span>
    <!-- PayPal -->
    <span class="wm-pay-badge" title="PayPal">
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="PayPal">
        <rect x="0.5" y="0.5" width="37" height="23" rx="2.5" fill="#FFFFFF" stroke="#E0E0E0"/>
        <path d="M16.2 7h4.2c2.1 0 3.2 1 3 2.8-.3 2.2-1.8 3.4-4 3.4h-1.4l-.6 3.8h-2.3L16.2 7z" fill="#003087"/>
        <path d="M17.8 9.2h3.3c1.6 0 2.5.8 2.3 2.3-.2 1.8-1.4 2.8-3.2 2.8h-1.1l-.5 3.2h-1.8l1-8.3z" fill="#0070BA" opacity="0.85"/>
      </svg>
    </span>
    <!-- Diners Club -->
    <span class="wm-pay-badge" title="Diners Club">
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Diners Club">
        <rect x="0.5" y="0.5" width="37" height="23" rx="2.5" fill="#FFFFFF" stroke="#E0E0E0"/>
        <circle cx="19" cy="12" r="6.5" fill="#0079BE"/>
        <path d="M17.8 8.3a3.7 3.7 0 0 0 0 7.4V8.3zm2.4 0v7.4a3.7 3.7 0 0 0 0-7.4z" fill="#FFFFFF"/>
      </svg>
    </span>
    <!-- Discover -->
    <span class="wm-pay-badge" title="Discover">
      <svg viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Discover">
        <rect x="0.5" y="0.5" width="37" height="23" rx="2.5" fill="#FFFFFF" stroke="#E0E0E0"/>
        <text x="18" y="13.5" text-anchor="middle" fill="#111111" font-family="Arial, sans-serif" font-weight="800" font-size="5.6">DISCOVER</text>
        <path d="M22 23.5h13a2.5 2.5 0 0 0 2.5-2.5v-4.5L22 23.5z" fill="#F47216"/>
      </svg>
    </span>
  </div>
</aside>
