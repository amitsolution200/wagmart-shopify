{%- comment -%}
  Wagmart Sticky Order Summary Card Snippet
  Parameters:
  - cart_obj: Shopify cart object
{%- endcomment -%}

{%- liquid
  assign c = cart_obj | default: cart
  assign final_cents = c.total_price | default: 0
  assign discount_cents = c.total_discount | default: 0
  assign threshold_cents = 49900

  if final_cents >= threshold_cents or final_cents == 0
    assign shipping_inr = 0
  else
    assign shipping_inr = 49
  endif

  assign subtotal_inr = final_cents | divided_by: 100.0 | round
  assign discount_inr = discount_cents | divided_by: 100.0 | round
  assign grand_total_inr = subtotal_inr | plus: shipping_inr
-%}

<aside class="wm-cart-summary" aria-labelledby="wm-cart-summary-heading" data-cart-summary>
  <h2 id="wm-cart-summary-heading" class="wm-cart-summary__title">Order Summary</h2>

  {%- comment -%} 1. Free-Shipping Progress Bar {%- endcomment -%}
  {% render 'cart-free-shipping-bar', cart_total_cents: final_cents, threshold_rupees: 499 %}

  {%- comment -%} 2. Coupon / Promo Code Field {%- endcomment -%}
  <div class="wm-cart-coupon" data-cart-coupon-box>
    <div class="wm-cart-coupon__form">
      <input
        type="text"
        class="wm-cart-coupon__input"
        placeholder="Enter promo code (e.g. WAGMART10)"
        aria-label="Promo or coupon code"
        data-coupon-input
      >
      <button type="button" class="wm-cart-coupon__btn" data-coupon-apply>Apply</button>
    </div>
    <p class="wm-cart-coupon__feedback" data-coupon-feedback aria-live="polite"></p>
    <div class="wm-cart-coupon__chip-wrap" data-coupon-chip-wrap hidden>
      <span class="wm-cart-coupon__chip">
        <span class="wm-cart-coupon__chip-code" data-coupon-chip-label>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span data-coupon-code-text>WAGMART10</span>
        </span>
        <button type="button" class="wm-cart-coupon__chip-remove" data-coupon-remove aria-label="Remove coupon code">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </span>
    </div>
  </div>

  {%- comment -%} 3. Cost Breakdown Rows {%- endcomment -%}
  <div class="wm-cart-summary__rows">
    <div class="wm-cart-summary__row">
      <span>Subtotal (<span data-summary-item-count>{{ c.item_count | default: 0 }}</span> items)</span>
      <span class="wm-cart-summary__val" data-summary-subtotal>&#8377;{{ subtotal_inr }}</span>
    </div>

    <div class="wm-cart-summary__row is-discount" data-summary-discount-row {% if discount_inr <= 0 %}hidden{% endif %}>
      <span>Order Discount</span>
      <span class="wm-cart-summary__val" data-summary-discount>&minus;&#8377;{{ discount_inr }}</span>
    </div>

    <div class="wm-cart-summary__row">
      <span>Estimated Shipping</span>
      <span class="wm-cart-summary__val{% if shipping_inr == 0 %} is-free{% endif %}" data-summary-shipping>
        {%- if shipping_inr == 0 -%}FREE{%- else -%}&#8377;{{ shipping_inr }}{%- endif -%}
      </span>
    </div>

    <div class="wm-cart-summary__row">
      <span>Estimated Taxes (GST)</span>
      <span class="wm-cart-summary__val" data-summary-tax>Included</span>
    </div>
  </div>

  <hr class="wm-cart-summary__divider">

  {%- comment -%} 4. Total Row {%- endcomment -%}
  <div class="wm-cart-summary__total-row">
    <div class="wm-cart-summary__total-label">
      Total Amount
      <small>Inclusive of all taxes</small>
    </div>
    <span class="wm-cart-summary__total-val" data-summary-total>&#8377;{{ grand_total_inr }}</span>
  </div>

  {%- comment -%} 5. Savings Pill {%- endcomment -%}
  <div class="wm-cart-summary__savings-pill" data-summary-savings-pill {% if discount_inr <= 0 %}hidden{% endif %}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    <span data-summary-savings-text>You save &#8377;{{ discount_inr }} on this order</span>
  </div>

  {%- comment -%} 6. Primary Proceed to Checkout CTA {%- endcomment -%}
  <button
    type="submit"
    name="checkout"
    form="wm-cart-form"
    class="wm-cart-summary__checkout-btn"
    data-cart-checkout-btn
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
    <span>PROCEED TO CHECKOUT</span>
  </button>

  {%- comment -%} 7. Secondary Continue Shopping Link {%- endcomment -%}
  <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="wm-cart-summary__continue">
    Continue shopping
  </a>

  {%- comment -%} 8. Optional Pincode Delivery Estimator {%- endcomment -%}
  <div class="wm-cart-pincode" data-cart-pincode>
    <p class="wm-cart-pincode__label">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
      Estimate Delivery Time
    </p>
    <div class="wm-cart-pincode__row">
      <input
        type="text"
        class="wm-cart-pincode__input"
        placeholder="Enter 6-digit pincode"
        maxlength="6"
        inputmode="numeric"
        value="395007"
        aria-label="Delivery pincode"
        data-cart-pincode-input
      >
      <button type="button" class="wm-cart-pincode__btn" data-cart-pincode-btn>Check</button>
    </div>
    <p class="wm-cart-pincode__result" data-cart-pincode-result aria-live="polite">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      <span>Delivery by <strong>Tue, 28 Oct</strong> &bull; COD Available</span>
    </p>
  </div>

  {%- comment -%} 9. Trust Badges (2x2 Grid, 14px text) {%- endcomment -%}
  <div class="wm-cart-trust" role="list" aria-label="Store guarantees">
    <div class="wm-cart-trust__item" role="listitem">
      <span class="wm-cart-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </span>
      <span class="wm-cart-trust__text">100% Secure Payments</span>
    </div>
    <div class="wm-cart-trust__item" role="listitem">
      <span class="wm-cart-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      </span>
      <span class="wm-cart-trust__text">Easy 7-Day Returns</span>
    </div>
    <div class="wm-cart-trust__item" role="listitem">
      <span class="wm-cart-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      </span>
      <span class="wm-cart-trust__text">Fast Express Delivery</span>
    </div>
    <div class="wm-cart-trust__item" role="listitem">
      <span class="wm-cart-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      </span>
      <span class="wm-cart-trust__text">Vet-Tested &amp; Safe</span>
    </div>
  </div>

  {%- comment -%} 10. Payment Icon Row {%- endcomment -%}
  <div class="wm-cart-payments" aria-label="Accepted payment methods">
    <span class="wm-cart-payment-pill">UPI</span>
    <span class="wm-cart-payment-pill">VISA</span>
    <span class="wm-cart-payment-pill">Mastercard</span>
    <span class="wm-cart-payment-pill">RuPay</span>
    <span class="wm-cart-payment-pill">COD</span>
  </div>
</aside>
