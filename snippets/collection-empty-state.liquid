{%- comment -%}
  Wagmart Collection Empty, Skeleton & Trust Strip Snippet (snippets/collection-empty-state.liquid)
  1. state_type == 'skeleton': Loading Shimmer Skeleton Grid (responsive for Grid & List View across all devices)
  2. state_type == 'trust-strip': Slim 4-Item Trust Strip before the footer
  3. state_type == 'empty' (default): No-Results Empty State ("No products match your filters" + "Clear All Filters" button)
{%- endcomment -%}

{%- if state_type == 'skeleton' -%}
  <div class="wm-plp-skeleton-grid" data-plp-skeleton hidden aria-hidden="true">
    {%- for i in (1..10) -%}
      <div class="wm-plp-skeleton-card">
        <div class="wm-plp-skeleton-card__media">
          <span class="wm-plp-skeleton-card__badge"></span>
          <span class="wm-plp-skeleton-card__actions">
            <span class="wm-plp-skeleton-card__circle"></span>
            <span class="wm-plp-skeleton-card__circle"></span>
          </span>
          <span class="wm-plp-skeleton-card__cta"></span>
        </div>
        <div class="wm-plp-skeleton-card__body">
          <div class="wm-plp-skeleton-card__meta">
            <span class="wm-plp-skeleton-line wm-plp-skeleton-line--pill"></span>
            <span class="wm-plp-skeleton-line wm-plp-skeleton-line--stock"></span>
          </div>
          <div class="wm-plp-skeleton-line wm-plp-skeleton-line--title"></div>
          <div class="wm-plp-skeleton-line wm-plp-skeleton-line--price"></div>
          <div class="wm-plp-skeleton-line wm-plp-skeleton-line--desc-1"></div>
          <div class="wm-plp-skeleton-line wm-plp-skeleton-line--desc-2"></div>
        </div>
      </div>
    {%- endfor -%}
  </div>

{%- elsif state_type == 'trust-strip' -%}
  <section class="wm-plp-trust-strip" aria-label="Wagmart Store Guarantees">
    <div class="wm-plp-trust-strip__grid">
      <div class="wm-plp-trust-strip__item">
        <span class="wm-plp-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </span>
        <div class="wm-plp-trust-strip__text">
          <strong class="wm-plp-trust-strip__title">Free Shipping Above ₹499</strong>
          <span class="wm-plp-trust-strip__sub">Fast express dispatch from Surat</span>
        </div>
      </div>

      <div class="wm-plp-trust-strip__item">
        <span class="wm-plp-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <div class="wm-plp-trust-strip__text">
          <strong class="wm-plp-trust-strip__title">100% Vet-Approved &amp; Safe</strong>
          <span class="wm-plp-trust-strip__sub">Non-toxic, pet-friendly materials</span>
        </div>
      </div>

      <div class="wm-plp-trust-strip__item">
        <span class="wm-plp-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        </span>
        <div class="wm-plp-trust-strip__text">
          <strong class="wm-plp-trust-strip__title">7-Day Easy Returns</strong>
          <span class="wm-plp-trust-strip__sub">Hassle-free replacement or refund</span>
        </div>
      </div>

      <div class="wm-plp-trust-strip__item">
        <span class="wm-plp-trust-strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <div class="wm-plp-trust-strip__text">
          <strong class="wm-plp-trust-strip__title">UPI, Cards &amp; COD Available</strong>
          <span class="wm-plp-trust-strip__sub">100% secure encrypted checkout</span>
        </div>
      </div>
    </div>
  </section>

{%- else -%}
  <div class="wm-plp-empty-state" data-plp-empty-state hidden role="status" aria-live="polite">
    <div class="wm-plp-empty-state__icon" aria-hidden="true">
      <svg viewBox="0 0 80 80" width="68" height="68" fill="none">
        <circle cx="40" cy="40" r="36" fill="#E8F3EC"/>
        <circle cx="28" cy="29" r="5" fill="#1B3A2A"/>
        <circle cx="40" cy="24" r="5" fill="#1B3A2A"/>
        <circle cx="52" cy="29" r="5" fill="#1B3A2A"/>
        <path d="M30 46c0-5.5 4.5-10 10-10s10 4.5 10 10c0 4-3 7-6 7h-8c-3 0-6-3-6-7z" fill="#1B3A2A"/>
        <path d="M52 52l10 10" stroke="#7A46E5" stroke-width="3.5" stroke-linecap="round"/>
      </svg>
    </div>

    <h2 class="wm-plp-empty-state__title">No products match your filters</h2>
    <p class="wm-plp-empty-state__desc">
      We couldn&rsquo;t find any pet supplies matching your current selection. Try adjusting your price range or clearing some filters.
    </p>

    <button type="button" class="wm-plp-empty-state__btn" data-plp-clear-all>
      Clear All Filters
    </button>
  </div>
{%- endif -%}
