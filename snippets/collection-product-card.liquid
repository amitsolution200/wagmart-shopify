{%- comment -%}
  Wagmart Collection Product Card (Converted from React ProductCard)
  - 4:5 aspect ratio with rounded-[20px] and overflow-hidden
  - Smooth 500ms hover image swap (fades out primary image, zooms in secondary image)
  - Inside content: bottom left (title + price in default store Rupees ₹)
  - Heart toggle: top right (toggles wishlist / favorite)
  - Inside bottom right: On-hover Add to Cart button that transforms into - / + quantity stepper
  - Fully responsive across mobile, tablet, and desktop
{%- endcomment -%}

{%- liquid
  assign p_id = card_id | default: 'wm-item-1'
  assign p_handle = card_handle | default: ''
  assign p_sku = card_sku | default: ''
  assign p_title = card_title | default: 'Gentle Silicone Pet Grooming & De-Shedding Brush'
  assign p_url = card_url | default: '/products/pet-grooming-glove'
  assign p_cat = card_category | default: 'Grooming'
  if p_cat == 'My Store 2' or p_cat == 'My Store' or p_cat == blank
    assign p_cat = 'Grooming'
  endif
  assign p_cats_all = card_categories | default: p_cat
  assign p_pet = card_pet | default: 'dog,cat'
  assign p_price = card_price_inr | default: 330 | plus: 0
  assign p_compare = card_compare_inr | default: 0 | plus: 0
  assign p_rating = card_rating | default: ''
  assign p_reviews = card_reviews | default: ''
  assign p_stock = card_stock | default: 15 | plus: 0
  assign p_promo = card_badge_promo | default: 'bestseller,sale'
  assign p_img = card_image
  assign p_images = card_images | default: card_image
  assign p_desc = card_desc
  if p_desc == blank
    assign p_desc = 'Crafted with pet-safe, vet-approved materials for daily comfort and care.'
  endif
  assign fallback_img = 'catalog-bath-massage-brush.webp' | asset_url

  if p_img == blank
    assign p_img = fallback_img
  endif
  if p_images == blank
    assign p_images = p_img
  endif

  assign discount_pct = 0
  if p_compare > p_price and p_compare > 0
    assign diff = p_compare | minus: p_price
    assign discount_pct = diff | times: 100 | divided_by: p_compare | round
  endif

  assign is_sold_out = false
  if p_stock <= 0
    assign is_sold_out = true
  endif

  assign badge_text = ''
  if is_sold_out
    assign badge_text = 'Sold Out'
  endif
-%}

<div
  class="wm-plp-card wm-unified-card wm-react-card group relative w-full flex flex-col select-none transition-all duration-300 cursor-pointer{% if is_sold_out %} is-sold-out{% endif %}"
  data-product-card
  data-product-id="{{ p_id }}"
  data-handle="{{ p_handle | escape }}"
  data-sku="{{ p_sku | escape }}"
  data-product-url="{{ p_url }}"
  data-product-name="{{ p_title | escape }}"
  data-product-price="₹{{ p_price }}"
  data-product-original-price="{% if p_compare > p_price %}₹{{ p_compare }}{% endif %}"
  data-product-compare-price="{% if p_compare > p_price %}₹{{ p_compare }}{% endif %}"
  data-product-image="{{ p_img }}"
  data-images="{{ p_images | escape }}"
  data-product-category="{{ p_cat | downcase | escape }}"
  data-product-desc="{{ p_desc | escape }}"
  data-title="{{ p_title | escape }}"
  data-category="{{ p_cat | escape }}"
  data-categories="{{ p_cats_all | downcase | escape }}"
  data-pet="{{ p_pet | downcase | escape }}"
  data-price="{{ p_price }}"
  data-compare-price="{% if p_compare > p_price %}{{ p_compare }}{% else %}0{% endif %}"
  data-discount="{{ discount_pct }}"
  {% if p_rating != blank %}data-rating="{{ p_rating }}"{% endif %}
  {% if p_reviews != blank %}data-reviews="{{ p_reviews }}"{% endif %}
  data-availability="{% if is_sold_out %}out-of-stock{% else %}in-stock{% endif %}"
  data-stock="{{ p_stock }}"
  data-badge-promo="{{ p_promo | downcase | escape }}"
  data-image="{{ p_img }}"
  data-url="{{ p_url }}"
  data-desc="{{ p_desc | escape }}"
  role="region"
  aria-label="{{ p_title | escape }}"
>
  <!-- Image Container (4:5 Aspect Ratio, Rounded 20px, Overflow Hidden, #FBFBF7 Background, No Border) -->
  <div class="wm-react-card__image-box relative w-full aspect-[4/5] rounded-[20px] overflow-hidden bg-[#FBFBF7] border-0 transition-all duration-500">
    <!-- Full card product link -->
    <a href="{{ p_url }}" class="wm-unified-card__media wm-plp-card__media-link block w-full h-full relative" aria-label="{{ p_title | escape }}">
      <!-- Primary Image (Only one image, no second image on hover) -->
      <img
        src="{{ p_img }}"
        alt="{{ p_title | escape }}"
        class="wm-react-card__img-primary wm-plp-card__img absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        width="600"
        height="750"
        loading="eager"
        decoding="async"
        onerror="this.onerror=null;this.src='{{ fallback_img }}';"
      >

      <!-- Sold Out Badge only (Best Seller removed) -->
      {%- if is_sold_out and badge_text != blank -%}
        <div class="wm-plp-card__badges absolute top-3.5 left-3.5 sm:top-4 sm:left-4 z-10 pointer-events-none">
          <span class="px-2.5 py-1 rounded-full text-[10.5px] sm:text-[11px] font-semibold uppercase tracking-wider bg-neutral-900/80 text-white backdrop-blur-xs shadow-xs">
            {{ badge_text }}
          </span>
        </div>
      {%- elsif p_cat != blank -%}
        <!-- Top Left: Category Badge (Glassmorphic pill with pure black text) -->
        <span class="wm-card__badge" aria-label="Category {{ p_cat | escape }}">
          {{ p_cat | capitalize }}
        </span>
      {%- endif -%}
    </a>

    <!-- Top Right Actions: Heart Wishlist & Eye Quick View directly below it -->
    <div class="wm-card__top-right-actions absolute top-2 right-2 sm:top-2.5 sm:right-2.5 z-20 flex flex-col items-center gap-1.5 pointer-events-auto">
      <!-- 1. Heart Wishlist Button -->
      <button
        type="button"
        class="wm-react-card__wishlist wm-plp-card__icon-btn w-7 h-7 rounded-full bg-white/95 hover:bg-white text-neutral-800 shadow-sm backdrop-blur-xs flex items-center justify-center p-0.5 cursor-pointer transition-all duration-200 hover:scale-110 active:scale-95"
        data-wishlist-btn
        data-wishlist-toggle
        data-product-id="{{ p_id }}"
        aria-label="Wishlist {{ p_title | escape }}"
      >
        <svg class="w-3.5 h-3.5 transition-colors duration-200 stroke-2 text-neutral-700 hover:text-[#E11D48]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
        </svg>
      </button>

      <!-- 2. Eye Quick View Button Below Heart (Opens Quick View on Click) -->
      <button
        type="button"
        class="wm-card__side-qv wm-plp-card__icon-btn w-7 h-7 rounded-full bg-white/95 hover:bg-white text-neutral-800 shadow-sm backdrop-blur-xs flex items-center justify-center p-0.5 cursor-pointer transition-all duration-200 hover:scale-110 active:scale-95"
        data-quick-view-trigger
        data-quick-view="{{ p_handle | default: p_id | default: 'pet-grooming-glove' | escape }}"
        aria-label="Quick View {{ p_title | escape }}"
      >
        <svg class="w-3.5 h-3.5 stroke-[2] text-neutral-700 hover:text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
    </div>

    <!-- Bottom Inside Image: Add To Bag Button (White Pill) & Active Stepper -->
    <div class="wm-card__img-qv-wrap absolute inset-x-2.5 bottom-2.5 sm:bottom-3 z-20 flex justify-center pointer-events-none">
      {%- if is_sold_out -%}
        <span class="wm-card__img-qv-btn pointer-events-auto flex items-center justify-center w-full h-7 sm:h-7.5 px-3 rounded-full bg-white/95 text-neutral-400 text-[10.5px] sm:text-[11px] font-semibold shadow-md select-none">
          Sold Out
        </span>
      {%- else -%}
        <button
          type="button"
          class="wm-card__img-qv-btn pointer-events-auto flex items-center justify-center gap-1.5 w-full h-7 sm:h-7.5 px-3 rounded-full bg-white/95 hover:bg-white text-neutral-900 text-[10.5px] sm:text-[11px] font-semibold shadow-md backdrop-blur-xs transition-all duration-200 hover:scale-[1.02] active:scale-95 cursor-pointer whitespace-nowrap"
          data-add-to-cart
          aria-label="Add {{ p_title | escape }} to Bag"
        >
          {% render 'icon-bag', class: 'w-3.5 h-3.5 stroke-[2.2]' %}
          <span>Add To Bag</span>
        </button>

        <!-- Stepper when product is in cart -->
        <div
          class="hidden pointer-events-auto w-full"
          data-card-stepper
        >
          <button
            type="button"
            data-card-stepper-btn
            data-delta="-1"
            aria-label="Decrease quantity"
          >
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>

          <span data-card-qty>
            1
          </span>

          <button
            type="button"
            data-card-stepper-btn
            data-delta="1"
            aria-label="Increase quantity"
          >
            <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- Content Below Image Box (Reference matching layout) -->
  <div class="wm-card__info wm-plp-card__info pt-2 pb-0.5 text-left flex flex-col items-start w-full flex-1">
    <div class="wm-plp-card__list-meta hidden">
      <span class="wm-plp-card__list-cat">{{ p_cat }}</span>
      <span class="wm-plp-card__list-stock"><span class="wm-plp-card__list-dot"></span>In Stock</span>
    </div>

    <!-- Product Heading / Title -->
    <h3 class="wm-card__title text-[13px] sm:text-[14.5px] leading-tight font-bold text-neutral-900 truncate w-full">
      <a href="{{ p_url }}" class="hover:underline text-neutral-900 block truncate" aria-label="{{ p_title | escape }}">
        {{ p_title }}
      </a>
    </h3>

    <!-- Bottom Row: Price -->
    <div class="wm-card__bottom-row flex items-center justify-between gap-1.5 w-full pt-0">
      <div data-price-wrap class="flex flex-col items-start leading-none shrink min-w-0">
        <div class="flex items-baseline gap-1.5 truncate">
          <span class="wm-card__price font-bold text-[13.5px] sm:text-[15px] text-neutral-900 tracking-tight" data-price-val>₹{{ p_price }}</span>
          {%- if p_compare > p_price -%}
            <span class="wm-card__compare-price text-neutral-400 line-through text-[9px] sm:text-[11px]" data-compare-val>₹{{ p_compare }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- if p_desc != blank -%}
      <p class="wm-plp-card__desc text-[13.5px] leading-relaxed text-neutral-500 line-clamp-2 mt-1 hidden" data-product-desc>
        {{ p_desc }}
      </p>
    {%- endif -%}
  </div>
</div>
