{%- comment -%}
  Reusable Product Trust Badges, Payment Icons & Social Share Component
  (snippets/product-trust-badges.liquid)
{%- endcomment -%}

{%- comment -%} 11. Trust Badge Grid (2x2, 14px, Lucide SVG Icons) {%- endcomment -%}
<div class="wm-trust-grid" aria-label="Store trust guarantees">
  <div class="wm-trust-card">
    <span class="wm-trust-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
      </svg>
    </span>
    <span class="wm-trust-card__text">Vet-Tested &amp; Safe</span>
  </div>

  <div class="wm-trust-card">
    <span class="wm-trust-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
    </span>
    <span class="wm-trust-card__text">Fast Express Delivery</span>
  </div>

  <div class="wm-trust-card">
    <span class="wm-trust-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
      </svg>
    </span>
    <span class="wm-trust-card__text">Easy 7-Day Returns</span>
  </div>

  <div class="wm-trust-card">
    <span class="wm-trust-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
    </span>
    <span class="wm-trust-card__text">100% Secure Payments</span>
  </div>
</div>

{%- comment -%} 12 & 13. Payment Icon Row + Share Buttons {%- endcomment -%}
<div class="wm-meta-footer">
  <div class="wm-payment-badges" aria-label="Accepted payment methods">
    <span class="wm-payment-badge" title="UPI Instant Pay">UPI</span>
    <span class="wm-payment-badge" title="Visa">VISA</span>
    <span class="wm-payment-badge" title="Mastercard">Mastercard</span>
    <span class="wm-payment-badge" title="RuPay">RuPay</span>
    <span class="wm-payment-badge" title="Cash on Delivery">COD</span>
  </div>

  <div class="wm-share-row">
    <span class="wm-share-row__label">Share:</span>
    <a
      href="https://api.whatsapp.com/send?text={{ product.title | default: 'Pet Grooming Glove' | url_encode }}%20{{ shop.url }}{{ product.url }}"
      target="_blank"
      rel="noopener noreferrer"
      class="wm-share-btn"
      aria-label="Share on WhatsApp"
      title="Share on WhatsApp"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
      </svg>
    </a>
    <a
      href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}"
      target="_blank"
      rel="noopener noreferrer"
      class="wm-share-btn"
      aria-label="Share on Facebook"
      title="Share on Facebook"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
      </svg>
    </a>
    <button
      type="button"
      class="wm-share-btn"
      data-share-copy
      aria-label="Copy product link"
      title="Copy link"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
      </svg>
    </button>
  </div>
</div>
