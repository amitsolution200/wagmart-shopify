{%- comment -%}
  Wagmart Unified Global Quick View Drawer (snippets/quick-view-modal.liquid)
  - Rendered globally in layout/theme.liquid so the Eye icon works on Homepage, Collection Page, Cart Page & Product Details Page
  - Desktop (>=1200px): 50vw width (max 900px), max-height 90vh, fixed to the right, 2-column gallery (48%) + product info (52%)
  - Laptop & Tablet (768px-1199px): 80vw width (max 1000px), max-height 90vh, fixed to the right, 2-column layout
  - Mobile (<768px): 100vw x 100dvh full-screen single-column drawer matching the mobile reference
{%- endcomment -%}

<style>
  /* ==========================================================================
     WAGMART RESPONSIVE PRODUCT QUICK VIEW DRAWER
     ========================================================================== */
  .wm-plp-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    box-sizing: border-box;
    pointer-events: auto;
  }

  .wm-plp-modal[hidden],
  .wm-plp-modal.hidden {
    display: none !important;
  }

  .wm-plp-modal__backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(18, 16, 14, 0.52);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  .wm-plp-modal.is-open .wm-plp-modal__backdrop {
    opacity: 1;
  }

  .wm-plp-modal.is-closing .wm-plp-modal__backdrop {
    opacity: 0;
  }

  /* Desktop Drawer (>=1200px): 52vw width, max 820px, auto-fit height matching gallery + info */
  .wm-plp-modal__dialog {
    position: relative;
    z-index: 1;
    background-color: #FFFFFF;
    border-radius: 20px;
    width: 52vw;
    max-width: 820px;
    height: auto !important;
    max-height: 88vh;
    margin: auto;
    box-shadow: 0 24px 64px rgba(15, 18, 16, 0.24), 0 4px 16px rgba(15, 18, 16, 0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    outline: none;
    box-sizing: border-box;
    transform: translateY(16px) scale(0.98);
    opacity: 0;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease-out;
  }

  .wm-plp-modal.is-open .wm-plp-modal__dialog {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .wm-plp-modal.is-closing .wm-plp-modal__dialog {
    transform: translateY(16px) scale(0.98);
    opacity: 0;
  }

  /* Drag handle indicator (only visible on mobile bottom-sheet) */
  .wm-plp-modal__handle {
    display: none;
  }

  /* Upper-Right Close Button */
  .wm-plp-modal__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 15;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #E5E1D8;
    background-color: #F4F2ED;
    color: #2B2623;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .wm-plp-modal__close:hover {
    background-color: #EAE5DC;
    border-color: #D4CBB8;
  }

  .wm-plp-modal__close:focus-visible {
    outline: 2px solid #8C4A27;
    outline-offset: 2px;
  }

  /* Two-Column Internal Layout (Gallery ~48%, Info ~52%) */
  .wm-plp-modal__grid {
    display: grid;
    grid-template-columns: 48% 52%;
    align-items: stretch;
    width: 100%;
    height: auto !important;
    max-height: 88vh;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    box-sizing: border-box;
    scrollbar-width: thin;
    scrollbar-color: #D5CFC4 transparent;
  }

  /* Left Column: Product Gallery (Main Image + Horizontal Thumbnail Strip Below per Reference Image 2) */
  .wm-plp-modal__media {
    position: relative;
    top: 0;
    align-self: stretch;
    background-color: #FFFFFF;
    padding: 20px;
    width: 100%;
    min-width: 0 !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    overflow: hidden !important;
    box-sizing: border-box;
    user-select: none;
  }

  .wm-plp-modal__gallery-main {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    gap: 12px;
    width: 100%;
    min-width: 0 !important;
    max-width: 100% !important;
    overflow: hidden !important;
  }

  /* Primary Image Card with Circular Prev/Next Overlay Arrows */
  .wm-plp-modal__stage {
    order: 1;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    min-height: 0;
    max-height: none;
    background-color: #FFFFFF;
    border-radius: 14px;
    padding: 0;
    display: block;
    overflow: hidden;
    box-sizing: border-box;
  }

  .wm-plp-modal__img-link {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border-radius: inherit;
    overflow: hidden;
    text-decoration: none;
  }

  .wm-plp-modal__img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    object-position: center;
    border-radius: inherit;
    display: block;
    margin: 0;
    padding: 0;
    transition: opacity 0.18s ease;
  }

  /* Circular Prev / Next Arrows on Gallery Thumbnails Row */
  #wm-quick-view-modal .wm-plp-modal__thumbs-row {
    order: 2;
    position: relative !important;
    width: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }

  .wm-plp-modal__stage-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 6;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background-color: rgba(255, 255, 255, 0.95);
    color: #1F1916;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.14);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
  }

  .wm-plp-modal__stage-arrow:hover {
    background-color: #FFFFFF;
    box-shadow: 0 5px 14px rgba(0, 0, 0, 0.2);
    transform: translateY(-50%) scale(1.05);
  }

  .wm-plp-modal__stage-arrow--prev {
    left: 6px;
  }

  .wm-plp-modal__stage-arrow--next {
    right: 6px;
  }

  .wm-plp-modal__stage-arrow[hidden] {
    display: none !important;
  }

  /* Horizontal Row of Square Gallery Thumbnails Below Main Image (Exact 3 Visible) */
  #wm-quick-view-modal .wm-plp-modal__thumbs {
    order: 2;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 10px !important;
    width: 100% !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    padding: 2px 0 !important;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #wm-quick-view-modal .wm-plp-modal__thumbs::-webkit-scrollbar {
    display: none;
  }

  #wm-quick-view-modal .wm-plp-modal__thumbs[hidden] {
    display: none !important;
  }

  #wm-quick-view-modal .wm-plp-modal__thumb {
    width: calc((100% - 20px) / 3) !important;
    height: 96px !important;
    min-width: calc((100% - 20px) / 3) !important;
    max-width: calc((100% - 20px) / 3) !important;
    min-height: 96px !important;
    max-height: 96px !important;
    flex: 0 0 calc((100% - 20px) / 3) !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: 10px !important;
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
    background-color: transparent !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    opacity: 1 !important;
    transition: opacity 0.18s ease !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }

  #wm-quick-view-modal .wm-plp-modal__thumb:hover,
  #wm-quick-view-modal .wm-plp-modal__thumb:focus,
  #wm-quick-view-modal .wm-plp-modal__thumb:focus-visible {
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
  }

  #wm-quick-view-modal .wm-plp-modal__thumb.is-active {
    opacity: 0.45 !important;
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
  }

  #wm-quick-view-modal .wm-plp-modal__thumb img {
    width: 100% !important;
    height: 100% !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center !important;
    border-radius: inherit !important;
    border: none !important;
    box-shadow: none !important;
    outline: none !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* Hide legacy dot pager since horizontal thumbnails row is shown below main image */
  #wm-quick-view-modal .wm-plp-modal__pager {
    display: none !important;
  }

  .wm-plp-modal__nav {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: #3F3A34;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .wm-plp-modal__nav:hover {
    color: #1F1916;
  }

  .wm-plp-modal__nav[hidden] {
    display: none !important;
  }

  .wm-plp-modal__dots {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .wm-plp-modal__dots[hidden] {
    display: none !important;
  }

  .wm-plp-modal__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: #A8A298;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .wm-plp-modal__dot.is-active {
    background-color: #263849;
    transform: scale(1.15);
  }

  /* Right Column: Product Information (Aligned to Top) */
  .wm-plp-modal__info {
    position: sticky;
    top: 0;
    align-self: start;
    min-height: 100%;
    padding: 24px 26px 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 10px;
    box-sizing: border-box;
    min-width: 0;
  }

  .wm-plp-modal__category {
    font-size: 12.5px;
    font-weight: 500;
    color: #78716C;
    line-height: 1.3;
    margin: 0;
    text-transform: capitalize;
  }

  .wm-plp-modal__title {
    font-size: clamp(20px, 1.55vw, 24px);
    font-weight: 700;
    line-height: 1.25;
    color: #1F1916;
    margin: 0;
    letter-spacing: -0.015em;
    padding-right: 36px;
    overflow-wrap: break-word;
  }

  .wm-plp-modal__title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .wm-plp-modal__title-link:hover {
    color: #8C4A27;
  }

  /* SKU & Genuine Rating */
  .wm-plp-modal__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin-top: -2px;
  }

  .wm-plp-modal__sku {
    font-size: 12px;
    font-weight: 400;
    color: #78716C;
    letter-spacing: 0.01em;
  }

  .wm-plp-modal__rating {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: #1F1916;
  }

  .wm-plp-modal__rating[hidden],
  .wm-plp-modal__sku[hidden] {
    display: none !important;
  }

  .wm-plp-modal__stars {
    color: #F59E0B;
    letter-spacing: 0.02em;
  }

  .wm-plp-modal__reviews {
    color: #78716C;
    font-weight: 400;
  }

  /* Price Row */
  .wm-plp-modal__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2px;
  }

  .wm-plp-modal__price {
    font-size: clamp(22px, 1.7vw, 26px);
    font-weight: 700;
    color: #1F1916;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .wm-plp-modal__compare {
    font-size: 15px;
    color: #9CA3AF;
    text-decoration: line-through;
    font-weight: 500;
  }

  .wm-plp-modal__compare[hidden] {
    display: none !important;
  }

  .wm-plp-modal__badge {
    background-color: #EBF5EC;
    color: #2E6F3E;
    border: 1px solid #CBE6CE;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    line-height: 1.2;
  }

  .wm-plp-modal__badge[hidden] {
    display: none !important;
  }

  /* Product Options / Variants */
  .wm-plp-modal__options {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 2px;
  }

  .wm-plp-modal__options[hidden] {
    display: none !important;
  }

  .wm-plp-modal__option-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .wm-plp-modal__option-label {
    font-size: 12.5px;
    font-weight: 600;
    color: #1F1916;
  }

  .wm-plp-modal__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wm-plp-modal__option-btn {
    padding: 7px 14px;
    border-radius: 6px;
    border: 1px solid #D6D1C7;
    background-color: #FFFFFF;
    color: #1F1916;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .wm-plp-modal__option-btn:hover {
    border-color: #1F1916;
  }

  .wm-plp-modal__option-btn.is-selected {
    border-color: #1F1916;
    box-shadow: inset 0 0 0 1px #1F1916;
    font-weight: 600;
  }

  /* 2-Column CTA Grid matching PDP across ALL devices: [Add to Cart / - 1 + Stepper] | [Buy it now] */
  .wm-plp-modal__cta-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
    width: 100%;
  }

  #wm-quick-view-modal .wm-plp-modal__cta-grid {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 10px !important;
    align-items: stretch !important;
    width: 100% !important;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-cell {
    min-width: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-cell [data-qv-atc][hidden],
  #wm-quick-view-modal .wm-plp-modal__atc-stepper[hidden] {
    display: none !important;
  }

  /* Active Cart Quantity Stepper (- 1 +) matching PDP (.wm-pdp-atc-stepper) */
  #wm-quick-view-modal .wm-plp-modal__atc-stepper {
    width: 100%;
    height: 46px;
    min-height: 46px;
    padding: 0 8px;
    border-radius: 9999px;
    border: 1.5px solid #000000;
    background-color: #FFFFFF;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    font-variant-numeric: tabular-nums;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-stepper-btn {
    width: 34px;
    height: 34px;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #000000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: background-color 150ms ease;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-stepper-btn:hover:not(:disabled) {
    background-color: #F4F1EA;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-stepper-btn:disabled {
    opacity: 0.32;
    cursor: not-allowed;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-stepper-val {
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    color: #000000;
    text-align: center;
    min-width: 24px;
    user-select: none;
  }

  /* Add to Cart Button (Matching Product Details Page: Solid Black, White Text, Bag Icon) */
  #wm-quick-view-modal .wm-plp-modal__atc-btn,
  #wm-quick-view-modal .wm-qv-atc-btn {
    width: 100%;
    height: 46px;
    min-height: 46px;
    border-radius: 9999px !important;
    border: 1.5px solid #000000 !important;
    background-color: #000000 !important;
    color: #FFFFFF !important;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    padding: 0 14px;
    box-sizing: border-box;
    transition: background-color 0.16s ease, transform 0.12s ease, border-color 0.16s ease;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-btn:hover:not(:disabled),
  #wm-quick-view-modal .wm-qv-atc-btn:hover:not(:disabled) {
    background-color: #222222 !important;
    border-color: #222222 !important;
  }

  #wm-quick-view-modal .wm-plp-modal__atc-btn:disabled,
  #wm-quick-view-modal .wm-plp-modal__buy-btn:disabled,
  #wm-quick-view-modal .wm-qv-atc-btn:disabled,
  #wm-quick-view-modal .wm-qv-buy-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* Buy It Now Button (Matching PDP .wm-pdp-form__buy-now-fallback: Solid Black Pill) */
  #wm-quick-view-modal .wm-plp-modal__buy-btn,
  #wm-quick-view-modal .wm-qv-buy-btn {
    width: 100%;
    height: 46px;
    min-height: 46px;
    border-radius: 9999px !important;
    border: 1.5px solid #000000 !important;
    background-color: #000000 !important;
    color: #FFFFFF !important;
    font-family: inherit;
    font-size: 14.5px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    padding: 0 16px;
    box-sizing: border-box;
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.12s ease;
  }

  #wm-quick-view-modal .wm-plp-modal__buy-btn:hover:not(:disabled),
  #wm-quick-view-modal .wm-qv-buy-btn:hover:not(:disabled) {
    background-color: #222222 !important;
    border-color: #222222 !important;
    color: #FFFFFF !important;
  }

  .wm-plp-modal__spinner,
  .wm-qv-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    display: inline-block;
    animation: wmQvSpin 0.65s linear infinite;
  }

  .wm-plp-modal__spinner[hidden],
  .wm-qv-spinner[hidden] {
    display: none !important;
  }

  @keyframes wmQvSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Status Feedback Message (Hidden - Add to Cart updates stepper directly) */
  .wm-plp-modal__feedback {
    display: none !important;
  }

  /* Short Product Description (Below Buy It Now) */
  .wm-plp-modal__desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: #3F3A34;
    margin: 4px 0 0;
  }

  /* View Full Details Link (At Bottom) */
  .wm-plp-modal__full-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #1F1916;
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-top: 2px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    transition: color 0.15s ease;
  }

  .wm-plp-modal__full-link:hover {
    color: #8C4A27;
  }

  /* Never show weight/kg option pills in Quick View */
  [data-qv-variants],
  .wm-plp-modal__variants-label,
  .wm-plp-modal__variant-pills,
  .wm-plp-modal .weight-chip,
  .wm-plp-modal [data-weight] {
    display: none !important;
  }

  /* ==========================================================================
     LAPTOP & TABLET LAYOUT (768px - 1199px): Auto-Fit Height + Main Image & Row Thumbnails Below
     ========================================================================== */
  @media (min-width: 1024px) and (max-width: 1199px) {
    .wm-plp-modal {
      justify-content: center;
      align-items: center;
      padding: 16px;
    }

    #wm-quick-view-modal .wm-plp-modal__dialog {
      width: 68vw !important;
      max-width: 740px !important;
      height: auto !important;
      max-height: 88vh !important;
      margin: auto;
      border-radius: 18px;
    }

    #wm-quick-view-modal .wm-plp-modal__grid {
      grid-template-columns: 46% 54% !important;
      align-items: stretch !important;
      height: auto !important;
      max-height: 88vh !important;
    }

    #wm-quick-view-modal .wm-plp-modal__media {
      position: relative !important;
      top: 0 !important;
      align-self: stretch !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      padding: 16px !important;
      gap: 10px !important;
      justify-content: flex-start !important;
      align-items: center !important;
    }

    #wm-quick-view-modal .wm-plp-modal__gallery-main {
      gap: 10px !important;
    }

