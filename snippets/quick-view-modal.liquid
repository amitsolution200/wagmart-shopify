            <div class="wm-plp-modal__thumbs" data-qv-thumbs role="listbox" aria-label="Product thumbnails" hidden></div>

            <button
              type="button"
              class="wm-plp-modal__stage-arrow wm-plp-modal__stage-arrow--next"
              data-qv-next
