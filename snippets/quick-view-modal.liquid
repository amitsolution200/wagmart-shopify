        <div class="wm-plp-modal__gallery-main">
          <div class="wm-plp-modal__stage" data-qv-stage>
            <a href="/products/pet-grooming-glove" class="wm-plp-modal__img-link" data-qv-image-link data-qv-link tabindex="-1">
              <img
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                alt="Product preview"
                class="wm-plp-modal__img"
