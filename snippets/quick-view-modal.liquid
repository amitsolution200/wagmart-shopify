        </p>

        <a href="/products/pet-grooming-glove" class="wm-plp-modal__full-link" data-qv-full-link data-qv-link>
          View full details
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} Global Variant & Product Stock Map for Quick View & Cart Stepper Stock Limits {%- endcomment -%}
  <script type="application/json" id="cart-drawer-stock-map">
    {
      {%- assign qv_first_entry = true -%}
      {%- for qv_prod in collections['all'].products limit: 250 -%}
        {%- for qv_var in qv_prod.variants -%}
          {%- liquid
            if qv_var.available == false
              assign qv_max = 0
            elsif qv_var.inventory_management == 'shopify' and qv_var.inventory_policy == 'deny'
              assign qv_max = qv_var.inventory_quantity | default: 0
            else
              assign qv_max = 99
            endif
          -%}
          {%- unless qv_first_entry -%},{%- endunless -%}
          "{{ qv_var.id }}": {{ qv_max | json }}
          {%- assign qv_first_entry = false -%}
        {%- endfor -%}
        {%- liquid
          assign qv_sel = qv_prod.selected_or_first_available_variant | default: qv_prod.variants.first
          if qv_sel.available == false
            assign qv_prod_max = 0
          elsif qv_sel.inventory_management == 'shopify' and qv_sel.inventory_policy == 'deny'
            assign qv_prod_max = qv_sel.inventory_quantity | default: 0
          else
            assign qv_prod_max = 99
          endif
        -%}
        ,"{{ qv_prod.id }}": {{ qv_prod_max | json }}
      {%- endfor -%}
    }
  </script>
