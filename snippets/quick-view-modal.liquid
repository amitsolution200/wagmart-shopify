              >
                <span class="wm-plp-modal__spinner" data-qv-atc-spinner hidden aria-hidden="true"></span>
                <svg class="wm-icon wm-icon--bag" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-qv-atc-icon>
                  <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                  <line x1="3" y1="6" x2="21" y2="6"/>
                  <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
                <span data-qv-atc-label>Add to Cart</span>
              </button>

              <div class="wm-plp-modal__atc-stepper" data-qv-atc-stepper hidden>
