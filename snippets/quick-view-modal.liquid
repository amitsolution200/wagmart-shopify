        <div class="wm-plp-modal__price-row" data-qv-price-row>
          <span class="wm-plp-modal__price" data-qv-price>₹330</span>
          <s class="wm-plp-modal__compare" data-qv-compare>₹413</s>
          <span class="wm-plp-modal__badge" data-qv-badge hidden></span>
        </div>

        <div class="wm-plp-modal__options" data-qv-options hidden></div>

        <div
