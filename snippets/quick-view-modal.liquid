{%- comment -%}
  Wagmart Unified Global Quick View Drawer (snippets/quick-view-modal.liquid)
  - Rendered globally in layout/theme.liquid so the Eye icon works on Homepage, Collection Page, Cart Page & Product Details Page
  - Desktop (>=1200px): 50vw width (max 900px), max-height 90vh, fixed to the right, 2-column gallery (48%) + product info (52%)
  - Laptop & Tablet (768px-1199px): 80vw width (max 1000px), max-height 90vh, fixed to the right, 2-column layout
  - Mobile (<768px): 100vw x 100dvh full-screen single-column drawer matching the mobile reference
{%- endcomment -%}

<style>
  /* ==========================================================================
     WAGMART RESPONSIVE PRODUCT QUICK VIEW DRAWER
     ========================================================================== */
  .wm-plp-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    box-sizing: border-box;
    pointer-events: auto;
  }

  .wm-plp-modal[hidden],
  .wm-plp-modal.hidden {
    display: none !important;
  }

  .wm-plp-modal__backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(18, 16, 14, 0.52);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 220ms ease-out;
  }

  .wm-plp-modal.is-open .wm-plp-modal__backdrop {
    opacity: 1;
  }

  .wm-plp-modal.is-closing .wm-plp-modal__backdrop {
    opacity: 0;
  }

  /* Desktop Drawer (>=1200px): 48vw width, max 800px, max-height 80vh, centered */
  .wm-plp-modal__dialog {
    position: relative;
    z-index: 1;
    background-color: #FFFFFF;
    border-radius: 20px;
    width: 48vw;
    max-width: 800px;
    height: 80vh;
    max-height: 680px;
    margin: auto;
    box-shadow: 0 24px 64px rgba(15, 18, 16, 0.24), 0 4px 16px rgba(15, 18, 16, 0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    outline: none;
    box-sizing: border-box;
    transform: translateY(16px) scale(0.98);
    opacity: 0;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms ease-out;
  }

  .wm-plp-modal.is-open .wm-plp-modal__dialog {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .wm-plp-modal.is-closing .wm-plp-modal__dialog {
    transform: translateY(16px) scale(0.98);
    opacity: 0;
  }

  /* Drag handle indicator (only visible on mobile bottom-sheet) */
  .wm-plp-modal__handle {
    display: none;
  }

  /* Upper-Right Close Button */
  .wm-plp-modal__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 15;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid #E5E1D8;
    background-color: #F4F2ED;
    color: #2B2623;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .wm-plp-modal__close:hover {
    background-color: #EAE5DC;
    border-color: #D4CBB8;
  }

  .wm-plp-modal__close:focus-visible {
    outline: 2px solid #8C4A27;
    outline-offset: 2px;
  }

  /* Two-Column Internal Layout (Gallery ~48%, Info ~52%) */
  .wm-plp-modal__grid {
    display: grid;
    grid-template-columns: 48% 52%;
    align-items: start;
    width: 100%;
    height: 100%;
    max-height: 90vh;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    box-sizing: border-box;
    scrollbar-width: thin;
    scrollbar-color: #D5CFC4 transparent;
  }

  /* Left Column: Sticky Product Gallery with Stacked Main-Size Images */
  .wm-plp-modal__media {
    position: sticky;
    top: 0;
    align-self: start;
    background-color: #F6F5F2;
    padding: 16px;
    width: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    box-sizing: border-box;
    user-select: none;
  }

  .wm-plp-modal__gallery-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    width: 100%;
  }

  /* Primary Image Card (Zero inner padding, full card image fit) */
  .wm-plp-modal__stage {
    order: 1;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    min-height: 0;
    max-height: none;
    background-color: #F3F4F6;
    border-radius: 14px;
    padding: 0;
    display: block;
    overflow: hidden;
    box-sizing: border-box;
  }

  .wm-plp-modal__img-link {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border-radius: inherit;
    overflow: hidden;
    text-decoration: none;
  }

  .wm-plp-modal__img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    object-position: center;
    border-radius: inherit;
    display: block;
    margin: 0;
    padding: 0;
    transition: opacity 0.18s ease;
  }

  /* Stacked Gallery Images Matching Main Image Height & Width */
  .wm-plp-modal__thumbs {
    order: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    width: 100%;
  }

  .wm-plp-modal__thumbs[hidden] {
    display: none !important;
  }

  .wm-plp-modal__thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    min-height: 0;
    max-height: none;
    border-radius: 14px;
    border: none;
    background-color: #F3F4F6;
    padding: 0;
    display: block;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    flex-shrink: 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  .wm-plp-modal__thumb:hover {
    box-shadow: 0 6px 18px rgba(15, 18, 16, 0.06);
  }

  .wm-plp-modal__thumb.is-active {
    box-shadow: 0 0 0 2px rgba(140, 74, 39, 0.18);
  }

  .wm-plp-modal__thumb img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    object-position: center;
    border-radius: inherit;
    display: block;
    margin: 0;
    padding: 0;
  }

  /* Compact Pill Pager (< • • • >) for Mobile / Multi-Image Navigation */
  .wm-plp-modal__pager {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #EAE5D7;
    border-radius: 999px;
    padding: 4px 10px;
    width: fit-content;
    margin: 2px auto 0;
  }

  .wm-plp-modal__pager[hidden] {
    display: none !important;
  }

  .wm-plp-modal__nav {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: #3F3A34;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .wm-plp-modal__nav:hover {
    color: #1F1916;
  }

  .wm-plp-modal__nav[hidden] {
    display: none !important;
  }

  .wm-plp-modal__dots {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .wm-plp-modal__dots[hidden] {
    display: none !important;
  }

  .wm-plp-modal__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background-color: #A8A298;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .wm-plp-modal__dot.is-active {
    background-color: #263849;
    transform: scale(1.15);
  }

  /* Right Column: Product Information (Aligned to Top) */
  .wm-plp-modal__info {
    position: sticky;
    top: 0;
    align-self: start;
    min-height: 100%;
    padding: 24px 26px 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 10px;
    box-sizing: border-box;
    min-width: 0;
  }

  .wm-plp-modal__category {
    font-size: 12.5px;
    font-weight: 500;
    color: #78716C;
    line-height: 1.3;
    margin: 0;
    text-transform: capitalize;
  }

  .wm-plp-modal__title {
    font-size: clamp(20px, 1.55vw, 24px);
    font-weight: 700;
    line-height: 1.25;
    color: #1F1916;
    margin: 0;
    letter-spacing: -0.015em;
    padding-right: 36px;
    overflow-wrap: break-word;
  }

  .wm-plp-modal__title-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .wm-plp-modal__title-link:hover {
    color: #8C4A27;
  }

  /* SKU & Genuine Rating */
  .wm-plp-modal__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    margin-top: -2px;
  }

  .wm-plp-modal__sku {
    font-size: 12px;
    font-weight: 400;
    color: #78716C;
    letter-spacing: 0.01em;
  }

  .wm-plp-modal__rating {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    font-weight: 600;
    color: #1F1916;
  }

  .wm-plp-modal__rating[hidden],
  .wm-plp-modal__sku[hidden] {
    display: none !important;
  }

  .wm-plp-modal__stars {
    color: #F59E0B;
    letter-spacing: 0.02em;
  }

  .wm-plp-modal__reviews {
    color: #78716C;
    font-weight: 400;
  }

  /* Price Row */
  .wm-plp-modal__price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 2px;
  }

  .wm-plp-modal__price {
    font-size: clamp(22px, 1.7vw, 26px);
    font-weight: 700;
    color: #1F1916;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .wm-plp-modal__compare {
    font-size: 15px;
    color: #9CA3AF;
    text-decoration: line-through;
    font-weight: 500;
  }

  .wm-plp-modal__compare[hidden] {
    display: none !important;
  }

  .wm-plp-modal__badge {
    background-color: #EBF5EC;
    color: #2E6F3E;
    border: 1px solid #CBE6CE;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 999px;
    line-height: 1.2;
  }

  .wm-plp-modal__badge[hidden] {
    display: none !important;
  }

  /* Product Options / Variants */
  .wm-plp-modal__options {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 2px;
  }

  .wm-plp-modal__options[hidden] {
    display: none !important;
  }

  .wm-plp-modal__option-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .wm-plp-modal__option-label {
    font-size: 12.5px;
    font-weight: 600;
    color: #1F1916;
  }

  .wm-plp-modal__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .wm-plp-modal__option-btn {
    padding: 7px 14px;
    border-radius: 6px;
    border: 1px solid #D6D1C7;
    background-color: #FFFFFF;
    color: #1F1916;
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .wm-plp-modal__option-btn:hover {
    border-color: #1F1916;
  }

  .wm-plp-modal__option-btn.is-selected {
    border-color: #1F1916;
    box-shadow: inset 0 0 0 1px #1F1916;
    font-weight: 600;
  }

  /* Purchase Controls Stack: [Quantity + Add to Cart] Row + [Buy It Now] Row */
  .wm-plp-modal__cta-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
    width: 100%;
  }

  .wm-plp-modal__purchase-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    width: 100%;
  }

  /* Compact Quantity Selector (- 1 +) */
  .wm-plp-modal__qty-box {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 44px;
    border: 1px solid #000000;
    border-radius: 9999px;
    background-color: #FFFFFF;
    padding: 0 8px;
    box-sizing: border-box;
  }

  .wm-plp-modal__qty-btn {
    width: 32px;
    height: 34px;
    border: none;
    background: transparent;
    color: #111827;
    font-size: 16px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border-radius: 6px;
    transition: background-color 0.15s ease, opacity 0.15s ease;
    padding: 0;
  }

  .wm-plp-modal__qty-btn:hover:not(:disabled) {
    background-color: #F3F4F6;
  }

  .wm-plp-modal__qty-btn:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }

  .wm-plp-modal__qty-input {
    width: 36px;
    height: 100%;
    border: none;
    background: transparent;
    text-align: center;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    color: #111827;
    outline: none;
    -moz-appearance: textfield;
  }

  .wm-plp-modal__qty-input::-webkit-outer-spin-button,
  .wm-plp-modal__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* Add to Cart Button (Matching Product Details Page: Solid Black, White Text) */
  .wm-plp-modal__atc-btn,
  .wm-qv-atc-btn {
    width: 100%;
    height: 44px;
    min-height: 44px;
    border-radius: 9999px;
    border: 1px solid #000000;
    background-color: #000000;
    color: #FFFFFF;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    padding: 0 16px;
    box-sizing: border-box;
    transition: background-color 0.16s ease, transform 0.12s ease, border-color 0.16s ease;
  }

  .wm-plp-modal__atc-btn:hover:not(:disabled),
  .wm-qv-atc-btn:hover:not(:disabled) {
    background-color: #222222;
    border-color: #222222;
  }

  .wm-plp-modal__atc-btn:disabled,
  .wm-plp-modal__buy-btn:disabled,
  .wm-qv-atc-btn:disabled,
  .wm-qv-buy-btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* Buy It Now Button (Matching Product Details Page: White, Black Border, Black Text - NO GREEN) */
  .wm-plp-modal__buy-btn,
  .wm-qv-buy-btn {
    width: 100%;
    height: 44px;
    min-height: 44px;
    border-radius: 9999px;
    border: 1px solid #000000;
    background-color: #FFFFFF;
    color: #000000;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    padding: 0 18px;
    box-sizing: border-box;
    transition: background-color 0.16s ease, color 0.16s ease, transform 0.12s ease;
  }

  .wm-plp-modal__buy-btn:hover:not(:disabled),
  .wm-qv-buy-btn:hover:not(:disabled) {
    background-color: #000000;
    color: #FFFFFF;
  }

  .wm-plp-modal__spinner,
  .wm-qv-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    display: inline-block;
    animation: wmQvSpin 0.65s linear infinite;
  }

  .wm-plp-modal__spinner[hidden],
  .wm-qv-spinner[hidden] {
    display: none !important;
  }

  @keyframes wmQvSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Status Feedback Message (Hidden - Add to Cart opens Cart Drawer directly) */
  .wm-plp-modal__feedback {
    display: none !important;
  }

  /* Short Product Description (Below Buy It Now) */
  .wm-plp-modal__desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: #3F3A34;
    margin: 4px 0 0;
  }

  /* View Full Details Link (At Bottom) */
  .wm-plp-modal__full-link {
    font-size: 13.5px;
    font-weight: 500;
    color: #1F1916;
    text-decoration: underline;
    text-underline-offset: 4px;
    margin-top: 2px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    width: fit-content;
    transition: color 0.15s ease;
  }

  .wm-plp-modal__full-link:hover {
    color: #8C4A27;
  }

  /* Never show weight/kg option pills in Quick View */
  [data-qv-variants],
  .wm-plp-modal__variants-label,
  .wm-plp-modal__variant-pills,
  .wm-plp-modal .weight-chip,
  .wm-plp-modal [data-weight] {
    display: none !important;
  }

  /* ==========================================================================
     LAPTOP & TABLET LAYOUT (768px - 1199px): Decreased Size & Full-Card Images
     ========================================================================== */
    @media (min-width: 1024px) and (max-width: 1199px) {
    .wm-plp-modal {
      justify-content: center;
      align-items: center;
      padding: 16px;
    }

    .wm-plp-modal__dialog {
      width: 66vw;
      max-width: 720px;
      height: auto;
      max-height: min(70vh, 490px);
      margin: auto;
      border-radius: 18px;
    }

    .wm-plp-modal__grid {
      grid-template-columns: 46% 54%;
      align-items: start;
      height: auto;
      max-height: min(70vh, 490px);
    }

    .wm-plp-modal__media {
      position: sticky;
      top: 0;
      align-self: start;
      width: 100%;
      min-height: 100%;
      padding: 12px;
      gap: 12px;
      justify-content: flex-start;
      align-items: center;
    }

    .wm-plp-modal__gallery-main,
    .wm-plp-modal__thumbs {
      gap: 12px;
    }

    .wm-plp-modal__stage,
    .wm-plp-modal__thumb {
      width: 100%;
      aspect-ratio: 1 / 1;
      min-height: 0;
      max-height: none;
      padding: 0 !important;
      border-radius: 14px;
      background-color: #F3F4F6;
      overflow: hidden;
    }

    .wm-plp-modal__img,
    .wm-plp-modal__thumb img {
      width: 100% !important;
      height: 100% !important;
      max-height: none !important;
      object-fit: cover !important;
      object-position: center !important;
      border-radius: inherit !important;
      display: block !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .wm-plp-modal__info {
      position: sticky;
      top: 0;
      align-self: start;
      min-height: 100%;
      padding: 20px 22px 20px 18px;
      justify-content: flex-start;
      gap: 8px;
    }

    .wm-plp-modal__title {
      font-size: 19px;
    }

    .wm-plp-modal__price {
      font-size: 21px;
    }

    .wm-plp-modal__desc {
      font-size: 13px;
      line-height: 1.5;
      margin: 2px 0 0;
      display: -webkit-box;
      -webkit-line-clamp: 6;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .wm-plp-modal {
      justify-content: center;
      align-items: center;
      padding: 14px;
    }

    .wm-plp-modal__dialog {
      width: 76vw;
      max-width: 620px;
      height: min(60vh, 420px);
      max-height: min(60vh, 420px);
      margin: auto;
      border-radius: 16px;
    }

    .wm-plp-modal__grid {
      grid-template-columns: 46% 54%;
      align-items: start;
      height: 100%;
      max-height: min(60vh, 420px);
      overflow-y: auto;
      overflow-x: hidden;
    }

    /* Sticky Left Image Column in Tablet View while Right Details Scroll */
    .wm-plp-modal__media {
      position: -webkit-sticky !important;
      position: sticky !important;
      top: 0 !important;
      align-self: start !important;
      width: 100%;
      height: min(60vh, 420px);
      min-height: min(60vh, 420px);
      max-height: min(60vh, 420px);
      padding: 10px;
      gap: 8px;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      box-sizing: border-box;
    }

    .wm-plp-modal__media {
      justify-content: flex-start;
      padding: 12px;
      gap: 10px;
    }

    .wm-plp-modal__gallery-main {
      width: 100%;
      height: auto;
      gap: 0;
      justify-content: flex-start;
    }

    .wm-plp-modal__thumbs {
      display: none !important;
    }

    .wm-plp-modal__stage {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      min-height: 0;
      max-height: none;
      padding: 0 !important;
      border-radius: 12px;
      background-color: #F3F4F6;
      overflow: hidden;
    }

    .wm-plp-modal__pager {
      display: none !important;
    }

    .wm-plp-modal__img {
      width: 100% !important;
      height: 100% !important;
      max-height: none !important;
      object-fit: cover !important;
      object-position: center !important;
      border-radius: inherit !important;
      display: block !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .wm-plp-modal__info {
      position: static !important;
      top: auto !important;
      align-self: start;
      height: auto;
      min-height: 100%;
