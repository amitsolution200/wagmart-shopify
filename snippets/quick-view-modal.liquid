          data-product-image="{{ 'catalog-bath-massage-brush.webp' | asset_url }}"
          data-product-url="/products/pet-grooming-glove"
        >
          <input type="hidden" data-qv-qty-input value="1">

          {%- comment -%} 2-Column CTA Grid matching PDP across all devices: [Add to Cart / - 1 + Stepper] | [Buy it now] {%- endcomment -%}
          <div class="wm-plp-modal__cta-grid">
            <div class="wm-plp-modal__atc-cell">
              <button
                type="button"
                class="wm-plp-modal__atc-btn"
                data-qv-atc
