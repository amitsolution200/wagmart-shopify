                  <svg class="wm-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <span class="wm-plp-modal__atc-stepper-val" data-qv-atc-qty>1</span>
                <button
                  type="button"
                  class="wm-plp-modal__atc-stepper-btn"
                  data-qv-atc-delta="1"
                  aria-label="Increase quantity"
                >
                  <svg class="wm-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
              </div>
            </div>

            <button
