{% comment %}
  Wagmart Single Article Content Component
  - Clean editorial blog details page (NO AI slop: removed takeaways boxes, feedback widgets, promo banners)
  - Pure white background (#ffffff) across all devices
  - Exact blog page images: dog-groomed.webp, slow-feeder-nutrition.webp, cat-relaxing.webp, dog-owner-happy.webp
  - Clean breadcrumb, category, date, read time, author attribution & share buttons
  - High-readability editorial typography with authentic veterinary content
  - Explore Related Stories: EXACTLY 3 cards matching the blog page card design
  - Fully responsive across desktop (>= 1024px), tablet (640-1023px), and mobile (< 640px)
{% endcomment %}

<style>
  /* =============================================================
     1. PAGE LAYOUT & CONTAINERS
     ============================================================= */
  .wm-article-page {
    background: #ffffff;
    padding: 32px 0 72px;
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    color: #2d3748;
    -webkit-font-smoothing: antialiased;
  }
  .wm-article-page__wrap {
    --nav-outer: clamp(0px, 1.6vw, 20px);
    --nav-inner: clamp(16px, 2vw, 30px);
    box-sizing: border-box;
    max-width: calc(1240px + (2 * var(--nav-outer)));
    margin: 0 auto;
    padding: 0 calc(var(--nav-outer) + var(--nav-inner));
  }
  @media (max-width: 767px) {
    .wm-article-page { padding: 20px 0 54px; }
    .wm-article-page__wrap { --nav-inner: 10px; }
  }

  /* Focused Editorial Article Column (Optimal reading width) */
  .wm-article-col {
    max-width: 1300px;
    margin: 0 auto;
  }

  /* =============================================================
     2. BREADCRUMBS
     ============================================================= */
  .wm-article-crumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13.5px;
    color: #718096;
    margin-bottom: 22px;
  }
  .wm-article-crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #64748b;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }
  .wm-article-crumbs a:hover {
    color: #7a46e5;
  }
  .wm-article-crumbs__sep {
    color: #cbd5e1;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .wm-article-crumbs__current {
    color: #1a202c;
    font-weight: 700;
    max-width: 340px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 640px) {
    .wm-article-crumbs {
      flex-wrap: nowrap;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 6px;
      font-size: 12.5px;
      margin-bottom: 16px;
      padding-bottom: 2px;
    }
    .wm-article-crumbs::-webkit-scrollbar {
      display: none;
    }
    .wm-article-crumbs a,
    .wm-article-crumbs span {
      flex-shrink: 0;
    }
    .wm-article-crumbs__current {
      max-width: 260px;
    }
  }

  /* =============================================================
     3. ARTICLE HEADER & META
     ============================================================= */
  .wm-article-head {
    margin-bottom: 24px;
  }
  .wm-article-meta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
    margin-bottom: 14px;
    font-size: 13px;
  }
  .wm-article-category {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(122, 70, 229, 0.08);
    color: #7a46e5;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    
  }
  .wm-article-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #718096;
    font-weight: 600;
  }
  .wm-article-meta-sep {
    color: #cbd5e1;
    font-size: 10px;
  }

  /* Editorial Title */
  .wm-article-title {
    margin: 0 0 18px;
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-size: clamp(26px, 3.6vw, 40px);
    font-weight: 800;
    line-height: 1.24;
    letter-spacing: -0.018em;
    color: #111111;
  }

  /* Author Row & Social Sharing */
  .wm-article-author-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid #edf2f7;
    border-bottom: 1px solid #edf2f7;
    margin-bottom: 28px;
  }
  .wm-article-author-info {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #64748b;
  }
  .wm-article-author-name {
    font-weight: 700;
    color: #111111;
  }

  /* Share buttons */
  .wm-article-share-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wm-article-share-label {
    font-size: 12.5px;
    font-weight: 600;
    color: #718096;
    margin-right: 2px;
  }
  .wm-article-share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    color: #475569;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    user-select: none;
  }
  .wm-article-share-btn:hover {
    background: #000000;
    border-color: #000000;
    color: #ffffff;
  }
  .wm-article-share-btn svg {
    flex-shrink: 0;
  }
  .wm-article-share-btn--icon-only {
    width: 34px;
    padding: 0;
  }

  /* =============================================================
     4. HERO FEATURED IMAGE
     ============================================================= */
  .wm-article-hero-wrap {
    margin-bottom: 34px;
  }
  .wm-article-hero-media {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #f1f5f9;
    aspect-ratio: 16 / 9;
    width: 100%;
  }
  @media (min-width: 1024px) {
    .wm-article-hero-media {
      aspect-ratio: 16 / 7.5;
      max-height: 550px;
    }
  }
  .wm-article-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
  }

  /* =============================================================
     5. EDITORIAL CONTENT BODY
     ============================================================= */
  .wm-article-body {
    font-size: 17px;
    line-height: 1.8;
    color: #2d3748;
  }
  .wm-article-body p {
    margin: 0 0 20px;
  }
  .wm-article-body p:last-child {
    margin-bottom: 0;
  }
  .wm-article-body h2 {
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-size: clamp(21px, 2.3vw, 26px);
    font-weight: 800;
    color: #111111;
    margin: 36px 0 16px;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .wm-article-body ul, .wm-article-body ol {
    margin: 0 0 22px 0;
    padding-left: 20px;
  }
  .wm-article-body li {
    margin-bottom: 10px;
    line-height: 1.7;
  }
  .wm-article-body strong {
    color: #111111;
    font-weight: 700;
  }

  /* Back to Blog Action */
  .wm-article-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid #edf2f7;
  }
  .wm-article-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #111111;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .wm-article-back-btn:hover {
    background: #000000;
    border-color: #000000;
    color: #ffffff;
  }

  /* =============================================================
     6. EXPLORE RELATED STORIES: EXACTLY 3 CARDS
     - Matches the blog page card layout and styling 100%
     ============================================================= */
  .wm-related-section {
    margin-top: 56px;
    padding-top: 48px;
    border-top: 1px solid #edf2f7;
  }
  .wm-related-head {
    margin-bottom: 28px;
    text-align: left;
  }
  .wm-related-title {
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 800;
    color: #111111;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .wm-related-subtitle {
    font-size: 14.5px;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
  }

  /* Responsive 3-Card Grid:
     - Desktop (>= 1024px): 3 columns in a row
     - Tablet (640-1023px): 3 columns in a row (or 2 on smaller tablet)
     - Mobile (< 640px): 1 column (single card per row)
  */
  .wm-related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .wm-related-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(16px, 2vw, 24px);
    }
  }

  /* Card Component matching main-blog.liquid & blog-section.liquid EXACTLY */
  .wm-blog-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-align: left;
    height: 100%;
    background: transparent;
    border: none;
    padding: 0;
    box-shadow: none;
    cursor: pointer;
  }
  .wm-blog-card__media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 14px;
    background: #f2f2f2;
    aspect-ratio: 4 / 3;
    margin-bottom: 12px;
    width: 100%;
  }
  .wm-blog-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wm-blog-card:hover .wm-blog-card__media img {
    transform: scale(1.05);
  }
  .wm-blog-card__title {
    margin: 0 0 4px;
    font-family: 'Nunito', system-ui, -apple-system, sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
    color: #111111;
  }
  .wm-blog-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .wm-blog-card:hover .wm-blog-card__title a,
  .wm-blog-card__title a:hover {
    color: #7a46e5;
  }
  .wm-blog-card__date {
    margin: 0 0 8px;
    font-size: 12.5px;
    color: #9a9a9a;
  }
  .wm-blog-card__excerpt {
    margin: 0 0 12px;
    font-size: 13.5px;
    line-height: 1.6;
    color: #555555;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .wm-blog-card__foot {
    margin-top: auto;
  }
  .wm-blog-card__more {
    display: inline-block;
    position: relative;
    padding-bottom: 3px;
    font-size: 13.5px;
    font-weight: 600;
    color: #2b3a55;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: left 100%;
    background-size: 0% 1.5px;
    transition:
      background-size 0.4s cubic-bezier(0.65, 0, 0.35, 1),
      color 0.3s ease;
  }
  .wm-blog-card:hover .wm-blog-card__more,
  .wm-blog-card__more:focus-visible {
    color: #7a46e5;
    background-size: 100% 1.5px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-blog-card__media img,
    .wm-blog-card__more {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

{%- liquid
  assign current_article = article
  assign current_blog = blog

  # Title
  assign art_title = current_article.title | default: 'Pet Care Guide'

  # Category Tag
  assign art_category = current_article.tags.first | default: 'Pet Journal'

  # Publish Date
  assign art_date = current_article.published_at | date: '%b %d, %Y' | default: 'Recent'

  # Estimated reading time
  assign words = current_article.content | strip_html | split: ' ' | size
  assign read_minutes = words | divided_by: 200
  if read_minutes < 1
    assign read_minutes = 1
  endif
  assign art_readtime = read_minutes | append: ' min read'

  # Featured Image
  assign art_image = current_article.image

  # Content
  assign art_content = current_article.content
-%}

<div id="wm-article-container" class="wm-article-page" aria-label="Wagmart Pet Journal Article">
  <div class="wm-article-page__wrap">

    <!-- Focused Reading Container -->
    <div class="wm-article-col">

      <!-- 1. Breadcrumb Navigation -->
      <nav class="wm-article-crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Home
        </a>
        <span class="wm-article-crumbs__sep">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
        <a href="{{ current_blog.url | default: '/blogs/news' }}">{{ current_blog.title | default: 'Pet Journal' }}</a>
        <span class="wm-article-crumbs__sep">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
        <span style="color: #64748b; font-weight: 500;">
          {{ art_category }}
        </span>
        <span class="wm-article-crumbs__sep">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </span>
        <span class="wm-article-crumbs__current">
          {{ art_title }}
        </span>
      </nav>

      <!-- 2. Article Header -->
      <header class="wm-article-head">
        <div class="wm-article-meta-row">
          <span class="wm-article-category">
            {{ art_category }}
          </span>

          <span class="wm-article-meta-item">
            <span>{{ art_date }}</span>
          </span>

          <span class="wm-article-meta-sep">•</span>

          <span class="wm-article-meta-item">
            <span>{{ art_readtime }}</span>
          </span>
        </div>

        <h1 class="wm-article-title">
          {{ art_title }}
        </h1>
      </header>

      <!-- 3. Hero Featured Image -->
      {%- if art_image != blank -%}
        <div class="wm-article-hero-wrap">
          <div class="wm-article-hero-media">
            <img
              src="{{ art_image | image_url: width: 1200 }}"
              alt="{{ art_title | escape }}"
              loading="eager"
              width="1000"
              height="562"
            >
          </div>
        </div>
      {%- endif -%}

      <!-- 4. Real Article Content from Shopify Admin -->
      <div class="wm-article-body">
        {%- if art_content != blank -%}
          {{ art_content }}
        {%- else -%}
          <p>This article has no content yet. You can add content in Shopify Admin under <strong>Online Store &rarr; Blog posts</strong>.</p>
        {%- endif -%}
      </div>

      <!-- Back to Blog Action -->
      <div class="wm-article-nav-row" style="margin-top: 48px; padding-top: 24px; border-top: 1px solid #e2e8f0;">
        <a href="{{ current_blog.url | default: '/blogs/news' }}" class="wm-article-nav-btn" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: #7a46e5; text-decoration: none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to all articles
        </a>
      </div>

    </div><!-- /.wm-article-col -->

    <!-- 5. Related Articles from the same Blog -->
    {%- if current_blog.articles.size > 1 -%}
      <section class="wm-related-section" aria-label="Related Pet Journal Stories" style="margin-top: 64px;">
        <div class="wm-related-head">
          <h2 class="wm-related-title">Explore Related Stories</h2>
          <p class="wm-related-subtitle">Continue reading expert veterinary advice, nutrition tips, and pet care guides.</p>
        </div>

        <div class="wm-related-grid">
          {%- assign rel_shown = 0 -%}
          {%- for rel_article in current_blog.articles -%}
            {%- if rel_article.id != current_article.id and rel_shown < 3 -%}
              {%- assign rel_shown = rel_shown | plus: 1 -%}
              <article class="wm-blog-card">
                <a href="{{ rel_article.url }}" class="wm-blog-card__media" tabindex="-1" aria-hidden="true">
                  {%- if rel_article.image != blank -%}
                    <img
                      src="{{ rel_article.image | image_url: width: 600 }}"
                      alt="{{ rel_article.title | escape }}"
                      loading="lazy"
                      width="600"
                      height="450"
                    >
                  {%- else -%}
                    <div style="width: 100%; height: 220px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-weight: 600;">
                      Wagmart Journal
                    </div>
                  {%- endif -%}
                </a>

                <h3 class="wm-blog-card__title">
                  <a href="{{ rel_article.url }}">{{ rel_article.title }}</a>
                </h3>

                <p class="wm-blog-card__date">{{ rel_article.published_at | date: '%b %d, %Y' }}</p>

                <p class="wm-blog-card__excerpt">
                  {{ rel_article.excerpt_or_content | strip_html | truncate: 140 }}
                </p>

                <div class="wm-blog-card__foot">
                  <a href="{{ rel_article.url }}" class="wm-blog-card__more">Read more</a>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

  </div><!-- /.wm-article-page__wrap -->
</div><!-- /#wm-article-container -->
