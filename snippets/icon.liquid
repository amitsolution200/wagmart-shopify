{%- comment -%}
  Wagmart Editorial Line Icon Set (Lucide 24x24 geometry, 1.5px stroke)
  Usage: {% render 'icon', name: 'shield-check', size: 20, class: 'wm-icon' %}
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 20
  assign icon_stroke = stroke_width | default: 1.5
  assign icon_class = class | default: 'wm-icon'
-%}
<svg
  class="{{ icon_class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="{% if filled %}currentColor{% else %}none{% endif %}"
  stroke="currentColor"
  stroke-width="{{ icon_stroke }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'hand' -%}
      <path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v6"/><path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
    {%- when 'sparkles' or 'feather' -%}
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/><path d="M19 3v4"/><path d="M21 5h-4"/>
    {%- when 'droplets' or 'water' -%}
      <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/>
    {%- when 'heart-handshake' or 'calm' -%}
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/><path d="M12 5 9.04 7.96a2.17 2.17 0 0 0 0 3.08c.82.82 2.13.85 3 .07l2.07-1.9a2.82 2.82 0 0 1 3.79 0l2.96 2.66"/><path d="m18 15-2-2"/><path d="m15 18-2-2"/>
    {%- when 'shield-check' or 'guarantee' -%}
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
    {%- when 'truck' or 'shipping' -%}
      <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
    {%- when 'rotate-ccw' or 'returns' -%}
      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>
    {%- when 'wallet' or 'payment' -%}
      <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/>
    {%- when 'map-pin' -%}
      <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
    {%- when 'check' -%}
      <path d="M20 6 9 17l-5-5"/>
    {%- when 'alert-circle' -%}
      <circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/>
    {%- when 'plus' -%}
      <path d="M5 12h14"/><path d="M12 5v14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 18-6-6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 18 6-6-6-6"/>
    {%- when 'zoom-in' -%}
      <circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/><line x1="11" x2="11" y1="8" y2="14"/><line x1="8" x2="14" y1="11" y2="11"/>
    {%- when 'close' or 'x' -%}
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    {%- when 'star' -%}
      <path d="M11.29 3.48Q12 2 12.71 3.48L14.41 7.05Q14.94 8.15 16.16 8.32L20.08 8.83Q21.7 9.05 20.51 10.18L17.65 12.9Q16.76 13.75 16.98 14.95L17.7 18.84Q18 20.45 16.56 19.67L13.08 17.79Q12 17.2 10.92 17.79L7.44 19.67Q6 20.45 6.3 18.84L7.02 14.95Q7.24 13.75 6.35 12.9L3.49 10.18Q2.3 9.05 3.92 8.83L7.84 8.32Q9.06 8.15 9.59 7.05Z" fill="#FFA41C" stroke="none"/>
    {%- when 'star-empty' -%}
      <path d="M11.29 3.48Q12 2 12.71 3.48L14.41 7.05Q14.94 8.15 16.16 8.32L20.08 8.83Q21.7 9.05 20.51 10.18L17.65 12.9Q16.76 13.75 16.98 14.95L17.7 18.84Q18 20.45 16.56 19.67L13.08 17.79Q12 17.2 10.92 17.79L7.44 19.67Q6 20.45 6.3 18.84L7.02 14.95Q7.24 13.75 6.35 12.9L3.49 10.18Q2.3 9.05 3.92 8.83L7.84 8.32Q9.06 8.15 9.59 7.05Z" fill="#E5E7EB" stroke="none"/>
    {%- when 'bag' -%}
      <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
    {%- when 'play' -%}
      <polygon points="6 3 20 12 6 21 6 3" fill="currentColor"/>
    {%- when 'box' or 'model' -%}
      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
    {%- when 'heart' -%}
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
    {%- when 'award' -%}
      <circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
    {%- when 'eye' -%}
      <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
