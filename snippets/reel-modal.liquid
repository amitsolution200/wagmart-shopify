{% comment %}
  Renders Wagmart Video Reel Player Modal
{% endcomment %}

<div id="reel-modal" class="hidden fixed inset-0 z-50 overflow-y-auto p-4 flex items-center justify-center" role="dialog" aria-modal="true" aria-label="Pet Story Video Player">
  {% comment %} Backdrop {% endcomment %}
  <div class="fixed inset-0 bg-black/80 backdrop-blur-sm transition-opacity" data-close-reel></div>

  <div class="relative w-full max-w-sm sm:max-w-md bg-neutral-900 rounded-3xl overflow-hidden shadow-2xl z-10 text-white animate-in zoom-in-95 duration-200 border border-neutral-800 flex flex-col">
    {% comment %} Close Button {% endcomment %}
    <button
      type="button"
      class="absolute top-4 right-4 z-30 w-9 h-9 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center transition cursor-pointer border border-white/20 shadow-lg"
      data-close-reel
      aria-label="Close reel"
    >
      {% render 'icon-close', class: 'w-5 h-5' %}
    </button>

    {% comment %} Video Player Container {% endcomment %}
    <div class="relative aspect-[9/13.5] w-full bg-black overflow-hidden flex items-center justify-center">
      <iframe
        src=""
        title="Wagmart Pet Story"
        class="w-full h-full border-0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>

    {% comment %} Bottom Details & Call to Action {% endcomment %}
    <div class="p-5 sm:p-6 bg-neutral-900 border-t border-neutral-800 space-y-3.5">
      <div class="flex items-center justify-between gap-2">
        <span class="px-3 py-1 rounded-full text-[10px] font-extrabold uppercase bg-[#7a46e5]/20 text-[#cbb2fa]" data-reel-tag>
          PET STORY
        </span>
      </div>

      <div class="space-y-1">
        <h3 class="font-bold text-lg leading-snug" data-reel-title>
          Pet Story Title
        </h3>
        <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed" data-reel-story>
          Watch how much fun pets have using Wagmart essentials.
        </p>
      </div>

      <button
        type="button"
        class="w-full py-2.5 bg-gradient-to-r from-[#7a46e5] to-[#9361fa] hover:opacity-95 text-white text-xs sm:text-sm font-semibold rounded-xl flex items-center justify-center gap-2 transition cursor-pointer shadow-md"
        data-scroll-to-shop
      >
        <span>Shop Supplies in This Story</span>
      </button>
    </div>
  </div>
</div>
