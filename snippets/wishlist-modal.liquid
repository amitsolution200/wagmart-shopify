{% comment %}
  Renders Wagmart Wishlist Slide-Over Modal
{% endcomment %}

<div id="wishlist-modal" class="hidden fixed inset-0 z-50 overflow-hidden" role="dialog" aria-modal="true" aria-label="My Wishlist">
  {% comment %} Backdrop {% endcomment %}
  <div class="absolute inset-0 bg-black/40 backdrop-blur-xs transition-opacity" data-close-wishlist></div>

  <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
    <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col border-l border-[#EAE5D9] transition-transform duration-300">
      
      {% comment %} Header {% endcomment %}
      <div class="p-6 border-b border-[#F0EBE1] flex items-center justify-between bg-white">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-full bg-red-50 text-red-500 flex items-center justify-center">
            {% render 'icon-heart', class: 'w-5 h-5 fill-current text-red-500' %}
          </div>
          <div>
            <h3 class="font-bold text-lg text-[#111827]">Your Wishlist</h3>
            <p class="text-xs text-[#6B7280]">
              <span data-wishlist-count>0</span> items saved
            </p>
          </div>
        </div>

        <button
          type="button"
          class="w-8 h-8 rounded-full hover:bg-gray-200 text-gray-500 hover:text-gray-800 flex items-center justify-center transition cursor-pointer"
          data-close-wishlist
          aria-label="Close wishlist"
        >
          {% render 'icon-close', class: 'w-5 h-5' %}
        </button>
      </div>

      {% comment %} Items List {% endcomment %}
      <div class="flex-1 overflow-y-auto p-6 space-y-4">
        
        {% comment %} Empty State Container {% endcomment %}
        <div id="wishlist-empty-state" class="h-full flex flex-col items-center justify-center text-center p-6 space-y-4 text-gray-500">
          <div class="w-16 h-16 rounded-full bg-neutral-50 border border-[#EAE5D9] flex items-center justify-center text-gray-300">
            {% render 'icon-heart', class: 'w-8 h-8 text-gray-300' %}
          </div>
          <div class="space-y-1">
            <h4 class="font-bold text-base text-gray-900">Your wishlist is empty</h4>
            <p class="text-xs text-gray-500 max-w-xs">
              Save your favorite pet supplies by tapping the heart icon on any product card.
            </p>
          </div>
          {% render 'theme-button', text: 'Discover Products', attributes: 'data-scroll-to-shop' %}
        </div>

        {% comment %} Dynamic Wishlist Items Container {% endcomment %}
        <div id="wishlist-items-container" class="hidden space-y-3.5"></div>

      </div>

    </div>
  </div>
</div>
