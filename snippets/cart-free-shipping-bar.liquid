{%- comment -%}
  Wagmart Cart Free-Shipping Progress Bar Snippet
  Parameters:
  - cart_total_cents: (optional) cart total in paise/cents (defaults to cart.total_price)
  - threshold_rupees: (optional) free shipping threshold in INR (defaults to 499)
{%- endcomment -%}

{%- liquid
  assign threshold_inr = threshold_rupees | default: 499
  assign threshold_cents = threshold_inr | times: 100
  assign current_cents = cart_total_cents | default: cart.total_price | default: 0
  assign remaining_cents = threshold_cents | minus: current_cents
  assign remaining_inr = remaining_cents | divided_by: 100.0 | ceil

  if current_cents >= threshold_cents
    assign is_unlocked = true
    assign progress_pct = 100
  else
    assign is_unlocked = false
    assign progress_pct = current_cents | times: 100 | divided_by: threshold_cents
    if progress_pct > 100
      assign progress_pct = 100
    endif
  endif
-%}

<div
  class="wm-cart-shipbar{% if is_unlocked %} is-unlocked{% endif %}"
  data-cart-shipping-bar
  data-threshold-inr="{{ threshold_inr }}"
  role="region"
  aria-label="Free shipping progress"
>
  <div class="wm-cart-shipbar__header">
    <span class="wm-cart-shipbar__icon" data-shipping-bar-icon aria-hidden="true">
      {%- if is_unlocked -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      {%- else -%}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      {%- endif -%}
    </span>
    <p class="wm-cart-shipbar__text" data-shipping-bar-text aria-live="polite">
      {%- if is_unlocked -%}
        <strong>You've unlocked FREE Express Shipping!</strong>
      {%- else -%}
        Add <strong>&#8377;{{ remaining_inr }}</strong> more for <strong>FREE shipping</strong>
      {%- endif -%}
    </p>
  </div>
  <div
    class="wm-cart-shipbar__track"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="{{ threshold_inr }}"
    aria-valuenow="{{ current_cents | divided_by: 100 }}"
    data-shipping-bar-progressbar
  >
    <div class="wm-cart-shipbar__fill" data-shipping-bar-fill style="width: {{ progress_pct }}%;"></div>
  </div>
</div>
